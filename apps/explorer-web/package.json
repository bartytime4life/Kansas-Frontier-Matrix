{
  "name": "explorer-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "test": "pnpm run test:unit && pnpm run test:browser",
    "test:unit": "vitest run tests/*.test.ts",
    "test:browser": "playwright test --config=playwright.config.ts",
    "typecheck:integration": "tsc --noEmit -p tsconfig.integration.json",
    "test:browser:api": "playwright test --config=playwright.api.config.ts",
    "test:integration": "pnpm run typecheck:integration && pnpm --filter @kfm/maplibre test && pnpm run test && pnpm run test:browser:api"
  },
  "dependencies": {
    "@kfm/maplibre": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "26.5.1",
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.0"
  }
}
