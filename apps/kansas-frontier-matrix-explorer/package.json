{
  "name": "kansas-frontier-matrix-explorer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "build": "npm run typecheck && bash scripts/build-verified.sh",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite preview --host 0.0.0.0",
    "test": "npm run build && node --test tests/*.test.mjs",
    "posttest": "npm run test:lint",
    "test:lint": "node --test ../../tests/ui/test_explorer_lint_compat.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern public/maplibre",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.54.8",
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "7946.0.16",
    "@types/node": "26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "10.10.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "wrangler": "4.131.1"
  },
  "type": "module",
  "displayName": "Kansas Frontier Matrix",
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    },
    "miniflare": {
      "sharp": "0.35.4"
    },
    "fflate": "0.7.5"
  }
}
