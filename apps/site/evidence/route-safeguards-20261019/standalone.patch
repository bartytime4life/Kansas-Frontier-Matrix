+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { posix } from "node:path";
+import { DatabaseSync } from "node:sqlite";
+import { after, afterEach, beforeEach, test } from "node:test";
+import ts from "typescript";
+
+// Compile real application modules; replace only platform/provider boundaries.
+// No listener, hosted credentials, private records or provider network is used.
+const data = source => `data:text/javascript;base64,${Buffer.from(source).toString("base64")}`;
+const env = { KFM_HISTORICAL_OWNER_IDS: "synthetic-owner", KFM_ARCHIVE_OWNER_IDS: "synthetic-owner" };
+const objects = new Map();
+env.BUCKET = {
+  get: async key => { const value = objects.get(key); return value ? { size: value.byteLength, arrayBuffer: async () => value.buffer.slice(value.byteOffset, value.byteOffset + value.byteLength) } : null; },
+  put: async (key, value) => { objects.set(key, new Uint8Array(value)); },
+};
+const sqlite = new DatabaseSync(":memory:");
+sqlite.exec(await readFile(new URL("../drizzle/0005_daily_archive.sql", import.meta.url), "utf8"));
+const db = { prepare(sql) {
+  let bindings = [];
+  return { bind(...values) { bindings = values; return this; },
+    async all() { return { results: sqlite.prepare(sql).all(...bindings) }; },
+    async first() { return sqlite.prepare(sql).get(...bindings) ?? null; },
+    async run() { return { meta: { changes: sqlite.prepare(sql).run(...bindings).changes } }; },
+  };
+} };
+globalThis.__siteRouteSafeguards = { env, db, user: { id: "synthetic-owner", email: "owner@example.test" } };
+const overrides = {
+  "cloudflare:workers": data("export const env = globalThis.__siteRouteSafeguards.env;"),
+  "next/server": data("export class NextRequest extends Request { get nextUrl() { return new URL(this.url); } }"),
+  "db": data("export const getRawDb = () => globalThis.__siteRouteSafeguards.db;"),
+  "app/chatgpt-auth": data("export const getChatGPTUser = async () => globalThis.__siteRouteSafeguards.user;"),
+  "app/api/live-context/route": data("export const GET = async () => { throw new Error('Provider calls prohibited'); };"),
+};
+const modules = new Map();
+async function moduleUrl(name) {
+  if (overrides[name]) return overrides[name];
+  if (modules.has(name)) return modules.get(name);
+  let js = ts.transpileModule(await readFile(new URL(`../${name}.ts`, import.meta.url), "utf8"), {
+    compilerOptions: { module: ts.ModuleKind.ESNext, target: ts.ScriptTarget.ES2022 },
+  }).outputText;
+  for (const match of [...js.matchAll(/from\s+"([^"]+)"/g)]) {
+    const specifier = match[1];
+    const dependency = specifier.startsWith(".") ? posix.normalize(posix.join(posix.dirname(name), specifier)) : specifier;
+    js = js.replace(JSON.stringify(specifier), JSON.stringify(await moduleUrl(dependency)));
+  }
+  const url = data(js); modules.set(name, url); return url;
+}
+const load = async name => import(await moduleUrl(name));
+const topo = await load("app/historical-topo-overlay-server");
+const overlay = await load("app/api/historical-topo/overlay/route");
+const activate = await load("app/api/historical-topo/activate/route");
+const lightning = await load("app/lightning-server");
+const preview = await load("app/api/lightning/preview/route");
+const archive = await load("app/api/daily-archive/route");
+const store = await load("app/daily-archive-store");
+const { NextRequest } = await import(overrides["next/server"]);
+const originalFetch = globalThis.fetch;
+beforeEach(() => {
+  objects.clear(); globalThis.__siteRouteSafeguards.user = { id: "synthetic-owner", email: "owner@example.test" };
+  globalThis.fetch = async () => { throw new Error("Unexpected upstream request"); };
+  for (const table of ["daily_archive_reviews", "daily_archive_captures", "daily_archive_settings"]) sqlite.exec(`DELETE FROM ${table}`);
+});
+afterEach(() => { globalThis.fetch = originalFetch; });
+after(() => { sqlite.close(); delete globalThis.__siteRouteSafeguards; });
+const post = (name, body) => new Request(`https://site.test/api/historical-topo/${name}`, {
