{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KFM MapLibre performance envelope v1",
  "description": "Machine-shape validation for the repository-owned MapLibre performance threshold configuration. Validity does not establish benchmark, policy, release, or publication authority.",
  "$comment": "This unversioned repository path remains a transitional compatibility surface. The schema_version property carries the payload version.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "domain",
    "policy_posture",
    "thresholds",
    "notes"
  ],
  "properties": {
    "object_type": {
      "const": "PerfEnvelope"
    },
    "schema_version": {
      "const": "v1"
    },
    "domain": {
      "const": "maplibre"
    },
    "policy_posture": {
      "const": "public_safe"
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "avg_frame_ms",
        "p95_frame_ms",
        "idle_ms",
        "load_ms",
        "render_pixel_delta_ratio"
      ],
      "properties": {
        "avg_frame_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "p95_frame_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "idle_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "load_ms": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "render_pixel_delta_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500,
        "allOf": [
          {
            "pattern": "\\S"
          },
          {
            "not": {
              "pattern": "[\\u0000-\\u001f\\u007f]"
            }
          }
        ]
      }
    }
  }
}
