{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/runtime/runtime_verification/receipt.schema.json",
  "title": "RuntimeVerificationReceipt",
  "description": "Progress/checkpoint process memory for one runtime artifact-verification attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "receipt_id",
    "job_id",
    "artifact_ref",
    "manifest_ref",
    "source_url",
    "bytes_processed",
    "checkpoint_index",
    "partial_digest",
    "status",
    "recorded_at",
    "prior_receipt_ref",
    "verifier"
  ],
  "properties": {
    "object_type": {
      "const": "RuntimeVerificationReceipt"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^kfm://receipt/runtime-verification/[a-z0-9][a-z0-9_.:-]{2,160}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{2,160}$"
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 720,
      "pattern": "\\S"
    },
    "manifest_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 720,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_url": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 720,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "bytes_processed": {
      "type": "integer",
      "minimum": 0
    },
    "checkpoint_index": {
      "type": "integer",
      "minimum": 0
    },
    "partial_digest": {
      "oneOf": [
        {
          "$ref": "https://schemas.kfm.local/contracts/v1/runtime/runtime_verification/digest.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "STARTED",
        "IN_PROGRESS",
        "CHECKPOINTED",
        "RESUMED"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "prior_receipt_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 720,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "version"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "CHECKPOINTED",
              "RESUMED"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "partial_digest": {
            "$ref": "https://schemas.kfm.local/contracts/v1/runtime/runtime_verification/digest.schema.json"
          },
          "checkpoint_index": {
            "minimum": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "RESUMED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "prior_receipt_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 720,
            "pattern": "\\S"
          }
        }
      }
    }
  ],
  "x-kfm": {
    "status": "PROPOSED",
    "contract_doc": "contracts/runtime/runtime_verification.md",
    "fixtures_root": "fixtures/contracts/v1/runtime/runtime_verification/receipts/",
    "validator": "tools/validators/runtime_verification/validate_runtime_verification.py",
    "tests": "tests/validators/test_validate_runtime_verification.py",
    "authority": "runtime_verification_progress_receipt_shape_only",
    "non_effects": [
      "does_not_create_final_verification_proof",
      "does_not_evaluate_policy",
      "does_not_authorize_release_or_publication"
    ]
  }
}
