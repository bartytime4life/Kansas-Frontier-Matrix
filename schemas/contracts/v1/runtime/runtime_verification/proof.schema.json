{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/runtime/runtime_verification/proof.schema.json",
  "title": "RuntimeVerificationProof",
  "description": "Final finite, proof-ready result of one runtime artifact-verification attempt.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "proof_id",
    "job_id",
    "artifact_ref",
    "manifest_ref",
    "outcome",
    "expected_digest",
    "observed_digest",
    "reason",
    "verified_at",
    "verifier",
    "receipt_ref"
  ],
  "properties": {
    "object_type": {
      "const": "RuntimeVerificationProof"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "proof_id": {
      "type": "string",
      "pattern": "^kfm://proof/runtime-verification/[a-z0-9][a-z0-9_.:-]{2,160}$"
    },
    "job_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{2,160}$"
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 720,
      "pattern": "\\S"
    },
    "manifest_ref": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 720,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "outcome": {
      "$ref": "https://schemas.kfm.local/contracts/v1/runtime/runtime_verification/outcome.schema.json"
    },
    "expected_digest": {
      "oneOf": [
        {
          "$ref": "https://schemas.kfm.local/contracts/v1/runtime/runtime_verification/digest.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "observed_digest": {
      "oneOf": [
        {
          "$ref": "https://schemas.kfm.local/contracts/v1/runtime/runtime_verification/digest.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        },
        {
          "type": "null"
        }
      ]
    },
    "verified_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "version"
      ],
      "properties": {
        "surface": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-z0-9][a-z0-9_.:-]*$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        }
      }
    },
    "receipt_ref": {
      "type": "string",
      "pattern": "^kfm://receipt/runtime-verification/[a-z0-9][a-z0-9_.:-]{2,160}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "VERIFIED"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "manifest_ref": {
            "type": "string",
            "minLength": 1
          },
          "expected_digest": {
            "$ref": "https://schemas.kfm.local/contracts/v1/runtime/runtime_verification/digest.schema.json"
          },
          "observed_digest": {
            "$ref": "https://schemas.kfm.local/contracts/v1/runtime/runtime_verification/digest.schema.json"
          },
          "reason": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "MISMATCH"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "manifest_ref": {
            "type": "string",
            "minLength": 1
          },
          "expected_digest": {
            "$ref": "https://schemas.kfm.local/contracts/v1/runtime/runtime_verification/digest.schema.json"
          },
          "observed_digest": {
            "$ref": "https://schemas.kfm.local/contracts/v1/runtime/runtime_verification/digest.schema.json"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "MISSING_DECLARATION"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "manifest_ref": {
            "type": "null"
          },
          "expected_digest": {
            "type": "null"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "INTERRUPTED"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "outcome": {
            "const": "ERROR"
          }
        },
        "required": [
          "outcome"
        ]
      },
      "then": {
        "properties": {
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "expected_digest": {
            "not": {
              "type": "null"
            }
          }
        },
        "required": [
          "expected_digest"
        ]
      },
      "then": {
        "properties": {
          "manifest_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  ],
  "x-kfm": {
    "status": "PROPOSED",
    "contract_doc": "contracts/runtime/runtime_verification.md",
    "fixtures_root": "fixtures/contracts/v1/runtime/runtime_verification/proofs/",
    "validator": "tools/validators/runtime_verification/validate_runtime_verification.py",
    "tests": "tests/validators/test_validate_runtime_verification.py",
    "authority": "runtime_verification_proof_ready_shape_only",
    "non_effects": [
      "does_not_create_evidence_bundle_closure",
      "does_not_evaluate_policy",
      "does_not_authorize_promotion_release_or_publication"
    ]
  }
}
