{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/runtime/database_mutation_transaction_receipt.schema.json",
  "title": "DatabaseMutationTransactionReceiptCandidate",
  "description": "Fixture-only companion profile for a RunReceipt that declares transaction boundaries, finite mutation outcome, row counts, and a recovery target without connecting to or mutating a database.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "profile",
    "execution_mode",
    "source_card",
    "profile_spec_hash",
    "observed_at",
    "run_receipt",
    "run_receipt_digest",
    "transaction",
    "mutations",
    "totals",
    "recovery_target",
    "authority_claims"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "object_type": {
      "const": "DatabaseMutationTransactionReceiptCandidate"
    },
    "profile": {
      "const": "kfm.runtime.database-mutation-transaction-receipt.fixture.v1"
    },
    "execution_mode": {
      "const": "FIXTURE_ONLY_DECLARATION"
    },
    "source_card": {
      "const": "KFM-P18-INV-404"
    },
    "profile_spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "run_receipt": {
      "$ref": "https://schemas.kfm.local/contracts/v1/runtime/run_receipt.schema.json"
    },
    "run_receipt_digest": {
      "$ref": "#/$defs/sha256"
    },
    "transaction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transaction_id",
        "mode",
        "began_at",
        "ended_at",
        "isolation_level",
        "outcome",
        "persisted_state"
      ],
      "properties": {
        "transaction_id": {
          "type": "string",
          "pattern": "^tx:[a-z0-9][a-z0-9_.:-]*$",
          "maxLength": 128
        },
        "mode": {
          "enum": [
            "APPLY",
            "ROLLBACK_REHEARSAL"
          ]
        },
        "began_at": {
          "type": "string",
          "format": "date-time"
        },
        "ended_at": {
          "type": "string",
          "format": "date-time"
        },
        "isolation_level": {
          "enum": [
            "READ_COMMITTED",
            "REPEATABLE_READ",
            "SERIALIZABLE"
          ]
        },
        "outcome": {
          "enum": [
            "COMMITTED",
            "ROLLED_BACK",
            "FAILED_BEFORE_COMMIT",
            "INDETERMINATE"
          ]
        },
        "persisted_state": {
          "enum": [
            "PERSISTED",
            "NOT_PERSISTED",
            "UNKNOWN"
          ]
        }
      }
    },
    "mutations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "statement_id",
          "operation",
          "relation_ref",
          "attempted_rows",
          "affected_rows",
          "validation_ref"
        ],
        "properties": {
          "statement_id": {
            "type": "string",
            "pattern": "^statement:[0-9]{4}$"
          },
          "operation": {
            "enum": [
              "INSERT",
              "UPDATE",
              "DELETE",
              "MERGE"
            ]
          },
          "relation_ref": {
            "type": "string",
            "pattern": "^kfm:relation:synthetic:[a-z0-9][a-z0-9_.:-]*$",
            "maxLength": 256
          },
          "attempted_rows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "affected_rows": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000000000
          },
          "validation_ref": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    },
    "totals": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement_count",
        "attempted_rows",
        "affected_rows"
      ],
      "properties": {
        "statement_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "attempted_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000000
        },
        "affected_rows": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000000000
        }
      }
    },
    "recovery_target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest",
        "resolution"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^kfm:recovery-target:synthetic:[a-z0-9][a-z0-9_.:-]*$",
          "maxLength": 256
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "resolution": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED"
          ]
        }
      }
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_assessment",
        "validator_network_accessed",
        "database_connected",
        "transaction_executed",
        "transaction_outcome_authenticated",
        "affected_rows_authenticated",
        "recovery_target_authenticated",
        "policy_authority",
        "review_authority",
        "promotion_authority",
        "release_authority",
        "publication_authority"
      ],
      "properties": {
        "deterministic_assessment": {
          "const": true
        },
        "validator_network_accessed": {
          "const": false
        },
        "database_connected": {
          "const": false
        },
        "transaction_executed": {
          "const": false
        },
        "transaction_outcome_authenticated": {
          "const": false
        },
        "affected_rows_authenticated": {
          "const": false
        },
        "recovery_target_authenticated": {
          "const": false
        },
        "policy_authority": {
          "const": false
        },
        "review_authority": {
          "const": false
        },
        "promotion_authority": {
          "const": false
        },
        "release_authority": {
          "const": false
        },
        "publication_authority": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^\\S+$"
    }
  },
  "x-kfm": {
    "contract_doc": "contracts/runtime/database_mutation_transaction_receipt.md",
    "fixtures_root": "fixtures/contracts/v1/runtime/database_mutation_transaction_receipt/",
    "validator": "tools/validators/runtime/validate_database_mutation_transaction_receipt.py",
    "status": "PROPOSED_INACTIVE",
    "network": false,
    "database_effects": false,
    "authority_effects": false
  }
}
