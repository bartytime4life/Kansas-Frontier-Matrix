{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/runtime/pipeline_resilience_plan.schema.json",
  "title": "pipeline_resilience_plan",
  "description": "Deterministic planning-only decisions for governed pipeline resilience.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "plan_id",
    "planner_version",
    "pipeline_id",
    "step_id",
    "contract_version",
    "spec_hash",
    "idempotency_key",
    "decision",
    "reason_codes",
    "trigger",
    "retry",
    "backpressure",
    "circuit_breaker",
    "delivery",
    "kill_switch",
    "required_receipts",
    "observability_requirements",
    "authority",
    "write_authority"
  ],
  "properties": {
    "plan_id": {
      "type": "string",
      "pattern": "^pipeline-resilience:[a-z][a-z0-9._-]{0,127}:[a-z][a-z0-9._-]{0,127}:[a-f0-9]{16}$"
    },
    "planner_version": {
      "const": "v1"
    },
    "pipeline_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "step_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^v[1-9][0-9]*$"
    },
    "spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "idempotency_key": {
      "$ref": "#/$defs/sha256"
    },
    "decision": {
      "type": "string",
      "enum": [
        "ALLOW_START",
        "ALLOW_RETRY",
        "ALLOW_REPLAY",
        "PAUSE",
        "QUARANTINE",
        "DENY",
        "NO_ACTION",
        "OPERATOR_REQUIRED"
      ]
    },
    "reason_codes": {
      "$ref": "#/$defs/reason_codes"
    },
    "trigger": {
      "$ref": "#/$defs/trigger"
    },
    "retry": {
      "$ref": "#/$defs/retry"
    },
    "backpressure": {
      "$ref": "#/$defs/backpressure"
    },
    "circuit_breaker": {
      "$ref": "#/$defs/circuit_breaker"
    },
    "delivery": {
      "$ref": "#/$defs/delivery"
    },
    "kill_switch": {
      "$ref": "#/$defs/kill_switch"
    },
    "required_receipts": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "attempt_receipt",
          "backpressure_decision_receipt",
          "circuit_breaker_transition_receipt",
          "dead_letter_replay_receipt",
          "kill_switch_state_receipt",
          "terminal_receipt"
        ]
      }
    },
    "observability_requirements": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "breaker_state",
          "oldest_queue_age_seconds",
          "queue_depth",
          "retry_attempt_count",
          "time_to_drain_seconds"
        ]
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_fetch",
        "artifact_write",
        "workflow_mutation",
        "database_mutation",
        "secret_access",
        "policy_evaluation",
        "promotion",
        "release",
        "publication"
      ],
      "properties": {
        "network_fetch": {
          "const": false
        },
        "artifact_write": {
          "const": false
        },
        "workflow_mutation": {
          "const": false
        },
        "database_mutation": {
          "const": false
        },
        "secret_access": {
          "const": false
        },
        "policy_evaluation": {
          "const": false
        },
        "promotion": {
          "const": false
        },
        "release": {
          "const": false
        },
        "publication": {
          "const": false
        }
      }
    },
    "write_authority": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "environment",
        "concurrency_group",
        "secret_scope",
        "decision",
        "reason_codes"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "push",
            "pull_request",
            "schedule",
            "workflow_dispatch",
            "repository_dispatch",
            "release",
            "workflow_call",
            "pipeline_handoff",
            "external_webhook"
          ]
        },
        "environment": {
          "type": "string",
          "enum": [
            "fixture",
            "development",
            "staging",
            "production"
          ]
        },
        "concurrency_group": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "secret_scope": {
          "type": "string",
          "enum": [
            "NONE",
            "READ_ONLY",
            "DOMAIN_SCOPED",
            "ENVIRONMENT_SCOPED"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "ALLOW",
            "DENY"
          ]
        },
        "reason_codes": {
          "$ref": "#/$defs/reason_codes"
        }
      }
    },
    "retry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "decision",
        "delay_seconds",
        "next_attempt",
        "idempotency_retention_seconds",
        "reason_codes"
      ],
      "properties": {
        "classification": {
          "type": "string",
          "enum": [
            "NONE",
            "TRANSIENT",
            "RATE_LIMITED",
            "DETERMINISTIC",
            "POLICY_DENIED",
            "QUARANTINE",
            "OPERATOR_REQUIRED"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "NO_ACTION",
            "RETRY",
            "STOP",
            "QUARANTINE",
            "OPERATOR_REQUIRED"
          ]
        },
        "delay_seconds": {
          "type": "number",
          "minimum": 0
        },
        "next_attempt": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "integer",
              "minimum": 2
            }
          ]
        },
        "idempotency_retention_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "reason_codes": {
          "$ref": "#/$defs/reason_codes"
        }
      }
    },
    "backpressure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "partition",
        "decision",
        "reason_codes"
      ],
      "properties": {
        "partition": {
          "type": "string",
          "enum": [
            "CANARY",
            "FULL"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "ACCEPT",
            "THROTTLE",
            "SHED",
            "HOLD",
            "DENY"
          ]
        },
        "reason_codes": {
          "$ref": "#/$defs/reason_codes"
        }
      }
    },
    "circuit_breaker": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current_state",
        "next_state",
        "decision",
        "reason_codes"
      ],
      "properties": {
        "current_state": {
          "type": "string",
          "enum": [
            "CLOSED",
            "OPEN",
            "HALF_OPEN"
          ]
        },
        "next_state": {
          "type": "string",
          "enum": [
            "CLOSED",
            "OPEN",
            "HALF_OPEN"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "ALLOW",
            "DENY",
            "PROBE"
          ]
        },
        "reason_codes": {
          "$ref": "#/$defs/reason_codes"
        }
      }
    },
    "dead_letter_detail": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "reason_code",
        "attempt_count",
        "contract_version",
        "target_contract_version"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "reason_code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{0,127}$"
        },
        "attempt_count": {
          "type": "integer",
          "minimum": 1
        },
        "contract_version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        },
        "target_contract_version": {
          "type": "string",
          "pattern": "^v[1-9][0-9]*$"
        }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision",
        "durability_mode",
        "reason_codes"
      ],
      "properties": {
        "decision": {
          "type": "string",
          "enum": [
            "ALLOW",
            "HOLD",
            "QUARANTINE",
            "DENY",
            "REPLAY",
            "NOT_APPLICABLE"
          ]
        },
        "durability_mode": {
          "type": "string",
          "enum": [
            "NONE",
            "TRANSACTIONAL_OUTBOX",
            "WAL"
          ]
        },
        "dead_letter": {
          "$ref": "#/$defs/dead_letter_detail"
        },
        "reason_codes": {
          "$ref": "#/$defs/reason_codes"
        }
      }
    },
    "kill_switch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "previous_mode",
        "mode",
        "decision",
        "reason_codes"
      ],
      "properties": {
        "previous_mode": {
          "type": "string",
          "enum": [
            "RUNNING",
            "PAUSE_NEW_STARTS",
            "EMERGENCY_STOP"
          ]
        },
        "mode": {
          "type": "string",
          "enum": [
            "RUNNING",
            "PAUSE_NEW_STARTS",
            "EMERGENCY_STOP"
          ]
        },
        "decision": {
          "type": "string",
          "enum": [
            "ALLOW",
            "PAUSE_NEW_STARTS",
            "STOP_ALL",
            "DENY"
          ]
        },
        "reason_codes": {
          "$ref": "#/$defs/reason_codes"
        }
      }
    }
  },
  "x-kfm": {
    "contract_doc": "contracts/runtime/pipeline_resilience_plan.md",
    "planner": "packages/pipelines-core/src/pipelines_core/pipeline_resilience.py",
    "cli": "scripts/plan_pipeline_resilience.py",
    "fixtures_root": "fixtures/contracts/v1/runtime/pipeline_resilience_plan/",
    "source_idea_ids": [
      "KFM-P8-PROG-0001",
      "KFM-P8-PROG-0002",
      "KFM-P8-PROG-0003",
      "KFM-P8-PROG-0004",
      "KFM-P8-PROG-0005"
    ],
    "status": "PROPOSED"
  }
}
