{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/runtime/generated_runtime_proof_artifact.schema.json",
  "title": "GeneratedRuntimeProofArtifact",
  "description": "Fixture-first lifecycle record for generated runtime-test outputs. Schema validity does not create evidence, policy, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "artifact_id",
    "artifact_kind",
    "profile",
    "case_id",
    "artifact_ref",
    "content",
    "lifecycle",
    "provenance",
    "review",
    "golden_promotion",
    "invalidation",
    "safety",
    "governance"
  ],
  "properties": {
    "object_type": {"const": "GeneratedRuntimeProofArtifact"},
    "schema_version": {"const": "1.0.0"},
    "artifact_id": {
      "type": "string",
      "pattern": "^runtime-proof-artifact:[a-z0-9][a-z0-9_.:-]{7,240}$"
    },
    "artifact_kind": {
      "type": "string",
      "enum": ["ACTUAL_RESPONSE", "SUMMARY", "DIFF", "TRACE", "OTHER_TEST_ARTIFACT"]
    },
    "profile": {"$ref": "#/$defs/profile"},
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_.:-]{2,160}$"
    },
    "artifact_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 720,
      "pattern": "^(?:kfm://|urn:)[^\\s@]+@sha256:[a-f0-9]{64}$"
    },
    "content": {"$ref": "#/$defs/content"},
    "lifecycle": {"$ref": "#/$defs/lifecycle"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "review": {"$ref": "#/$defs/review"},
    "golden_promotion": {"$ref": "#/$defs/golden_promotion"},
    "invalidation": {"$ref": "#/$defs/invalidation"},
    "safety": {"$ref": "#/$defs/safety"},
    "governance": {"$ref": "#/$defs/governance"}
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 640,
      "pattern": "\\S"
    },
    "nullable_ref": {
      "oneOf": [
        {"$ref": "#/$defs/ref"},
        {"type": "null"}
      ]
    },
    "ref_array": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/ref"},
      "uniqueItems": true
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "aware_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullable_datetime": {
      "oneOf": [
        {"$ref": "#/$defs/aware_datetime"},
        {"type": "null"}
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "profile_version", "spec_hash"],
      "properties": {
        "profile_id": {"$ref": "#/$defs/ref"},
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "spec_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["digest", "byte_size", "media_type", "encoding", "canonicalization_profile"],
      "properties": {
        "digest": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 1, "maximum": 67108864},
        "media_type": {
          "type": "string",
          "enum": ["application/json", "text/markdown", "text/plain", "application/octet-stream"]
        },
        "encoding": {"type": "string", "enum": ["utf-8", "binary"]},
        "canonicalization_profile": {
          "type": "string",
          "enum": ["byte-exact", "canonical-json-rfc8785", "kfm-canonical-json-v1", "none"]
        }
      }
    },
    "state": {
      "type": "string",
      "enum": ["EPHEMERAL", "RETAINED", "REVIEWED", "PROMOTED_GOLDEN", "STALE", "INVALIDATED", "DELETED"]
    },
    "nullable_state": {
      "oneOf": [
        {"$ref": "#/$defs/state"},
        {"type": "null"}
      ]
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,96}$"
      },
      "uniqueItems": true
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "previous_state", "transitioned_at", "expires_at", "reason_codes", "prior_record_ref"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "previous_state": {"$ref": "#/$defs/nullable_state"},
        "transitioned_at": {"$ref": "#/$defs/aware_datetime"},
        "expires_at": {"$ref": "#/$defs/nullable_datetime"},
        "reason_codes": {"$ref": "#/$defs/reason_codes"},
        "prior_record_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "run_receipt_ref", "generator_id", "generator_version", "input_refs"],
      "properties": {
        "generated_at": {"$ref": "#/$defs/aware_datetime"},
        "run_receipt_ref": {"$ref": "#/$defs/ref"},
        "generator_id": {"$ref": "#/$defs/ref"},
        "generator_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "input_refs": {"$ref": "#/$defs/ref_array"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "review_record_refs"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["NOT_REQUESTED", "PENDING", "APPROVED", "CHANGES_REQUESTED", "REJECTED"]
        },
        "review_record_refs": {"$ref": "#/$defs/ref_array"}
      }
    },
    "golden_promotion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "decision_id", "decided_at", "artifact_digest", "review_record_refs", "expires_at", "authority"],
      "properties": {
        "decision": {
          "type": "string",
          "enum": ["NOT_REQUESTED", "HOLD", "DENY", "PROMOTE_GOLDEN"]
        },
        "decision_id": {"$ref": "#/$defs/nullable_ref"},
        "decided_at": {"$ref": "#/$defs/nullable_datetime"},
        "artifact_digest": {"$ref": "#/$defs/nullable_sha256"},
        "review_record_refs": {"$ref": "#/$defs/ref_array"},
        "expires_at": {"$ref": "#/$defs/nullable_datetime"},
        "authority": {"const": "TEST_FIXTURE_ONLY"}
      }
    },
    "invalidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_codes", "correction_ref", "superseded_by_ref", "deletion_receipt_ref"],
      "properties": {
        "reason_codes": {"$ref": "#/$defs/reason_codes"},
        "correction_ref": {"$ref": "#/$defs/nullable_ref"},
        "superseded_by_ref": {"$ref": "#/$defs/nullable_ref"},
        "deletion_receipt_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_class", "contains_secrets", "contains_personal_data", "contains_precise_sensitive_geometry", "public_use_allowed"],
      "properties": {
        "data_class": {
          "type": "string",
          "enum": ["SYNTHETIC_PUBLIC_SAFE", "INTERNAL", "RESTRICTED", "UNKNOWN"]
        },
        "contains_secrets": {"type": "boolean"},
        "contains_personal_data": {"type": "boolean"},
        "contains_precise_sensitive_geometry": {"type": "boolean"},
        "public_use_allowed": {"type": "boolean"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority_created", "evidence_closure_claimed", "policy_evaluated", "promotion_authorized", "release_authorized", "publication_authorized", "release_ref"],
      "properties": {
        "authority_created": {"type": "boolean"},
        "evidence_closure_claimed": {"type": "boolean"},
        "policy_evaluated": {"type": "boolean"},
        "promotion_authorized": {"type": "boolean"},
        "release_authorized": {"type": "boolean"},
        "publication_authorized": {"type": "boolean"},
        "release_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED",
    "contract_doc": "contracts/runtime/generated_runtime_proof_artifact.md",
    "fixtures_root": "fixtures/contracts/v1/runtime/generated_runtime_proof_artifact/",
    "validator": "tools/validators/validate_generated_runtime_proof_artifact.py",
    "tests": "tests/validators/test_validate_generated_runtime_proof_artifact.py",
    "authority": "generated_test_artifact_lifecycle_only",
    "non_effects": [
      "does_not_store_generated_payload_bytes",
      "does_not_create_evidence_or_policy_authority",
      "does_not_authenticate_reviewers",
      "does_not_authorize_release_or_publication"
    ]
  }
}
