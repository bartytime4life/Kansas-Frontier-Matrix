{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/roads-rail-trade/faa_airspace_context.schema.json",
  "title": "Kansas FAA airspace, airport and airway display context",
  "type": "object",
  "required": ["profile", "generator", "nasr_cycle", "valid_from", "valid_to_exclusive", "evidence_role", "region_bbox", "source", "limitations", "class_a", "volumes", "airports", "airways", "withheld", "rejects", "product_id"],
  "additionalProperties": false,
  "$defs": {
    "bound": {
      "type": "object",
      "required": ["value_ft", "reference"],
      "additionalProperties": false,
      "properties": {
        "value_ft": {"type": "integer", "minimum": -2000, "maximum": 100000},
        "reference": {"enum": ["MSL", "AGL", "SFC"]},
        "inclusive": {"const": false}
      }
    },
    "binding": {
      "type": "object",
      "required": ["package", "version", "integrity", "sha256"],
      "additionalProperties": false,
      "properties": {
        "package": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "integrity": {"type": "string", "pattern": "^sha512-"},
        "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
      }
    },
    "position": {"type": "array", "prefixItems": [{"type": "number", "minimum": -180, "maximum": 180}, {"type": "number", "minimum": -90, "maximum": 90}], "minItems": 2, "maxItems": 2}
  },
  "properties": {
    "profile": {"const": "kfm.aviation-kansas-context/v1"},
    "generator": {"const": "faa-airspace-v1"},
    "nasr_cycle": {"type": "string", "format": "date"},
    "valid_from": {"type": "string", "format": "date"},
    "valid_to_exclusive": {"type": "string", "format": "date"},
    "evidence_role": {"const": "EXTERNAL_CONTEXT_ONLY"},
    "region_bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
    "source": {
      "type": "object",
      "required": ["authority", "nasr_url", "airspace", "airports", "airways"],
      "additionalProperties": false,
      "properties": {
        "authority": {"type": "string"},
        "nasr_url": {"type": "string", "format": "uri"},
        "airspace": {"$ref": "#/$defs/binding"},
        "airports": {"$ref": "#/$defs/binding"},
        "airways": {"$ref": "#/$defs/binding"}
      }
    },
    "limitations": {"type": "array", "items": {"type": "string"}, "minItems": 1},
    "class_a": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["floor", "ceiling"], "additionalProperties": false, "properties": {"floor": {"$ref": "#/$defs/bound"}, "ceiling": {"$ref": "#/$defs/bound"}}}]},
    "volumes": {"type": "array", "maxItems": 2000, "items": {
      "type": "object",
      "required": ["id", "type", "identifier", "name", "state", "floor", "ceiling", "schedule", "controlling_facility", "ground_reference", "bbox", "rings"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^faa-airspace:[a-f0-9]{16}$"},
        "type": {"enum": ["CLASS_B", "CLASS_C", "CLASS_D", "CLASS_E2", "CLASS_E3", "CLASS_E4", "CLASS_E5", "CLASS_E6", "CLASS_E7", "MOA", "RESTRICTED", "PROHIBITED", "WARNING", "ALERT", "NSA"]},
        "identifier": {"type": "string"},
        "name": {"type": "string"},
        "state": {"type": ["string", "null"]},
        "floor": {"$ref": "#/$defs/bound"},
        "ceiling": {"$ref": "#/$defs/bound"},
        "schedule": {"type": ["string", "null"]},
        "controlling_facility": {"type": ["string", "null"]},
        "ground_reference": {"oneOf": [{"type": "null"}, {"type": "object", "required": ["ft", "method", "airport", "distance_km"], "additionalProperties": false, "properties": {
          "ft": {"type": "integer"}, "method": {"enum": ["ASSOCIATED_AIRPORT", "NEAREST_AIRPORT"]}, "airport": {"type": "string"}, "distance_km": {"type": "number", "minimum": 0}}}]},
        "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4},
        "rings": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 4, "items": {"$ref": "#/$defs/position"}}}
      }
    }},
    "airports": {"type": "array", "maxItems": 5000, "items": {
      "type": "object",
      "required": ["faa_id", "icao_id", "name", "lon", "lat", "elevation_ft", "facility_type", "weather_station", "runways"],
      "properties": {
        "faa_id": {"type": "string", "minLength": 2, "maxLength": 8},
        "icao_id": {"type": ["string", "null"], "pattern": "^[A-Z]{4}$"},
        "lon": {"type": "number", "minimum": -180, "maximum": 180},
        "lat": {"type": "number", "minimum": -90, "maximum": 90},
        "elevation_ft": {"type": "number"},
        "weather_station": {"type": ["string", "null"]},
        "runways": {"type": "array"}
      }
    }},
    "airways": {"type": "array", "items": {
      "type": "object",
      "required": ["designation", "type", "from", "to", "coords", "mea_ft", "maa_ft"],
      "additionalProperties": false,
      "properties": {
        "designation": {"type": "string"},
        "type": {"enum": ["VICTOR", "JET", "RNAV_T", "RNAV_Q"]},
        "from": {"type": ["string", "null"]},
        "to": {"type": ["string", "null"]},
        "coords": {"type": "array", "items": {"$ref": "#/$defs/position"}, "minItems": 2, "maxItems": 2},
        "mea_ft": {"type": ["number", "null"]},
        "maa_ft": {"type": ["number", "null"]}
      }
    }},
    "withheld": {"type": "object", "required": ["private_use_airports"], "properties": {"private_use_airports": {"type": "integer", "minimum": 0}}},
    "rejects": {"type": "array"},
    "product_id": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
