{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/domains/agriculture/ndvi_readiness.schema.json",
  "title": "NdviReadinessAssessment",
  "description": "Fixture-only smoke-aware NDVI readiness sidecar; not a release decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "assessment_id",
    "assessed_at",
    "product",
    "region",
    "thresholds",
    "tile_summary",
    "critical_aoi_summary",
    "county_readiness",
    "inputs",
    "qc_reason_counts",
    "emit_decision",
    "governance"
  ],
  "properties": {
    "object_type": {
      "const": "NdviReadinessAssessment"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "assessment_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 160
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "product": {
      "const": "ndvi_delta"
    },
    "region": {
      "type": "string",
      "pattern": "^[A-Z]{2}-[A-Z0-9]{2,3}$"
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_mask_health_emit",
        "min_area_fraction_emit",
        "no_heavy_smoke_in_aois"
      ],
      "properties": {
        "min_mask_health_emit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_area_fraction_emit": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "no_heavy_smoke_in_aois": {
          "type": "boolean"
        }
      }
    },
    "tile_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "readiness_score",
        "fraction_ready",
        "primary_blocker"
      ],
      "properties": {
        "level": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "readiness_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "fraction_ready": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "primary_blocker": {
          "type": [
            "string",
            "null"
          ],
          "enum": [
            null,
            "LOW_MASK_HEALTH",
            "LOW_READY_AREA",
            "HEAVY_SMOKE_AOI",
            "INPUT_RECEIPT_UNRESOLVED"
          ]
        }
      }
    },
    "critical_aoi_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heavy_smoke_overlap_count"
      ],
      "properties": {
        "heavy_smoke_overlap_count": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "county_readiness": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fips",
          "fraction_ready",
          "primary_blocker"
        ],
        "properties": {
          "fips": {
            "type": "string",
            "pattern": "^[0-9]{5}$"
          },
          "fraction_ready": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "primary_blocker": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              null,
              "CLOUD",
              "CIRRUS",
              "SHADOW",
              "LOW_SOLAR",
              "ABI_QC_FAIL",
              "AOD_MISSING",
              "AOD_UNDER_CLOUD",
              "LIGHT_SMOKE",
              "MODERATE_SMOKE",
              "HEAVY_SMOKE",
              "HRRR_SMOKE_FORECAST"
            ]
          }
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source",
          "source_role",
          "spec_hash",
          "evidence_ref",
          "receipt_state"
        ],
        "properties": {
          "source": {
            "type": "string",
            "minLength": 1
          },
          "source_role": {
            "enum": [
              "observation",
              "analyst_smoke_mask",
              "corroboration",
              "forecast"
            ]
          },
          "spec_hash": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 1
          },
          "receipt_state": {
            "enum": [
              "RESOLVED",
              "UNRESOLVED",
              "DENIED"
            ]
          }
        }
      }
    },
    "qc_reason_counts": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "CLOUD",
          "CIRRUS",
          "SHADOW",
          "LOW_SOLAR",
          "ABI_QC_FAIL",
          "AOD_MISSING",
          "AOD_UNDER_CLOUD",
          "LIGHT_SMOKE",
          "MODERATE_SMOKE",
          "HEAVY_SMOKE",
          "HRRR_SMOKE_FORECAST"
        ]
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "emit_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reasons"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "EMIT_CANDIDATE",
            "HOLD"
          ]
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "LOW_MASK_HEALTH",
              "LOW_READY_AREA",
              "HEAVY_SMOKE_AOI",
              "INPUT_RECEIPT_UNRESOLVED"
            ]
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_eligible",
        "public_use_allowed",
        "release_state",
        "review_state"
      ],
      "properties": {
        "promotion_eligible": {
          "const": false
        },
        "public_use_allowed": {
          "const": false
        },
        "release_state": {
          "const": "not_released"
        },
        "review_state": {
          "const": "fixture_only"
        }
      }
    }
  }
}
