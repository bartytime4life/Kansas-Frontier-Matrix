{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/domains/agriculture/vegetation_connectivity_gate.schema.json",
  "title": "VegetationConnectivityGateAssessment",
  "description": "Fixture-only gate over precomputed vegetation component summaries; not a raster computation or release decision.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "assessment_id",
    "assessed_at",
    "spatial_unit",
    "analysis_profile",
    "observation_ids",
    "thresholds",
    "inputs",
    "components",
    "summary",
    "outcome",
    "governance",
    "spec_hash"
  ],
  "properties": {
    "object_type": {
      "const": "VegetationConnectivityGateAssessment"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{15,159}$"
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "spatial_unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "enum": [
            "COUNTY",
            "HUC12"
          ]
        },
        "id": {
          "type": "string"
        }
      },
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "COUNTY"
            },
            "id": {
              "pattern": "^20[0-9]{3}$"
            }
          }
        },
        {
          "properties": {
            "kind": {
              "const": "HUC12"
            },
            "id": {
              "pattern": "^[0-9]{12}$"
            }
          }
        }
      ]
    },
    "analysis_profile": {
      "const": "SYNTHETIC_PRECOMPUTED_COMPONENT_SUMMARY_V1"
    },
    "observation_ids": {
      "type": "array",
      "minItems": 2,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9._:-]{5,127}$"
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_component_area_m2",
        "min_persistent_observations",
        "min_persistence_basis_points",
        "min_qualifying_component_count"
      ],
      "properties": {
        "min_component_area_m2": {
          "type": "integer",
          "minimum": 1
        },
        "min_persistent_observations": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        },
        "min_persistence_basis_points": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "min_qualifying_component_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        }
      }
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "artifact_ref",
          "artifact_sha256",
          "evidence_ref",
          "logical_role",
          "receipt_state"
        ],
        "properties": {
          "artifact_ref": {
            "type": "string",
            "minLength": 8,
            "maxLength": 512
          },
          "artifact_sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          },
          "evidence_ref": {
            "type": "string",
            "minLength": 8,
            "maxLength": 512
          },
          "logical_role": {
            "enum": [
              "NDVI_MATERIALITY_ASSESSMENT",
              "NDVI_READINESS_ASSESSMENT"
            ]
          },
          "receipt_state": {
            "enum": [
              "RESOLVED",
              "UNRESOLVED",
              "DENIED"
            ]
          }
        }
      }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "component_id",
          "area_m2",
          "present_observation_ids",
          "persistence_basis_points",
          "qualifies"
        ],
        "properties": {
          "component_id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._:-]{5,127}$"
          },
          "area_m2": {
            "type": "integer",
            "minimum": 1
          },
          "present_observation_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9._:-]{5,127}$"
            }
          },
          "persistence_basis_points": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "qualifies": {
            "type": "boolean"
          }
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "component_count",
        "qualifying_component_count",
        "qualifying_area_m2",
        "largest_qualifying_component_area_m2"
      ],
      "properties": {
        "component_count": {
          "type": "integer",
          "minimum": 1
        },
        "qualifying_component_count": {
          "type": "integer",
          "minimum": 0
        },
        "qualifying_area_m2": {
          "type": "integer",
          "minimum": 0
        },
        "largest_qualifying_component_area_m2": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reasons"
      ],
      "properties": {
        "status": {
          "enum": [
            "PROPOSED_INDICATOR_CANDIDATE",
            "HOLD"
          ]
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "AREA_THRESHOLD_NOT_MET",
              "INPUT_RECEIPT_UNRESOLVED",
              "PERSISTENCE_THRESHOLD_NOT_MET",
              "QUALIFYING_COMPONENT_COUNT_NOT_MET"
            ]
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_only",
        "network_allowed",
        "raster_processing_allowed",
        "source_activation_allowed",
        "raw_admission_allowed",
        "promotion_allowed",
        "release_allowed",
        "publication_allowed",
        "public_use_allowed"
      ],
      "properties": {
        "fixture_only": {
          "const": true
        },
        "network_allowed": {
          "const": false
        },
        "raster_processing_allowed": {
          "const": false
        },
        "source_activation_allowed": {
          "const": false
        },
        "raw_admission_allowed": {
          "const": false
        },
        "promotion_allowed": {
          "const": false
        },
        "release_allowed": {
          "const": false
        },
        "publication_allowed": {
          "const": false
        },
        "public_use_allowed": {
          "const": false
        }
      }
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
