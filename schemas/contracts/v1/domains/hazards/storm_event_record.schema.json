{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/schemas/contracts/v1/domains/hazards/storm_event_record.schema.json",
  "title": "Storm Event Record",
  "description": "Closed v1 projection of one NOAA NCEI Storm Events details row that NCEI attributed to Kansas (STATE_FIPS 20), for the Kansas Storm Events pilot. A record is a forecaster-compiled historical event report, not a measurement, warning, inundation extent or damage settlement. Damage, magnitude and F/EF scale keep their source strings verbatim; damage_*_usd is the exact nominal event-year dollar value of the source string, or null when NCEI left it blank (not zero). Local times are the zone's wall clock as issued; *_utc is null when the zone carries no UTC offset. Narratives are never copied; has_narrative only records that one exists. Source authority and release eligibility require separate evidence, policy and review checks. See contracts/domains/hazards/storm_event_record.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile", "id", "event_id", "episode_id", "event_type", "cz_type", "cz_fips", "cz_name", "cz_timezone",
    "begin_local", "end_local", "begin_utc", "end_utc", "injuries_direct", "injuries_indirect", "deaths_direct",
    "deaths_indirect", "damage_property_usd", "damage_crops_usd", "damage_property_source", "damage_crops_source",
    "magnitude_source", "magnitude_type", "tor_f_scale", "begin_lat", "begin_lon", "end_lat", "end_lon",
    "has_narrative", "flags", "source_row_digest", "page_digest", "retrieved_at", "evidence_ref", "record_digest"
  ],
  "properties": {
    "profile": {"const": "kfm.storm-event-record/v1"},
    "id": {"type": "string", "pattern": "^kfm:storm:[a-f0-9]{64}$"},
    "event_id": {"type": "integer", "minimum": 1},
    "episode_id": {"type": ["integer", "null"], "minimum": 0},
    "event_type": {"type": "string", "minLength": 1, "maxLength": 64},
    "cz_type": {"enum": ["C", "Z", "M"]},
    "cz_fips": {"type": "integer", "minimum": 0, "maximum": 999},
    "cz_name": {"type": "string", "maxLength": 128},
    "cz_timezone": {"type": "string", "maxLength": 16},
    "begin_local": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$"},
    "end_local": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}$"},
    "begin_utc": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}Z$"},
    "end_utc": {"type": ["string", "null"], "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}Z$"},
    "injuries_direct": {"type": "integer", "minimum": 0, "maximum": 999999},
    "injuries_indirect": {"type": "integer", "minimum": 0, "maximum": 999999},
    "deaths_direct": {"type": "integer", "minimum": 0, "maximum": 999999},
    "deaths_indirect": {"type": "integer", "minimum": 0, "maximum": 999999},
    "damage_property_usd": {"type": ["integer", "null"], "minimum": 0},
    "damage_crops_usd": {"type": ["integer", "null"], "minimum": 0},
    "damage_property_source": {"type": "string", "maxLength": 16},
    "damage_crops_source": {"type": "string", "maxLength": 16},
    "magnitude_source": {"type": "string", "maxLength": 16},
    "magnitude_type": {"type": "string", "maxLength": 8},
    "tor_f_scale": {"type": "string", "maxLength": 8},
    "begin_lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "begin_lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "end_lat": {"type": ["number", "null"], "minimum": -90, "maximum": 90},
    "end_lon": {"type": ["number", "null"], "minimum": -180, "maximum": 180},
    "has_narrative": {"type": "boolean"},
    "flags": {
      "type": "array", "uniqueItems": true, "maxItems": 4,
      "items": {"enum": ["EPISODE_ID_ABSENT", "EVENT_TYPE_OUTSIDE_DIRECTIVE", "UTC_OFFSET_UNKNOWN", "ZONE_OR_COUNTY_SUPPORT_ONLY"]}
    },
    "source_row_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "page_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "evidence_ref": {"type": "string", "pattern": "^kfm:evidence:storm:[a-f0-9]{64}$"},
    "record_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
