{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/atmosphere/pm25_sensor_colocation_manifest.schema.json",
  "title": "PM25SensorColocationManifestCandidate",
  "description": "Fixture-only co-location planning evidence. It does not evaluate a live sensor or create scientific, source, policy, review, promotion, release, publication, public-health, or reference-equivalence authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "spec_hash", "status", "sensor_ids", "reference_site", "window", "data_completeness", "seasonal_coverage", "validation_split", "generalization_assumptions", "evidence_refs", "controls", "non_effects"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "manifest_id": {"type": "string", "pattern": "^kfm:pm25-colocation-manifest:[a-f0-9]{24}$"},
    "spec_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "status": {"const": "PROPOSED_INACTIVE"},
    "sensor_ids": {"$ref": "#/$defs/sensor_ids"},
    "reference_site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["site_ref", "source_descriptor_ref", "evidence_refs"],
      "properties": {
        "site_ref": {"type": "string", "pattern": "^fixture://reference-site/[a-z0-9][a-z0-9._-]{0,127}$"},
        "source_descriptor_ref": {"type": "string", "pattern": "^source://synthetic/[^\\s]{1,256}$"},
        "evidence_refs": {"$ref": "#/$defs/ref_array_nonempty"}
      }
    },
    "window": {"$ref": "#/$defs/time_window"},
    "data_completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected_interval_minutes", "coverage_status", "sensors"],
      "properties": {
        "expected_interval_minutes": {"type": "integer", "minimum": 1, "maximum": 1440},
        "coverage_status": {"enum": ["COMPLETE_DECLARED_INTERVAL", "PARTIAL_DECLARED_INTERVAL"]},
        "sensors": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["sensor_id", "expected_count", "observed_count", "completeness_fraction", "evidence_refs"],
            "properties": {
              "sensor_id": {"$ref": "#/$defs/sensor_id"},
              "expected_count": {"type": "integer", "minimum": 1, "maximum": 10000000},
              "observed_count": {"type": "integer", "minimum": 0, "maximum": 10000000},
              "completeness_fraction": {"type": "number", "minimum": 0, "maximum": 1},
              "evidence_refs": {"$ref": "#/$defs/ref_array_nonempty"}
            }
          }
        }
      }
    },
    "seasonal_coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seasons", "coverage_status", "evidence_refs"],
      "properties": {
        "seasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["METEOROLOGICAL_FALL", "METEOROLOGICAL_SPRING", "METEOROLOGICAL_SUMMER", "METEOROLOGICAL_WINTER"]}
        },
        "coverage_status": {"enum": ["COMPLETE_DECLARED_INTERVAL", "PARTIAL_DECLARED_INTERVAL"]},
        "evidence_refs": {"$ref": "#/$defs/ref_array_nonempty"}
      }
    },
    "validation_split": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "partitions"],
      "properties": {
        "method": {"enum": ["TIME_BLOCKED", "SITE_HOLDOUT"]},
        "partitions": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "started_at", "ended_at", "sensor_ids", "evidence_refs"],
            "properties": {
              "name": {"enum": ["CALIBRATION", "TEST", "VALIDATION"]},
              "started_at": {"$ref": "#/$defs/aware_datetime"},
              "ended_at": {"$ref": "#/$defs/aware_datetime"},
              "sensor_ids": {"$ref": "#/$defs/sensor_ids"},
              "evidence_refs": {"$ref": "#/$defs/ref_array_nonempty"}
            }
          }
        }
      }
    },
    "generalization_assumptions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 3, "maxLength": 256, "pattern": "\\S"}
    },
    "evidence_refs": {"$ref": "#/$defs/ref_array_nonempty"},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_only", "live_sensor_evaluated", "scientific_validity_claimed", "source_admitted", "policy_evaluated", "review_approved", "promotion_eligible", "release_authorized", "publication_authorized", "public_health_authority", "reference_grade_equivalence_claimed"],
      "properties": {
        "fixture_only": {"const": true},
        "live_sensor_evaluated": {"const": false},
        "scientific_validity_claimed": {"const": false},
        "source_admitted": {"const": false},
        "policy_evaluated": {"const": false},
        "review_approved": {"const": false},
        "promotion_eligible": {"const": false},
        "release_authorized": {"const": false},
        "publication_authorized": {"const": false},
        "public_health_authority": {"const": false},
        "reference_grade_equivalence_claimed": {"const": false}
      }
    },
    "non_effects": {
      "const": ["NO_LIVE_SENSOR_EVALUATION", "NO_POLICY_DECISION", "NO_PROMOTION", "NO_PUBLICATION", "NO_PUBLIC_HEALTH_GUIDANCE", "NO_REFERENCE_GRADE_EQUIVALENCE", "NO_RELEASE", "NO_SCIENTIFIC_VALIDITY_CLAIM", "NO_SOURCE_ADMISSION"]
    }
  },
  "$defs": {
    "aware_datetime": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "sensor_id": {"type": "string", "pattern": "^fixture://sensor/[a-z0-9][a-z0-9._-]{0,127}$"},
    "sensor_ids": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/sensor_id"}},
    "ref_array_nonempty": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9+.-]*://[^\\s]{1,1000}$"}},
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "ended_at"],
      "properties": {"started_at": {"$ref": "#/$defs/aware_datetime"}, "ended_at": {"$ref": "#/$defs/aware_datetime"}}
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "source_card": "KFM-P30-PROG-0003",
    "contract_doc": "contracts/domains/atmosphere/pm25_sensor_colocation_manifest.md",
    "fixture_root": "fixtures/contracts/v1/domains/atmosphere/pm25_sensor_colocation_manifest/",
    "authority": "bounded synthetic co-location planning evidence only"
  }
}
