{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/fauna/tile_field_allowlist.schema.json",
  "title": "FaunaTileFieldAllowlistProfile",
  "description": "Inactive fixture-only policy profile for comparing public Fauna vector-tile property names with a LayerManifest allowlist; no tile, policy-decision, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "profile_status",
    "source_card",
    "applies_to",
    "required_public_fields",
    "allowed_public_fields",
    "forbidden_exact_fields",
    "forbidden_field_patterns",
    "candidate_requirements",
    "authority_claims",
    "outcomes",
    "non_effects"
  ],
  "properties": {
    "object_type": {"const": "FaunaTileFieldAllowlistProfile"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.fauna.tile-field-allowlist.fixture.v1"},
    "profile_status": {"const": "PROPOSED_INACTIVE_FIXTURE_ONLY"},
    "source_card": {"const": "KFM-P18-INV-400"},
    "applies_to": {
      "type": "object",
      "additionalProperties": false,
      "required": ["domain", "exposure", "property_scope", "vector_formats"],
      "properties": {
        "domain": {"const": "fauna"},
        "exposure": {"const": "PUBLIC_CANDIDATE"},
        "property_scope": {"const": "ENCODED_PROPERTIES_ONLY"},
        "vector_formats": {
          "const": ["MLT", "MVT", "PMTILES"]
        }
      }
    },
    "required_public_fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/field_name"}
    },
    "allowed_public_fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/field_name"}
    },
    "forbidden_exact_fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/field_name"}
    },
    "forbidden_field_patterns": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 180
      }
    },
    "candidate_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "encoded_fields_must_be_manifest_allowlisted",
        "manifest_fields_must_be_policy_allowlisted",
        "required_fields_must_be_encoded",
        "style_only_protection_forbidden"
      ],
      "properties": {
        "encoded_fields_must_be_manifest_allowlisted": {"const": true},
        "manifest_fields_must_be_policy_allowlisted": {"const": true},
        "required_fields_must_be_encoded": {"const": true},
        "style_only_protection_forbidden": {"const": true}
      }
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_authority",
        "policy_decision_authority",
        "review_authority",
        "promotion_authority",
        "release_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "evidence_authority": {"const": false},
        "policy_decision_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    },
    "outcomes": {"const": ["PASS", "DENY", "ERROR"]},
    "non_effects": {
      "const": [
        "does_not_approve_a_production_field_set",
        "does_not_inspect_or_build_tile_bytes",
        "does_not_verify_geometry_size_or_accessibility",
        "does_not_resolve_evidence_policy_review_or_release",
        "does_not_promote_deploy_publish_or_authorize_public_use"
      ]
    }
  },
  "$defs": {
    "field_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z][a-z0-9_]*$"
    }
  }
}
