{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/water_planning/advisory_committee_meeting.schema.json",
  "title": "advisory_committee_meeting",
  "type": "object",
  "description": "A Kansas Regional Advisory Committee (RAC) meeting event. An advisory meeting is not a planning decision, approval, or award. It is linked to a governed PlanningRegion identity.",
  "x-kfm": {
    "status": "PROPOSED",
    "contract_doc": "contracts/domains/water_planning/advisory_committee_meeting.md",
    "fixtures_root": "fixtures/domains/water_planning/advisory_committee_meeting/",
    "policy": "policy/domains/water_planning/"
  },
  "properties": {
    "meeting_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:.-]*$"
    },
    "meeting_type": {
      "type": "string",
      "const": "advisory_committee_meeting",
      "description": "Discriminant that distinguishes this record from PublicMeeting."
    },
    "planning_region_ref": {
      "type": "string",
      "pattern": "^kwo-rac-[0-9]{2}$",
      "description": "Reference to the governed PlanningRegion identity (kwo-rac-01 … kwo-rac-14)."
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "starts_at": {
      "type": "string",
      "format": "date-time"
    },
    "ends_at": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "location_description": {
      "type": ["string", "null"]
    },
    "virtual_access_posture": {
      "type": "string",
      "enum": ["in_person", "virtual", "hybrid", "unknown"]
    },
    "cancellation_state": {
      "type": "string",
      "enum": ["scheduled", "cancelled", "rescheduled"]
    },
    "source_publication_time": {
      "type": ["string", "null"],
      "format": "date-time"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "meeting_id",
    "meeting_type",
    "planning_region_ref",
    "title",
    "starts_at",
    "virtual_access_posture",
    "cancellation_state",
    "source_ref"
  ],
  "additionalProperties": false
}
