{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/water_planning/project.schema.json",
  "title": "project",
  "type": "object",
  "description": "A water infrastructure project associated with an Award. A project is not a completed project, a payment, or an operational benefit. Project-region membership and project-location geometry are separate authority-resolved facts; missing values remain explicit unresolved states.",
  "x-kfm": {
    "status": "PROPOSED",
    "contract_doc": "contracts/domains/water_planning/project.md",
    "fixtures_root": "fixtures/domains/water_planning/project/",
    "authority_fixtures_root": "fixtures/domains/water_planning/geometry_authority/",
    "authority_validator": "tools/validators/domains/water_planning/validate_geometry_authority.py",
    "policy": "policy/domains/water_planning/"
  },
  "properties": {
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:.-]*$"
    },
    "award_ref": {
      "type": "string",
      "minLength": 1
    },
    "recipient_ref": {
      "type": [
        "string",
        "null"
      ],
      "description": "Reference to the recipient organization identity, or null if not yet resolved."
    },
    "recipient_resolution_status": {
      "type": "string",
      "enum": [
        "resolved",
        "unresolved",
        "pending"
      ],
      "description": "Resolution status of the recipient identity. Missing recipient identity must be stored as unresolved, not guessed."
    },
    "location_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1,
      "description": "Reference to a governed project-location geometry authority record, or null while unresolved. Geometry is never embedded here."
    },
    "geometry_confidence": {
      "type": "string",
      "enum": [
        "unresolved",
        "approximate",
        "confirmed"
      ],
      "description": "Reference resolution state. Approximate and confirmed require a non-null authority-backed location_ref; missing or unverified geometry remains unresolved."
    },
    "planning_region_ref": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^kwo-rac-(0[1-9]|1[0-4])$",
      "description": "Reference to one of the exact governed RAC identities, or null while unresolved. A GMD identifier cannot satisfy this field."
    },
    "planning_region_resolution_status": {
      "type": "string",
      "enum": [
        "unresolved",
        "resolved"
      ],
      "description": "Explicit authority-resolution state for planning_region_ref."
    },
    "source_publication_time": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "project_id",
    "award_ref",
    "recipient_ref",
    "recipient_resolution_status",
    "location_ref",
    "geometry_confidence",
    "planning_region_ref",
    "planning_region_resolution_status",
    "source_ref"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "geometry_confidence": {
            "const": "unresolved"
          }
        },
        "required": [
          "geometry_confidence"
        ]
      },
      "then": {
        "properties": {
          "location_ref": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "location_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "planning_region_resolution_status": {
            "const": "unresolved"
          }
        },
        "required": [
          "planning_region_resolution_status"
        ]
      },
      "then": {
        "properties": {
          "planning_region_ref": {
            "type": "null"
          }
        }
      },
      "else": {
        "properties": {
          "planning_region_ref": {
            "type": "string",
            "pattern": "^kwo-rac-(0[1-9]|1[0-4])$"
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
