{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/settlements-infrastructure/place_name_authority_graph.schema.json",
  "title": "PlaceNameAuthorityGraphPacket",
  "description": "Fixture-first packet for time-bounded, source-role-bound place-name assertions, alias edges, feature bindings, and reversible authority decisions. Validation grants no feature, geometry, legal-status, ownership, source, policy, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "packet_id",
    "hash_profile",
    "spec_hash",
    "place_name_assertions",
    "alias_edges",
    "feature_bindings",
    "authority_decisions",
    "separation",
    "provenance",
    "governance"
  ],
  "properties": {
    "object_type": {
      "const": "PlaceNameAuthorityGraphPacket"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^place-name-graph:[a-z0-9][a-z0-9_.:-]{7,240}$"
    },
    "hash_profile": {
      "const": "kfm-fixture-json-v1"
    },
    "spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "place_name_assertions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/place_name_assertion"
      }
    },
    "alias_edges": {
      "type": "array",
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/alias_edge"
      }
    },
    "feature_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "$ref": "#/$defs/feature_binding"
      }
    },
    "authority_decisions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/authority_decision"
      }
    },
    "separation": {
      "$ref": "#/$defs/separation"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 640,
      "pattern": "\\S"
    },
    "nullable_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "nonempty_ref_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true
    },
    "ref_array": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,96}$"
      },
      "uniqueItems": true
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "aware_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullable_datetime": {
      "oneOf": [
        {
          "$ref": "#/$defs/aware_datetime"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_text": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        {
          "type": "null"
        }
      ]
    },
    "place_name_assertion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assertion_id",
        "source_descriptor_ref",
        "source_role",
        "source_native_id",
        "name_text",
        "normalized_name_key",
        "name_type",
        "language_tag",
        "community_context_ref",
        "jurisdiction_ref",
        "feature_ref",
        "valid_from",
        "valid_to",
        "issued_at",
        "sensitivity",
        "evidence_refs",
        "native_assertion_preserved"
      ],
      "properties": {
        "assertion_id": {
          "type": "string",
          "pattern": "^place-name-assertion:[a-z0-9][a-z0-9_.:-]{4,240}$"
        },
        "source_descriptor_ref": {
          "$ref": "#/$defs/ref"
        },
        "source_role": {
          "enum": [
            "NAMING_AUTHORITY",
            "HISTORICAL_RECORD",
            "COMMUNITY_USAGE",
            "TRANSLATION_AUTHORITY",
            "CONTEXT"
          ]
        },
        "source_native_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "name_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "\\S"
        },
        "normalized_name_key": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.:-]{1,240}$"
        },
        "name_type": {
          "enum": [
            "OFFICIAL",
            "VARIANT",
            "HISTORICAL",
            "TRANSLATED",
            "COMMUNITY",
            "DISPUTED",
            "SENSITIVE_WITHHELD"
          ]
        },
        "language_tag": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z]{2,8}(?:-[A-Za-z0-9]{1,8})*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "community_context_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "jurisdiction_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "feature_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "valid_from": {
          "$ref": "#/$defs/nullable_datetime"
        },
        "valid_to": {
          "$ref": "#/$defs/nullable_datetime"
        },
        "issued_at": {
          "$ref": "#/$defs/aware_datetime"
        },
        "sensitivity": {
          "enum": [
            "PUBLIC",
            "GENERALIZED",
            "WITHHELD",
            "REVIEW_ONLY"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_ref_array"
        },
        "native_assertion_preserved": {
          "const": true
        }
      }
    },
    "alias_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "edge_id",
        "from_assertion_ref",
        "to_assertion_ref",
        "relation_type",
        "effective_at",
        "evidence_refs",
        "active",
        "reversible"
      ],
      "properties": {
        "edge_id": {
          "type": "string",
          "pattern": "^place-name-edge:[a-z0-9][a-z0-9_.:-]{4,240}$"
        },
        "from_assertion_ref": {
          "$ref": "#/$defs/ref"
        },
        "to_assertion_ref": {
          "$ref": "#/$defs/ref"
        },
        "relation_type": {
          "enum": [
            "VARIANT_OF",
            "FORMER_NAME_OF",
            "TRANSLATION_OF",
            "COMMUNITY_NAME_FOR",
            "DISPUTES",
            "SUPERSEDES",
            "SAME_FEATURE_NAME",
            "UNRESOLVED"
          ]
        },
        "effective_at": {
          "$ref": "#/$defs/aware_datetime"
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_ref_array"
        },
        "active": {
          "type": "boolean"
        },
        "reversible": {
          "const": true
        }
      }
    },
    "feature_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_id",
        "assertion_ref",
        "feature_ref",
        "binding_type",
        "valid_from",
        "valid_to",
        "confidence_class",
        "evidence_refs",
        "geometry_authority_claimed",
        "legal_status_claimed",
        "ownership_claimed"
      ],
      "properties": {
        "binding_id": {
          "type": "string",
          "pattern": "^feature-name-binding:[a-z0-9][a-z0-9_.:-]{4,240}$"
        },
        "assertion_ref": {
          "$ref": "#/$defs/ref"
        },
        "feature_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "binding_type": {
          "enum": [
            "PRIMARY_FOR_PERIOD",
            "ALIAS",
            "DISPUTED",
            "UNBOUND"
          ]
        },
        "valid_from": {
          "$ref": "#/$defs/nullable_datetime"
        },
        "valid_to": {
          "$ref": "#/$defs/nullable_datetime"
        },
        "confidence_class": {
          "enum": [
            "CONFIRMED",
            "PROVISIONAL",
            "DISPUTED",
            "UNRESOLVED"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_ref_array"
        },
        "geometry_authority_claimed": {
          "const": false
        },
        "legal_status_claimed": {
          "const": false
        },
        "ownership_claimed": {
          "const": false
        }
      }
    },
    "authority_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "assertion_refs",
        "binding_refs",
        "outcome",
        "authority_role",
        "profile_id",
        "profile_version",
        "reason_codes",
        "evidence_refs",
        "recorded_at",
        "supersedes_decision_ref",
        "automatic_resolution",
        "reversible"
      ],
      "properties": {
        "decision_id": {
          "type": "string",
          "pattern": "^place-name-decision:[a-z0-9][a-z0-9_.:-]{4,240}$"
        },
        "assertion_refs": {
          "$ref": "#/$defs/nonempty_ref_array"
        },
        "binding_refs": {
          "$ref": "#/$defs/ref_array"
        },
        "outcome": {
          "enum": [
            "ACCEPT_FOR_USE",
            "PROVISIONAL",
            "HOLD",
            "ABSTAIN",
            "REJECT"
          ]
        },
        "authority_role": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,96}$"
        },
        "profile_id": {
          "type": "string",
          "pattern": "^place-name-profile:[a-z0-9][a-z0-9_.:-]{4,240}$"
        },
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "reason_codes": {
          "$ref": "#/$defs/reason_codes"
        },
        "evidence_refs": {
          "$ref": "#/$defs/nonempty_ref_array"
        },
        "recorded_at": {
          "$ref": "#/$defs/aware_datetime"
        },
        "supersedes_decision_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "automatic_resolution": {
          "const": false
        },
        "reversible": {
          "const": true
        }
      }
    },
    "separation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name_is_not_feature_identity",
        "naming_authority_is_not_geometry_authority",
        "naming_authority_is_not_legal_status",
        "naming_authority_is_not_ownership",
        "disputed_names_preserved",
        "sensitive_names_can_be_withheld"
      ],
      "properties": {
        "name_is_not_feature_identity": {
          "const": true
        },
        "naming_authority_is_not_geometry_authority": {
          "const": true
        },
        "naming_authority_is_not_legal_status": {
          "const": true
        },
        "naming_authority_is_not_ownership": {
          "const": true
        },
        "disputed_names_preserved": {
          "const": true
        },
        "sensitive_names_can_be_withheld": {
          "const": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_at",
        "run_receipt_ref",
        "resolver_id",
        "resolver_version",
        "input_refs"
      ],
      "properties": {
        "recorded_at": {
          "$ref": "#/$defs/aware_datetime"
        },
        "run_receipt_ref": {
          "$ref": "#/$defs/ref"
        },
        "resolver_id": {
          "$ref": "#/$defs/ref"
        },
        "resolver_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "input_refs": {
          "$ref": "#/$defs/nonempty_ref_array"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_admitted",
        "policy_evaluated",
        "feature_identity_created",
        "geometry_authority_created",
        "legal_status_created",
        "ownership_authority_created",
        "promotion_authorized",
        "release_authorized",
        "publication_authorized",
        "public_search_authorized",
        "release_ref"
      ],
      "properties": {
        "source_admitted": {
          "const": false
        },
        "policy_evaluated": {
          "const": false
        },
        "feature_identity_created": {
          "const": false
        },
        "geometry_authority_created": {
          "const": false
        },
        "legal_status_created": {
          "const": false
        },
        "ownership_authority_created": {
          "const": false
        },
        "promotion_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        },
        "public_search_authorized": {
          "const": false
        },
        "release_ref": {
          "type": "null"
        }
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED",
    "contract_doc": "contracts/domains/settlements-infrastructure/place_name_authority_graph.md",
    "fixtures_root": "fixtures/contracts/v1/domains/settlements-infrastructure/place_name_authority_graph/",
    "validator": "tools/validators/validate_place_name_authority_graph.py",
    "tests": "tests/validators/test_validate_place_name_authority_graph.py",
    "authority": "place_name_assertion_alias_binding_and_reconciliation_only",
    "non_effects": [
      "does_not_create_feature_geometry_legal_status_or_ownership_authority",
      "does_not_admit_sources_or_resolve_evidence",
      "does_not_authorize_search_release_or_publication"
    ]
  }
}
