{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfm.local/schemas/contracts/v1/domains/settlements-infrastructure/place-identity.schema.json",
  "title": "PlaceIdentityProfile",
  "description": "PROPOSED fixture-first profile that keeps municipal legal identity, census statistical identity, and other settlement identity families explicit and non-interchangeable. Validation grants no legal status, census authority, source admission, evidence closure, policy approval, release, publication, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "id",
    "spec_hash",
    "domain",
    "identity_family",
    "display_name",
    "normalized_name_key",
    "source_ref",
    "source_role",
    "source_native_id",
    "evidence_refs",
    "valid_time",
    "legal_status_claimed",
    "census_status_claimed",
    "public_geometry_rule",
    "sensitivity_label",
    "policy_decision_ref",
    "release_manifest_ref",
    "rollback_ref",
    "separation",
    "limitations"
  ],
  "properties": {
    "object_type": {
      "const": "PlaceIdentityProfile"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "domain": {
      "const": "settlements-infrastructure"
    },
    "identity_family": {
      "enum": [
        "Settlement",
        "Municipality",
        "CensusPlace",
        "Townsite",
        "GhostTown",
        "Fort",
        "Mission",
        "ReservationCommunity"
      ]
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "normalized_name_key": {
      "type": "string",
      "minLength": 1
    },
    "source_ref": {
      "type": "string",
      "minLength": 1
    },
    "source_role": {
      "type": "string",
      "minLength": 1
    },
    "source_native_id": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "valid_time": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "legal_status_claimed": {
      "type": "boolean"
    },
    "census_status_claimed": {
      "type": "boolean"
    },
    "public_geometry_rule": {
      "enum": [
        "exact",
        "generalized",
        "county-level",
        "narrative-only",
        "hidden",
        "denied",
        "review-only"
      ]
    },
    "sensitivity_label": {
      "enum": [
        "public",
        "generalized",
        "withheld",
        "review-only"
      ]
    },
    "policy_decision_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "release_manifest_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "rollback_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "separation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identity_family_is_explicit",
        "municipality_and_census_place_not_collapsed",
        "source_role_preserved",
        "release_not_inferred"
      ],
      "properties": {
        "identity_family_is_explicit": {
          "const": true
        },
        "municipality_and_census_place_not_collapsed": {
          "const": true
        },
        "source_role_preserved": {
          "const": true
        },
        "release_not_inferred": {
          "const": true
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "identity_family": {
            "const": "Municipality"
          }
        },
        "required": [
          "identity_family"
        ]
      },
      "then": {
        "properties": {
          "legal_status_claimed": {
            "const": true
          },
          "census_status_claimed": {
            "const": false
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity_family": {
            "const": "CensusPlace"
          }
        },
        "required": [
          "identity_family"
        ]
      },
      "then": {
        "properties": {
          "legal_status_claimed": {
            "const": false
          },
          "census_status_claimed": {
            "const": true
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "identity_family": {
            "enum": [
              "Settlement",
              "Townsite",
              "GhostTown",
              "Fort",
              "Mission",
              "ReservationCommunity"
            ]
          }
        },
        "required": [
          "identity_family"
        ]
      },
      "then": {
        "properties": {
          "legal_status_claimed": {
            "const": false
          },
          "census_status_claimed": {
            "const": false
          }
        }
      }
    }
  ],
  "x-kfm": {
    "status": "PROPOSED",
    "truth_posture": "cite-or-abstain",
    "scope": "fixture-first-place-identity-separation-only",
    "sources": [
      "contracts/domains/settlements-infrastructure/place-identity.md",
      "docs/atlases/domains-v1.1-ch14.md"
    ],
    "non_effects": [
      "No legal-status determination.",
      "No census-status determination.",
      "No source admission or activation.",
      "No EvidenceBundle closure.",
      "No policy approval.",
      "No release, deployment, publication, or public-use authority."
    ]
  }
}
