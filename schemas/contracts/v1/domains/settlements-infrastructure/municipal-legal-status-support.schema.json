{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfm.local/schemas/contracts/v1/domains/settlements-infrastructure/municipal-legal-status-support.schema.json",
  "title": "MunicipalLegalStatusSupportEnvelope",
  "description": "PROPOSED synthetic no-live-source envelope. Validation grants no real legal status, source admission, evidence closure, policy/review approval, release, deployment, publication, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "id",
    "spec_hash",
    "domain",
    "synthetic",
    "input_state",
    "subject",
    "claim",
    "legal_status_evidence",
    "census_geography_context",
    "policy_gate",
    "review_gate",
    "release_gate",
    "outcome",
    "reason_codes",
    "non_authority",
    "limitations"
  ],
  "properties": {
    "object_type": {
      "const": "MunicipalLegalStatusSupportEnvelope"
    },
    "schema_version": {
      "const": "0.1.0"
    },
    "id": {
      "type": "string",
      "pattern": "^kfm:municipal-legal-status-support:synthetic:[a-z0-9_-]+$"
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "domain": {
      "const": "settlements-infrastructure"
    },
    "synthetic": {
      "const": true
    },
    "input_state": {
      "enum": [
        "VALID",
        "ERROR"
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "place_identity_ref",
        "identity_family",
        "display_label"
      ],
      "properties": {
        "place_identity_ref": {
          "type": "string",
          "pattern": "^kfm:place-identity:synthetic-[a-z0-9_-]+$"
        },
        "identity_family": {
          "enum": [
            "Municipality",
            "CensusPlace"
          ]
        },
        "display_label": {
          "type": "string",
          "pattern": "^Synthetic [A-Za-z0-9 _-]+$"
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_type",
        "as_of"
      ],
      "properties": {
        "claim_type": {
          "const": "municipal_legal_status"
        },
        "as_of": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "legal_status_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_role",
        "source_ref",
        "evidence_ref",
        "source_date",
        "effective_from",
        "effective_to"
      ],
      "properties": {
        "source_role": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^source:synthetic:[a-z0-9_-]+$"
        },
        "evidence_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^evidence:synthetic:[a-z0-9_-]+$"
        },
        "source_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "effective_from": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "effective_to": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        }
      }
    },
    "census_geography_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_role",
        "source_ref",
        "evidence_ref",
        "vintage"
      ],
      "properties": {
        "source_role": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "pattern": "^source:synthetic:[a-z0-9_-]+$"
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^evidence:synthetic:[a-z0-9_-]+$"
        },
        "vintage": {
          "type": "string",
          "pattern": "^synthetic-[0-9]{4}$"
        }
      }
    },
    "policy_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "decision_ref"
      ],
      "properties": {
        "state": {
          "const": "UNRESOLVED"
        },
        "decision_ref": {
          "type": "null"
        }
      }
    },
    "review_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "review_ref"
      ],
      "properties": {
        "state": {
          "const": "UNRESOLVED"
        },
        "review_ref": {
          "type": "null"
        }
      }
    },
    "release_gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "manifest_ref"
      ],
      "properties": {
        "state": {
          "const": "UNRELEASED"
        },
        "manifest_ref": {
          "type": "null"
        }
      }
    },
    "outcome": {
      "enum": [
        "ANSWER",
        "ABSTAIN",
        "DENY",
        "ERROR"
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "LEGAL_STATUS_SUPPORT_PRESENT",
          "LEGAL_STATUS_EVIDENCE_INSUFFICIENT",
          "LEGAL_STATUS_EVIDENCE_UNDATED",
          "LEGAL_STATUS_EVIDENCE_OUT_OF_SCOPE",
          "CENSUS_PLACE_NOT_MUNICIPALITY",
          "SYNTHETIC_INPUT_ERROR",
          "LEGAL_EVIDENCE_PARTIAL"
        ]
      }
    },
    "non_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_world_assertion",
        "source_activation",
        "evidence_bundle_resolution",
        "policy_approval",
        "review_approval",
        "release_or_publication",
        "live_route"
      ],
      "properties": {
        "real_world_assertion": {
          "const": false
        },
        "source_activation": {
          "const": false
        },
        "evidence_bundle_resolution": {
          "const": false
        },
        "policy_approval": {
          "const": false
        },
        "review_approval": {
          "const": false
        },
        "release_or_publication": {
          "const": false
        },
        "live_route": {
          "const": false
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED",
    "truth_posture": "cite-or-abstain",
    "scope": "synthetic-no-network-municipal-legal-status-support-only",
    "depends_on": [
      "contracts/domains/settlements-infrastructure/place-identity.md",
      "schemas/contracts/v1/domains/settlements-infrastructure/place-identity.schema.json"
    ],
    "non_effects": [
      "No real municipal legal-status determination.",
      "No live source activation.",
      "No geometry or protected-location handling.",
      "No EvidenceBundle resolution.",
      "No policy or review approval.",
      "No release, deployment, publication, or public-use authority."
    ]
  }
}
