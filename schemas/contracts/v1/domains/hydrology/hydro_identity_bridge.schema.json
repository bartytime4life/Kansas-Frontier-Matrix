{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/hydrology/hydro_identity_bridge.schema.json",
  "title": "hydro_identity_bridge",
  "description": "Deterministic, source-native bridge between current NHDPlus HR identifiers and legacy COMIDs.",
  "type": "object",
  "additionalProperties": false,
  "x-kfm": {
    "contract_doc": "contracts/domains/hydrology/hydro_identity_bridge.md",
    "fixtures_root": "fixtures/contracts/v1/domains/hydrology/hydro_identity_bridge/",
    "validator": "tools/validators/domains/hydrology/validate_hydro_identity_bridge.py",
    "policy": "policy/hydrology/",
    "status": "PROPOSED"
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S+$"
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset",
        "release_id",
        "spec_hash"
      ],
      "properties": {
        "dataset": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S+$"
        },
        "spec_hash": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "currentIdentifier": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id_type",
        "value",
        "source_native"
      ],
      "properties": {
        "id_type": {
          "type": "string",
          "enum": [
            "PERMANENT_IDENTIFIER",
            "NHDPLUSID"
          ]
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        },
        "source_native": {
          "const": true
        }
      }
    }
  },
  "required": [
    "bridge_id",
    "schema_version",
    "source_versions",
    "request",
    "resolution",
    "temporal_basis",
    "governance",
    "spec_hash"
  ],
  "properties": {
    "bridge_id": {
      "type": "string",
      "pattern": "^hydro-bridge:[a-f0-9]{24}$"
    },
    "schema_version": {
      "const": "v1"
    },
    "source_versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "current",
        "legacy",
        "crosswalk"
      ],
      "properties": {
        "current": {
          "allOf": [
            {
              "$ref": "#/$defs/release"
            },
            {
              "properties": {
                "dataset": {
                  "const": "NHDPLUS_HR"
                }
              }
            }
          ]
        },
        "legacy": {
          "allOf": [
            {
              "$ref": "#/$defs/release"
            },
            {
              "properties": {
                "dataset": {
                  "const": "NHDPLUS_LEGACY"
                }
              }
            }
          ]
        },
        "crosswalk": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataset",
            "release_id",
            "spec_hash",
            "artifact_ref"
          ],
          "properties": {
            "dataset": {
              "const": "NHDPLUS_WATERBODY_CROSSWALK"
            },
            "release_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^\\S+$"
            },
            "spec_hash": {
              "$ref": "#/$defs/hash"
            },
            "artifact_ref": {
              "$ref": "#/$defs/ref"
            }
          }
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "request_id",
        "identifier_kind",
        "identifier"
      ],
      "properties": {
        "request_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9:._-]{2,127}$"
        },
        "identifier_kind": {
          "type": "string",
          "enum": [
            "LEGACY_COMID",
            "CURRENT_PERMANENT_IDENTIFIER",
            "CURRENT_NHDPLUSID"
          ]
        },
        "identifier": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9._:-]+$"
        }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "relationship_type",
        "current_identifiers",
        "legacy_comids",
        "reason_codes",
        "evidence_refs",
        "join_receipt_ref"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "ANSWER",
            "ABSTAIN",
            "DENY",
            "ERROR"
          ]
        },
        "relationship_type": {
          "type": "string",
          "enum": [
            "EXACT",
            "SPLIT",
            "MERGE",
            "RETIRED",
            "NO_LEGACY",
            "UNRESOLVED"
          ]
        },
        "current_identifiers": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/currentIdentifier"
          }
        },
        "legacy_comids": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          }
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "join_receipt_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/ref"
            }
          ]
        }
      }
    },
    "temporal_basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluated_at",
        "crosswalk_release_date",
        "crosswalk_release_id"
      ],
      "properties": {
        "evaluated_at": {
          "type": "string",
          "format": "date-time"
        },
        "crosswalk_release_date": {
          "type": "string",
          "format": "date"
        },
        "crosswalk_release_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^\\S+$"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_native_ids_preserved",
        "legacy_relabel_denied",
        "geometry_equality_assumed",
        "authority_created",
        "source_data_mutated",
        "policy_evaluated",
        "promotion_authorized",
        "release_authorized",
        "publication_authorized"
      ],
      "properties": {
        "source_native_ids_preserved": {
          "const": true
        },
        "legacy_relabel_denied": {
          "const": true
        },
        "geometry_equality_assumed": {
          "const": false
        },
        "authority_created": {
          "const": false
        },
        "source_data_mutated": {
          "const": false
        },
        "policy_evaluated": {
          "const": false
        },
        "promotion_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        }
      }
    },
    "spec_hash": {
      "$ref": "#/$defs/hash"
    }
  }
}
