{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/hydrology/proof_slice_request.schema.json",
  "title": "Hydrology proof-slice base request",
  "description": "The complete synthetic request that each proof-slice case overrides.",
  "x-kfm": {
    "contract_doc": "contracts/domains/hydrology/proof_slice.md",
    "validator": "pipelines/domains/hydrology/proof_slice.py",
    "status": "PROPOSED"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidence_bundle",
    "feature_source_role",
    "geometry_precision",
    "policy_evaluator",
    "presented_as",
    "release_candidate",
    "requested_artifact",
    "rollback_target",
    "scenario_id",
    "surface"
  ],
  "properties": {
    "surface": {
      "enum": [
        "governed_api",
        "browser_direct_model"
      ]
    },
    "requested_artifact": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
    },
    "scenario_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "evidence_bundle": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        }
      ]
    },
    "geometry_precision": {
      "enum": [
        "generalized_huc12",
        "exact_point"
      ]
    },
    "feature_source_role": {
      "enum": [
        "synthetic_observation",
        "regulatory_context"
      ]
    },
    "presented_as": {
      "enum": [
        "observed_gauge_series",
        "regulatory_context_overlay",
        "observed_flood_event"
      ]
    },
    "policy_evaluator": {
      "enum": [
        "available",
        "unavailable"
      ]
    },
    "release_candidate": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_:.-]{0,127}$"
    },
    "rollback_target": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_:.-]{0,127}$"
        }
      ]
    }
  }
}
