{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/hydrology/proof_slice_profile.schema.json",
  "title": "Hydrology proof-slice execution profile",
  "description": "Closed, digest-pinned input set and expected finite outcomes for the synthetic no-network Hydrology proof slice. It admits no source and grants no release or publication authority.",
  "x-kfm": {
    "contract_doc": "contracts/domains/hydrology/proof_slice.md",
    "validator": "pipelines/domains/hydrology/proof_slice.py",
    "status": "PROPOSED"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "posture",
    "evaluated_at",
    "license_allowlist",
    "public_artifact_prefix",
    "packet",
    "base_request",
    "evidence_bundles",
    "cases",
    "authority_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "kfm.hydrology-proof-slice-profile/v1"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "posture": {
      "const": "SYNTHETIC_FIXTURE_ONLY"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "license_allowlist": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      }
    },
    "public_artifact_prefix": {
      "const": "data/published/"
    },
    "packet": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "base_request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "evidence_bundles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "expected_outcome",
          "expected_reason_code"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          },
          "expected_outcome": {
            "enum": [
              "ANSWER",
              "ABSTAIN",
              "DENY",
              "ERROR"
            ]
          },
          "expected_reason_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{0,63}$"
          }
        }
      }
    },
    "authority_boundary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
