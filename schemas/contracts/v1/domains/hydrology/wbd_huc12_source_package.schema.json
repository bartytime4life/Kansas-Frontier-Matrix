{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/domains/hydrology/wbd_huc12_source_package.schema.json",
  "title": "WbdHuc12SourcePackage",
  "description": "Fixture-first captured WBD HUC12 response package for deterministic ingest-candidate evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "package_id",
    "observed_at",
    "source_descriptor_ref",
    "huc12",
    "request",
    "response",
    "prior_snapshot",
    "governance",
    "spec_hash"
  ],
  "properties": {
    "object_type": {
      "const": "WbdHuc12SourcePackage"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "package_id": {
      "type": "string",
      "minLength": 8,
      "maxLength": 180
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_descriptor_ref": {
      "const": "data/registry/hydrology/sources/wbd_huc12.yaml"
    },
    "huc12": {
      "type": "string",
      "pattern": "^[0-9]{12}$"
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "url",
        "method",
        "where_clause",
        "out_fields",
        "http_status",
        "etag",
        "last_modified",
        "content_type"
      ],
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://hydro\\.nationalmap\\.gov/arcgis/rest/services/wbd/MapServer/6/query"
        },
        "method": {
          "const": "GET"
        },
        "where_clause": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "out_fields": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "http_status": {
          "enum": [
            200,
            304
          ]
        },
        "etag": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "last_modified": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "content_type": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "body_sha256",
        "feature_collection"
      ],
      "properties": {
        "body_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "feature_collection": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "type",
                "features"
              ],
              "properties": {
                "type": {
                  "const": "FeatureCollection"
                },
                "features": {
                  "type": "array",
                  "maxItems": 4,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "type",
                      "properties",
                      "geometry"
                    ],
                    "properties": {
                      "type": {
                        "const": "Feature"
                      },
                      "properties": {
                        "type": "object"
                      },
                      "geometry": {
                        "type": "object",
                        "additionalProperties": false,
                        "required": [
                          "type",
                          "coordinates"
                        ],
                        "properties": {
                          "type": {
                            "enum": [
                              "Polygon",
                              "MultiPolygon"
                            ]
                          },
                          "coordinates": {
                            "type": "array",
                            "minItems": 1
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          ]
        }
      }
    },
    "prior_snapshot": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "feature",
            "fingerprint"
          ],
          "properties": {
            "feature": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "huc12",
                "areasqkm",
                "geometry",
                "source_metadata"
              ],
              "properties": {
                "huc12": {
                  "type": "string",
                  "pattern": "^[0-9]{12}$"
                },
                "areasqkm": {
                  "type": "number",
                  "minimum": 0
                },
                "geometry": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "coordinates"
                  ],
                  "properties": {
                    "type": {
                      "enum": [
                        "Polygon",
                        "MultiPolygon"
                      ]
                    },
                    "coordinates": {
                      "type": "array",
                      "minItems": 1
                    }
                  }
                },
                "source_metadata": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "load_date",
                    "last_edit_date"
                  ],
                  "properties": {
                    "load_date": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "last_edit_date": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "etag": {
                      "type": [
                        "string",
                        "null"
                      ]
                    }
                  }
                }
              }
            },
            "fingerprint": {
              "type": "string",
              "pattern": "^sha256:[a-f0-9]{64}$"
            }
          }
        }
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_only",
        "network_fetch",
        "source_activation",
        "lifecycle_write",
        "promotion_allowed",
        "publication_allowed"
      ],
      "properties": {
        "fixture_only": {
          "const": true
        },
        "network_fetch": {
          "const": false
        },
        "source_activation": {
          "const": false
        },
        "lifecycle_write": {
          "const": false
        },
        "promotion_allowed": {
          "const": false
        },
        "publication_allowed": {
          "const": false
        }
      }
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "request": {
            "properties": {
              "http_status": {
                "const": 304
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "response": {
            "properties": {
              "body_sha256": {
                "type": "null"
              },
              "feature_collection": {
                "type": "null"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "request": {
            "properties": {
              "http_status": {
                "const": 200
              }
            }
          }
        }
      },
      "then": {
        "properties": {
          "response": {
            "properties": {
              "body_sha256": {
                "type": "string"
              },
              "feature_collection": {
                "type": "object"
              }
            }
          }
        }
      }
    }
  ]
}
