{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/schemas/contracts/v1/domains/hydrology/living_waters_fixture_packet.schema.json",
  "title": "Living Waters fixture packet",
  "description": "Closed synthetic-only packet for the first Living Waters review proof. Validation grants no source, policy, release, deployment, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["packet_id", "profile", "snapshot", "gauge", "series", "scenarios", "governance"],
  "properties": {
    "packet_id": {"type": "string", "pattern": "^fixture:hydrology:living-waters:[a-z0-9-]+$"},
    "profile": {"const": "living-waters-fixture-v1"},
    "snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["identity", "version", "content_digest", "huc12", "reach_ids", "role"],
      "properties": {
        "identity": {"type": "string", "pattern": "^fixture://hydrology/snapshot/"},
        "version": {"type": "string", "minLength": 1},
        "content_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "huc12": {"type": "string", "pattern": "^[0-9]{12}$"},
        "reach_ids": {"type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^fixture-reach-[0-9]{2}$"}},
        "role": {"const": "synthetic_reference"}
      }
    },
    "gauge": {
      "type": "object", "additionalProperties": false,
      "required": ["site_id", "state", "spatial_support", "role"],
      "properties": {
        "site_id": {"type": "string", "pattern": "^fixture-ks-[0-9]{8}$"},
        "state": {"const": "KS"},
        "spatial_support": {"const": "generalized_county"},
        "role": {"const": "synthetic_site_metadata"}
      }
    },
    "series": {
      "type": "object", "additionalProperties": false,
      "required": ["parameter_code", "parameter_name", "statistic_code", "statistic_name", "unit_code", "qualifier_code", "qualifier_name", "points"],
      "properties": {
        "parameter_code": {"const": "00060"},
        "parameter_name": {"const": "discharge"},
        "statistic_code": {"const": "00000"},
        "statistic_name": {"const": "instantaneous"},
        "unit_code": {"const": "ft3/s"},
        "qualifier_code": {"const": "P"},
        "qualifier_name": {"const": "provisional"},
        "points": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["observed_at", "value"],
            "properties": {
              "observed_at": {"type": "string", "format": "date-time", "pattern": "Z$"},
              "value": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "scenarios": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "state", "join_outcome", "reason_codes", "display_message"],
        "properties": {
          "id": {"enum": ["current", "stale", "no-results", "unavailable", "ambiguous-reach"]},
          "state": {"enum": ["AVAILABLE", "STALE", "NO_RESULTS", "UNAVAILABLE", "ABSTAIN"]},
          "join_outcome": {"enum": ["EXACT", "NOT_ATTEMPTED", "AMBIGUOUS"]},
          "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
          "display_message": {"type": "string", "minLength": 1}
        }
      }
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["source_admitted", "source_activated", "policy_evaluated", "released", "deployed", "published", "fixture_only"],
      "properties": {
        "source_admitted": {"const": false}, "source_activated": {"const": false},
        "policy_evaluated": {"const": false}, "released": {"const": false},
        "deployed": {"const": false}, "published": {"const": false},
        "fixture_only": {"const": true}
      }
    }
  }
}
