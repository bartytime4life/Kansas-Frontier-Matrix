{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfm://schemas/contracts/v1/domains/hydrology/huc12_comid_crosswalk_manifest.schema.json",
  "title": "HUC12-COMID Crosswalk Manifest",
  "description": "Closed, fixture-first candidate manifest for one time-bounded HUC12 to COMID crosswalk artifact. Validation does not approve source admission, promotion, release, or publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "manifest_id",
    "layer_type",
    "huc12",
    "wbd_snapshot_id",
    "nhd_snapshot_id",
    "valid_from",
    "valid_to",
    "crosswalk_ref",
    "crosswalk_digest",
    "crosswalk_media_type",
    "row_count",
    "comid_count",
    "run_receipt_ref",
    "evidence_bundle_ref",
    "source_refs",
    "spec_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "kfm.hydrology.huc12-comid-crosswalk-manifest.v1"
    },
    "object_type": {
      "const": "HUC12COMIDCrosswalkManifest"
    },
    "manifest_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^kfm://manifest/hydrology/huc12-comid/[0-9]{12}/[A-Za-z0-9][A-Za-z0-9._:-]{0,127}/[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "layer_type": {
      "const": "huc12"
    },
    "huc12": {
      "type": "string",
      "pattern": "^[0-9]{12}$"
    },
    "wbd_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "nhd_snapshot_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "valid_from": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "valid_to": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "crosswalk_ref": {
      "$ref": "#/$defs/digestBoundRef"
    },
    "crosswalk_digest": {
      "$ref": "#/$defs/sha256"
    },
    "crosswalk_media_type": {
      "enum": [
        "text/csv",
        "application/vnd.apache.parquet"
      ]
    },
    "row_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "comid_count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000000000
    },
    "run_receipt_ref": {
      "$ref": "#/$defs/digestBoundRef"
    },
    "evidence_bundle_ref": {
      "$ref": "#/$defs/digestBoundRef"
    },
    "source_refs": {
      "type": "array",
      "minItems": 2,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/versionBoundRef"
      }
    },
    "spec_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "digestBoundRef": {
      "type": "string",
      "minLength": 80,
      "maxLength": 1024,
      "pattern": "^(?:kfm://|urn:)[^\\s@]+@sha256:[a-f0-9]{64}$"
    },
    "versionBoundRef": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1024,
      "pattern": "^(?:kfm://|urn:)[^\\s@]+@(?:sha256:[a-f0-9]{64}|[A-Za-z0-9][A-Za-z0-9._:-]{0,127})$"
    }
  },
  "x-kfm": {
    "status": "PROPOSED",
    "authority_boundary": "Fixture-only shape and semantic validation; no source activation, evidence resolution, policy approval, promotion, release, or publication effect.",
    "contract_doc": "contracts/domains/hydrology/huc12_comid_crosswalk_manifest.md"
  }
}
