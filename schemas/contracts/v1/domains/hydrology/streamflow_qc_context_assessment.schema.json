{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfm.local/schemas/contracts/v1/domains/hydrology/streamflow_qc_context_assessment.schema.json",
  "title": "Streamflow QC Context Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "assessment_id", "spec_hash", "subject", "regional_context", "integrity_context", "assessment", "governance"],
  "properties": {
    "profile": {"const": "STREAMFLOW_QC_CONTEXT_V1"},
    "assessment_id": {"type": "string", "pattern": "^kfm:streamflow-qc-context:[a-f0-9]{24}$"},
    "spec_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "subject": {"$ref": "#/$defs/subject"},
    "regional_context": {"$ref": "#/$defs/regional_context"},
    "integrity_context": {"$ref": "#/$defs/integrity_context"},
    "assessment": {"$ref": "#/$defs/assessment"},
    "governance": {"$ref": "#/$defs/governance"}
  },
  "$defs": {
    "aware_datetime": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "ref": {"type": "string", "pattern": "^kfm:[a-z0-9][a-z0-9:._/-]{5,240}$"},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence:[a-z0-9][a-z0-9:._-]{5,200}$"}},
    "subject": {
      "type": "object", "additionalProperties": false,
      "required": ["gauge_ref", "observation_ref", "observation_source_ref", "percentile_context_ref", "observed_at", "retrieved_at", "flow_state", "evidence_refs"],
      "properties": {
        "gauge_ref": {"$ref": "#/$defs/ref"},
        "observation_ref": {"$ref": "#/$defs/ref"},
        "observation_source_ref": {"$ref": "#/$defs/ref"},
        "percentile_context_ref": {"$ref": "#/$defs/ref"},
        "observed_at": {"$ref": "#/$defs/aware_datetime"},
        "retrieved_at": {"$ref": "#/$defs/aware_datetime"},
        "flow_state": {"enum": ["LOW_PERCENTILE", "NOT_LOW", "UNKNOWN"]},
        "evidence_refs": {"$ref": "#/$defs/evidence_refs"}
      }
    },
    "regional_context": {
      "type": "object", "additionalProperties": false,
      "required": ["adjacent_gauge_count", "corroboration", "drought_context", "context_evidence_refs"],
      "properties": {
        "adjacent_gauge_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "corroboration": {"enum": ["CORROBORATES_LOW_FLOW", "DOES_NOT_CORROBORATE", "INSUFFICIENT"]},
        "drought_context": {"enum": ["SUPPORTS_LOW_FLOW", "DOES_NOT_SUPPORT", "UNKNOWN"]},
        "context_evidence_refs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence:[a-z0-9][a-z0-9:._-]{5,200}$"}}
      }
    },
    "integrity_context": {
      "type": "object", "additionalProperties": false,
      "required": ["ingest_state", "unit_state", "cadence_state"],
      "properties": {
        "ingest_state": {"enum": ["CLEAN", "GAP_OR_INTEGRATION_CONCERN", "UNKNOWN"]},
        "unit_state": {"enum": ["COMPATIBLE", "CONFLICT", "UNKNOWN"]},
        "cadence_state": {"enum": ["ON_TIME", "LATE", "UNKNOWN"]}
      }
    },
    "assessment": {
      "type": "object", "additionalProperties": false,
      "required": ["outcome", "priority", "reason_codes"],
      "properties": {
        "outcome": {"enum": ["REGIONAL_LOW_FLOW_CONTEXT", "LOCAL_SIGNAL_REVIEW", "NO_QC_ESCALATION", "HOLD", "ERROR"]},
        "priority": {"enum": ["ROUTINE", "ELEVATED", "HIGH", "NONE"]},
        "reason_codes": {
          "type": "array", "minItems": 1, "maxItems": 4, "uniqueItems": true,
          "items": {"enum": ["ADJACENT_GAUGES_CORROBORATE", "ADJACENT_GAUGES_DO_NOT_CORROBORATE", "ASSESSMENT_ERROR", "CONTEXT_INSUFFICIENT", "DROUGHT_CONTEXT_SUPPORTS", "INTEGRITY_CONCERN", "LOW_FLOW_SIGNAL", "NO_LOW_FLOW_SIGNAL"]}
        }
      }
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["execution_mode", "network_attempted", "percentile_computed", "sensor_invalidated", "hydrologic_event_declared", "detector_configuration_mutated", "policy_evaluated", "review_approved", "promotion_authorized", "release_authorized", "publication_authorized", "public_use_allowed"],
      "properties": {
        "execution_mode": {"const": "FIXTURE_ONLY"},
        "network_attempted": {"const": false},
        "percentile_computed": {"const": false},
        "sensor_invalidated": {"const": false},
        "hydrologic_event_declared": {"const": false},
        "detector_configuration_mutated": {"const": false},
        "policy_evaluated": {"const": false},
        "review_approved": {"const": false},
        "promotion_authorized": {"const": false},
        "release_authorized": {"const": false},
        "publication_authorized": {"const": false},
        "public_use_allowed": {"const": false}
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "source_ideas": ["KFM-P32-IDEA-0002", "KFM-P32-FEAT-0001"],
    "validator": "tools/validators/domains/hydrology/validate_streamflow_qc_context_assessment.py",
    "authority": "local fixture consistency only"
  }
}
