{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/domains/hydrology/western_kansas_observation_assessment.schema.json",
  "title": "Western Kansas Observation Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "analysis_time",
    "max_age_days",
    "sources",
    "claim",
    "material_change",
    "governance",
    "outcome"
  ],
  "properties": {
    "profile": {
      "const": "kfm.western-kansas-observation-assessment.v1"
    },
    "analysis_time": {
      "type": "string",
      "format": "date-time"
    },
    "max_age_days": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3650
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/source"
      }
    },
    "claim": {
      "$ref": "#/$defs/claim"
    },
    "material_change": {
      "$ref": "#/$defs/material_change"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "outcome": {
      "enum": [
        "OBSERVED",
        "FORECAST",
        "DERIVED",
        "CONFLICT",
        "STALE",
        "ABSTAIN",
        "ERROR"
      ]
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_family",
        "source_id",
        "source_version_ref",
        "observation_status",
        "observation_start",
        "observation_end",
        "valid_start",
        "valid_end",
        "publication_time",
        "retrieval_time",
        "revision_status",
        "support_kind",
        "support_id",
        "crs",
        "resolution_m",
        "method",
        "unit",
        "evidence_ref",
        "payload_digest",
        "correction_ref",
        "supersedes_ref"
      ],
      "properties": {
        "source_family": {
          "enum": [
            "USDM",
            "USGS_STREAMFLOW",
            "KGS_GROUNDWATER",
            "PRECIP_EDDI",
            "SOIL_MOISTURE",
            "AGRICULTURE_CONTEXT",
            "WATER_MANAGEMENT_BOUNDARY",
            "CPC_DROUGHT_OUTLOOK"
          ]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_version_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_role": {
          "enum": [
            "OBSERVATION",
            "CLASSIFICATION",
            "FORECAST",
            "CONTEXT",
            "REFERENCE"
          ]
        },
        "observation_status": {
          "enum": [
            "PRESENT",
            "MISSING"
          ]
        },
        "observation_start": {
          "type": "string",
          "format": "date-time"
        },
        "observation_end": {
          "type": "string",
          "format": "date-time"
        },
        "valid_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "valid_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "forecast_issue_time": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "forecast_valid_start": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "forecast_valid_end": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "predecessor_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "predecessor_relation": {
          "enum": [
            "SUCCESSOR",
            "CORRECTION",
            "SUPERSESSION",
            null
          ]
        },
        "publication_time": {
          "type": "string",
          "format": "date-time"
        },
        "retrieval_time": {
          "type": "string",
          "format": "date-time"
        },
        "revision_status": {
          "enum": [
            "PROVISIONAL",
            "FINAL",
            "CURRENT",
            "CORRECTED",
            "SUPERSEDED"
          ]
        },
        "support_kind": {
          "enum": [
            "STATION",
            "POINT",
            "POLYGON",
            "GRID_CELL",
            "BASIN",
            "COUNTY",
            "MANAGEMENT_AREA"
          ]
        },
        "support_id": {
          "type": "string",
          "minLength": 1
        },
        "crs": {
          "type": "string",
          "minLength": 1
        },
        "resolution_m": {
          "type": [
            "number",
            "null"
          ],
          "exclusiveMinimum": 0
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "minLength": 1
        },
        "payload_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "correction_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "supersedes_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "support_kind",
        "support_id",
        "transformation_ref",
        "source_conflict",
        "county_intersection_only",
        "resampled",
        "source_support_preserved",
        "tuple_evidence_refs"
      ],
      "properties": {
        "kind": {
          "enum": [
            "DROUGHT_CLASSIFICATION",
            "DROUGHT_OUTLOOK",
            "STREAMFLOW_CONDITION",
            "GROUNDWATER_CONDITION",
            "EVAPORATIVE_DEMAND",
            "PRECIPITATION_CONDITION",
            "SOIL_MOISTURE_CONDITION",
            "AGRICULTURE_CONTEXT",
            "AGRICULTURAL_LOSS",
            "MANAGEMENT_BOUNDARY_CONTEXT",
            "CROSS_SOURCE_STRESS"
          ]
        },
        "support_kind": {
          "enum": [
            "STATION",
            "POINT",
            "POLYGON",
            "GRID_CELL",
            "BASIN",
            "COUNTY",
            "MANAGEMENT_AREA"
          ]
        },
        "support_id": {
          "type": "string",
          "minLength": 1
        },
        "transformation_ref": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_conflict": {
          "type": "boolean"
        },
        "county_intersection_only": {
          "type": "boolean"
        },
        "resampled": {
          "type": "boolean"
        },
        "source_support_preserved": {
          "type": "boolean"
        },
        "tuple_evidence_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "material_change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prior_claim_digest",
        "current_claim_digest",
        "declared_material"
      ],
      "properties": {
        "prior_claim_digest": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "current_claim_digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "declared_material": {
          "type": "boolean"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_admitted",
        "lifecycle_mutated",
        "policy_approved",
        "release_authorized",
        "publication_authorized"
      ],
      "properties": {
        "source_admitted": {
          "type": "boolean"
        },
        "lifecycle_mutated": {
          "type": "boolean"
        },
        "policy_approved": {
          "type": "boolean"
        },
        "release_authorized": {
          "type": "boolean"
        },
        "publication_authorized": {
          "type": "boolean"
        }
      }
    }
  }
}
