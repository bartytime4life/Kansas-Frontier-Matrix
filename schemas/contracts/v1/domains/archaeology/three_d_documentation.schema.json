{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/archaeology/three_d_documentation.schema.json",
  "title": "ThreeDDocumentation",
  "description": "Fixture-only Archaeology 3D-documentation paradata profile. Conformance grants no evidence, interpretation, policy, review, release, publication, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "source_card",
    "spec_hash",
    "documentation_id",
    "recorded_at",
    "documentation_type",
    "subject_refs",
    "capture",
    "processing_steps",
    "spatial_reference",
    "interpretation",
    "assets",
    "governance",
    "limitations",
    "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "ThreeDDocumentation"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.archaeology.three-d-documentation.fixture.v1"},
    "source_card": {"const": "KFM-P18-INV-410"},
    "spec_hash": {"$ref": "#/$defs/sha256"},
    "documentation_id": {
      "type": "string",
      "pattern": "^kfm:archaeology:three-d-documentation:[a-f0-9]{24}$"
    },
    "recorded_at": {"$ref": "#/$defs/date_time"},
    "documentation_type": {
      "enum": [
        "CT_VOLUME",
        "DEPTH_CAPTURE",
        "IMAGE_BASED_MODEL",
        "INTEGRATED_SCENE",
        "LASER_SCAN",
        "LIDAR_DERIVATIVE",
        "STRUCTURED_LIGHT_SCAN"
      ]
    },
    "subject_refs": {"$ref": "#/$defs/ref_array_nonempty"},
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "methods", "device_refs", "acquisition_receipt_ref", "method_statement"],
      "properties": {
        "state": {"enum": ["COMPLETE", "ERROR", "INCOMPLETE", "UNKNOWN"]},
        "methods": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "COMPUTED_TOMOGRAPHY",
              "DEPTH_SENSOR",
              "LASER_SCANNING",
              "LIDAR_REUSE",
              "PHOTOGRAMMETRY",
              "STRUCTURED_LIGHT"
            ]
          }
        },
        "device_refs": {"$ref": "#/$defs/ref_array"},
        "acquisition_receipt_ref": {"$ref": "#/$defs/nullable_ref"},
        "method_statement": {"$ref": "#/$defs/nullable_statement"}
      }
    },
    "processing_steps": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sequence", "operation", "input_asset_refs", "output_asset_refs", "method_statement", "receipt_ref", "interpretive"],
        "properties": {
          "sequence": {"type": "integer", "minimum": 1, "maximum": 64},
          "operation": {
            "enum": [
              "ALIGNMENT",
              "CALIBRATION",
              "DECIMATION",
              "GEOREFERENCING",
              "INTEGRATION",
              "INTERPOLATION",
              "INTERPRETATION",
              "MESHING",
              "RECONSTRUCTION",
              "SCALING",
              "TEXTURING"
            ]
          },
          "input_asset_refs": {"$ref": "#/$defs/ref_array_nonempty"},
          "output_asset_refs": {"$ref": "#/$defs/ref_array_nonempty"},
          "method_statement": {"type": "string", "minLength": 12, "maxLength": 1000},
          "receipt_ref": {"$ref": "#/$defs/ref"},
          "interpretive": {"type": "boolean"}
        }
      }
    },
    "spatial_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scale_state",
        "scale_statement",
        "scale_receipt_ref",
        "georeference_state",
        "crs_ref",
        "georeference_receipt_ref",
        "orientation_statement"
      ],
      "properties": {
        "scale_state": {"enum": ["APPROXIMATE", "MEASURED", "UNRESOLVED"]},
        "scale_statement": {"$ref": "#/$defs/nullable_statement"},
        "scale_receipt_ref": {"$ref": "#/$defs/nullable_ref"},
        "georeference_state": {"enum": ["GEOREFERENCED", "LOCAL_FRAME", "UNRESOLVED"]},
        "crs_ref": {"$ref": "#/$defs/nullable_ref"},
        "georeference_receipt_ref": {"$ref": "#/$defs/nullable_ref"},
        "orientation_statement": {"$ref": "#/$defs/nullable_statement"}
      }
    },
    "interpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "knowledge_character",
        "representation_kind",
        "interpretive_step_refs",
        "uncertainty_statement",
        "vertical_surface_loss_disclosed"
      ],
      "properties": {
        "knowledge_character": {"enum": ["INTERPRETIVE", "MIXED", "REALITY_BASED", "UNKNOWN"]},
        "representation_kind": {"enum": ["TRUE_3D", "TWO_POINT_FIVE_D", "UNKNOWN"]},
        "interpretive_step_refs": {"$ref": "#/$defs/ref_array"},
        "uncertainty_statement": {"$ref": "#/$defs/nullable_statement"},
        "vertical_surface_loss_disclosed": {"type": ["boolean", "null"]}
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_asset_refs", "derived_asset_refs", "public_safe_asset_refs"],
      "properties": {
        "source_asset_refs": {"$ref": "#/$defs/ref_array_nonempty"},
        "derived_asset_refs": {"$ref": "#/$defs/ref_array_nonempty"},
        "public_safe_asset_refs": {"$ref": "#/$defs/ref_array"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "intended_use",
        "sensitivity_state",
        "evidence_bundle_ref",
        "rights_ref",
        "technical_review_ref",
        "cultural_review_ref",
        "policy_decision_ref",
        "publication_transform_receipt_ref",
        "release_manifest_ref",
        "correction_ref",
        "rollback_ref"
      ],
      "properties": {
        "state": {"enum": ["COMPLETE", "ERROR", "INCOMPLETE", "UNKNOWN"]},
        "intended_use": {"enum": ["INTERNAL_REVIEW", "PUBLIC_CANDIDATE", "UNKNOWN"]},
        "sensitivity_state": {"enum": ["CONTROLLED", "PUBLIC_SAFE_REVIEWED", "UNRESOLVED"]},
        "evidence_bundle_ref": {"$ref": "#/$defs/nullable_ref"},
        "rights_ref": {"$ref": "#/$defs/nullable_ref"},
        "technical_review_ref": {"$ref": "#/$defs/nullable_ref"},
        "cultural_review_ref": {"$ref": "#/$defs/nullable_ref"},
        "policy_decision_ref": {"$ref": "#/$defs/nullable_ref"},
        "publication_transform_receipt_ref": {"$ref": "#/$defs/nullable_ref"},
        "release_manifest_ref": {"$ref": "#/$defs/nullable_ref"},
        "correction_ref": {"$ref": "#/$defs/nullable_ref"},
        "rollback_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "limitations": {
      "const": [
        "DECLARATION_ONLY",
        "NO_ASSET_CREATION_OR_MUTATION",
        "NO_EVIDENCE_OR_INTERPRETATION_AUTHORITY",
        "NO_POLICY_OR_REVIEW_AUTHORITY",
        "NO_RELEASE_OR_PUBLICATION_AUTHORITY",
        "SYNTHETIC_REFERENCES_ONLY"
      ]
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_mutation_authority",
        "evidence_authority",
        "interpretation_authority",
        "policy_authority",
        "review_authority",
        "release_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "asset_mutation_authority": {"const": false},
        "evidence_authority": {"const": false},
        "interpretation_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "date_time": {"type": "string", "format": "date-time"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "nullable_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "ref_array": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "ref_array_nonempty": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "nullable_statement": {
      "anyOf": [
        {"type": "string", "minLength": 12, "maxLength": 1000},
        {"type": "null"}
      ]
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "execution_mode": "FIXTURE_ONLY",
    "contract_doc": "contracts/domains/archaeology/three_d_documentation.md",
    "source_card": "KFM-P18-INV-410"
  }
}
