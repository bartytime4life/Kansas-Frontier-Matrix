{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/schemas/contracts/v1/domains/archaeology/candidate_feature.schema.json",
  "title": "Candidate Feature",
  "type": "object",
  "description": "DRAFT bounded projection for an archaeology candidate that is not a confirmed site and never carries inline location geometry.",
  "x-kfm": {
    "status": "DRAFT_BOUNDED_PROJECTION",
    "contract_doc": "contracts/domains/archaeology/candidate_feature.md",
    "public_location_posture": "DENY_INLINE_LOCATION",
    "truth_posture": "CANDIDATE_ONLY"
  },
  "required": [
    "candidate_feature_id",
    "object_type",
    "truth_state",
    "origin_method",
    "source_refs",
    "review_state",
    "sensitivity_class",
    "lifecycle_state"
  ],
  "properties": {
    "candidate_feature_id": {
      "type": "string",
      "$comment": "Uses a portable strict end-of-input assertion so terminal line breaks cannot become part of identity.",
      "pattern": "^arc-candidate-[a-z0-9][a-z0-9-]*(?![\\s\\S])"
    },
    "object_type": {
      "const": "CandidateFeature"
    },
    "truth_state": {
      "const": "CANDIDATE"
    },
    "candidate_type": {
      "type": "string",
      "enum": [
        "ANOMALY",
        "ARCHIVAL_LEAD",
        "EARTHWORK",
        "FIELD_OBSERVATION",
        "LANDSCAPE_TRACE",
        "MATERIAL_SCATTER",
        "STRUCTURE_TRACE",
        "OTHER"
      ]
    },
    "origin_method": {
      "type": "string",
      "enum": [
        "ARCHIVAL",
        "CROSS_DOMAIN_CONTEXT",
        "FIELD_SURVEY",
        "GEOPHYSICS",
        "HISTORICAL_MAP_COMPARISON",
        "LIDAR",
        "REMOTE_SENSING",
        "STEWARD_SUBMISSION",
        "OTHER"
      ]
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!.*[/._~-](?:[Ll][Aa][Tt](?:[Ii][Tt][Uu][Dd][Ee])?|[Ll][Oo][Nn](?:[Gg][Ii][Tt][Uu][Dd][Ee])?|[Ll][Nn][Gg]|[Cc][Oo][Oo][Rr][Dd][Ii][Nn][Aa][Tt][Ee][Ss]?|[Bb][Bb][Oo][Xx]|[Gg][Ee][Oo][Hh][Aa][Ss][Hh]|[Ww][Kk][Tt]|[Ee][Aa][Ss][Tt][Ii][Nn][Gg]|[Nn][Oo][Rr][Tt][Hh][Ii][Nn][Gg]|[Uu][Tt][Mm]|[Mm][Gg][Rr][Ss])(?:$|[0-9]|[/._~-]))kfm://[A-Za-z0-9][A-Za-z0-9._~/-]*(?![\\s\\S])",
        "allOf": [
          {
            "pattern": "^kfm://(?:source|source-descriptor|source-record)/[A-Za-z0-9][A-Za-z0-9._~-]*(?:/[A-Za-z0-9][A-Za-z0-9._~-]*)*(?![\\s\\S])"
          }
        ]
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!.*[/._~-](?:[Ll][Aa][Tt](?:[Ii][Tt][Uu][Dd][Ee])?|[Ll][Oo][Nn](?:[Gg][Ii][Tt][Uu][Dd][Ee])?|[Ll][Nn][Gg]|[Cc][Oo][Oo][Rr][Dd][Ii][Nn][Aa][Tt][Ee][Ss]?|[Bb][Bb][Oo][Xx]|[Gg][Ee][Oo][Hh][Aa][Ss][Hh]|[Ww][Kk][Tt]|[Ee][Aa][Ss][Tt][Ii][Nn][Gg]|[Nn][Oo][Rr][Tt][Hh][Ii][Nn][Gg]|[Uu][Tt][Mm]|[Mm][Gg][Rr][Ss])(?:$|[0-9]|[/._~-]))kfm://[A-Za-z0-9][A-Za-z0-9._~/-]*(?![\\s\\S])",
        "allOf": [
          {
            "pattern": "^kfm://(?:evidence|evidence-ref|evidence-bundle)/[A-Za-z0-9][A-Za-z0-9._~-]*(?:/[A-Za-z0-9][A-Za-z0-9._~-]*)*(?![\\s\\S])"
          }
        ]
      }
    },
    "observation_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!.*[/._~-](?:[Ll][Aa][Tt](?:[Ii][Tt][Uu][Dd][Ee])?|[Ll][Oo][Nn](?:[Gg][Ii][Tt][Uu][Dd][Ee])?|[Ll][Nn][Gg]|[Cc][Oo][Oo][Rr][Dd][Ii][Nn][Aa][Tt][Ee][Ss]?|[Bb][Bb][Oo][Xx]|[Gg][Ee][Oo][Hh][Aa][Ss][Hh]|[Ww][Kk][Tt]|[Ee][Aa][Ss][Tt][Ii][Nn][Gg]|[Nn][Oo][Rr][Tt][Hh][Ii][Nn][Gg]|[Uu][Tt][Mm]|[Mm][Gg][Rr][Ss])(?:$|[0-9]|[/._~-]))kfm://[A-Za-z0-9][A-Za-z0-9._~/-]*(?![\\s\\S])",
        "allOf": [
          {
            "pattern": "^kfm://observation/[A-Za-z0-9][A-Za-z0-9._~-]*(?:/[A-Za-z0-9][A-Za-z0-9._~-]*)*(?![\\s\\S])"
          }
        ]
      }
    },
    "candidate_geometry_ref": {
      "type": "string",
      "pattern": "^(?!.*[/._~-](?:[Ll][Aa][Tt](?:[Ii][Tt][Uu][Dd][Ee])?|[Ll][Oo][Nn](?:[Gg][Ii][Tt][Uu][Dd][Ee])?|[Ll][Nn][Gg]|[Cc][Oo][Oo][Rr][Dd][Ii][Nn][Aa][Tt][Ee][Ss]?|[Bb][Bb][Oo][Xx]|[Gg][Ee][Oo][Hh][Aa][Ss][Hh]|[Ww][Kk][Tt]|[Ee][Aa][Ss][Tt][Ii][Nn][Gg]|[Nn][Oo][Rr][Tt][Hh][Ii][Nn][Gg]|[Uu][Tt][Mm]|[Mm][Gg][Rr][Ss])(?:$|[0-9]|[/._~-]))kfm://[A-Za-z0-9][A-Za-z0-9._~/-]*(?![\\s\\S])",
      "allOf": [
        {
          "pattern": "^kfm://geometry/[A-Za-z0-9][A-Za-z0-9._~-]*(?:/[A-Za-z0-9][A-Za-z0-9._~-]*)*(?![\\s\\S])"
        }
      ]
    },
    "spatial_precision_class": {
      "type": "string",
      "enum": [
        "WITHHELD",
        "GENERALIZED",
        "PUBLIC_SAFE_GENERALIZED"
      ]
    },
    "confidence_statement": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000,
      "$comment": "Requires a portable non-surrogate BMP content code point; excludes Unicode 15.0 BMP Cc/Cf/separators and Default_Ignorable ranges.",
      "pattern": "(?=[\\u0000-\\uFFFF])[^\\u0000-\\u0020\\u007F-\\u00A0\\u00AD\\u034F\\u0600-\\u0605\\u061C\\u06DD\\u070F\\u0890-\\u0891\\u08E2\\u115F-\\u1160\\u1680\\u17B4-\\u17B5\\u180B-\\u180F\\u2000-\\u200F\\u2028-\\u202F\\u205F-\\u206F\\u3000\\u3164\\uD800-\\uDFFF\\uFE00-\\uFE0F\\uFEFF\\uFFA0\\uFFF0-\\uFFFB]"
    },
    "review_state": {
      "type": "string",
      "enum": [
        "INTAKE",
        "NEEDS_REVIEW",
        "UNDER_REVIEW",
        "RETAINED",
        "REJECTED",
        "QUARANTINED",
        "SUPERSEDED"
      ]
    },
    "sensitivity_class": {
      "type": "string",
      "enum": [
        "RESTRICTED",
        "WITHHELD",
        "PUBLIC_SAFE_GENERALIZED"
      ]
    },
    "lifecycle_state": {
      "type": "string",
      "enum": [
        "WORK",
        "QUARANTINE",
        "PROCESSED",
        "CATALOG"
      ]
    },
    "correction_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!.*[/._~-](?:[Ll][Aa][Tt](?:[Ii][Tt][Uu][Dd][Ee])?|[Ll][Oo][Nn](?:[Gg][Ii][Tt][Uu][Dd][Ee])?|[Ll][Nn][Gg]|[Cc][Oo][Oo][Rr][Dd][Ii][Nn][Aa][Tt][Ee][Ss]?|[Bb][Bb][Oo][Xx]|[Gg][Ee][Oo][Hh][Aa][Ss][Hh]|[Ww][Kk][Tt]|[Ee][Aa][Ss][Tt][Ii][Nn][Gg]|[Nn][Oo][Rr][Tt][Hh][Ii][Nn][Gg]|[Uu][Tt][Mm]|[Mm][Gg][Rr][Ss])(?:$|[0-9]|[/._~-]))kfm://[A-Za-z0-9][A-Za-z0-9._~/-]*(?![\\s\\S])",
        "allOf": [
          {
            "pattern": "^kfm://(?:correction|correction-notice|rollback)/[A-Za-z0-9][A-Za-z0-9._~-]*(?:/[A-Za-z0-9][A-Za-z0-9._~-]*)*(?![\\s\\S])"
          }
        ]
      }
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "anyOf": [
          {
            "properties": {
              "review_state": {
                "enum": [
                  "UNDER_REVIEW",
                  "RETAINED"
                ]
              }
            },
            "required": [
              "review_state"
            ]
          },
          {
            "properties": {
              "lifecycle_state": {
                "enum": [
                  "PROCESSED",
                  "CATALOG"
                ]
              }
            },
            "required": [
              "lifecycle_state"
            ]
          }
        ]
      },
      "then": {
        "required": [
          "evidence_refs"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "review_state": {
            "const": "SUPERSEDED"
          }
        },
        "required": [
          "review_state"
        ]
      },
      "then": {
        "required": [
          "correction_refs"
        ]
      }
    },
    {
      "if": {
        "required": [
          "candidate_geometry_ref"
        ]
      },
      "then": {
        "required": [
          "spatial_precision_class"
        ]
      }
    }
  ]
}
