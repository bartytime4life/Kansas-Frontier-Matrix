{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/archaeology/archaeological_volume_measurement_assessment.schema.json",
  "title": "ArchaeologicalVolumeMeasurementAssessmentCandidate",
  "description": "Fixture-only assessment candidate that keeps archaeological volume measurements distinct from visual 3D carriers. Conformance grants no evidence, interpretation, policy, review, release, publication, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "source_card",
    "spec_hash",
    "assessment_id",
    "recorded_at",
    "subject",
    "source_documentation",
    "method",
    "measurement",
    "uncertainty",
    "governance",
    "limitations",
    "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "ArchaeologicalVolumeMeasurementAssessmentCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.archaeology.volume-measurement-assessment.fixture.v1"},
    "source_card": {"const": "KFM-P18-INV-435"},
    "spec_hash": {"$ref": "#/$defs/sha256"},
    "assessment_id": {
      "type": "string",
      "pattern": "^kfm:archaeology:volume-measurement-assessment:[a-f0-9]{24}$"
    },
    "recorded_at": {"$ref": "#/$defs/date_time"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject_ref", "subject_kind", "measurement_scope"],
      "properties": {
        "subject_ref": {"$ref": "#/$defs/ref"},
        "subject_kind": {
          "enum": ["ARTIFACT", "ASSEMBLAGE", "CONTEXT", "DEPOSIT", "FEATURE", "OTHER", "SAMPLE"]
        },
        "measurement_scope": {
          "enum": ["DEPOSIT", "MODEL_REGION", "OBJECT", "REMOVED_MATERIAL", "VOID", "OTHER"]
        }
      }
    },
    "source_documentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "three_d_documentation_ref",
        "input_asset_refs",
        "visual_mesh_refs",
        "volumetric_input_refs",
        "source_separation_statement"
      ],
      "properties": {
        "three_d_documentation_ref": {"$ref": "#/$defs/ref"},
        "input_asset_refs": {"$ref": "#/$defs/ref_array_nonempty"},
        "visual_mesh_refs": {"$ref": "#/$defs/ref_array"},
        "volumetric_input_refs": {"$ref": "#/$defs/ref_array"},
        "source_separation_statement": {"$ref": "#/$defs/nullable_statement"}
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_class",
        "method_statement",
        "algorithm_ref",
        "scale_basis_ref",
        "processing_receipt_ref",
        "specialist_review_required"
      ],
      "properties": {
        "method_class": {
          "enum": ["CT_DERIVED", "DEPOSIT_ESTIMATE", "DIRECT_VOLUME", "MESH_DERIVED", "OTHER", "SURFACE_DIFFERENCE", "VOXEL_COUNT"]
        },
        "method_statement": {"$ref": "#/$defs/nullable_statement"},
        "algorithm_ref": {"$ref": "#/$defs/nullable_ref"},
        "scale_basis_ref": {"$ref": "#/$defs/nullable_ref"},
        "processing_receipt_ref": {"$ref": "#/$defs/nullable_ref"},
        "specialist_review_required": {"type": "boolean"}
      }
    },
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value", "unit", "precision_digits", "measurement_receipt_ref"],
      "properties": {
        "state": {"enum": ["COMPLETE", "ERROR", "INCOMPLETE", "UNKNOWN"]},
        "value": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "unit": {"enum": ["CUBIC_CENTIMETRE", "CUBIC_METRE", "CUBIC_MILLIMETRE"]},
        "precision_digits": {"type": "integer", "minimum": 0, "maximum": 9},
        "measurement_receipt_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "lower_bound", "upper_bound", "confidence_level", "uncertainty_statement", "uncertainty_profile_ref"],
      "properties": {
        "state": {"enum": ["QUALITATIVE", "QUANTIFIED", "UNRESOLVED"]},
        "lower_bound": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "upper_bound": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "confidence_level": {"type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1},
        "uncertainty_statement": {"$ref": "#/$defs/nullable_statement"},
        "uncertainty_profile_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "intended_use",
        "sensitivity_state",
        "evidence_bundle_ref",
        "rights_ref",
        "technical_review_ref",
        "cultural_review_ref",
        "policy_decision_ref",
        "publication_transform_receipt_ref",
        "release_manifest_ref",
        "correction_ref",
        "rollback_ref"
      ],
      "properties": {
        "state": {"enum": ["COMPLETE", "ERROR", "INCOMPLETE", "UNKNOWN"]},
        "intended_use": {"enum": ["INTERNAL_REVIEW", "PUBLIC_CANDIDATE", "UNKNOWN"]},
        "sensitivity_state": {"enum": ["CONTROLLED", "PUBLIC_SAFE_REVIEWED", "UNRESOLVED"]},
        "evidence_bundle_ref": {"$ref": "#/$defs/nullable_ref"},
        "rights_ref": {"$ref": "#/$defs/nullable_ref"},
        "technical_review_ref": {"$ref": "#/$defs/nullable_ref"},
        "cultural_review_ref": {"$ref": "#/$defs/nullable_ref"},
        "policy_decision_ref": {"$ref": "#/$defs/nullable_ref"},
        "publication_transform_receipt_ref": {"$ref": "#/$defs/nullable_ref"},
        "release_manifest_ref": {"$ref": "#/$defs/nullable_ref"},
        "correction_ref": {"$ref": "#/$defs/nullable_ref"},
        "rollback_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "limitations": {
      "const": [
        "DECLARATION_ONLY",
        "NO_ASSET_ACCESS_OR_MUTATION",
        "NO_COORDINATE_OR_LOCATION_FIELDS",
        "NO_EVIDENCE_OR_INTERPRETATION_AUTHORITY",
        "NO_POLICY_OR_REVIEW_AUTHORITY",
        "NO_RELEASE_OR_PUBLICATION_AUTHORITY",
        "SYNTHETIC_REFERENCES_ONLY"
      ]
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_mutation_authority",
        "measurement_truth_authority",
        "evidence_authority",
        "interpretation_authority",
        "policy_authority",
        "review_authority",
        "release_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "asset_mutation_authority": {"const": false},
        "measurement_truth_authority": {"const": false},
        "evidence_authority": {"const": false},
        "interpretation_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "date_time": {"type": "string", "format": "date-time"},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "nullable_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "ref_array": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "ref_array_nonempty": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "nullable_statement": {
      "anyOf": [
        {"type": "string", "minLength": 12, "maxLength": 1000},
        {"type": "null"}
      ]
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "execution_mode": "FIXTURE_ONLY",
    "contract_doc": "contracts/domains/archaeology/archaeological_volume_measurement_assessment.md",
    "source_card": "KFM-P18-INV-435"
  }
}
