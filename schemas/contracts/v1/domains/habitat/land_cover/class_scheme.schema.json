{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile_version",
    "scheme_id",
    "scheme_version",
    "source_id",
    "source_family",
    "source_product",
    "source_vintage",
    "source_descriptor_ref",
    "source_role",
    "classes",
    "nodata_value",
    "governance",
    "spec_hash"
  ],
  "properties": {
    "object_type": {
      "const": "ClassSchemeProfile"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "profile_version": {
      "const": "kfm.nlcd-class-scheme-candidate/v1"
    },
    "scheme_id": {
      "type": "string",
      "pattern": "^kfm:class-scheme:[A-Za-z0-9._:/-]{1,160}$"
    },
    "scheme_version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "source_id": {
      "const": "nlcd"
    },
    "source_family": {
      "const": "NLCD"
    },
    "source_product": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "source_vintage": {
      "type": "string",
      "format": "date"
    },
    "source_descriptor_ref": {
      "const": "data/registry/habitat/sources/nlcd.yaml"
    },
    "source_role": {
      "const": "OBSERVATION_CANDIDATE"
    },
    "classes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "label"
        ],
        "properties": {
          "code": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "minItems": 1,
      "maxItems": 255
    },
    "nodata_value": {
      "const": 0
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_admitted",
        "review_completed",
        "policy_evaluated",
        "lifecycle_write",
        "promotion_authorized",
        "release_authorized",
        "publication_authorized",
        "public_use_allowed",
        "review_required",
        "rights_status",
        "sensitivity"
      ],
      "properties": {
        "source_admitted": {
          "const": false
        },
        "review_completed": {
          "const": false
        },
        "policy_evaluated": {
          "const": false
        },
        "lifecycle_write": {
          "const": false
        },
        "promotion_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        },
        "public_use_allowed": {
          "const": false
        },
        "review_required": {
          "const": true
        },
        "rights_status": {
          "const": "UNVERIFIED"
        },
        "sensitivity": {
          "const": "NOT_EVALUATED"
        }
      }
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/schemas/contracts/v1/domains/habitat/land_cover/class_scheme.schema.json",
  "title": "ClassSchemeProfile - bounded NLCD candidate",
  "description": "Closed fixture-first NLCD candidate profile. Integrity and conformance grant no source admission, reviewed class meaning, habitat assertion, lifecycle write, release or publication authority.",
  "x-kfm": {
    "status": "PROPOSED",
    "contract_doc": "contracts/domains/habitat/land_cover/class_scheme.md",
    "profile_scope": "bounded-native-grid-candidate-only"
  }
}
