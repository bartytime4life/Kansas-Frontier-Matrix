{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/habitat/land_cover/cover_class_crosswalk_profile.schema.json",
  "title": "CoverClassCrosswalkProfileCandidate",
  "description": "Fixture-only, version-bound Habitat cover-class crosswalk candidate. Validation grants no source, evidence, policy, review, recoding, renderer, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_version",
    "candidate_id",
    "spec_hash",
    "source_scheme",
    "target_scheme",
    "crosswalk",
    "mappings",
    "summary",
    "governance"
  ],
  "properties": {
    "profile_version": {
      "const": "kfm.cover-class-crosswalk-candidate.v1"
    },
    "candidate_id": {
      "type": "string",
      "pattern": "^kfm:cover-class-crosswalk:[a-f0-9]{24}$"
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "source_scheme": {
      "$ref": "#/$defs/scheme"
    },
    "target_scheme": {
      "$ref": "#/$defs/scheme"
    },
    "crosswalk": {
      "$ref": "#/$defs/crosswalk"
    },
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/mapping"
      }
    },
    "summary": {
      "$ref": "#/$defs/summary"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
      "maxLength": 64
    },
    "classCode": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "evidenceRef": {
      "type": "string",
      "pattern": "^urn:kfm:synthetic:evidence:[a-z0-9][a-z0-9-]{2,95}$"
    },
    "scheme": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme_id",
        "scheme_version",
        "ontology_ref",
        "source_role",
        "class_codes"
      ],
      "properties": {
        "scheme_id": {
          "type": "string",
          "pattern": "^kfm:class-scheme:synthetic:[a-z0-9][a-z0-9-]{2,95}$"
        },
        "scheme_version": {
          "$ref": "#/$defs/semver"
        },
        "ontology_ref": {
          "type": "string",
          "pattern": "^urn:kfm:synthetic:ontology:[a-z0-9][a-z0-9-]{2,95}@[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$",
          "maxLength": 190
        },
        "source_role": {
          "enum": [
            "ADJACENCY_CONTEXT",
            "AUTHORITATIVE_OBSERVATION",
            "CANDIDATE",
            "MODELED_OUTPUT"
          ]
        },
        "class_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "$ref": "#/$defs/classCode"
          },
          "uniqueItems": true
        }
      }
    },
    "crosswalk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crosswalk_version",
        "directionality",
        "review_state",
        "mapping_basis",
        "source_role_effect",
        "allowed_uses",
        "denied_uses",
        "evidence_refs",
        "review_ref",
        "correction_path_ref",
        "rollback_ref"
      ],
      "properties": {
        "crosswalk_version": {
          "$ref": "#/$defs/semver"
        },
        "directionality": {
          "enum": [
            "BIDIRECTIONAL_REVIEW_REQUESTED",
            "FORWARD_ONLY"
          ]
        },
        "review_state": {
          "const": "CANDIDATE"
        },
        "mapping_basis": {
          "const": "SYNTHETIC_FIXTURE"
        },
        "source_role_effect": {
          "const": "PRESERVE_DISTINCT"
        },
        "allowed_uses": {
          "const": [
            "FIXTURE_VALIDATION"
          ]
        },
        "denied_uses": {
          "const": [
            "AUTOMATED_REVERSE_MAPPING",
            "OBSERVATION_TRUTH",
            "PUBLIC_RELEASE",
            "RENDERER_TRANSFORM"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "uniqueItems": true
        },
        "review_ref": {
          "type": "string",
          "pattern": "^urn:kfm:synthetic:review-request:[a-z0-9][a-z0-9-]{2,95}$"
        },
        "correction_path_ref": {
          "type": "string",
          "pattern": "^urn:kfm:synthetic:correction-path:[a-z0-9][a-z0-9-]{2,95}$"
        },
        "rollback_ref": {
          "type": "string",
          "pattern": "^urn:kfm:synthetic:rollback:[a-z0-9][a-z0-9-]{2,95}$"
        }
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row_id",
        "source_codes",
        "target_codes",
        "mapping_state",
        "lossy",
        "caveat_required",
        "evidence_refs"
      ],
      "properties": {
        "row_id": {
          "type": "string",
          "pattern": "^row-[0-9]{3}$"
        },
        "source_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/classCode"
          },
          "uniqueItems": true
        },
        "target_codes": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/classCode"
          },
          "uniqueItems": true
        },
        "mapping_state": {
          "enum": [
            "AGGREGATED",
            "AMBIGUOUS",
            "DENIED",
            "EXACT",
            "NODATA",
            "SPLIT",
            "UNMAPPED"
          ]
        },
        "lossy": {
          "type": "boolean"
        },
        "caveat_required": {
          "type": "boolean"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/evidenceRef"
          },
          "uniqueItems": true
        }
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ontology_versions_bound",
        "source_class_count",
        "accounted_source_class_count",
        "unmapped_source_class_count",
        "mapping_row_count",
        "lossy_row_count",
        "caveat_row_count",
        "profile_state",
        "silent_recode_authorized",
        "reverse_use_authorized",
        "production_use_authorized"
      ],
      "properties": {
        "ontology_versions_bound": {
          "type": "boolean"
        },
        "source_class_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "accounted_source_class_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "unmapped_source_class_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "mapping_row_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 256
        },
        "lossy_row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "caveat_row_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256
        },
        "profile_state": {
          "const": "REVIEW_REQUIRED"
        },
        "silent_recode_authorized": {
          "const": false
        },
        "reverse_use_authorized": {
          "const": false
        },
        "production_use_authorized": {
          "const": false
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_only",
        "network_access",
        "recodes_source_data",
        "source_activation_authority",
        "evidence_authority",
        "policy_authority",
        "review_authority",
        "renderer_authority",
        "release_authority",
        "publication_authority",
        "public_use_authorized"
      ],
      "properties": {
        "fixture_only": {
          "const": true
        },
        "network_access": {
          "const": false
        },
        "recodes_source_data": {
          "const": false
        },
        "source_activation_authority": {
          "const": false
        },
        "evidence_authority": {
          "const": false
        },
        "policy_authority": {
          "const": false
        },
        "review_authority": {
          "const": false
        },
        "renderer_authority": {
          "const": false
        },
        "release_authority": {
          "const": false
        },
        "publication_authority": {
          "const": false
        },
        "public_use_authorized": {
          "const": false
        }
      }
    }
  },
  "x-kfm": {
    "base_contract_doc": "contracts/domains/habitat/land_cover/crosswalk.md",
    "contract_doc": "contracts/domains/habitat/land_cover/cover_class_crosswalk_profile.md",
    "fixtures": "fixtures/domains/habitat/land_cover/crosswalk/profile_cases.json",
    "validator": "tools/validators/domains/habitat/validate_cover_class_crosswalk_profile.py",
    "status": "PROPOSED",
    "authority_boundary": "fixture-only-version-bound-crosswalk"
  }
}
