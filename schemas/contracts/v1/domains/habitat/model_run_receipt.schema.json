{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/habitat/model_run_receipt.schema.json",
  "title": "HabitatModelRunReceipt",
  "description": "Closed fixture profile for Habitat model-run process memory. Validation does not establish truth, evidence closure, policy, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "receipt_id",
    "domain",
    "run_kind",
    "run_state",
    "started_at",
    "completed_at",
    "recorded_at",
    "model",
    "inputs",
    "inputs_digest",
    "config",
    "outputs",
    "failure_reason_codes",
    "evidence_refs",
    "governance",
    "limitations",
    "spec_hash"
  ],
  "properties": {
    "object_type": { "const": "ModelRunReceipt" },
    "schema_version": { "const": "1.0.0" },
    "profile": { "const": "kfm.habitat-model-run-receipt.fixture.v1" },
    "receipt_id": {
      "type": "string",
      "pattern": "^kfm:model-run-receipt:habitat:[a-f0-9]{24}$"
    },
    "domain": { "const": "HABITAT" },
    "run_kind": {
      "enum": [
        "SUITABILITY_INFERENCE",
        "QUALITY_SCORE",
        "PATCH_DERIVATION",
        "CORRIDOR_DERIVATION",
        "UNCERTAINTY_GENERATION",
        "LAND_COVER_TRANSFORM"
      ]
    },
    "run_state": { "enum": ["COMPLETED", "FAILED"] },
    "started_at": { "$ref": "#/$defs/aware_datetime" },
    "completed_at": { "$ref": "#/$defs/aware_datetime" },
    "recorded_at": { "$ref": "#/$defs/aware_datetime" },
    "model": { "$ref": "#/$defs/model" },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": { "$ref": "#/$defs/input" }
    },
    "inputs_digest": { "$ref": "#/$defs/sha256" },
    "config": { "$ref": "#/$defs/config" },
    "outputs": {
      "type": "array",
      "maxItems": 32,
      "items": { "$ref": "#/$defs/output" }
    },
    "failure_reason_codes": {
      "type": "array",
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CONFIGURATION_REJECTED",
          "INPUT_VALIDATION_FAILED",
          "MODEL_EXECUTION_FAILED",
          "OUTPUT_VALIDATION_FAILED",
          "RESOURCE_LIMIT_REACHED"
        ]
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/ref" }
    },
    "governance": { "$ref": "#/$defs/governance" },
    "limitations": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true,
      "items": {
        "enum": [
          "FIXTURE_ONLY",
          "MODEL_OUTPUT_NOT_OBSERVATION",
          "NO_EVIDENCE_OR_PROOF_AUTHORITY",
          "NO_POLICY_OR_REVIEW_AUTHORITY",
          "NO_RELEASE_OR_PUBLICATION_AUTHORITY",
          "RECEIPT_IS_PROCESS_MEMORY_ONLY"
        ]
      }
    },
    "spec_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "aware_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^kfm://[a-z0-9][a-z0-9._:/-]{2,191}$"
    },
    "nullable_ref": {
      "oneOf": [
        { "$ref": "#/$defs/ref" },
        { "type": "null" }
      ]
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_ref",
        "model_version",
        "model_card_ref",
        "code_digest",
        "environment_digest"
      ],
      "properties": {
        "model_ref": { "$ref": "#/$defs/ref" },
        "model_version": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]{0,63}$"
        },
        "model_card_ref": { "$ref": "#/$defs/ref" },
        "code_digest": { "$ref": "#/$defs/sha256" },
        "environment_digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_ref",
        "source_role",
        "source_descriptor_ref",
        "digest"
      ],
      "properties": {
        "input_ref": { "$ref": "#/$defs/ref" },
        "source_role": {
          "enum": [
            "OBSERVED",
            "REGULATORY",
            "ADMINISTRATIVE",
            "AGGREGATE",
            "MODELED",
            "SYNTHETIC"
          ]
        },
        "source_descriptor_ref": { "$ref": "#/$defs/ref" },
        "digest": { "$ref": "#/$defs/sha256" }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["config_ref", "config_digest", "random_seed"],
      "properties": {
        "config_ref": { "$ref": "#/$defs/ref" },
        "config_digest": { "$ref": "#/$defs/sha256" },
        "random_seed": {
          "oneOf": [
            { "type": "integer", "minimum": 0, "maximum": 2147483647 },
            { "type": "null" }
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "output_ref",
        "source_role",
        "digest",
        "sensitivity",
        "uncertainty_ref",
        "validation_report_ref"
      ],
      "properties": {
        "output_ref": { "$ref": "#/$defs/ref" },
        "source_role": { "const": "MODELED" },
        "digest": { "$ref": "#/$defs/sha256" },
        "sensitivity": { "enum": ["PUBLIC_SAFE", "RESTRICTED"] },
        "uncertainty_ref": { "$ref": "#/$defs/ref" },
        "validation_report_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "network_accessed",
        "policy_evaluated",
        "review_approved",
        "release_authorized",
        "publication_authorized",
        "authority"
      ],
      "properties": {
        "execution_mode": { "const": "FIXTURE_ONLY" },
        "network_accessed": { "const": false },
        "policy_evaluated": { "const": false },
        "review_approved": { "const": false },
        "release_authorized": { "const": false },
        "publication_authorized": { "const": false },
        "authority": { "const": "NONE" }
      }
    }
  }
}
