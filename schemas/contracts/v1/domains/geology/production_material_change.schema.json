{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/geology/production_material_change.schema.json",
  "title": "production_material_change",
  "description": "Deterministic, no-network comparison of version-pinned KGS production snapshot metadata.",
  "type": "object",
  "additionalProperties": false,
  "x-kfm": {
    "contract_doc": "contracts/domains/geology/production_material_change.md",
    "fixtures_root": "fixtures/contracts/v1/domains/geology/production_material_change/",
    "validator": "tools/validators/domains/geology/validate_production_material_change.py",
    "status": "PROPOSED"
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S+$"
    },
    "month": {
      "type": "string",
      "pattern": "^[0-9]{4}-(0[1-9]|1[0-2])$"
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "snapshot_ref",
        "retrieved_at",
        "coverage_end",
        "record_count",
        "manifest_digest",
        "footprint_digest",
        "rights_state",
        "source_role",
        "support_type",
        "evidence_refs"
      ],
      "properties": {
        "snapshot_ref": {
          "$ref": "#/$defs/ref"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "coverage_end": {
          "$ref": "#/$defs/month"
        },
        "record_count": {
          "type": "integer",
          "minimum": 0
        },
        "manifest_digest": {
          "$ref": "#/$defs/hash"
        },
        "footprint_digest": {
          "$ref": "#/$defs/hash"
        },
        "rights_state": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "UNKNOWN",
            "RESTRICTED"
          ]
        },
        "source_role": {
          "const": "PRODUCTION_RECORDS"
        },
        "support_type": {
          "const": "OFFICIAL_DERIVED_PRODUCTION_REFERENCE"
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    }
  },
  "required": [
    "assessment_id",
    "schema_version",
    "source_descriptor_ref",
    "dataset_role",
    "prior_snapshot",
    "current_snapshot",
    "assessment",
    "governance",
    "spec_hash"
  ],
  "properties": {
    "assessment_id": {
      "type": "string",
      "pattern": "^kgs-production-change:[a-f0-9]{24}$"
    },
    "schema_version": {
      "const": "v1"
    },
    "source_descriptor_ref": {
      "$ref": "#/$defs/ref"
    },
    "dataset_role": {
      "const": "PRODUCTION_RECORDS"
    },
    "prior_snapshot": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/snapshot"
        }
      ]
    },
    "current_snapshot": {
      "$ref": "#/$defs/snapshot"
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "material_change",
        "change_dimensions",
        "reason_codes",
        "evidence_refs"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "NO_CHANGE",
            "REVIEW",
            "HOLD",
            "ERROR"
          ]
        },
        "material_change": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "change_dimensions": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "COVERAGE_END",
              "FOOTPRINT_DIGEST",
              "MANIFEST_DIGEST",
              "RECORD_COUNT"
            ]
          }
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_roles_preserved",
        "production_not_geology",
        "watcher_non_publisher",
        "network_fetch",
        "raw_rows_compared",
        "policy_evaluated",
        "promotion_authorized",
        "release_authorized",
        "publication_authorized"
      ],
      "properties": {
        "source_roles_preserved": {
          "const": true
        },
        "production_not_geology": {
          "const": true
        },
        "watcher_non_publisher": {
          "const": true
        },
        "network_fetch": {
          "const": false
        },
        "raw_rows_compared": {
          "const": false
        },
        "policy_evaluated": {
          "const": false
        },
        "promotion_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        }
      }
    },
    "spec_hash": {
      "$ref": "#/$defs/hash"
    }
  }
}
