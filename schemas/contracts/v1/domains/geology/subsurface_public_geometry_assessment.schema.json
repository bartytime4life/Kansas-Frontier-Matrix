{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/geology/subsurface_public_geometry_assessment.schema.json",
  "title": "GeologySubsurfacePublicGeometryAssessmentCandidate",
  "description": "Fixture-only declaration assessment for synthetic BoreholeReference and WellLogReference public-geometry projections. Conformance grants no source, policy, review, evidence, lifecycle, release, publication, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "source_packet",
    "spec_hash",
    "assessment_id",
    "recorded_at",
    "subject",
    "internal_support",
    "public_projection",
    "governance",
    "anti_collapse_assertions",
    "authority_claims"
  ],
  "properties": {
    "object_type": {
      "const": "GeologySubsurfacePublicGeometryAssessmentCandidate"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "profile": {
      "const": "kfm.geology.subsurface-public-geometry-assessment.fixture.v1"
    },
    "source_packet": {
      "const": "KFM-GEOLOGY-PUBLIC-SAFE-GEOMETRY-2026-04-21"
    },
    "spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^kfm:geology:subsurface-public-geometry-assessment:[a-f0-9]{24}$"
    },
    "recorded_at": {
      "$ref": "#/$defs/date_time"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_family",
        "subject_ref_digest",
        "source_descriptor_refs",
        "source_roles",
        "source_activation_state",
        "rights_state",
        "sensitivity_state"
      ],
      "properties": {
        "object_family": {
          "enum": [
            "BoreholeReference",
            "WellLogReference"
          ]
        },
        "subject_ref_digest": {
          "$ref": "#/$defs/sha256"
        },
        "source_descriptor_refs": {
          "$ref": "#/$defs/ref_array"
        },
        "source_roles": {
          "$ref": "#/$defs/source_role_array"
        },
        "source_activation_state": {
          "const": "INACTIVE"
        },
        "rights_state": {
          "enum": [
            "DENIED",
            "UNRESOLVED",
            "VERIFIED"
          ]
        },
        "sensitivity_state": {
          "enum": [
            "CONTROLLED",
            "UNRESOLVED"
          ]
        }
      }
    },
    "internal_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry_state",
        "geometry_precision_class",
        "horizontal_crs_ref",
        "vertical_datum_ref",
        "depth_reference_ref",
        "restricted_access",
        "payload_state"
      ],
      "properties": {
        "geometry_state": {
          "const": "REFERENCED_NOT_EMBEDDED"
        },
        "geometry_precision_class": {
          "enum": [
            "EXACT",
            "SOURCE_PRECISION"
          ]
        },
        "horizontal_crs_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "vertical_datum_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "depth_reference_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "restricted_access": {
          "const": true
        },
        "payload_state": {
          "enum": [
            "METADATA_REFERENCE_ONLY",
            "PAYLOAD_PUBLIC",
            "REFERENCE_ONLY",
            "WITHHELD"
          ]
        }
      }
    },
    "public_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "precision_class",
        "public_geometry_ref_digest",
        "geometry_quality_scope_assessment_ref",
        "redaction_receipt_ref",
        "public_summary",
        "reason_codes"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "DENIED",
            "GENERALIZED",
            "NONE",
            "WITHHELD"
          ]
        },
        "precision_class": {
          "enum": [
            "COUNTY",
            "EXACT",
            "GENERALIZED_POINT",
            "GRID",
            "NONE",
            "SOURCE_PRECISION",
            "WITHHELD"
          ]
        },
        "public_geometry_ref_digest": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "geometry_quality_scope_assessment_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "redaction_receipt_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "public_summary": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 24,
              "maxLength": 400
            },
            {
              "type": "null"
            }
          ]
        },
        "reason_codes": {
          "$ref": "#/$defs/reason_array"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment_state",
        "policy_decision_ref",
        "review_record_ref",
        "validation_report_ref",
        "correction_ref",
        "rollback_ref",
        "execution_mode",
        "network_access",
        "restricted_input_opened",
        "lifecycle_mutated"
      ],
      "properties": {
        "assessment_state": {
          "enum": [
            "COMPLETE",
            "ERROR",
            "INCOMPLETE",
            "UNKNOWN"
          ]
        },
        "policy_decision_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "review_record_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "validation_report_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "correction_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "rollback_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "execution_mode": {
          "const": "FIXTURE_ONLY"
        },
        "network_access": {
          "const": false
        },
        "restricted_input_opened": {
          "const": false
        },
        "lifecycle_mutated": {
          "const": false
        }
      }
    },
    "anti_collapse_assertions": {
      "const": [
        "BOREHOLE_POINT_NOT_REGIONAL_CONTINUITY",
        "EXACT_INTERNAL_GEOMETRY_NOT_PUBLIC",
        "GENERALIZED_GEOMETRY_NOT_PUBLIC_APPROVAL",
        "SUCCESSFUL_ASSESSMENT_NOT_POLICY_REVIEW_RELEASE",
        "WELL_LOG_REFERENCE_NOT_PAYLOAD_RELEASE"
      ]
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_admission_authority",
        "policy_authority",
        "review_authority",
        "geometry_fitness_authority",
        "evidence_authority",
        "lifecycle_authority",
        "release_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "source_admission_authority": {
          "const": false
        },
        "policy_authority": {
          "const": false
        },
        "review_authority": {
          "const": false
        },
        "geometry_fitness_authority": {
          "const": false
        },
        "evidence_authority": {
          "const": false
        },
        "lifecycle_authority": {
          "const": false
        },
        "release_authority": {
          "const": false
        },
        "publication_authority": {
          "const": false
        },
        "public_use_authority": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "date_time": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "^(?:fixture|kfm):[^\\s]+$"
    },
    "nullable_ref": {
      "anyOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_sha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "source_role_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ADMINISTRATIVE_RECORD",
          "DIRECT_OBSERVATION",
          "REFERENCE_CATALOG",
          "SYNTHETIC_FIXTURE"
        ]
      }
    },
    "reason_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "PUBLIC_GEOMETRY_DENIED",
          "SENSITIVE_SUBSURFACE_GENERALIZED",
          "SENSITIVE_SUBSURFACE_WITHHELD",
          "SOURCE_RIGHTS_UNRESOLVED",
          "SENSITIVITY_UNRESOLVED",
          "ASSESSMENT_INCOMPLETE"
        ]
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "execution_mode": "FIXTURE_ONLY",
    "contract_doc": "contracts/domains/geology/subsurface_public_geometry_assessment.md",
    "source_packet": "KFM-GEOLOGY-PUBLIC-SAFE-GEOMETRY-2026-04-21"
  }
}
