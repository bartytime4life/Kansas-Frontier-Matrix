{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/geology/aem_survey_campaign.schema.json",
  "title": "GMD 3 AEM Announcement-Bound Campaign Candidate Fixture Profile",
  "description": "PROPOSED closed fixture profile for one 2026-05-11 KU News announcement about a Southwest Kansas GMD 3 airborne-electromagnetic campaign. It records the document's historical planned posture while keeping current campaign state unknown and binding no acquisition or downstream product evidence.",
  "type": "object",
  "x-kfm": {
    "status": "PROPOSED",
    "profile_id": "kfm-geology-gmd3-aem-campaign-candidate-fixture-v1",
    "contract_doc": "contracts/domains/geology/AemSurveyCampaign.md",
    "fixtures_root": "fixtures/domains/geology/aem_survey_campaign/",
    "source_descriptor_fixture": "fixtures/contracts/v1/source/source_descriptor/valid/valid_ku_news_gmd3_aem_announcement_2026_05_11.json",
    "governance_issue": "https://github.com/bartytime4life/Kansas-Frontier-Matrix/issues/1944",
    "activation_state": "disabled",
    "release_state": "not_released",
    "source_authority": "document-specific candidate-only fixture binding"
  },
  "properties": {
    "profile_id": {
      "const": "kfm-geology-gmd3-aem-campaign-candidate-fixture-v1"
    },
    "id": {
      "const": "kfm:geology:aem-campaign-candidate:ku-news-gmd3-announcement-2026-05-11"
    },
    "object_type": {
      "const": "AemSurveyCampaign"
    },
    "source_descriptor_ref": {
      "const": "src:ku-news-gmd3-aem-announcement-2026-05-11",
      "description": "Document-specific fixture identity. It does not identify a campaign data product or establish canonical registry placement."
    },
    "announcement_reported_state": {
      "const": "planned",
      "description": "Historical posture reported by the source document, not current campaign truth."
    },
    "announcement_published_on": {
      "const": "2026-05-11"
    },
    "current_campaign_state": {
      "const": "unknown"
    },
    "acquisition_evidence_state": {
      "const": "not_bound_to_profile",
      "description": "The fixture binds no acquisition evidence. This is not a claim that acquisition did or did not occur."
    },
    "survey_method": {
      "const": "airborne_electromagnetic"
    },
    "claim_scope": {
      "const": "campaign_announcement",
      "description": "Historical announcement context only; not observation, product, operational, or current-state authority."
    },
    "supporting_reference_candidates": {
      "const": [
        "fixture://reference-candidate/geology/gmd3-aem/ku-news-announcement-2026-05-11"
      ],
      "description": "One frozen syntactic fixture candidate awaiting governed EvidenceRef/EvidenceBundle resolution. Presence is not evidence closure."
    },
    "review_state": {
      "const": "needs_review"
    },
    "release_state": {
      "const": "not_released"
    },
    "limitations": {
      "const": [
        "fixture_profile_only",
        "announcement_context_only",
        "current_campaign_state_unknown",
        "no_acquisition_evidence_bound",
        "no_processing_or_inversion_product_evidence_bound",
        "not_a_groundwater_level_observation",
        "not_a_water_right_title_or_legal_record",
        "not_released"
      ]
    },
    "correction": {
      "type": "object",
      "description": "Optional fixture correction lineage. Prior references must use the same campaign-candidate namespace; self-supersession is denied semantically.",
      "properties": {
        "supersedes_ref": {
          "type": "string",
          "pattern": "^kfm:geology:aem-campaign-candidate:[a-z0-9][a-z0-9._:-]{2,127}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "correction_time": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
        }
      },
      "required": [
        "supersedes_ref",
        "reason"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "profile_id",
    "id",
    "object_type",
    "source_descriptor_ref",
    "announcement_reported_state",
    "announcement_published_on",
    "current_campaign_state",
    "acquisition_evidence_state",
    "survey_method",
    "claim_scope",
    "supporting_reference_candidates",
    "review_state",
    "release_state",
    "limitations"
  ],
  "additionalProperties": false
}
