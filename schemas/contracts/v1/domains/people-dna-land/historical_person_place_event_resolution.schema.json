{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/domains/people-dna-land/historical_person_place_event_resolution.schema.json",
  "title": "HistoricalPersonPlaceEventResolutionCandidate",
  "description": "Fixture-only candidate scorecard for a historical person-place-event relation. It is not identity adjudication, title proof, policy approval, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_id",
    "profile_id",
    "object_family",
    "schema_version",
    "resolution_id",
    "spec_hash",
    "candidate_scope",
    "person",
    "event",
    "place",
    "glo_anchor",
    "co_mentions",
    "negative_evidence",
    "evidence_refs",
    "score",
    "confidence",
    "disposition",
    "governance",
    "limitations"
  ],
  "properties": {
    "fixture_id": {
      "type": "string",
      "pattern": "^fixture://[a-z0-9][a-z0-9._~:/-]*$"
    },
    "profile_id": {
      "const": "kfm-people-dna-land-historical-person-place-event-resolution-v1"
    },
    "object_family": {
      "const": "HistoricalPersonPlaceEventResolutionCandidate"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "resolution_id": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "candidate_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "synthetic_fixture",
        "historical_only",
        "living_person",
        "public_release"
      ],
      "properties": {
        "synthetic_fixture": {
          "type": "boolean"
        },
        "historical_only": {
          "type": "boolean"
        },
        "living_person": {
          "type": "boolean"
        },
        "public_release": {
          "type": "boolean"
        }
      }
    },
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "person_ref",
        "primary_authority",
        "authority_matches"
      ],
      "properties": {
        "person_ref": {
          "type": "string",
          "pattern": "^fixture://person/[a-z0-9._~-]+$"
        },
        "primary_authority": {
          "type": "string",
          "enum": [
            "lcnaf",
            "viaf",
            "isni",
            "wikidata",
            "local"
          ]
        },
        "authority_matches": {
          "type": "array",
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "authority",
              "identifier",
              "exact_match",
              "source_refs",
              "rights_spdx",
              "scan_ids"
            ],
            "properties": {
              "authority": {
                "type": "string",
                "enum": [
                  "lcnaf",
                  "viaf",
                  "isni",
                  "wikidata",
                  "snac"
                ]
              },
              "identifier": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "exact_match": {
                "type": "boolean"
              },
              "source_refs": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^fixture://[a-z0-9][a-z0-9._~:/-]*$"
                }
              },
              "rights_spdx": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "scan_ids": {
                "type": "object",
                "minProperties": 1,
                "maxProperties": 8,
                "additionalProperties": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_type",
        "date_iso",
        "time_slice"
      ],
      "properties": {
        "event_type": {
          "type": "string",
          "enum": [
            "land_patent",
            "residence",
            "migration",
            "burial",
            "other_historical"
          ]
        },
        "date_iso": {
          "type": "string",
          "format": "date"
        },
        "time_slice": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}$"
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "county_fips",
        "county_label",
        "state_code",
        "time_slice",
        "legal_description"
      ],
      "properties": {
        "county_fips": {
          "const": "99999"
        },
        "county_label": {
          "const": "Synthetic County"
        },
        "state_code": {
          "const": "KS"
        },
        "time_slice": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{4}$"
        },
        "legal_description": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "township",
            "range",
            "section",
            "synthetic_sentinel"
          ],
          "properties": {
            "township": {
              "const": "T00S"
            },
            "range": {
              "const": "R00W"
            },
            "section": {
              "const": "00"
            },
            "synthetic_sentinel": {
              "const": true
            }
          }
        }
      }
    },
    "glo_anchor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present",
        "exact_place_block",
        "patent_ref",
        "source_ref",
        "rights_spdx",
        "scan_ids",
        "legal_description"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "exact_place_block": {
          "type": "boolean"
        },
        "patent_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^fixture://[a-z0-9][a-z0-9._~:/-]*$"
        },
        "source_ref": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^fixture://[a-z0-9][a-z0-9._~:/-]*$"
        },
        "rights_spdx": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 128
        },
        "scan_ids": {
          "type": "object",
          "maxProperties": 8,
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "legal_description": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "township",
            "range",
            "section"
          ],
          "properties": {
            "township": {
              "type": [
                "string",
                "null"
              ]
            },
            "range": {
              "type": [
                "string",
                "null"
              ]
            },
            "section": {
              "type": [
                "string",
                "null"
              ]
            }
          }
        }
      }
    },
    "co_mentions": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_family",
          "source_ref",
          "county_fips",
          "time_slice",
          "rights_spdx",
          "scan_ids"
        ],
        "properties": {
          "source_family": {
            "type": "string",
            "enum": [
              "newspaper",
              "county_history",
              "glo_patent",
              "census",
              "archive",
              "monograph"
            ]
          },
          "source_ref": {
            "type": "string",
            "pattern": "^fixture://[a-z0-9][a-z0-9._~:/-]*$"
          },
          "county_fips": {
            "const": "99999"
          },
          "time_slice": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{4}$"
          },
          "rights_spdx": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "scan_ids": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 8,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "negative_evidence": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "strength",
          "source_ref",
          "reason_code",
          "rights_spdx",
          "scan_ids"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "census_conflict",
              "conflicting_patent",
              "other"
            ]
          },
          "strength": {
            "type": "string",
            "enum": [
              "strong",
              "moderate",
              "weak"
            ]
          },
          "source_ref": {
            "type": "string",
            "pattern": "^fixture://[a-z0-9][a-z0-9._~:/-]*$"
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          },
          "rights_spdx": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "scan_ids": {
            "type": "object",
            "minProperties": 1,
            "maxProperties": 8,
            "additionalProperties": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^fixture://evidence/[a-z0-9._~/-]+$"
      }
    },
    "score": {
      "type": "integer",
      "minimum": -3,
      "maximum": 7
    },
    "confidence": {
      "type": "string",
      "enum": [
        "high",
        "medium",
        "low"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "candidate_review",
        "hold_for_review",
        "abstain"
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_state",
        "sensitivity_state",
        "review_state",
        "release_state",
        "promotion_eligible",
        "public_exposure"
      ],
      "properties": {
        "rights_state": {
          "const": "fixture_only"
        },
        "sensitivity_state": {
          "const": "historical_synthetic_fixture"
        },
        "review_state": {
          "type": "string",
          "enum": [
            "candidate_review",
            "hold_for_review",
            "abstain"
          ]
        },
        "release_state": {
          "const": "not_released"
        },
        "promotion_eligible": {
          "const": false
        },
        "public_exposure": {
          "const": false
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "synthetic_fixture_only",
          "no_identity_adjudication",
          "no_living_person_claim",
          "no_title_or_boundary_claim",
          "no_public_release",
          "no_raw_dna",
          "no_policy_approval"
        ]
      },
      "allOf": [
        {
          "contains": {
            "const": "synthetic_fixture_only"
          }
        },
        {
          "contains": {
            "const": "no_identity_adjudication"
          }
        },
        {
          "contains": {
            "const": "no_living_person_claim"
          }
        },
        {
          "contains": {
            "const": "no_public_release"
          }
        },
        {
          "contains": {
            "const": "no_raw_dna"
          }
        }
      ]
    }
  }
}
