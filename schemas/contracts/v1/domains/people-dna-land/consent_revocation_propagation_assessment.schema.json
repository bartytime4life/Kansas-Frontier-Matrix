{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/people-dna-land/consent_revocation_propagation_assessment.schema.json",
  "title": "ConsentRevocationPropagationAssessmentCandidate",
  "description": "Inactive fixture-only assessment of current consent scope and declared revocation propagation. Schema validity grants no consent, cleanup, policy, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "profile_spec_hash",
    "source_card",
    "assessment_ref",
    "evaluated_at",
    "consent_grant_ref",
    "consent_state",
    "scope_match",
    "dependencies",
    "declared_outcome",
    "reason_codes",
    "limitations",
    "authority_claims"
  ],
  "properties": {
    "object_type": {
      "const": "ConsentRevocationPropagationAssessmentCandidate"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "profile": {
      "const": "kfm.people-dna-land.consent-revocation-propagation.fixture.v1"
    },
    "profile_spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "source_card": {
      "const": "KFM-TRIAD-038"
    },
    "assessment_ref": {
      "type": "string",
      "pattern": "^kfm:consent-revocation-propagation:synthetic:[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "consent_grant_ref": {
      "type": "string",
      "pattern": "^kfm:consent-grant:synthetic:[a-z0-9][a-z0-9._-]{2,80}$"
    },
    "consent_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observed_at",
        "status_receipt_ref"
      ],
      "properties": {
        "status": {
          "enum": ["ACTIVE", "REVOKED", "EXPIRED", "UNKNOWN", "ERROR"]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "valid_until": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "status_receipt_ref": {
          "$ref": "#/$defs/synthetic_ref"
        },
        "revocation_receipt_ref": {
          "oneOf": [
            {"$ref": "#/$defs/synthetic_ref"},
            {"type": "null"}
          ]
        }
      }
    },
    "scope_match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "operation",
        "fields",
        "relationships",
        "audience",
        "retention",
        "time"
      ],
      "properties": {
        "purpose": {"type": "boolean"},
        "operation": {"type": "boolean"},
        "fields": {"type": "boolean"},
        "relationships": {"type": "boolean"},
        "audience": {"type": "boolean"},
        "retention": {"type": "boolean"},
        "time": {"type": "boolean"}
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "prefixItems": [
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"surface": {"const": "READ"}}}]},
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"surface": {"const": "ANSWER"}}}]},
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"surface": {"const": "EXPORT"}}}]},
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"surface": {"const": "TILE"}}}]},
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"surface": {"const": "GRAPH"}}}]},
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"surface": {"const": "INDEX"}}}]},
        {"allOf": [{"$ref": "#/$defs/dependency"}, {"properties": {"surface": {"const": "CACHE"}}}]}
      ],
      "items": false
    },
    "declared_outcome": {
      "enum": ["SATISFIED", "DENY", "ABSTAIN", "ERROR"]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,80}$"
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "CONSENT_DIMENSION_ONLY",
          "NO_CLEANUP_EXECUTION",
          "NO_EVIDENCE_OR_POLICY_AUTHORITY",
          "NO_REAL_PERSON_OR_DNA_DATA",
          "NO_RELEASE_OR_PUBLICATION_AUTHORITY"
        ]
      }
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "consent_issuance_authority",
        "identity_authority",
        "evidence_authority",
        "rights_authority",
        "sensitivity_authority",
        "policy_authority",
        "review_authority",
        "cleanup_execution_authority",
        "release_authority",
        "publication_authority"
      ],
      "properties": {
        "consent_issuance_authority": {"const": false},
        "identity_authority": {"const": false},
        "evidence_authority": {"const": false},
        "rights_authority": {"const": false},
        "sensitivity_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "cleanup_execution_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "synthetic_ref": {
      "type": "string",
      "pattern": "^kfm:[a-z0-9][a-z0-9._:-]{4,180}$"
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["surface", "state", "action"],
      "properties": {
        "surface": {
          "enum": ["READ", "ANSWER", "EXPORT", "TILE", "GRAPH", "INDEX", "CACHE"]
        },
        "state": {
          "enum": ["READY", "BLOCKED", "INVALIDATED", "PURGED", "PENDING"]
        },
        "action": {
          "enum": ["NONE", "DENY_NEXT_USE", "INVALIDATE", "PURGE", "REVIEW"]
        },
        "action_receipt_ref": {
          "oneOf": [
            {"$ref": "#/$defs/synthetic_ref"},
            {"type": "null"}
          ]
        }
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "authority": "NONE",
    "network": false,
    "real_person_data": false,
    "cleanup_execution": false,
    "contract_doc": "contracts/domains/people-dna-land/consent_revocation_propagation_assessment.md",
    "fixture_manifest": "fixtures/domains/people-dna-land/consent_revocation_propagation/cases.json",
    "validator": "tools/validators/domains/people-dna-land/validate_consent_revocation_propagation_assessment.py",
    "tests": "tests/domains/people-dna-land/consent/revocation/test_consent_revocation_propagation_assessment.py"
  }
}
