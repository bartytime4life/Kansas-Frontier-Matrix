{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfm://schemas/contracts/v1/domains/soil/mukey_properties.schema.json",
  "title": "MukeyProperties fixture-only aggregate candidate",
  "description": "Closed machine shape for a deterministic, MUKEY-scoped SSURGO/SDA aggregate candidate. It preserves component and horizon lineage and grants no source, evidence, policy, release, publication, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "x-kfm": {
    "contract_doc": "contracts/domains/soil/mukey_properties.md",
    "fixtures_root": "fixtures/domains/soil/mukey_properties/",
    "validator": "tools/validators/domains/soil/mukey_properties/validate_mukey_properties.py",
    "status": "PROPOSED_INACTIVE",
    "profile": "kfm.soil.mukey-properties.v1",
    "authority": "fixture-only-derived-candidate"
  },
  "required": [
    "profile",
    "record_id",
    "mukey",
    "source",
    "aggregation",
    "components",
    "derived",
    "hydric",
    "evidence_refs",
    "governance",
    "public_use_requested",
    "content_spec_hash"
  ],
  "properties": {
    "profile": {
      "const": "kfm.soil.mukey-properties.v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^soil-mukey-properties:[0-9]{1,30}$"
    },
    "mukey": {
      "$ref": "#/$defs/numeric_id"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "aggregation": {
      "$ref": "#/$defs/aggregation"
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/component"
      }
    },
    "derived": {
      "$ref": "#/$defs/derived"
    },
    "hydric": {
      "$ref": "#/$defs/hydric"
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/safe_ref"
      }
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "public_use_requested": {
      "const": false
    },
    "content_spec_hash": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "numeric_id": {
      "type": "string",
      "pattern": "^[0-9]{1,30}$"
    },
    "safe_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9:._/-]{0,255}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "top_cm",
        "bottom_cm"
      ],
      "properties": {
        "top_cm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "bottom_cm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_ref",
        "source_family",
        "source_role",
        "support_type",
        "spatial_support",
        "source_version",
        "query_hash",
        "retrieved_at"
      ],
      "properties": {
        "source_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "source_family": {
          "enum": [
            "nrcs_sda",
            "nrcs_ssurgo"
          ]
        },
        "source_role": {
          "enum": [
            "official_query",
            "official_static_survey"
          ]
        },
        "support_type": {
          "const": "authoritative_static_soil"
        },
        "spatial_support": {
          "const": "map_unit_polygon"
        },
        "source_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "query_hash": {
          "$ref": "#/$defs/digest"
        },
        "retrieved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "aggregation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "root_zone_cm",
        "surface_window_cm",
        "component_percent_min_total",
        "component_percent_max_total",
        "comparison_tolerance"
      ],
      "properties": {
        "method": {
          "const": "depth_then_component_weighted_arithmetic_v1"
        },
        "root_zone_cm": {
          "allOf": [
            {
              "$ref": "#/$defs/interval"
            },
            {
              "properties": {
                "top_cm": {
                  "const": 0
                },
                "bottom_cm": {
                  "const": 100
                }
              }
            }
          ]
        },
        "surface_window_cm": {
          "allOf": [
            {
              "$ref": "#/$defs/interval"
            },
            {
              "properties": {
                "top_cm": {
                  "const": 0
                },
                "bottom_cm": {
                  "const": 5
                }
              }
            }
          ]
        },
        "component_percent_min_total": {
          "const": 99.0
        },
        "component_percent_max_total": {
          "const": 101.0
        },
        "comparison_tolerance": {
          "const": 1e-06
        }
      }
    },
    "horizon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chkey",
        "top_cm",
        "bottom_cm",
        "sand_total_pct",
        "clay_total_pct",
        "organic_matter_pct",
        "ksat_um_s",
        "available_water_capacity_fraction"
      ],
      "properties": {
        "chkey": {
          "$ref": "#/$defs/numeric_id"
        },
        "top_cm": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5000
        },
        "bottom_cm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "sand_total_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "clay_total_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "organic_matter_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "ksat_um_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "available_water_capacity_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cokey",
        "component_name",
        "component_pct",
        "horizons"
      ],
      "properties": {
        "cokey": {
          "$ref": "#/$defs/numeric_id"
        },
        "component_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "component_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "horizons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/horizon"
          }
        }
      }
    },
    "derived": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "root_zone_clay_pct",
        "root_zone_ksat_um_s",
        "root_zone_available_water_capacity_fraction",
        "surface_organic_matter_pct",
        "hydrologic_group",
        "hydrologic_group_basis",
        "component_pct_total",
        "metric_completeness"
      ],
      "properties": {
        "root_zone_clay_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "root_zone_ksat_um_s": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "root_zone_available_water_capacity_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "surface_organic_matter_pct": {
          "type": "number",
          "minimum": 0,
          "maximum": 20
        },
        "hydrologic_group": {
          "enum": [
            "A",
            "A/D",
            "B",
            "B/D",
            "C",
            "C/D",
            "D"
          ]
        },
        "hydrologic_group_basis": {
          "const": "source_muaggatt"
        },
        "component_pct_total": {
          "type": "number",
          "minimum": 0,
          "maximum": 101
        },
        "metric_completeness": {
          "const": "COMPLETE"
        }
      }
    },
    "hydric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "flag",
        "status",
        "criteria_ref",
        "source_field"
      ],
      "properties": {
        "flag": {
          "enum": [
            "YES",
            "NO",
            "PARTIAL",
            "UNKNOWN"
          ]
        },
        "status": {
          "enum": [
            "CURRENT",
            "NEEDS_VERIFICATION"
          ]
        },
        "criteria_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/safe_ref"
            }
          ]
        },
        "source_field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority",
        "source_activated",
        "evidence_resolution_claimed",
        "policy_evaluated",
        "promotion_authorized",
        "release_authorized",
        "publication_authorized",
        "release_ref"
      ],
      "properties": {
        "authority": {
          "const": "NONE"
        },
        "source_activated": {
          "const": false
        },
        "evidence_resolution_claimed": {
          "const": false
        },
        "policy_evaluated": {
          "const": false
        },
        "promotion_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        },
        "release_ref": {
          "type": "null"
        }
      }
    }
  }
}
