{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/soil/domain_feature_identity.schema.json",
  "title": "Soil DomainFeatureIdentity candidate profile",
  "description": "Closed fixture-first identity candidate preserving source-native identity, object role, support type, temporal scope, and evidence binding without creating canonical or release authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile","status","id","version","spec_hash","domain","object_family","object_role","support_type","source_ref","source_role","source_native_id","source_native_key_family","temporal_scope","evidence_refs","match_status","limitations","public_use_allowed","effects"],
  "properties": {
    "profile": {"const": "kfm.domains.soil.domain-feature-identity.v1"},
    "status": {"const": "PROPOSED_INACTIVE"},
    "id": {"type": "string", "pattern": "^soil-identity:[0-9a-f]{24}$"},
    "version": {"const": "1.0.0"},
    "spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "domain": {"const": "soil"},
    "object_family": {"enum": ["SoilMapUnit","SoilComponent","Horizon","ComponentHorizonJoin","SoilProperty","HydrologicSoilGroup","SoilMoistureObservation","Pedon","SoilProfileView","ErosionRisk","SuitabilityRating","SoilTimeCaveat"]},
    "object_role": {"enum": ["SURVEY_FEATURE","COMPONENT","HORIZON","LINEAGE_JOIN","PROPERTY","CLASSIFICATION","OBSERVATION","PROFILE","INTERPRETATION","TEMPORAL_CAVEAT"]},
    "support_type": {"enum": ["authoritative_static_soil","gridded_derivative_soil","station_soil_moisture","reference_station_soil_climate","satellite_soil_moisture_grid","profile_soil_evidence","soil_interpretation","governed_change_evidence"]},
    "source_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_role": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_:-]{1,127}$"},
    "source_native_id": {"type": "string", "minLength": 1, "maxLength": 256},
    "source_native_key_family": {"type": "string", "minLength": 1, "maxLength": 64},
    "temporal_scope": {"type": "object", "additionalProperties": false, "required": ["kind","value"], "properties": {"kind": {"enum": ["SOURCE_VINTAGE","OBSERVED_TIME","VALID_TIME","RETRIEVED_TIME","NOT_APPLICABLE"]}, "value": {"type": ["string","null"], "maxLength": 64}}},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "match_status": {"enum": ["CANDIDATE","CONFIRMED","CONFLICTED","SUPERSEDED","DENIED","UNKNOWN"]},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "public_use_allowed": {"const": false},
    "effects": {"type": "object", "additionalProperties": false, "required": ["canonical_identity_created","evidence_resolved","policy_evaluated","review_approved","released","published"], "properties": {"canonical_identity_created":{"const":false},"evidence_resolved":{"const":false},"policy_evaluated":{"const":false},"review_approved":{"const":false},"released":{"const":false},"published":{"const":false}}}
  },
  "x-kfm": {"status":"PROPOSED_INACTIVE","contract_doc":"contracts/domains/soil/domain_feature_identity.md","fixtures_root":"fixtures/domains/soil/domain_feature_identity/","validator":"tools/validators/domains/soil/validate_domain_feature_identity.py","authority":"identity_candidate_only","public_release_authority":false}
}
