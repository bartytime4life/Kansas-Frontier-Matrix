{
  "$defs": {
    "aware_datetime": {
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$",
      "type": "string"
    },
    "ref": {
      "maxLength": 640,
      "minLength": 1,
      "pattern": "\\S",
      "type": "string"
    },
    "ref_array": {
      "items": {
        "$ref": "#/$defs/ref"
      },
      "type": "array",
      "uniqueItems": true
    },
    "sha256": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "$id": "https://schemas.kfm.local/contracts/v1/domains/soil/promotion_materiality_input.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "assessment_id": {
      "pattern": "^material-change:soil:[a-z0-9][a-z0-9_.:-]{3,180}$",
      "type": "string"
    },
    "baseline": {
      "oneOf": [
        {
          "additionalProperties": false,
          "properties": {
            "content_spec_hash": {
              "$ref": "#/$defs/sha256"
            },
            "policy_hash": {
              "$ref": "#/$defs/sha256"
            },
            "retrieved_at": {
              "$ref": "#/$defs/aware_datetime"
            },
            "schema_hash": {
              "$ref": "#/$defs/sha256"
            },
            "source_descriptor_hash": {
              "$ref": "#/$defs/sha256"
            },
            "validator_hash": {
              "$ref": "#/$defs/sha256"
            }
          },
          "required": [
            "content_spec_hash",
            "source_descriptor_hash",
            "schema_hash",
            "validator_hash",
            "policy_hash",
            "retrieved_at"
          ],
          "type": "object"
        },
        {
          "type": "null"
        }
      ]
    },
    "baseline_ref": {
      "$ref": "#/$defs/ref"
    },
    "candidate": {
      "additionalProperties": false,
      "properties": {
        "content_spec_hash": {
          "$ref": "#/$defs/sha256"
        },
        "policy_hash": {
          "$ref": "#/$defs/sha256"
        },
        "retrieved_at": {
          "$ref": "#/$defs/aware_datetime"
        },
        "schema_hash": {
          "$ref": "#/$defs/sha256"
        },
        "source_descriptor_hash": {
          "$ref": "#/$defs/sha256"
        },
        "validator_hash": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "content_spec_hash",
        "source_descriptor_hash",
        "schema_hash",
        "validator_hash",
        "policy_hash",
        "retrieved_at"
      ],
      "type": "object"
    },
    "candidate_ref": {
      "$ref": "#/$defs/ref"
    },
    "evidence": {
      "additionalProperties": false,
      "properties": {
        "criterion_evidence_refs": {
          "$ref": "#/$defs/ref_array"
        },
        "diff_report_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "source_refs": {
          "$ref": "#/$defs/ref_array"
        },
        "validation_report_refs": {
          "$ref": "#/$defs/ref_array"
        }
      },
      "required": [
        "diff_report_ref",
        "validation_report_refs",
        "source_refs",
        "criterion_evidence_refs"
      ],
      "type": "object"
    },
    "evidence_complete": {
      "type": "boolean"
    },
    "subject_ref": {
      "$ref": "#/$defs/ref"
    },
    "timing": {
      "additionalProperties": false,
      "properties": {
        "assessed_at": {
          "$ref": "#/$defs/aware_datetime"
        },
        "baseline_as_of": {
          "oneOf": [
            {
              "$ref": "#/$defs/aware_datetime"
            },
            {
              "type": "null"
            }
          ]
        },
        "candidate_as_of": {
          "$ref": "#/$defs/aware_datetime"
        }
      },
      "required": [
        "baseline_as_of",
        "candidate_as_of",
        "assessed_at"
      ],
      "type": "object"
    }
  },
  "required": [
    "assessment_id",
    "subject_ref",
    "baseline_ref",
    "candidate_ref",
    "baseline",
    "candidate",
    "evidence_complete",
    "evidence",
    "timing"
  ],
  "title": "SoilPromotionMaterialityInput",
  "type": "object",
  "x-kfm": {
    "authority": "input_shape_only",
    "contract_doc": "contracts/domains/soil/promotion_materiality_profile.md",
    "status": "PROPOSED_INACTIVE",
    "validator": "tools/validators/domains/soil/validate_promotion_materiality.py"
  }
}
