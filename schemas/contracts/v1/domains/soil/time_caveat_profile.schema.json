{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/soil/time_caveat_profile.schema.json",
  "title": "SoilTimeCaveatProfile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile_id",
    "profile_version",
    "status",
    "spec_hash",
    "support_rules",
    "governance"
  ],
  "properties": {
    "object_type": {
      "const": "SoilTimeCaveatProfile"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "profile_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{7,63}$"
    },
    "profile_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "status": {
      "const": "PROPOSED_INACTIVE"
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "support_rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "support_type",
          "source_roles",
          "claim_kinds",
          "forbidden_claim_kinds",
          "required_time_axes",
          "maximum_age_seconds"
        ],
        "properties": {
          "support_type": {
            "type": "string",
            "enum": [
              "authoritative_static_soil",
              "gridded_derivative_soil",
              "station_soil_moisture",
              "reference_station_soil_climate",
              "satellite_soil_moisture_grid",
              "profile_soil_evidence",
              "soil_interpretation"
            ]
          },
          "source_roles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "claim_kinds": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "forbidden_claim_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "required_time_axes": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "source_published_at",
                "observed_at",
                "valid_from",
                "valid_to",
                "retrieved_at",
                "evaluated_at",
                "source_timezone"
              ]
            },
            "uniqueItems": true
          },
          "maximum_age_seconds": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_activated",
        "policy_evaluated",
        "promotion_authorized",
        "release_authorized",
        "public_use_allowed",
        "release_ref"
      ],
      "properties": {
        "source_activated": {
          "const": false
        },
        "policy_evaluated": {
          "const": false
        },
        "promotion_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "public_use_allowed": {
          "const": false
        },
        "release_ref": {
          "type": "null"
        }
      }
    }
  }
}
