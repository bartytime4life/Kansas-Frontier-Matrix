{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/domains/soil/domain_layer_descriptor.schema.json",
  "title": "Soil DomainLayerDescriptor candidate profile",
  "description": "Closed fixture-first candidate profile for Soil layer descriptors. A valid object is not a release, publication, or public-use authorization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "status",
    "id",
    "version",
    "spec_hash",
    "domain",
    "layer_id",
    "layer_family",
    "object_family",
    "support_type",
    "source_refs",
    "evidence_refs",
    "lifecycle_stage",
    "release_state",
    "release_ref",
    "rollback_ref",
    "temporal_scope",
    "scale_or_resolution",
    "limitations",
    "public_use_allowed",
    "effects"
  ],
  "properties": {
    "profile": {"const": "kfm.domains.soil.domain-layer-descriptor.v1"},
    "status": {"const": "PROPOSED_INACTIVE"},
    "id": {"type": "string", "pattern": "^soil-layer:[0-9a-f]{24}$"},
    "version": {"const": "1.0.0"},
    "spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "domain": {"const": "soil"},
    "layer_id": {"type": "string", "minLength": 1, "maxLength": 160},
    "layer_family": {"enum": ["STATIC_SURVEY", "GRIDDED_DERIVATIVE", "STATION_OBSERVATION", "REFERENCE_STATION", "SATELLITE_GRID", "PROFILE_EVIDENCE", "INTERPRETATION", "CHANGE_EVIDENCE"]},
    "object_family": {"enum": ["SoilMapUnit", "SoilComponent", "Horizon", "ComponentHorizonJoin", "SoilProperty", "HydrologicSoilGroup", "SoilMoistureObservation", "Pedon", "SoilProfileView", "ErosionRisk", "SuitabilityRating", "SoilTimeCaveat"]},
    "support_type": {"enum": ["authoritative_static_soil", "gridded_derivative_soil", "station_soil_moisture", "reference_station_soil_climate", "satellite_soil_moisture_grid", "profile_soil_evidence", "soil_interpretation", "governed_change_evidence"]},
    "source_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "lifecycle_stage": {"enum": ["PROCESSED", "CATALOG"]},
    "release_state": {"const": "UNRELEASED"},
    "release_ref": {"type": "null"},
    "rollback_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "temporal_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": {"enum": ["SOURCE_VINTAGE", "OBSERVED_TIME", "VALID_TIME", "RETRIEVED_TIME", "NOT_APPLICABLE"]},
        "value": {"type": ["string", "null"], "maxLength": 64}
      }
    },
    "scale_or_resolution": {"type": "string", "minLength": 1, "maxLength": 160},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 240}},
    "public_use_allowed": {"const": false},
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["catalog_written", "promoted", "released", "deployed", "published"],
      "properties": {
        "catalog_written": {"const": false},
        "promoted": {"const": false},
        "released": {"const": false},
        "deployed": {"const": false},
        "published": {"const": false}
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "contract_doc": "contracts/domains/soil/domain_layer_descriptor.md",
    "fixtures_root": "fixtures/domains/soil/domain_layer_descriptor/",
    "validator": "tools/validators/domains/soil/validate_domain_layer_descriptor.py",
    "authority": "fixture_candidate_only",
    "public_release_authority": false
  }
}
