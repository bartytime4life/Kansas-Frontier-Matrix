{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/schemas/contracts/v1/domains/soil/daily_soil_observation.schema.json",
  "title": "Daily Soil Observation",
  "description": "Closed v1 projection of one NOAA USCRN daily01 soil value (volumetric soil moisture or soil temperature at one sensor depth) for the Kansas reference-station pilot. observation_date is the station's local-standard-time day, not a UTC instant. source_token is NOAA's daily value verbatim. A missing or out-of-range value has value null and a withheld reason; it never counts as zero. Source authority and release eligibility require separate evidence, policy and review checks. See contracts/domains/soil/daily_soil_observation.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile", "id", "station_id", "variable", "depth_cm", "observation_date", "source_token", "value",
    "unit", "withheld", "datalogger_version", "source_role", "page_digest", "retrieved_at", "evidence_ref",
    "record_digest"
  ],
  "properties": {
    "profile": {"const": "kfm.daily-soil-observation/v1"},
    "id": {"type": "string", "pattern": "^kfm:soil:[a-f0-9]{64}$"},
    "station_id": {"enum": ["53974", "03067"]},
    "variable": {"enum": ["SOIL_MOISTURE", "SOIL_TEMP"]},
    "depth_cm": {"enum": [5, 10, 20, 50, 100]},
    "observation_date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
    "source_token": {"type": "string", "pattern": "^-?[0-9]{1,4}\\.[0-9]{1,3}$"},
    "value": {"type": ["number", "null"]},
    "unit": {"enum": ["m3/m3", "degC"]},
    "withheld": {"enum": [null, "MISSING", "OUT_OF_RANGE"]},
    "datalogger_version": {"type": "string", "pattern": "^[0-9A-Za-z.\\-]{1,16}$"},
    "source_role": {"const": "reference_station"},
    "page_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "retrieved_at": {"type": "string", "format": "date-time"},
    "evidence_ref": {"type": "string", "pattern": "^kfm:evidence:soil:[a-f0-9]{64}$"},
    "record_digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
