{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfm://schemas/contracts/v1/domains/soil/soil_component.schema.json",
  "title": "SoilComponent candidate profile",
  "description": "Closed fixture-first named component within a SoilMapUnit. Component percent is source/support context, not a current field measurement or release authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile","status","id","version","spec_hash","domain","support_type","source_ref","source_role","source_native_id","source_native_key_family","map_unit_ref","map_unit_native_id","component_name","component_kind","component_percent","percent_method_ref","horizon_refs","component_horizon_join_refs","temporal_scope","evidence_refs","lifecycle_stage","release_state","release_ref","rollback_ref","limitations","public_use_allowed","effects"],
  "properties": {
    "profile": {"const": "kfm.domains.soil.soil-component.v1"},
    "status": {"const": "PROPOSED_INACTIVE"},
    "id": {"type": "string", "pattern": "^soil-component:[0-9a-f]{24}$"},
    "version": {"const": "1.0.0"},
    "spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "domain": {"const": "soil"},
    "support_type": {"enum": ["authoritative_static_soil","gridded_derivative_soil"]},
    "source_ref": {"type": "string", "minLength": 1},
    "source_role": {"type": "string", "minLength": 1},
    "source_native_id": {"type": "string", "minLength": 1},
    "source_native_key_family": {"const": "COKEY"},
    "map_unit_ref": {"type": "string", "minLength": 1},
    "map_unit_native_id": {"type": "string", "minLength": 1},
    "component_name": {"type": "string", "minLength": 1},
    "component_kind": {"type": "string", "minLength": 1},
    "component_percent": {"type": "number", "minimum": 0, "maximum": 100},
    "percent_method_ref": {"type": "string", "minLength": 1},
    "horizon_refs": {"type": "array", "items": {"type":"string","minLength":1}, "uniqueItems": true},
    "component_horizon_join_refs": {"type": "array", "items": {"type":"string","minLength":1}, "uniqueItems": true},
    "temporal_scope": {"type":"object","additionalProperties":false,"required":["kind","value"],"properties":{"kind":{"enum":["SOURCE_VINTAGE","VALID_INTERVAL","DERIVATIVE_VINTAGE"]},"value":{"type":"string","minLength":1}}},
    "evidence_refs": {"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","minLength":1}},
    "lifecycle_stage": {"enum":["WORK","QUARANTINE","PROCESSED","CATALOG"]},
    "release_state": {"const":"UNRELEASED"},
    "release_ref": {"type":"null"},
    "rollback_ref": {"type":"string","minLength":1},
    "limitations": {"type":"array","minItems":1,"items":{"type":"string","minLength":1}},
    "public_use_allowed": {"const":false},
    "effects": {"type":"object","additionalProperties":false,"required":["component_persisted","evidence_resolved","policy_evaluated","review_approved","released","published"],"properties":{"component_persisted":{"const":false},"evidence_resolved":{"const":false},"policy_evaluated":{"const":false},"review_approved":{"const":false},"released":{"const":false},"published":{"const":false}}}
  },
  "x-kfm": {"status":"PROPOSED_INACTIVE","contract_doc":"contracts/domains/soil/soil_component.md","authority":"component_candidate_only"}
}
