{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/common/geography_version.schema.json",
  "title": "GeographyVersion",
  "description": "Fixture-only declaration of one version-bounded geography vocabulary and referenced boundary artifact.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "geography_version_id",
    "geography",
    "version",
    "representation",
    "lineage",
    "support",
    "disclosure",
    "governance",
    "spec_hash"
  ],
  "properties": {
    "object_type": { "const": "GeographyVersion" },
    "schema_version": { "const": "1.0.0" },
    "profile": { "const": "kfm.geography-version.fixture.v1" },
    "geography_version_id": {
      "type": "string",
      "pattern": "^kfm:geography-version:[a-f0-9]{24}$"
    },
    "geography": { "$ref": "#/$defs/geography" },
    "version": { "$ref": "#/$defs/version" },
    "representation": { "$ref": "#/$defs/representation" },
    "lineage": { "$ref": "#/$defs/lineage" },
    "support": { "$ref": "#/$defs/support" },
    "disclosure": { "$ref": "#/$defs/disclosure" },
    "governance": { "$ref": "#/$defs/governance" },
    "spec_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^kfm://[a-z0-9][a-z0-9._:/-]{2,191}$"
    },
    "digest_ref": {
      "type": "string",
      "pattern": "^kfm://[a-z0-9][a-z0-9._:/-]{2,191}@sha256:[a-f0-9]{64}$"
    },
    "nullable_digest_ref": {
      "oneOf": [{ "$ref": "#/$defs/digest_ref" }, { "type": "null" }]
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "nullable_date": {
      "oneOf": [{ "$ref": "#/$defs/date" }, { "type": "null" }]
    },
    "aware_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geography_key",
        "label",
        "geography_kind",
        "unit_level",
        "jurisdiction_code",
        "authority_role",
        "source_descriptor_ref",
        "definition_ref"
      ],
      "properties": {
        "geography_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "label": { "type": "string", "minLength": 1, "maxLength": 160 },
        "geography_kind": {
          "enum": [
            "ADMINISTRATIVE_AREA",
            "CENSUS_AREA",
            "ECOLOGICAL_AREA",
            "GRID",
            "HYDROLOGIC_AREA",
            "SYNTHETIC_AREA"
          ]
        },
        "unit_level": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,47}$"
        },
        "jurisdiction_code": {
          "type": "string",
          "pattern": "^[A-Z0-9][A-Z0-9.-]{1,31}$"
        },
        "authority_role": {
          "enum": ["ADMINISTRATIVE", "SCIENTIFIC", "STATISTICAL", "SYNTHETIC"]
        },
        "source_descriptor_ref": { "$ref": "#/$defs/digest_ref" },
        "definition_ref": { "$ref": "#/$defs/digest_ref" }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "version_key",
        "revision",
        "valid_from",
        "valid_to",
        "published_at",
        "retrieved_at",
        "identity_scope"
      ],
      "properties": {
        "version_key": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$"
        },
        "revision": { "type": "integer", "minimum": 1, "maximum": 2147483647 },
        "valid_from": { "$ref": "#/$defs/date" },
        "valid_to": { "$ref": "#/$defs/nullable_date" },
        "published_at": { "$ref": "#/$defs/aware_datetime" },
        "retrieved_at": { "$ref": "#/$defs/aware_datetime" },
        "identity_scope": { "const": "VERSION_LOCAL" }
      }
    },
    "representation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geometry_role",
        "boundary_artifact_ref",
        "crs_ref",
        "feature_id_scheme_ref",
        "transform_receipt_ref"
      ],
      "properties": {
        "geometry_role": {
          "enum": [
            "AUTHORITATIVE_SOURCE_GEOMETRY",
            "GENERALIZED_DERIVATIVE",
            "SYNTHETIC_FIXTURE"
          ]
        },
        "boundary_artifact_ref": { "$ref": "#/$defs/digest_ref" },
        "crs_ref": { "$ref": "#/$defs/digest_ref" },
        "feature_id_scheme_ref": { "$ref": "#/$defs/digest_ref" },
        "transform_receipt_ref": { "$ref": "#/$defs/nullable_digest_ref" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "predecessor_ref",
        "crosswalk_state",
        "crosswalk_ref",
        "different_version_join_policy"
      ],
      "properties": {
        "predecessor_ref": { "$ref": "#/$defs/nullable_digest_ref" },
        "crosswalk_state": {
          "enum": ["NOT_APPLICABLE", "REFERENCED_NOT_RESOLVED", "UNRESOLVED"]
        },
        "crosswalk_ref": { "$ref": "#/$defs/nullable_digest_ref" },
        "different_version_join_policy": { "const": "CROSSWALK_REQUIRED" }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_state", "evidence_refs", "rights_state", "sensitivity_state"],
      "properties": {
        "evidence_state": { "const": "REFERENCED_NOT_RESOLVED" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest_ref" }
        },
        "rights_state": { "const": "REFERENCED_NOT_EVALUATED" },
        "sensitivity_state": { "const": "REFERENCED_NOT_EVALUATED" }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretation_limits"],
      "properties": {
        "interpretation_limits": {
          "type": "array",
          "minItems": 5,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "NO_CROSS_VERSION_IDENTITY_INFERENCE",
              "NO_CROSSWALK_INFERENCE",
              "NO_PUBLICATION_AUTHORITY",
              "NOT_CURRENTNESS_PROOF",
              "SOURCE_ROLE_PRESERVED",
              "VERSION_BOUND"
            ]
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "network_attempted",
        "geometry_resolved",
        "crosswalk_resolved",
        "evidence_resolved",
        "rights_evaluated",
        "sensitivity_evaluated",
        "policy_evaluated",
        "review_approved",
        "promotion_authorized",
        "release_authorized",
        "public_use_allowed",
        "publication_authorized"
      ],
      "properties": {
        "execution_mode": { "const": "FIXTURE_ONLY" },
        "network_attempted": { "const": false },
        "geometry_resolved": { "const": false },
        "crosswalk_resolved": { "const": false },
        "evidence_resolved": { "const": false },
        "rights_evaluated": { "const": false },
        "sensitivity_evaluated": { "const": false },
        "policy_evaluated": { "const": false },
        "review_approved": { "const": false },
        "promotion_authorized": { "const": false },
        "release_authorized": { "const": false },
        "public_use_allowed": { "const": false },
        "publication_authorized": { "const": false }
      }
    }
  }
}
