{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/common/condition_relation.schema.json",
  "title": "condition_relation",
  "description": "Typed, scale-aware contextual relation that preserves source roles and denies causal inference.",
  "type": "object",
  "additionalProperties": false,
  "x-kfm": {
    "contract_doc": "contracts/common/condition_relation.md",
    "fixtures_root": "fixtures/contracts/v1/common/condition_relation/",
    "validator": "tools/validators/validate_condition_relation.py",
    "policy": "policy/common/",
    "status": "PROPOSED"
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S+$"
    },
    "spatialScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_ref",
        "scale",
        "geometry_digest"
      ],
      "properties": {
        "scope_ref": {
          "$ref": "#/$defs/ref"
        },
        "scale": {
          "type": "string",
          "enum": [
            "POINT",
            "GRID_CELL",
            "HUC12",
            "COUNTY",
            "REGIONAL",
            "STATEWIDE"
          ]
        },
        "geometry_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/hash"
            }
          ]
        }
      }
    },
    "temporalScope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end",
        "semantics"
      ],
      "properties": {
        "start": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "end": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "semantics": {
          "const": "HALF_OPEN"
        }
      }
    },
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_ref",
        "source_role",
        "support_type",
        "evidence_refs",
        "spatial_scope",
        "temporal_scope"
      ],
      "properties": {
        "subject_ref": {
          "$ref": "#/$defs/ref"
        },
        "source_role": {
          "type": "string",
          "enum": [
            "OBSERVATION",
            "CLASSIFICATION",
            "FORECAST",
            "ADVISORY",
            "MODEL",
            "CONTEXT"
          ]
        },
        "support_type": {
          "type": "string",
          "enum": [
            "DIRECT_MEASUREMENT",
            "DERIVED_CLASSIFICATION",
            "PREDICTION",
            "REGULATORY_STATUS",
            "MODELED_ESTIMATE",
            "CONTEXT_ONLY"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "spatial_scope": {
          "$ref": "#/$defs/spatialScope"
        },
        "temporal_scope": {
          "$ref": "#/$defs/temporalScope"
        }
      }
    }
  },
  "required": [
    "relation_id",
    "schema_version",
    "relation_kind",
    "requested_claim_type",
    "left",
    "right",
    "assessment",
    "governance",
    "spec_hash"
  ],
  "properties": {
    "relation_id": {
      "type": "string",
      "pattern": "^condition-relation:[a-f0-9]{24}$"
    },
    "schema_version": {
      "const": "v1"
    },
    "relation_kind": {
      "type": "string",
      "enum": [
        "SPATIAL_COINCIDENCE",
        "TEMPORAL_COINCIDENCE",
        "CONTEXTUAL_ASSOCIATION",
        "OUTLOOK_ALIGNMENT"
      ]
    },
    "requested_claim_type": {
      "type": "string",
      "enum": [
        "CONTEXTUAL",
        "CAUSAL"
      ]
    },
    "left": {
      "$ref": "#/$defs/endpoint"
    },
    "right": {
      "$ref": "#/$defs/endpoint"
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "spatial_relation",
        "temporal_relation",
        "scale_compatibility",
        "weighting_method",
        "causal_claim",
        "reason_codes",
        "evidence_refs"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": [
            "ANSWER",
            "ABSTAIN",
            "DENY",
            "ERROR"
          ]
        },
        "spatial_relation": {
          "type": "string",
          "enum": [
            "WITHIN",
            "CONTAINS",
            "INTERSECTS",
            "DISJOINT",
            "UNKNOWN"
          ]
        },
        "temporal_relation": {
          "type": "string",
          "enum": [
            "OVERLAPS",
            "PRECEDES",
            "FOLLOWS",
            "DISJOINT",
            "UNKNOWN"
          ]
        },
        "scale_compatibility": {
          "type": "string",
          "enum": [
            "COMPATIBLE",
            "REQUIRES_WEIGHTING",
            "INCOMPATIBLE",
            "UNKNOWN"
          ]
        },
        "weighting_method": {
          "type": "string",
          "enum": [
            "NONE",
            "AREA_WEIGHTED",
            "DISTANCE_WEIGHTED",
            "STATION_ASSIGNMENT",
            "NOT_APPLICABLE",
            "UNKNOWN"
          ]
        },
        "causal_claim": {
          "const": false
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
          }
        },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_roles_preserved",
        "support_types_preserved",
        "causality_not_inferred",
        "observation_not_forecast",
        "classification_not_observation",
        "authority_created",
        "policy_evaluated",
        "promotion_authorized",
        "release_authorized",
        "publication_authorized"
      ],
      "properties": {
        "source_roles_preserved": {
          "const": true
        },
        "support_types_preserved": {
          "const": true
        },
        "causality_not_inferred": {
          "const": true
        },
        "observation_not_forecast": {
          "const": true
        },
        "classification_not_observation": {
          "const": true
        },
        "authority_created": {
          "const": false
        },
        "policy_evaluated": {
          "const": false
        },
        "promotion_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        }
      }
    },
    "spec_hash": {
      "$ref": "#/$defs/hash"
    }
  }
}
