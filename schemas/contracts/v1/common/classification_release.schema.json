{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/common/classification_release.schema.json",
  "title": "ClassificationRelease candidate profile",
  "description": "Closed, fixture-only candidate for a broad-scale classification product. It preserves classification/observation/forecast source-role boundaries and creates no source, evidence, policy, review, release, publication, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "status",
    "classification_release_id",
    "version",
    "spec_hash",
    "classification_family",
    "product_ref",
    "source_ref",
    "source_native_id",
    "issuing_authority_ref",
    "source_role",
    "support_type",
    "source_snapshot_refs",
    "temporal_authority_ref",
    "times",
    "space",
    "spatial_artifact_refs",
    "aggregate_statistic_refs",
    "legend_ref",
    "narrative_ref",
    "content_digests",
    "evidence_refs",
    "class_codes",
    "lineage",
    "release_state",
    "release_ref",
    "limitations",
    "public_use_allowed",
    "effects"
  ],
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^\\S+$"
    },
    "aware_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullable_datetime": {
      "oneOf": [
        {
          "$ref": "#/$defs/aware_datetime"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "canonical_ref_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "optional_ref_array": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    }
  },
  "properties": {
    "profile": {
      "const": "kfm.common.classification-release.v1"
    },
    "status": {
      "const": "PROPOSED_INACTIVE"
    },
    "classification_release_id": {
      "type": "string",
      "pattern": "^classification-release:[a-f0-9]{24}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "classification_family": {
      "enum": [
        "DROUGHT_CLASSIFICATION",
        "LAND_COVER_CLASSIFICATION",
        "RISK_CLASSIFICATION",
        "RESOURCE_CLASSIFICATION",
        "OTHER"
      ]
    },
    "product_ref": {
      "$ref": "#/$defs/ref"
    },
    "source_ref": {
      "$ref": "#/$defs/ref"
    },
    "source_native_id": {
      "$ref": "#/$defs/ref"
    },
    "issuing_authority_ref": {
      "$ref": "#/$defs/ref"
    },
    "source_role": {
      "enum": [
        "CLASSIFICATION",
        "OBSERVATION",
        "FORECAST",
        "MODEL",
        "SURVEY",
        "CONTEXT"
      ]
    },
    "support_type": {
      "enum": [
        "DERIVED_CLASSIFICATION",
        "DIRECT_MEASUREMENT",
        "PREDICTION",
        "MODELED_ESTIMATE",
        "AGGREGATE_STATISTIC",
        "CONTEXT_ONLY"
      ]
    },
    "source_snapshot_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^kfm:source-snapshot:[a-f0-9]{64}$"
      }
    },
    "temporal_authority_ref": {
      "$ref": "#/$defs/ref"
    },
    "times": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_data_cutoff_at",
        "source_valid_from",
        "source_valid_to",
        "source_released_at",
        "retrieved_at",
        "corrected_at",
        "superseded_at",
        "native_timezone"
      ],
      "properties": {
        "source_data_cutoff_at": {
          "$ref": "#/$defs/aware_datetime"
        },
        "source_valid_from": {
          "$ref": "#/$defs/aware_datetime"
        },
        "source_valid_to": {
          "$ref": "#/$defs/aware_datetime"
        },
        "source_released_at": {
          "$ref": "#/$defs/aware_datetime"
        },
        "retrieved_at": {
          "$ref": "#/$defs/aware_datetime"
        },
        "corrected_at": {
          "$ref": "#/$defs/nullable_datetime"
        },
        "superseded_at": {
          "$ref": "#/$defs/nullable_datetime"
        },
        "native_timezone": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z][A-Za-z0-9_+\\-/]{1,127}$"
        }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geography_ref",
        "scale",
        "geometry_role",
        "geometry_digest",
        "geometry_confidence"
      ],
      "properties": {
        "geography_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "scale": {
          "enum": [
            "POINT",
            "GRID",
            "POLYGON_SET",
            "COUNTY",
            "MULTI_COUNTY",
            "REGIONAL",
            "STATEWIDE",
            "NATIONAL"
          ]
        },
        "geometry_role": {
          "enum": [
            "AUTHORITATIVE",
            "OPERATIONAL",
            "INDICATIVE",
            "APPROXIMATE",
            "DISPLAY_ONLY",
            "UNRESOLVED"
          ]
        },
        "geometry_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "geometry_confidence": {
          "enum": [
            "CONFIRMED",
            "HIGH",
            "MEDIUM",
            "LOW",
            "UNRESOLVED"
          ]
        }
      }
    },
    "spatial_artifact_refs": {
      "$ref": "#/$defs/canonical_ref_array"
    },
    "aggregate_statistic_refs": {
      "$ref": "#/$defs/canonical_ref_array"
    },
    "legend_ref": {
      "$ref": "#/$defs/ref"
    },
    "narrative_ref": {
      "$ref": "#/$defs/ref"
    },
    "content_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "evidence_refs": {
      "$ref": "#/$defs/canonical_ref_array"
    },
    "class_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "pattern": "^[A-Z0-9][A-Z0-9_.:-]{0,63}$"
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "corrects",
        "supersedes",
        "superseded_by",
        "conflict_refs"
      ],
      "properties": {
        "state": {
          "enum": [
            "CURRENT",
            "CORRECTED",
            "SUPERSEDED",
            "CONFLICTED"
          ]
        },
        "corrects": {
          "$ref": "#/$defs/optional_ref_array"
        },
        "supersedes": {
          "$ref": "#/$defs/optional_ref_array"
        },
        "superseded_by": {
          "$ref": "#/$defs/optional_ref_array"
        },
        "conflict_refs": {
          "$ref": "#/$defs/optional_ref_array"
        }
      }
    },
    "release_state": {
      "enum": [
        "UNRELEASED",
        "RELEASED"
      ]
    },
    "release_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240,
        "pattern": "\\S"
      }
    },
    "public_use_allowed": {
      "type": "boolean"
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_activated",
        "evidence_resolved",
        "policy_evaluated",
        "promoted",
        "released",
        "published"
      ],
      "properties": {
        "source_activated": {
          "type": "boolean"
        },
        "evidence_resolved": {
          "type": "boolean"
        },
        "policy_evaluated": {
          "type": "boolean"
        },
        "promoted": {
          "type": "boolean"
        },
        "released": {
          "type": "boolean"
        },
        "published": {
          "type": "boolean"
        }
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "contract_doc": "contracts/common/classification_release.md",
    "fixtures_root": "fixtures/contracts/v1/common/classification_release/",
    "validator": "tools/validators/validate_classification_release.py",
    "tests": [
      "tests/validators/test_validate_classification_release.py",
      "tests/cross_domain/test_classification_observation_boundary.py"
    ],
    "authority": "fixture_candidate_only",
    "public_release_authority": false
  }
}
