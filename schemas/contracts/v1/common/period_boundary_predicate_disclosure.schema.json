{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/common/period_boundary_predicate_disclosure.schema.json",
  "title": "PeriodBoundaryPredicateDisclosureCandidate",
  "description": "Fixture-only profile for interval convention, endpoint predicate, and intersection disclosure without temporal truth, evidence, policy, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "profile_spec_hash",
    "source_card",
    "observed_at",
    "claim_ref",
    "claim_digest",
    "claim_scope",
    "interval_convention",
    "left_window",
    "right_window",
    "declared_predicate",
    "declared_intersection_shape",
    "explanation",
    "evidence_refs",
    "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "PeriodBoundaryPredicateDisclosureCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.common.period-boundary-predicate-disclosure.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_card": {"const": "KFM-P18-INV-462"},
    "observed_at": {"type": "string", "format": "date-time"},
    "claim_ref": {"$ref": "#/$defs/ref"},
    "claim_digest": {"$ref": "#/$defs/sha256"},
    "claim_scope": {"$ref": "#/$defs/resolved_reference"},
    "interval_convention": {
      "enum": ["CLOSED", "OPEN", "LEFT_CLOSED_RIGHT_OPEN", "LEFT_OPEN_RIGHT_CLOSED", "MIXED_EXPLICIT"]
    },
    "left_window": {"$ref": "#/$defs/window_binding"},
    "right_window": {"$ref": "#/$defs/window_binding"},
    "declared_predicate": {
      "enum": [
        "BEFORE",
        "MEETS",
        "OVERLAPS",
        "STARTS",
        "DURING",
        "FINISHES",
        "EQUALS",
        "FINISHED_BY",
        "CONTAINS",
        "STARTED_BY",
        "OVERLAPPED_BY",
        "MET_BY",
        "AFTER"
      ]
    },
    "declared_intersection_shape": {"enum": ["EMPTY", "POINT", "INTERVAL"]},
    "explanation": {"type": "string", "minLength": 20, "maxLength": 1200},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporal_truth_authority",
        "evidence_authority",
        "policy_authority",
        "review_authority",
        "promotion_authority",
        "release_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "temporal_truth_authority": {"const": false},
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^\\S+$"},
    "resolved_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "resolution"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    },
    "window_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "window_ref",
        "window_digest",
        "resolution",
        "start",
        "end",
        "start_inclusive",
        "end_inclusive"
      ],
      "properties": {
        "window_ref": {"$ref": "#/$defs/ref"},
        "window_digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]},
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "start_inclusive": {"type": "boolean"},
        "end_inclusive": {"type": "boolean"}
      }
    }
  },
  "x-kfm": {
    "contract_doc": "contracts/common/period_boundary_predicate_disclosure.md",
    "fixtures_root": "fixtures/contracts/v1/common/period_boundary_predicate_disclosure/",
    "validator": "tools/validators/validate_period_boundary_predicate_disclosure.py",
    "status": "PROPOSED_INACTIVE",
    "network": false,
    "authority_effects": false
  }
}
