{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/common/identifier_precision_lineage_assessment.schema.json",
  "title": "IdentifierPrecisionLineageAssessmentCandidate",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "aware_datetime": {"type":"string","format":"date-time","pattern":"(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "spec_hash": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "nullable_assertion_ref": {"oneOf":[{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,127}$"},{"type":"null"}]},
    "nullable_evidence_ref": {"oneOf":[{"type":"string","pattern":"^kfm:evidence:[a-z0-9][a-z0-9._:-]{2,220}$"},{"type":"null"}]},
    "nullable_profile_ref": {"oneOf":[{"type":"string","pattern":"^kfm:[a-z0-9][a-z0-9._:/-]{5,220}$"},{"type":"null"}]},
    "valid_time": {
      "type":"object","additionalProperties":false,
      "properties":{"start":{"$ref":"#/$defs/aware_datetime"},"end":{"oneOf":[{"$ref":"#/$defs/aware_datetime"},{"type":"null"}]}},
      "required":["start","end"]
    },
    "identifier": {
      "type":"object","additionalProperties":false,
      "properties":{
        "assertion_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,127}$"},
        "namespace":{"type":"string","pattern":"^[a-z][a-z0-9._:-]{2,127}$"},
        "value_digest":{"$ref":"#/$defs/spec_hash"},
        "role":{"enum":["SOURCE_NATIVE","RESOLVED","COMPATIBILITY","DISPLAY_ONLY"]},
        "valid_time":{"$ref":"#/$defs/valid_time"},
        "source_descriptor_ref":{"type":"string","pattern":"^kfm://source/[a-z0-9][a-z0-9._:-]{2,127}$"},
        "evidence_ref":{"$ref":"#/$defs/nullable_evidence_ref"},
        "status":{"enum":["ACTIVE","SUPERSEDED","UNRESOLVED","REVOKED"]},
        "supersedes_assertion_id":{"$ref":"#/$defs/nullable_assertion_ref"},
        "confidence":{"enum":["SOURCE_DECLARED","REVIEWED","UNRESOLVED"]},
        "reason_codes":{"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"enum":["SOURCE_ID_RETAINED","CROSSWALK_REVIEWED","CROSSWALK_AMBIGUOUS","COMPATIBILITY_ALIAS","DISPLAY_DERIVATIVE","ASSERTION_SUPERSEDED","EVIDENCE_REVOKED"]}}
      },
      "required":["assertion_id","namespace","value_digest","role","valid_time","source_descriptor_ref","evidence_ref","status","supersedes_assertion_id","confidence","reason_codes"]
    },
    "crosswalk": {
      "type":"object","additionalProperties":false,
      "properties":{
        "resolution_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,127}$"},
        "from_assertion_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,127}$"},
        "to_assertion_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,127}$"},
        "decision":{"enum":["MATCHED","NOT_MATCHED","AMBIGUOUS","UNRESOLVED"]},
        "method_profile_ref":{"type":"string","pattern":"^kfm:crosswalk-profile:[a-z0-9][a-z0-9._:-]{2,127}$"},
        "method_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "evidence_refs":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^kfm:evidence:[a-z0-9][a-z0-9._:-]{2,220}$"}},
        "reviewer_state":{"enum":["PENDING","REVIEWED","NOT_REQUIRED"]},
        "source_roles_preserved":{"const":true}
      },
      "required":["resolution_id","from_assertion_id","to_assertion_id","decision","method_profile_ref","method_version","evidence_refs","reviewer_state","source_roles_preserved"]
    },
    "precision": {
      "type":"object","additionalProperties":false,
      "properties":{
        "source_geometry_ref":{"type":"string","pattern":"^kfm:geometry:[a-z0-9][a-z0-9._:-]{2,127}$"},
        "source_precision_m":{"type":"integer","minimum":1,"maximum":1000000},
        "effective_precision_m":{"oneOf":[{"type":"integer","minimum":1,"maximum":1000000},{"type":"null"}]},
        "uncertainty_class":{"enum":["SOURCE_DECLARED","APPROXIMATE","GENERALIZED","WITHHELD"]},
        "transform":{"enum":["NONE","GENERALIZED","AGGREGATED","WITHHELD"]},
        "transform_profile_ref":{"$ref":"#/$defs/nullable_profile_ref"},
        "transform_receipt_ref":{"$ref":"#/$defs/nullable_profile_ref"},
        "precision_not_identity":{"const":true}
      },
      "required":["source_geometry_ref","source_precision_m","effective_precision_m","uncertainty_class","transform","transform_profile_ref","transform_receipt_ref","precision_not_identity"]
    },
    "governance": {
      "type":"object","additionalProperties":false,
      "properties":{
        "execution_mode":{"const":"FIXTURE_ONLY"},
        "network_attempted":{"const":false},
        "raw_identifier_stored":{"const":false},
        "coordinate_payload_stored":{"const":false},
        "source_accessed":{"const":false},
        "identity_resolved":{"const":false},
        "geometry_transformed":{"const":false},
        "evidence_authenticated":{"const":false},
        "policy_evaluated":{"const":false},
        "review_approved":{"const":false},
        "release_authorized":{"const":false},
        "publication_authorized":{"const":false},
        "public_use_allowed":{"const":false}
      },
      "required":["execution_mode","network_attempted","raw_identifier_stored","coordinate_payload_stored","source_accessed","identity_resolved","geometry_transformed","evidence_authenticated","policy_evaluated","review_approved","release_authorized","publication_authorized","public_use_allowed"]
    }
  },
  "properties": {
    "object_type":{"const":"IdentifierPrecisionLineageAssessmentCandidate"},
    "schema_version":{"const":"1.0.0"},
    "profile":{"const":"kfm.identifier-precision-lineage.fixture.v1"},
    "assessment_id":{"type":"string","pattern":"^kfm:identifier-precision-lineage:[0-9a-f]{24}$"},
    "subject_ref":{"type":"string","pattern":"^kfm:[a-z0-9][a-z0-9._:/-]{5,220}$"},
    "assessed_at":{"$ref":"#/$defs/aware_datetime"},
    "identifiers":{"type":"array","minItems":2,"maxItems":8,"items":{"$ref":"#/$defs/identifier"}},
    "crosswalk":{"$ref":"#/$defs/crosswalk"},
    "precision":{"$ref":"#/$defs/precision"},
    "summary":{
      "type":"object","additionalProperties":false,
      "properties":{
        "assertion_count":{"type":"integer","minimum":2,"maximum":8},
        "active_identifier_count":{"type":"integer","minimum":0,"maximum":8},
        "unresolved_identifier_count":{"type":"integer","minimum":0,"maximum":8},
        "lineage_outcome":{"enum":["RESOLVED","HOLD","ABSTAIN"]},
        "effective_precision_m":{"oneOf":[{"type":"integer","minimum":1,"maximum":1000000},{"type":"null"}]},
        "source_identity_preserved":{"const":true},
        "identity_resolution_authorized":{"const":false},
        "separate_policy_gate_required":{"const":true},
        "public_use_allowed":{"const":false}
      },
      "required":["assertion_count","active_identifier_count","unresolved_identifier_count","lineage_outcome","effective_precision_m","source_identity_preserved","identity_resolution_authorized","separate_policy_gate_required","public_use_allowed"]
    },
    "governance":{"$ref":"#/$defs/governance"},
    "spec_hash":{"$ref":"#/$defs/spec_hash"}
  },
  "required":["object_type","schema_version","profile","assessment_id","subject_ref","assessed_at","identifiers","crosswalk","precision","summary","governance","spec_hash"],
  "x-kfm":{
    "status":"PROPOSED_INACTIVE",
    "authority":"NONE",
    "contract_doc":"contracts/common/identifier_precision_lineage_assessment.md",
    "fixtures_root":"fixtures/contracts/v1/common/identifier_precision_lineage_assessment/",
    "validator":"tools/validators/validate_identifier_precision_lineage_assessment.py"
  }
}
