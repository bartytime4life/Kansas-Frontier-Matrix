{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/common/open_ended_temporal_semantics_disclosure.schema.json",
  "title": "OpenEndedTemporalSemanticsDisclosureCandidate",
  "description": "Fixture-only profile for explicit open-ended, current, and now-relative period semantics without temporal truth, evidence, policy, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "profile_spec_hash",
    "source_card",
    "supporting_source_cards",
    "observed_at",
    "temporal_claim_ref",
    "temporal_claim_digest",
    "claim_scope",
    "intended_use",
    "period",
    "disclosure",
    "evidence_refs",
    "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "OpenEndedTemporalSemanticsDisclosureCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.common.open-ended-temporal-semantics-disclosure.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_card": {"const": "KFM-P18-INV-093"},
    "supporting_source_cards": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "prefixItems": [
        {"const": "KFM-P18-INV-194"},
        {"const": "KFM-P18-INV-287"}
      ],
      "items": false
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "temporal_claim_ref": {"$ref": "#/$defs/ref"},
    "temporal_claim_digest": {"$ref": "#/$defs/sha256"},
    "claim_scope": {"$ref": "#/$defs/resolved_reference"},
    "intended_use": {"enum": ["INTERNAL_QA", "EXPLORATORY_ANALYSIS", "PUBLIC_EXPLANATION", "RELEASE_REVIEW"]},
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "end_semantics", "as_of_time", "now_basis", "sentinel_used", "sentinel_value"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": ["string", "null"], "format": "date-time"},
        "end_semantics": {"enum": ["EXPLICIT_END", "UNKNOWN_END", "CURRENT_UNTIL_SUPERSEDED", "NOW_RELATIVE"]},
        "as_of_time": {"type": ["string", "null"], "format": "date-time"},
        "now_basis": {"enum": ["NOT_APPLICABLE", "OBSERVED_TIME", "SOURCE_TIME", "TRANSACTION_TIME", "RELEASE_TIME"]},
        "sentinel_used": {"type": "boolean"},
        "sentinel_value": {"type": ["string", "null"], "maxLength": 128}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "interpretation", "obligations", "explanation", "review_record_refs"],
      "properties": {
        "state": {"enum": ["COMPLETE", "INCOMPLETE", "UNKNOWN"]},
        "interpretation": {"enum": ["BOUNDED_PERIOD", "END_NOT_KNOWN", "CURRENT_KNOWN_STATE", "NOW_RESOLVED_AT_AS_OF"]},
        "obligations": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"enum": ["AS_OF_TIME_REQUIRED", "FAR_FUTURE_SENTINEL_FORBIDDEN", "OPEN_END_LABEL_REQUIRED", "PUBLIC_EXPLANATION_REQUIRED", "SUPERSESSION_CAVEAT_REQUIRED"]}
        },
        "explanation": {"type": "string", "minLength": 20, "maxLength": 1200},
        "review_record_refs": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ref"}
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "authority_claims": {"$ref": "#/$defs/authority_claims"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^\\S+$"},
    "resolved_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "resolution"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["temporal_truth_authority", "evidence_authority", "policy_authority", "review_authority", "promotion_authority", "release_authority", "publication_authority", "public_use_authority"],
      "properties": {
        "temporal_truth_authority": {"const": false},
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "x-kfm": {
    "contract_doc": "contracts/common/open_ended_temporal_semantics_disclosure.md",
    "fixtures_root": "fixtures/contracts/v1/common/open_ended_temporal_semantics_disclosure/",
    "validator": "tools/validators/validate_open_ended_temporal_semantics_disclosure.py",
    "status": "PROPOSED_INACTIVE",
    "network": false,
    "authority_effects": false
  }
}
