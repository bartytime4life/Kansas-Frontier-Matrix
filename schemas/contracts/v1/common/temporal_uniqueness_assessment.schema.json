{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/common/temporal_uniqueness_assessment.schema.json",
  "title": "TemporalUniquenessAssessmentCandidate",
  "description": "Fixture-only identity-plus-period uniqueness assessment without table, constraint-execution, or lifecycle authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "profile_spec_hash",
    "source_card",
    "assessed_at",
    "key_profile",
    "overlap_policy",
    "subject",
    "comparisons",
    "declared_state",
    "failure_handling",
    "evidence_refs",
    "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "TemporalUniquenessAssessmentCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.common.temporal-uniqueness-assessment.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_card": {"const": "KFM-P18-INV-392"},
    "assessed_at": {"type": "string", "format": "date-time"},
    "key_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "resolution", "identity_field_refs", "temporal_mode", "pair_conflict_rule"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]},
        "identity_field_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ref"}
        },
        "temporal_mode": {"enum": ["VALID_TIME", "TRANSACTION_TIME", "BITEMPORAL"]},
        "pair_conflict_rule": {"enum": ["ANY_DECLARED_AXIS_OVERLAP", "ALL_DECLARED_AXES_OVERLAP"]}
      }
    },
    "overlap_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "resolution", "policy_profile_ref", "exception_review_refs"],
      "properties": {
        "mode": {"enum": ["DENY_OVERLAP", "ALLOW_WITH_SUPERSESSION", "ALLOW_REVIEWED_PARALLEL"]},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]},
        "policy_profile_ref": {"$ref": "#/$defs/ref"},
        "exception_review_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ref"}
        }
      }
    },
    "subject": {"$ref": "#/$defs/record"},
    "comparisons": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/comparison"}
    },
    "declared_state": {"enum": ["UNIQUE", "CONFLICT", "ALLOWED_OVERLAP", "UNRESOLVED"]},
    "failure_handling": {"$ref": "#/$defs/failure_handling"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "table_inspection_authority",
        "record_mutation_authority",
        "constraint_execution_authority",
        "quarantine_authority",
        "evidence_authority",
        "policy_authority",
        "review_authority",
        "promotion_authority",
        "release_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "table_inspection_authority": {"const": false},
        "record_mutation_authority": {"const": false},
        "constraint_execution_authority": {"const": false},
        "quarantine_authority": {"const": false},
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^\\S+$"},
    "nullable_ref": {
      "oneOf": [
        {"$ref": "#/$defs/ref"},
        {"type": "null"}
      ]
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "key_digest", "presence"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "key_digest": {"$ref": "#/$defs/sha256"},
        "presence": {"enum": ["PRESENT", "UNRESOLVED"]}
      }
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["window_ref", "resolution", "start", "end", "start_inclusive", "end_inclusive"],
      "properties": {
        "window_ref": {"$ref": "#/$defs/ref"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]},
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "start_inclusive": {"type": "boolean"},
        "end_inclusive": {"type": "boolean"}
      }
    },
    "axis_comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["axis", "subject_window", "peer_window", "declared_overlap"],
      "properties": {
        "axis": {"enum": ["VALID_TIME", "TRANSACTION_TIME"]},
        "subject_window": {"$ref": "#/$defs/window"},
        "peer_window": {"$ref": "#/$defs/window"},
        "declared_overlap": {"enum": ["OVERLAPS", "DISJOINT", "UNRESOLVED"]}
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": ["peer", "lineage_relation", "lineage_ref", "axes"],
      "properties": {
        "peer": {"$ref": "#/$defs/record"},
        "lineage_relation": {"enum": ["NONE", "SUBJECT_SUPERSEDES_PEER", "PEER_SUPERSEDES_SUBJECT"]},
        "lineage_ref": {"$ref": "#/$defs/nullable_ref"},
        "axes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "items": {"$ref": "#/$defs/axis_comparison"}
        }
      }
    },
    "failure_handling": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recommended_action",
        "recommendation_only",
        "disposition_executed",
        "review_record_refs",
        "correction_ref",
        "rollback_ref"
      ],
      "properties": {
        "recommended_action": {"enum": ["NONE", "DENY_CANDIDATE", "QUARANTINE_CANDIDATE", "REVIEW_OVERLAP"]},
        "recommendation_only": {"const": true},
        "disposition_executed": {"const": false},
        "review_record_refs": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ref"}
        },
        "correction_ref": {"$ref": "#/$defs/ref"},
        "rollback_ref": {"$ref": "#/$defs/ref"}
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "contract_doc": "contracts/common/temporal_uniqueness_assessment.md",
    "fixtures_root": "fixtures/contracts/v1/common/temporal_uniqueness_assessment/",
    "validator": "tools/validators/validate_temporal_uniqueness_assessment.py",
    "network": false,
    "table_inspection": false,
    "constraint_execution": false,
    "authority_effects": false
  }
}
