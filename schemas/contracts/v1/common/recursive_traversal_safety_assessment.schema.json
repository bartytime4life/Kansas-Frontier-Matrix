{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/common/recursive_traversal_safety_assessment.schema.json",
  "title": "RecursiveTraversalSafetyAssessmentCandidate",
  "description": "Fixture-only recursive traversal guard declaration without SQL execution, database access, evidence, policy, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "profile_spec_hash",
    "source_card",
    "recorded_at",
    "assessment_ref",
    "intended_use",
    "assessment_state",
    "traversal_family",
    "query_definition",
    "dialect_semantics",
    "identity_fields",
    "guard_profile",
    "observation",
    "evidence_bundle_refs",
    "limitations",
    "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "RecursiveTraversalSafetyAssessmentCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.common.recursive-traversal-safety.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_card": {"const": "KFM-P18-INV-133"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "assessment_ref": {"$ref": "#/$defs/ref"},
    "intended_use": {"enum": ["INTERNAL_QUERY_QA", "HIERARCHY_QUERY_CANDIDATE", "LINEAGE_QUERY_CANDIDATE", "NETWORK_QUERY_CANDIDATE"]},
    "assessment_state": {"enum": ["COMPLETE", "INCOMPLETE", "ERROR"]},
    "traversal_family": {"enum": ["HIERARCHY", "NETWORK", "ROUTE_GRAPH", "CALENDAR", "LINEAGE"]},
    "query_definition": {"$ref": "#/$defs/resolved_reference"},
    "dialect_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dialect_profile", "parity_state", "parity_fixture_ref"],
      "properties": {
        "dialect_profile": {"$ref": "#/$defs/resolved_reference"},
        "parity_state": {"enum": ["SINGLE_DIALECT_DECLARED", "SYNTHETIC_PARITY", "UNRESOLVED", "MISMATCH"]},
        "parity_fixture_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "identity_fields": {"$ref": "#/$defs/field_array"},
    "guard_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_depth",
        "max_nodes",
        "max_edges",
        "termination_predicate",
        "depth_cap_justification",
        "cycle_strategy",
        "cycle_identity_fields",
        "on_depth_limit",
        "on_cycle"
      ],
      "properties": {
        "max_depth": {"type": "integer", "minimum": 1, "maximum": 1024},
        "max_nodes": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "max_edges": {"type": "integer", "minimum": 1, "maximum": 2000000},
        "termination_predicate": {"$ref": "#/$defs/resolved_reference"},
        "depth_cap_justification": {"$ref": "#/$defs/resolved_reference"},
        "cycle_strategy": {"enum": ["VISITED_SET", "PATH_REJECTION", "DIALECT_CYCLE_CLAUSE", "NONE"]},
        "cycle_identity_fields": {"$ref": "#/$defs/field_array"},
        "on_depth_limit": {"enum": ["ABSTAIN", "DENY", "ERROR", "SILENT_PARTIAL"]},
        "on_cycle": {"enum": ["STOP_AND_REPORT", "ABSTAIN", "DENY", "ERROR", "IGNORE"]}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_state", "recursion_depth", "cycle_detected", "visited_nodes", "visited_edges", "receipt_ref"],
      "properties": {
        "execution_state": {"enum": ["NOT_RUN", "COMPLETE", "DEPTH_LIMIT_REACHED", "CYCLE_DETECTED", "ERROR"]},
        "recursion_depth": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "cycle_detected": {"oneOf": [{"type": "boolean"}, {"type": "null"}]},
        "visited_nodes": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "visited_edges": {"$ref": "#/$defs/nullable_nonnegative_integer"},
        "receipt_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "evidence_bundle_refs": {"$ref": "#/$defs/ref_array"},
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["DECLARATION_ONLY", "NO_DATABASE_EXECUTION", "NO_EVIDENCE_RESOLUTION", "NO_PUBLICATION_AUTHORITY"]}
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "traversal_truth_authority",
        "database_execution_authority",
        "query_authority",
        "evidence_authority",
        "policy_authority",
        "review_authority",
        "promotion_authority",
        "release_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "traversal_truth_authority": {"const": false},
        "database_execution_authority": {"const": false},
        "query_authority": {"const": false},
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^\\S+$"},
    "nullable_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "nullable_nonnegative_integer": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 2000000}, {"type": "null"}]},
    "field_name": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$"},
    "field_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/field_name"}
    },
    "ref_array": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "resolved_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "resolution"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    }
  },
  "x-kfm": {
    "contract_doc": "contracts/common/recursive_traversal_safety_assessment.md",
    "fixtures_root": "fixtures/contracts/v1/common/recursive_traversal_safety_assessment/",
    "validator": "tools/validators/validate_recursive_traversal_safety_assessment.py",
    "status": "PROPOSED_INACTIVE",
    "network": false,
    "authority_effects": false,
    "sql_text_allowed": false,
    "database_execution": false
  }
}
