{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/common/temporal_support_acceptance_assessment.schema.json",
  "title": "TemporalSupportAcceptanceAssessment",
  "description": "Fixture-only cross-surface temporal-support declaration assessment without evidence, policy, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type", "schema_version", "profile", "profile_spec_hash", "source_item", "evaluated_at",
    "assessment_state", "intended_use", "subject", "temporal_support_assessment", "release_state",
    "time_dimensions", "disclosure", "limitations", "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "TemporalSupportAcceptanceAssessment"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.common.temporal-support-acceptance.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_item": {"const": "KFM-P20-EXP-013"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "assessment_state": {"enum": ["COMPLETE", "INCOMPLETE", "UNKNOWN", "ERROR"]},
    "intended_use": {"enum": ["INTERNAL_QA", "EXPLORATORY_ANALYSIS", "PUBLIC_SURFACE_CANDIDATE"]},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "ref", "digest", "resolution"],
      "properties": {
        "kind": {"enum": ["TILE_ARTIFACT", "LAYER_MANIFEST", "EVIDENCE_BUNDLE", "POLICY_DECISION", "AI_ENVELOPE"]},
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    },
    "temporal_support_assessment": {"$ref": "#/$defs/resolved_reference"},
    "release_state": {"enum": ["CANDIDATE", "UNRELEASED", "RELEASED", "CORRECTED", "WITHDRAWN"]},
    "time_dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid_time", "observed_at", "source_updated_at", "retrieved_at", "release_time",
        "correction_time", "as_of_time", "freshness_ttl_seconds"
      ],
      "properties": {
        "valid_time": {"$ref": "#/$defs/nullable_interval"},
        "observed_at": {"$ref": "#/$defs/nullable_datetime"},
        "source_updated_at": {"$ref": "#/$defs/nullable_datetime"},
        "retrieved_at": {"$ref": "#/$defs/nullable_datetime"},
        "release_time": {"$ref": "#/$defs/nullable_datetime"},
        "correction_time": {"$ref": "#/$defs/nullable_datetime"},
        "as_of_time": {"$ref": "#/$defs/nullable_datetime"},
        "freshness_ttl_seconds": {
          "oneOf": [{"type": "integer", "minimum": 0, "maximum": 31536000}, {"type": "null"}]
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reason_codes", "evidence_drawer_section_ref", "temporal_caveat"],
      "properties": {
        "reason_codes": {"type": "array", "maxItems": 50, "uniqueItems": true, "items": {"$ref": "#/$defs/code"}},
        "evidence_drawer_section_ref": {"$ref": "#/$defs/nullable_ref"},
        "temporal_caveat": {
          "oneOf": [{"type": "string", "minLength": 20, "maxLength": 1200}, {"type": "null"}]
        }
      }
    },
    "limitations": {
      "type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true,
      "items": {"enum": [
        "DECLARATION_ONLY", "NO_REFERENCE_RESOLUTION", "NO_FRESHNESS_POLICY_EVALUATION", "NO_PUBLICATION_AUTHORITY"
      ]}
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temporal_truth_authority", "evidence_authority", "policy_authority", "review_authority",
        "lifecycle_write_authority", "promotion_authority", "release_authority", "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "temporal_truth_authority": {"const": false},
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "lifecycle_write_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^\\S+$"},
    "nullable_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "code": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,79}$"},
    "nullable_datetime": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
    "nullable_interval": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false, "required": ["start", "end"],
          "properties": {"start": {"type": "string", "format": "date-time"}, "end": {"type": "string", "format": "date-time"}}
        },
        {"type": "null"}
      ]
    },
    "resolved_reference": {
      "type": "object", "additionalProperties": false, "required": ["ref", "digest", "resolution"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    }
  },
  "x-kfm": {
    "contract_doc": "contracts/common/temporal_support_acceptance_assessment.md",
    "fixtures_root": "fixtures/contracts/v1/common/temporal_support_acceptance_assessment/",
    "validator": "tools/validators/validate_temporal_support_acceptance_assessment.py",
    "status": "PROPOSED_INACTIVE",
    "network": false,
    "authority_effects": false
  }
}
