{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/common/station_spatial_assignment_assessment.schema.json",
  "title": "StationSpatialAssignmentAssessmentCandidate",
  "description": "Closed, fixture-only deterministic assessment of synthetic station-to-state/county/HUC12 point-in-polygon assignments.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "profile_status",
    "execution_mode",
    "authority",
    "assessment_id",
    "profile_spec_hash",
    "observed_at",
    "station_ref",
    "point",
    "boundary_snapshots",
    "assignments",
    "declared_context",
    "permissions",
    "non_effects"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "profile": {
      "const": "kfm.common.station-spatial-assignment-assessment.v1"
    },
    "profile_status": {
      "const": "PROPOSED_INACTIVE"
    },
    "execution_mode": {
      "const": "FIXTURE_ONLY_NO_NETWORK"
    },
    "authority": {
      "const": "NONE"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^kfm:station-spatial-assignment:[0-9a-f]{24}$"
    },
    "profile_spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "station_ref": {
      "type": "string",
      "pattern": "^kfm://synthetic/[A-Za-z0-9._~:/-]{3,480}$"
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crs",
        "longitude",
        "latitude"
      ],
      "properties": {
        "crs": {
          "const": "EPSG:4326"
        },
        "longitude": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        "latitude": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      }
    },
    "boundary_snapshots": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/snapshot"
      }
    },
    "assignments": {
      "type": "array",
      "minItems": 3,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/assignment"
      }
    },
    "declared_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state_fips",
        "county_geoid",
        "huc12"
      ],
      "properties": {
        "state_fips": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            }
          ]
        },
        "county_geoid": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{5}$"
            }
          ]
        },
        "huc12": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[0-9]{12}$"
            }
          ]
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_activate_source",
        "may_write_lifecycle",
        "may_publish_location",
        "may_promote",
        "may_release",
        "public_use_allowed"
      ],
      "properties": {
        "may_activate_source": {
          "const": false
        },
        "may_write_lifecycle": {
          "const": false
        },
        "may_publish_location": {
          "const": false
        },
        "may_promote": {
          "const": false
        },
        "may_release": {
          "const": false
        },
        "public_use_allowed": {
          "const": false
        }
      }
    },
    "non_effects": {
      "const": [
        "no_live_boundary_access",
        "no_source_activation",
        "no_canonical_geography_write",
        "no_location_publication",
        "no_promotion_release_or_publication"
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "kfm_ref": {
      "type": "string",
      "pattern": "^kfm://[A-Za-z0-9._~:/-]{3,500}$"
    },
    "level": {
      "enum": [
        "COUNTY",
        "HUC12",
        "STATE"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "source_ref",
        "version_ref",
        "geometry_digest",
        "resolution_state"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/level"
        },
        "source_ref": {
          "$ref": "#/$defs/kfm_ref"
        },
        "version_ref": {
          "$ref": "#/$defs/kfm_ref"
        },
        "geometry_digest": {
          "$ref": "#/$defs/sha256"
        },
        "resolution_state": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED"
          ]
        }
      }
    },
    "position": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        },
        {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "ring": {
      "type": "array",
      "minItems": 4,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/position"
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "level",
        "geography_id",
        "polygon_ring",
        "declared_relation"
      ],
      "properties": {
        "level": {
          "$ref": "#/$defs/level"
        },
        "geography_id": {
          "type": "string",
          "pattern": "^(?:[0-9]{2}|[0-9]{5}|[0-9]{12})$"
        },
        "polygon_ring": {
          "$ref": "#/$defs/ring"
        },
        "declared_relation": {
          "enum": [
            "BOUNDARY",
            "CONTAINS",
            "OUTSIDE"
          ]
        }
      }
    }
  }
}
