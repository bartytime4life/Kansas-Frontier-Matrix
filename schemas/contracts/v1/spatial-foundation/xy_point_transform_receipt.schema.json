{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/spatial-foundation/xy_point_transform_receipt.schema.json",
  "title": "XYPointTransformReceiptCandidate",
  "description": "Fixture-only table-to-point coordinate-creation receipt candidate without source, coordinate-truth, evidence, policy, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "profile_spec_hash",
    "source_card",
    "observed_at",
    "transform_ref",
    "source_table",
    "axis_mapping",
    "coordinate_reference_system",
    "precision",
    "declared_valid_bounds",
    "observed_coordinate_bounds",
    "validation_summary",
    "output_point_set",
    "evidence_refs",
    "limitations",
    "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "XYPointTransformReceiptCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.spatial-foundation.xy-point-transform-receipt.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_card": {"const": "KFM-P18-INV-174"},
    "observed_at": {"type": "string", "format": "date-time"},
    "transform_ref": {"$ref": "#/$defs/ref"},
    "source_table": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "artifact_digest", "resolution", "source_role", "row_count"],
      "properties": {
        "artifact_ref": {"$ref": "#/$defs/ref"},
        "artifact_digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]},
        "source_role": {"enum": ["OBSERVATION_CANDIDATE", "REFERENCE_CANDIDATE", "ADMINISTRATIVE_CANDIDATE", "SYNTHETIC_TEST"]},
        "row_count": {"type": "integer", "minimum": 1, "maximum": 1000000000}
      }
    },
    "axis_mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": {"$ref": "#/$defs/axis_field"},
        "y": {"$ref": "#/$defs/axis_field"}
      }
    },
    "coordinate_reference_system": {
      "type": "object",
      "additionalProperties": false,
      "required": ["crs_ref", "crs_digest", "resolution", "coordinate_space", "axis_order", "unit"],
      "properties": {
        "crs_ref": {"$ref": "#/$defs/ref"},
        "crs_digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]},
        "coordinate_space": {"enum": ["GEOGRAPHIC", "PROJECTED", "OTHER_DECLARED"]},
        "axis_order": {"enum": ["X_Y", "LONGITUDE_LATITUDE", "LATITUDE_LONGITUDE", "EASTING_NORTHING", "NORTHING_EASTING", "OTHER_DECLARED"]},
        "unit": {"enum": ["DEGREE", "METRE", "FOOT", "OTHER_DECLARED"]}
      }
    },
    "precision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["declared_max_decimal_places", "observed_x_decimal_places", "observed_y_decimal_places"],
      "properties": {
        "declared_max_decimal_places": {"type": "integer", "minimum": 0, "maximum": 15},
        "observed_x_decimal_places": {"type": "integer", "minimum": 0, "maximum": 15},
        "observed_y_decimal_places": {"type": "integer", "minimum": 0, "maximum": 15}
      }
    },
    "declared_valid_bounds": {"$ref": "#/$defs/bounds"},
    "observed_coordinate_bounds": {"$ref": "#/$defs/bounds"},
    "validation_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "total_rows",
        "created_points",
        "rejected_rows",
        "missing_coordinate_rows",
        "out_of_range_rows",
        "non_finite_rows",
        "other_invalid_rows",
        "axis_swap_check"
      ],
      "properties": {
        "total_rows": {"$ref": "#/$defs/count"},
        "created_points": {"$ref": "#/$defs/count"},
        "rejected_rows": {"$ref": "#/$defs/count"},
        "missing_coordinate_rows": {"$ref": "#/$defs/count"},
        "out_of_range_rows": {"$ref": "#/$defs/count"},
        "non_finite_rows": {"$ref": "#/$defs/count"},
        "other_invalid_rows": {"$ref": "#/$defs/count"},
        "axis_swap_check": {"enum": ["PASS", "FAIL"]}
      }
    },
    "output_point_set": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "artifact_digest", "geometry_type", "feature_count", "crs_ref", "crs_digest"],
      "properties": {
        "artifact_ref": {"$ref": "#/$defs/ref"},
        "artifact_digest": {"$ref": "#/$defs/sha256"},
        "geometry_type": {"const": "POINT"},
        "feature_count": {"$ref": "#/$defs/count"},
        "crs_ref": {"$ref": "#/$defs/ref"},
        "crs_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 10, "maxLength": 500}
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observation_authority",
        "coordinate_truth_authority",
        "evidence_authority",
        "policy_authority",
        "review_authority",
        "promotion_authority",
        "release_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "observation_authority": {"const": false},
        "coordinate_truth_authority": {"const": false},
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^\\S+$"},
    "count": {"type": "integer", "minimum": 0, "maximum": 1000000000},
    "axis_field": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field_name", "semantic_role"],
      "properties": {
        "field_name": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"},
        "semantic_role": {"enum": ["LONGITUDE", "LATITUDE", "EASTING", "NORTHING", "X_COORDINATE", "Y_COORDINATE"]}
      }
    },
    "bounds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_x", "min_y", "max_x", "max_y"],
      "properties": {
        "min_x": {"type": "number"},
        "min_y": {"type": "number"},
        "max_x": {"type": "number"},
        "max_y": {"type": "number"}
      }
    }
  },
  "x-kfm": {
    "contract_doc": "contracts/spatial-foundation/xy_point_transform_receipt.md",
    "fixtures_root": "fixtures/contracts/v1/spatial-foundation/xy_point_transform_receipt/",
    "validator": "tools/validators/validate_xy_point_transform_receipt.py",
    "status": "PROPOSED_INACTIVE",
    "network": false,
    "authority_effects": false,
    "coordinate_payloads": false
  }
}
