{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/pipeline_spec_declaration.schema.json",
  "title": "KfmPipelineSpecDeclaration",
  "description": "Fail-closed declaration for an inactive pipeline stage boundary, pipeline candidate, or compatibility alias. Validation creates no source, lifecycle, promotion, release, publication, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "spec_id",
    "spec_version",
    "profile_kind",
    "domain_id",
    "stage",
    "status",
    "implementation_status",
    "path",
    "purpose",
    "canonicalization_profile",
    "source_docs",
    "bindings",
    "lifecycle",
    "execution",
    "required_gates",
    "reason_codes",
    "non_effects",
    "rollback",
    "spec_hash"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "object_type": {
      "const": "KfmPipelineSpecDeclaration"
    },
    "spec_id": {
      "type": "string",
      "pattern": "^kfm\\.pipeline\\.[a-z0-9]+(?:[.-][a-z0-9]+)*$",
      "maxLength": 220
    },
    "spec_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "profile_kind": {
      "enum": [
        "STAGE_BOUNDARY",
        "PIPELINE_CANDIDATE",
        "COMPATIBILITY_ALIAS"
      ]
    },
    "domain_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 96
    },
    "stage": {
      "enum": [
        "INGEST",
        "NORMALIZE",
        "VALIDATE",
        "CATALOG",
        "PUBLISH",
        "DERIVE",
        "WATCH",
        "REFRESH",
        "PUBLISH_DRY_RUN",
        "UNSPECIFIED"
      ]
    },
    "status": {
      "const": "PROPOSED_INACTIVE"
    },
    "implementation_status": {
      "enum": [
        "NOT_IMPLEMENTED",
        "IMPLEMENTED_FIXTURE_FIRST"
      ]
    },
    "path": {
      "$ref": "#/$defs/pipeline_spec_path"
    },
    "purpose": {
      "type": "string",
      "minLength": 16,
      "maxLength": 1024
    },
    "canonicalization_profile": {
      "const": "kfm-canonical-json-v1"
    },
    "canonical_target": {
      "$ref": "#/$defs/pipeline_spec_path"
    },
    "source_docs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repository_ref"
      }
    },
    "bindings": {
      "$ref": "#/$defs/bindings"
    },
    "lifecycle": {
      "$ref": "#/$defs/lifecycle"
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "required_gates": {
      "$ref": "#/$defs/finite_code_array"
    },
    "reason_codes": {
      "$ref": "#/$defs/finite_code_array"
    },
    "non_effects": {
      "$ref": "#/$defs/finite_code_array"
    },
    "rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "strategy"
      ],
      "properties": {
        "strategy": {
          "const": "REVERT_DECLARATION_CHANGE"
        }
      }
    },
    "spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "command",
        "workflow"
      ],
      "properties": {
        "command": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        "workflow": {
          "type": "string",
          "pattern": "^\\.github/workflows/[A-Za-z0-9._-]+\\.ya?ml$",
          "maxLength": 260
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "repository_ref": {
      "type": "string",
      "pattern": "^[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*/?$",
      "maxLength": 512
    },
    "pipeline_spec_path": {
      "type": "string",
      "pattern": "^pipeline_specs/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[A-Za-z0-9._-]+)*\\.ya?ml$",
      "maxLength": 300
    },
    "reference_array": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/repository_ref"
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_descriptor_refs",
        "contract_refs",
        "schema_refs",
        "implementation_refs",
        "fixture_refs",
        "test_refs",
        "workflow_refs"
      ],
      "properties": {
        "source_descriptor_refs": {
          "$ref": "#/$defs/reference_array"
        },
        "contract_refs": {
          "$ref": "#/$defs/reference_array"
        },
        "schema_refs": {
          "$ref": "#/$defs/reference_array"
        },
        "implementation_refs": {
          "$ref": "#/$defs/reference_array"
        },
        "fixture_refs": {
          "$ref": "#/$defs/reference_array"
        },
        "test_refs": {
          "$ref": "#/$defs/reference_array"
        },
        "workflow_refs": {
          "$ref": "#/$defs/reference_array"
        }
      }
    },
    "lifecycle_code_array": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
      }
    },
    "lifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_inputs",
        "candidate_outputs",
        "writes_targets"
      ],
      "properties": {
        "candidate_inputs": {
          "$ref": "#/$defs/lifecycle_code_array"
        },
        "candidate_outputs": {
          "$ref": "#/$defs/lifecycle_code_array"
        },
        "writes_targets": {
          "const": false
        },
        "declared_possible_targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repository_ref"
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "network_access",
        "source_activation",
        "lifecycle_write",
        "promotion",
        "release",
        "publication"
      ],
      "properties": {
        "mode": {
          "enum": [
            "DISABLED",
            "FIXTURE_ONLY"
          ]
        },
        "network_access": {
          "const": "DENIED"
        },
        "source_activation": {
          "const": "DENIED"
        },
        "lifecycle_write": {
          "const": "DENIED"
        },
        "promotion": {
          "const": "DENIED"
        },
        "release": {
          "const": "DENIED"
        },
        "publication": {
          "const": "DENIED"
        }
      }
    },
    "finite_code_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{1,95}$"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "profile_kind": {
            "const": "COMPATIBILITY_ALIAS"
          }
        },
        "required": [
          "profile_kind"
        ]
      },
      "then": {
        "required": [
          "canonical_target"
        ],
        "properties": {
          "implementation_status": {
            "const": "NOT_IMPLEMENTED"
          },
          "execution": {
            "properties": {
              "mode": {
                "const": "DISABLED"
              }
            }
          }
        }
      },
      "else": {
        "not": {
          "required": [
            "canonical_target"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "implementation_status": {
            "const": "IMPLEMENTED_FIXTURE_FIRST"
          }
        },
        "required": [
          "implementation_status"
        ]
      },
      "then": {
        "required": [
          "validation"
        ],
        "properties": {
          "profile_kind": {
            "const": "PIPELINE_CANDIDATE"
          },
          "execution": {
            "properties": {
              "mode": {
                "const": "FIXTURE_ONLY"
              }
            }
          },
          "bindings": {
            "properties": {
              "source_descriptor_refs": {
                "minItems": 1
              },
              "contract_refs": {
                "minItems": 1
              },
              "schema_refs": {
                "minItems": 1
              },
              "implementation_refs": {
                "minItems": 1
              },
              "fixture_refs": {
                "minItems": 1
              },
              "test_refs": {
                "minItems": 1
              },
              "workflow_refs": {
                "minItems": 1
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "execution": {
            "properties": {
              "mode": {
                "const": "DISABLED"
              }
            }
          }
        }
      }
    }
  ],
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "contract_doc": "contracts/pipeline_spec_declaration.md",
    "fixtures_root": "fixtures/contracts/v1/pipeline_spec_declaration/",
    "validator": "tools/validators/validate_pipeline_spec_declarations.py",
    "tests": "tests/validators/test_validate_pipeline_spec_declarations.py",
    "workflow": ".github/workflows/pipeline-spec-declarations.yml",
    "instance_glob": "pipeline_specs/**/*.yaml",
    "authority": "inactive_declarative_repository_contract_only",
    "canonicalization_profile": "kfm-canonical-json-v1",
    "hash_projection": "sorted compact UTF-8 JSON excluding top-level spec_hash",
    "coordination_boundaries": {
      "github": "authoritative_versioned_repository_record",
      "google_drive": "read_only_lineage",
      "notion": "coordination_only",
      "pipelines": "executable_implementation_elsewhere"
    },
    "non_effects": [
      "does_not_fetch_or_activate_sources",
      "does_not_write_lifecycle_targets",
      "does_not_evaluate_or_approve_policy",
      "does_not_authorize_promotion_or_release",
      "does_not_publish_or_authorize_public_use"
    ]
  }
}
