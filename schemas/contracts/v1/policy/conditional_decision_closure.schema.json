{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/policy/conditional_decision_closure.schema.json",
  "title": "ConditionalDecisionClosureCandidate",
  "description": "Fixture-only closure assessment over an already-declared conditional decision and PolicyObligationSet reference. It creates no policy, review, enforcement, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "status",
    "closure_id",
    "subject_ref",
    "operation",
    "conditional_decision_ref",
    "obligation_set_ref",
    "assessed_at",
    "obligations",
    "result",
    "canonicalization_profile",
    "spec_hash",
    "governance"
  ],
  "properties": {
    "object_type": {"const": "ConditionalDecisionClosure"},
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "PROPOSED_INACTIVE"},
    "closure_id": {
      "type": "string",
      "pattern": "^kfm://policy/conditional-decision-closure/[0-9a-f]{24}$"
    },
    "subject_ref": {"$ref": "#/$defs/ref"},
    "operation": {
      "type": "string",
      "enum": ["ANALYZE", "CACHE", "DERIVE", "DOWNLOAD", "EXPORT", "PUBLISH", "REDISTRIBUTE", "VIEW"]
    },
    "conditional_decision_ref": {"$ref": "#/$defs/ref"},
    "obligation_set_ref": {
      "type": "string",
      "pattern": "^kfm://policy/obligation-set/[0-9a-f]{24}$"
    },
    "assessed_at": {"$ref": "#/$defs/aware_datetime"},
    "obligations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/obligation_closure"}
    },
    "result": {"$ref": "#/$defs/result"},
    "canonicalization_profile": {"const": "RFC8785-JCS"},
    "spec_hash": {"$ref": "#/$defs/hash"},
    "governance": {"$ref": "#/$defs/governance"}
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "\\S"
    },
    "nullable_ref": {
      "oneOf": [
        {"$ref": "#/$defs/ref"},
        {"type": "null"}
      ]
    },
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "aware_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullable_datetime": {
      "oneOf": [
        {"$ref": "#/$defs/aware_datetime"},
        {"type": "null"}
      ]
    },
    "reference_array": {
      "type": "array",
      "maxItems": 32,
      "items": {"$ref": "#/$defs/ref"},
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
      },
      "uniqueItems": true
    },
    "obligation_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obligation_id",
        "applicable",
        "state",
        "evidence_refs",
        "authority_ref",
        "superseded_by_ref",
        "closed_at",
        "reason_codes"
      ],
      "properties": {
        "obligation_id": {
          "type": "string",
          "pattern": "^kfm://policy/obligation/[a-z0-9][a-z0-9/_-]{2,126}$"
        },
        "applicable": {"type": "boolean"},
        "state": {
          "type": "string",
          "enum": ["OPEN", "SATISFIED", "WAIVED", "EXPIRED", "VIOLATED", "SUPERSEDED", "NOT_APPLICABLE"]
        },
        "evidence_refs": {"$ref": "#/$defs/reference_array"},
        "authority_ref": {"$ref": "#/$defs/nullable_ref"},
        "superseded_by_ref": {"$ref": "#/$defs/nullable_ref"},
        "closed_at": {"$ref": "#/$defs/nullable_datetime"},
        "reason_codes": {"$ref": "#/$defs/reason_codes"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "blocking_obligation_ids", "closed_obligation_ids", "reason_codes"],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["HOLD", "CLOSED_FOR_SEPARATE_GATE"]
        },
        "blocking_obligation_ids": {"$ref": "#/$defs/reference_array"},
        "closed_obligation_ids": {"$ref": "#/$defs/reference_array"},
        "reason_codes": {"$ref": "#/$defs/reason_codes"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_evaluated",
        "obligations_enforced",
        "review_authorized",
        "promotion_authorized",
        "release_authorized",
        "publication_authorized"
      ],
      "properties": {
        "policy_evaluated": {"const": false},
        "obligations_enforced": {"const": false},
        "review_authorized": {"const": false},
        "promotion_authorized": {"const": false},
        "release_authorized": {"const": false},
        "publication_authorized": {"const": false}
      }
    }
  }
}
