{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfm.local/schemas/contracts/v1/policy/sovereignty_exception_receipt.schema.json",
  "title": "SovereigntyExceptionReceipt Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_type", "schema_version", "status", "receipt_id", "spec_hash", "subject_ref", "exception_class", "requested_operation", "reason_codes", "requested_at", "recorded_at", "decision", "provenance", "governance"],
  "properties": {
    "object_type": {"const": "SovereigntyExceptionReceiptCandidate"},
    "schema_version": {"const": "1.0.0"},
    "status": {"const": "PROPOSED_INACTIVE"},
    "receipt_id": {"type": "string", "pattern": "^kfm://policy/sovereignty-exception-receipt/[a-f0-9]{24}$"},
    "spec_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "subject_ref": {"$ref": "#/$defs/ref"},
    "exception_class": {"enum": ["SOVEREIGNTY_CONSTRAINT", "SENSITIVE_RELEASE_CONSTRAINT"]},
    "requested_operation": {"enum": ["ANALYZE", "PROCESS", "RENDER", "EXPORT", "RELEASE_CANDIDATE"]},
    "reason_codes": {"type": "array", "minItems": 1, "maxItems": 6, "uniqueItems": true, "items": {"enum": ["LOCAL_PROCESS_REQUIRED", "RESTRICTED_EGRESS_REQUIRED", "SENSITIVE_RELEASE_REVIEW_REQUIRED", "SOVEREIGN_CUSTODY_REQUIRED"]}},
    "requested_at": {"$ref": "#/$defs/aware_datetime"},
    "recorded_at": {"$ref": "#/$defs/aware_datetime"},
    "decision": {"$ref": "#/$defs/decision"},
    "provenance": {"$ref": "#/$defs/provenance"},
    "governance": {"$ref": "#/$defs/governance"}
  },
  "$defs": {
    "ref": {"type": "string", "pattern": "^kfm://[a-z0-9][a-z0-9:._/-]{5,240}$"},
    "nullable_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "aware_datetime": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "nullable_datetime": {"oneOf": [{"$ref": "#/$defs/aware_datetime"}, {"type": "null"}]},
    "ref_array": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "policy_decision_ref", "review_record_refs", "approver_roster_ref", "decided_at", "expires_at", "obligations"],
      "properties": {
        "disposition": {"enum": ["PENDING_REVIEW", "RECORDED_APPROVED", "RECORDED_DENIED", "EXPIRED"]},
        "policy_decision_ref": {"$ref": "#/$defs/nullable_ref"},
        "review_record_refs": {"$ref": "#/$defs/ref_array"},
        "approver_roster_ref": {"$ref": "#/$defs/nullable_ref"},
        "decided_at": {"$ref": "#/$defs/nullable_datetime"},
        "expires_at": {"$ref": "#/$defs/nullable_datetime"},
        "obligations": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["AUDIT_REQUIRED", "EXPIRY_ENFORCED", "GENERALIZED_OUTPUT_ONLY", "LOCAL_PROCESS_ONLY", "NO_RAW_EGRESS", "STAGED_ACCESS"]}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["activity_ref", "evidence_refs"],
      "properties": {
        "activity_ref": {"$ref": "#/$defs/nullable_ref"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^evidence:[a-z0-9][a-z0-9:._-]{5,200}$"}}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_mode", "network_attempted", "exception_authority_created", "policy_overridden", "review_approved_by_validator", "access_granted", "lifecycle_write_performed", "promotion_authorized", "release_authorized", "publication_authorized", "published"],
      "properties": {
        "execution_mode": {"const": "FIXTURE_ONLY"},
        "network_attempted": {"const": false},
        "exception_authority_created": {"const": false},
        "policy_overridden": {"const": false},
        "review_approved_by_validator": {"const": false},
        "access_granted": {"const": false},
        "lifecycle_write_performed": {"const": false},
        "promotion_authorized": {"const": false},
        "release_authorized": {"const": false},
        "publication_authorized": {"const": false},
        "published": {"const": false}
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "source_ideas": ["KFM-P32-IDEA-0007"],
    "validator": "tools/validators/policy/validate_sovereignty_exception_receipt.py",
    "authority": "records an asserted external decision; grants no exception"
  }
}
