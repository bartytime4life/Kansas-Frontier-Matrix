{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/ui/story_manifest.schema.json",
  "title": "StoryManifest public-safe composite projection",
  "description": "Closed fixture-only composite of bounded StoryNode trust snapshots. No truth, policy, review, release, publication, or ref-resolution authority.",
  "type": "object",
  "additionalProperties": false,
  "x-kfm": {
    "contract_doc": "contracts/ui/story_manifest.md",
    "fixtures_root": "fixtures/ui/story_manifest/",
    "validator": "tools/validators/ui/validate_story_manifest.py",
    "policy": "policy/ui/",
    "status": "PROPOSED",
    "profile": "kfm.ui.story-manifest.public-safe.v1",
    "authority": "public-safe-composite-projection-only"
  },
  "required": ["profile", "id", "version", "spec_hash", "story_ref", "title", "accessibility_summary", "state", "outcome", "reason_codes", "limiting_node_refs", "constituents", "trust_state", "support", "caveats", "authoritative", "projection_only"],
  "properties": {
    "profile": { "const": "kfm.ui.story-manifest.public-safe.v1" },
    "id": { "type": "string", "pattern": "^kfm:story-manifest:[0-9a-f]{24}$" },
    "version": { "const": "1.0.0" },
    "spec_hash": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "story_ref": { "$ref": "#/$defs/governed_ref" },
    "title": { "$ref": "#/$defs/title" },
    "accessibility_summary": { "$ref": "#/$defs/summary" },
    "state": { "$ref": "#/$defs/state" },
    "outcome": { "$ref": "#/$defs/outcome" },
    "reason_codes": { "type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/reason_code" } },
    "limiting_node_refs": { "type": "array", "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/node_ref" } },
    "constituents": { "type": "array", "minItems": 1, "maxItems": 64, "items": { "$ref": "#/$defs/constituent" } },
    "trust_state": { "$ref": "#/$defs/trust_state" },
    "support": { "$ref": "#/$defs/support" },
    "caveats": { "type": "array", "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/bounded_text" } },
    "supersession": { "$ref": "#/$defs/supersession" },
    "authoritative": { "const": false },
    "projection_only": { "const": true }
  },
  "$defs": {
    "state": { "type": "string", "enum": ["READY", "PARTIAL", "ABSTAINED", "SUPERSEDED", "BLOCKED", "ERROR"] },
    "outcome": { "type": "string", "enum": ["ANSWER", "ABSTAIN", "DENY", "ERROR"] },
    "reason_code": { "type": "string", "enum": ["SUPPORTED", "PARTIAL_SUPPORT", "MISSING_EVIDENCE", "STALE_EVIDENCE", "CITATION_UNRESOLVED", "POLICY_ABSTAINED", "POLICY_DENIED", "RIGHTS_UNRESOLVED", "SENSITIVE_DETAIL_RESTRICTED", "REVIEW_PENDING", "RELEASE_UNAVAILABLE", "SUPERSEDED", "UPSTREAM_ERROR"] },
    "node_ref": { "type": "string", "pattern": "^kfm://story-node/[a-z0-9][a-z0-9._/-]{0,127}$" },
    "governed_ref": { "type": "string", "maxLength": 192, "pattern": "^(?:kfm://|artifact:|evidence:|citation:|policy:|release:|review:|correction:|rollback:|story:)[A-Za-z0-9][A-Za-z0-9:._/-]{0,175}$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]+$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]+$" },
    "bounded_text": { "type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\u0000-\\u0008\\u000B\\u000C\\u000E-\\u001F\\u007F]+$" },
    "ref_array": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/governed_ref" } },
    "constituent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_ref", "order_index", "state", "outcome", "reason_code", "trust_state"],
      "properties": {
        "node_ref": { "$ref": "#/$defs/node_ref" },
        "order_index": { "type": "integer", "minimum": 0, "maximum": 9999 },
        "state": { "$ref": "#/$defs/state" },
        "outcome": { "$ref": "#/$defs/outcome" },
        "reason_code": { "$ref": "#/$defs/reason_code" },
        "trust_state": { "$ref": "#/$defs/trust_state" }
      }
    },
    "trust_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rights", "sensitivity", "policy", "review", "release", "freshness", "correction"],
      "properties": {
        "rights": { "enum": ["CLEARED", "GENERALIZED", "WITHHELD", "UNRESOLVED"] },
        "sensitivity": { "enum": ["PUBLIC", "GENERALIZED", "RESTRICTED", "UNKNOWN"] },
        "policy": { "enum": ["ALLOW", "ABSTAIN", "DENY", "ERROR"] },
        "review": { "enum": ["REVIEWED", "NOT_APPLICABLE", "PENDING"] },
        "release": { "enum": ["RELEASED", "UNRELEASED", "WITHDRAWN"] },
        "freshness": { "enum": ["CURRENT", "STALE", "UNKNOWN"] },
        "correction": { "enum": ["NONE", "CURRENT", "CORRECTED", "SUPERSEDED"] }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_bundle_refs", "citation_validation_refs", "policy_decision_refs", "release_refs", "review_refs", "correction_refs"],
      "properties": {
        "evidence_bundle_refs": { "$ref": "#/$defs/ref_array" },
        "citation_validation_refs": { "$ref": "#/$defs/ref_array" },
        "policy_decision_refs": { "$ref": "#/$defs/ref_array" },
        "release_refs": { "$ref": "#/$defs/ref_array" },
        "review_refs": { "$ref": "#/$defs/ref_array" },
        "correction_refs": { "$ref": "#/$defs/ref_array" },
        "rollback_ref": { "$ref": "#/$defs/governed_ref" }
      }
    },
    "supersession": {
      "type": "object",
      "additionalProperties": false,
      "required": ["replacement_manifest_ref", "public_note"],
      "properties": {
        "replacement_manifest_ref": { "type": "string", "pattern": "^kfm:story-manifest:[0-9a-f]{24}$" },
        "public_note": { "$ref": "#/$defs/bounded_text" }
      }
    }
  }
}
