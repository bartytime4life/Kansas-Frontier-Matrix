{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfm://schemas/contracts/v1/evidence/cog_byte_range_integrity_manifest.schema.json",
  "title": "COGByteRangeIntegrityManifestCandidate",
  "description": "Closed proposed-inactive shape for deterministic fixture-only whole-artifact and explicit byte-range integrity verification. Shape validity grants no TIFF, COG, interpretation, policy, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifest_version",
    "manifest_id",
    "observed_at",
    "artifact",
    "range_profile",
    "format_validation",
    "governance",
    "manifest_spec_hash"
  ],
  "properties": {
    "manifest_version": {
      "const": "kfm.cog-byte-range-integrity-manifest.candidate.v1"
    },
    "manifest_id": {
      "$ref": "#/$defs/id"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "range_profile": {
      "$ref": "#/$defs/range_profile"
    },
    "format_validation": {
      "$ref": "#/$defs/format_validation"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "manifest_spec_hash": {
      "$ref": "#/$defs/digest"
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[a-z0-9][a-z0-9._:-]+$"
    },
    "ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "^\\S+$"
    },
    "nullable_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref",
        "intended_format",
        "media_type",
        "byte_length",
        "whole_digest",
        "payload_availability",
        "immutability_state",
        "sidecar_freshness_state",
        "source_artifact_manifest_ref"
      ],
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ref"
        },
        "intended_format": {
          "const": "COG"
        },
        "media_type": {
          "enum": [
            "application/octet-stream",
            "image/tiff",
            "image/tiff; application=geotiff; profile=cloud-optimized"
          ]
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "whole_digest": {
          "$ref": "#/$defs/digest"
        },
        "payload_availability": {
          "enum": [
            "AVAILABLE",
            "MISSING",
            "UNKNOWN"
          ]
        },
        "immutability_state": {
          "enum": [
            "IMMUTABLE",
            "MUTABLE",
            "UNKNOWN"
          ]
        },
        "sidecar_freshness_state": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN"
          ]
        },
        "source_artifact_manifest_ref": {
          "$ref": "#/$defs/nullable_ref"
        }
      }
    },
    "range_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "range_set_version",
        "algorithm",
        "coverage_mode",
        "entries"
      ],
      "properties": {
        "profile": {
          "const": "EXPLICIT_SHA256_SEGMENTS"
        },
        "range_set_version": {
          "const": 1
        },
        "algorithm": {
          "const": "sha256"
        },
        "coverage_mode": {
          "const": "FULL_ARTIFACT_CONTIGUOUS"
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "$ref": "#/$defs/range_entry"
          }
        }
      }
    },
    "range_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "range_id",
        "role",
        "offset",
        "length",
        "digest"
      ],
      "properties": {
        "range_id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "HEADER",
            "IMAGE_FILE_DIRECTORY",
            "TILE_DATA",
            "OVERVIEW_DATA",
            "AUXILIARY"
          ]
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 67108863
        },
        "length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "digest": {
          "$ref": "#/$defs/digest"
        }
      }
    },
    "format_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tiff_structure_state",
        "cog_layout_state",
        "overview_layout_state",
        "validator_report_ref"
      ],
      "properties": {
        "tiff_structure_state": {
          "$ref": "#/$defs/validation_state"
        },
        "cog_layout_state": {
          "$ref": "#/$defs/validation_state"
        },
        "overview_layout_state": {
          "$ref": "#/$defs/validation_state"
        },
        "validator_report_ref": {
          "$ref": "#/$defs/nullable_ref"
        }
      }
    },
    "validation_state": {
      "enum": [
        "VALID",
        "INVALID",
        "NOT_EVALUATED",
        "UNKNOWN"
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_refs",
        "policy_state",
        "review_state",
        "release_state",
        "release_manifest_ref",
        "rollback_ref",
        "interpretation_authority",
        "format_conformance_authority",
        "policy_authority",
        "review_authority",
        "promotion_authority",
        "release_authority",
        "publication_authority"
      ],
      "properties": {
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "policy_state": {
          "enum": [
            "NOT_EVALUATED",
            "ALLOW",
            "DENY"
          ]
        },
        "review_state": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "release_state": {
          "enum": [
            "NOT_RELEASED",
            "RELEASED",
            "WITHDRAWN"
          ]
        },
        "release_manifest_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "rollback_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "interpretation_authority": {
          "type": "boolean"
        },
        "format_conformance_authority": {
          "type": "boolean"
        },
        "policy_authority": {
          "type": "boolean"
        },
        "review_authority": {
          "type": "boolean"
        },
        "promotion_authority": {
          "type": "boolean"
        },
        "release_authority": {
          "type": "boolean"
        },
        "publication_authority": {
          "type": "boolean"
        }
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "scope": "fixture-only explicit SHA-256 whole-artifact and byte-range integrity declaration",
    "authority": "NONE",
    "network": "DENIED",
    "payload_fixture_is_cog": false,
    "format_validation_required_for_integrity_pass": false,
    "format_conformance_granted": false,
    "interpretation_authority_granted": false,
    "release_authority_granted": false,
    "publication_authority_granted": false
  }
}
