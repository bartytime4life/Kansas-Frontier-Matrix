{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/measurement_scale_operation_assessment.schema.json",
  "title": "MeasurementScaleOperationAssessmentCandidate",
  "description": "Fixture-only assessment of declared measurement-scale compatibility with requested aggregation and legend operations without authority effects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_type", "schema_version", "profile", "profile_spec_hash", "source_card", "observed_at", "attribute_ref", "attribute_digest", "intended_use", "measurement", "requested_operations", "assessment", "authority_claims"],
  "properties": {
    "object_type": {"const": "MeasurementScaleOperationAssessmentCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.evidence.measurement-scale-operation-assessment.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_card": {"const": "KFM-P18-INV-377"},
    "observed_at": {"type": "string", "format": "date-time"},
    "attribute_ref": {"$ref": "#/$defs/ref"},
    "attribute_digest": {"$ref": "#/$defs/sha256"},
    "intended_use": {"enum": ["INTERNAL_QA", "EXPLORATORY_ANALYSIS", "SCIENTIFIC_SUMMARY", "PUBLIC_MAP", "POLICY_CONTEXT"]},
    "measurement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scale_class", "unit_ref", "true_zero", "ordering_meaningful", "equal_intervals", "scale_definition"],
      "properties": {
        "scale_class": {"enum": ["NOMINAL", "ORDINAL", "INTERVAL", "RATIO", "MIXED", "CUSTOM"]},
        "unit_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
        "true_zero": {"enum": ["PRESENT", "ABSENT", "NOT_APPLICABLE", "UNKNOWN"]},
        "ordering_meaningful": {"type": "boolean"},
        "equal_intervals": {"type": "boolean"},
        "scale_definition": {"$ref": "#/$defs/resolved_reference"}
      }
    },
    "requested_operations": {"$ref": "#/$defs/operation_array_nonempty"},
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "permitted_operations", "denied_operations", "obligations", "review_record_refs"],
      "properties": {
        "state": {"enum": ["COMPLETE", "INCOMPLETE", "UNKNOWN"]},
        "permitted_operations": {"$ref": "#/$defs/operation_array"},
        "denied_operations": {"$ref": "#/$defs/operation_array"},
        "obligations": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"enum": ["UNSUPPORTED_OPERATION_BLOCKED", "CUSTOM_SCALE_REVIEW_REQUIRED", "MIXED_SCALE_SPLIT_REQUIRED", "PUBLIC_EXPLANATION_REQUIRED"]}},
        "review_record_refs": {"$ref": "#/$defs/ref_array"}
      }
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["measurement_authority", "analytics_authority", "legend_authority", "evidence_authority", "policy_authority", "review_authority", "promotion_authority", "release_authority", "publication_authority", "public_use_authority"],
      "properties": {
        "measurement_authority": {"const": false},
        "analytics_authority": {"const": false},
        "legend_authority": {"const": false},
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^\\S+$"},
    "ref_array": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "resolved_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "resolution"],
      "properties": {"ref": {"$ref": "#/$defs/ref"}, "digest": {"$ref": "#/$defs/sha256"}, "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}}
    },
    "operation": {"enum": ["CATEGORICAL_LEGEND", "ORDERED_LEGEND", "SEQUENTIAL_COLOR_RAMP", "DIVERGING_COLOR_RAMP", "RANK", "MODE", "MEDIAN", "MEAN", "SUM", "DIFFERENCE", "RATIO", "MIN_MAX", "PROPORTIONAL_SYMBOL", "QUANTILE_CLASSIFICATION"]},
    "operation_array": {"type": "array", "maxItems": 14, "uniqueItems": true, "items": {"$ref": "#/$defs/operation"}},
    "operation_array_nonempty": {"type": "array", "minItems": 1, "maxItems": 14, "uniqueItems": true, "items": {"$ref": "#/$defs/operation"}}
  },
  "x-kfm": {
    "contract_doc": "contracts/evidence/measurement_scale_operation_assessment.md",
    "fixtures_root": "fixtures/contracts/v1/evidence/measurement_scale_operation_assessment/",
    "validator": "tools/validators/evidence/validate_measurement_scale_operation_assessment.py",
    "status": "PROPOSED_INACTIVE",
    "network": false,
    "authority_effects": false
  }
}
