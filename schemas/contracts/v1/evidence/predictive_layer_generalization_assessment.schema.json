{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/predictive_layer_generalization_assessment.schema.json",
  "title": "PredictiveLayerGeneralizationAssessmentCandidate",
  "description": "Fixture-only assessment of predictive-output validation, overfitting, and generalization disclosure without authority effects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_type", "schema_version", "profile", "profile_spec_hash", "source_card", "observed_at", "predictive_output_ref", "predictive_output_digest", "intended_use", "model_card", "model_run_receipt", "analytic_output_disclosure", "evaluation", "disclosure", "limitations", "authority_claims"],
  "properties": {
    "object_type": {"const": "PredictiveLayerGeneralizationAssessmentCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.evidence.predictive-layer-generalization-assessment.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_card": {"const": "KFM-P18-INV-407"},
    "observed_at": {"type": "string", "format": "date-time"},
    "predictive_output_ref": {"$ref": "#/$defs/ref"},
    "predictive_output_digest": {"$ref": "#/$defs/sha256"},
    "intended_use": {"enum": ["INTERNAL_QA", "EXPLORATORY_ANALYSIS", "PUBLIC_INTERPRETATION", "POLICY_CONTEXT"]},
    "model_card": {"$ref": "#/$defs/resolved_reference"},
    "model_run_receipt": {"$ref": "#/$defs/resolved_reference"},
    "analytic_output_disclosure": {"$ref": "#/$defs/resolved_reference"},
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "split_strategy", "training_dataset_ref", "evaluation_dataset_ref", "data_independence", "cross_validation", "overfitting_label", "generalization_label", "validation_report_refs", "limitation_refs"],
      "properties": {
        "state": {"enum": ["COMPLETE", "INCOMPLETE", "UNKNOWN", "ERROR"]},
        "split_strategy": {"enum": ["HOLDOUT", "K_FOLD", "STRATIFIED_K_FOLD", "GROUP_K_FOLD", "TIME_SERIES_SPLIT", "LEAVE_ONE_GROUP_OUT", "CUSTOM", "UNKNOWN"]},
        "training_dataset_ref": {"$ref": "#/$defs/nullable_ref"},
        "evaluation_dataset_ref": {"$ref": "#/$defs/nullable_ref"},
        "data_independence": {"enum": ["INDEPENDENT", "GROUP_SEPARATED", "TIME_ORDERED", "NOT_INDEPENDENT", "UNKNOWN"]},
        "cross_validation": {"$ref": "#/$defs/cross_validation"},
        "overfitting_label": {"enum": ["NOT_DETECTED", "RISK_PRESENT", "DETECTED", "UNKNOWN"]},
        "generalization_label": {"enum": ["SUPPORTED", "LIMITED", "NOT_SUPPORTED", "UNKNOWN"]},
        "validation_report_refs": {"$ref": "#/$defs/ref_array"},
        "limitation_refs": {"$ref": "#/$defs/ref_array"}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_record_refs", "evidence_drawer_section_ref", "public_interpretation_caveat"],
      "properties": {
        "review_record_refs": {"$ref": "#/$defs/ref_array"},
        "evidence_drawer_section_ref": {"$ref": "#/$defs/nullable_ref"},
        "public_interpretation_caveat": {
          "oneOf": [
            {"type": "string", "minLength": 12, "maxLength": 1000},
            {"type": "null"}
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["DECLARATION_ONLY", "NO_METRIC_RECOMPUTATION", "NO_MODEL_EXECUTION", "NO_PUBLICATION_AUTHORITY"]}
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_evaluation_authority", "evidence_authority", "layer_authority", "policy_authority", "review_authority", "promotion_authority", "release_authority", "publication_authority", "public_use_authority"],
      "properties": {
        "model_evaluation_authority": {"const": false},
        "evidence_authority": {"const": false},
        "layer_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^\\S+$"},
    "nullable_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "ref_array": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "resolved_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "resolution"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    },
    "cross_validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "fold_count", "repeat_count", "metric_refs"],
      "properties": {
        "status": {"enum": ["PERFORMED", "NOT_PERFORMED", "NOT_APPLICABLE", "UNKNOWN"]},
        "fold_count": {"oneOf": [{"type": "integer", "minimum": 2, "maximum": 1000}, {"type": "null"}]},
        "repeat_count": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 1000}, {"type": "null"}]},
        "metric_refs": {"$ref": "#/$defs/ref_array"}
      }
    }
  },
  "x-kfm": {
    "contract_doc": "contracts/evidence/predictive_layer_generalization_assessment.md",
    "fixtures_root": "fixtures/contracts/v1/evidence/predictive_layer_generalization_assessment/",
    "validator": "tools/validators/evidence/validate_predictive_layer_generalization_assessment.py",
    "status": "PROPOSED_INACTIVE",
    "network": false,
    "authority_effects": false
  }
}
