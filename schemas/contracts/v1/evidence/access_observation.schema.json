{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/evidence/access_observation.schema.json",
  "title": "AccessObservation fixture profile",
  "description": "One fixture-only aggregate service-access measure for one version-bound Kansas county and calendar year.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "profile",
    "observation_id",
    "subject",
    "temporal",
    "measure",
    "method",
    "suppression",
    "source",
    "lineage",
    "disclosure",
    "governance",
    "spec_hash"
  ],
  "properties": {
    "object_type": { "const": "AccessObservation" },
    "profile": { "const": "kfm.access-observation.fixture.v1" },
    "observation_id": {
      "type": "string",
      "pattern": "^kfm:access-observation:[0-9a-f]{24}$"
    },
    "subject": { "$ref": "#/$defs/subject" },
    "temporal": { "$ref": "#/$defs/temporal" },
    "measure": { "$ref": "#/$defs/measure" },
    "method": { "$ref": "#/$defs/method" },
    "suppression": { "$ref": "#/$defs/suppression" },
    "source": { "$ref": "#/$defs/source" },
    "lineage": { "$ref": "#/$defs/lineage" },
    "disclosure": { "$ref": "#/$defs/disclosure" },
    "governance": { "$ref": "#/$defs/governance" },
    "spec_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "digest_ref": {
      "type": "string",
      "pattern": "^kfm://[a-z0-9][a-z0-9._/-]*@sha256:[0-9a-f]{64}$"
    },
    "nullable_digest_ref": {
      "oneOf": [
        { "$ref": "#/$defs/digest_ref" },
        { "type": "null" }
      ]
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "geography_version_ref",
        "geography_version_profile",
        "geography_feature_key",
        "unit_level",
        "jurisdiction_code",
        "identity_scope"
      ],
      "properties": {
        "geography_version_ref": { "$ref": "#/$defs/digest_ref" },
        "geography_version_profile": { "const": "kfm.geography-version.fixture.v1" },
        "geography_feature_key": {
          "type": "string",
          "pattern": "^[0-9]{5}$"
        },
        "unit_level": { "const": "COUNTY" },
        "jurisdiction_code": { "const": "US-KS" },
        "identity_scope": { "const": "VERSION_LOCAL" }
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_period_kind",
        "reference_year",
        "reference_period_start",
        "reference_period_end",
        "source_released_at",
        "retrieved_at",
        "corrected_at"
      ],
      "properties": {
        "reference_period_kind": { "const": "CALENDAR_YEAR" },
        "reference_year": { "type": "integer", "minimum": 1800, "maximum": 2200 },
        "reference_period_start": { "type": "string", "format": "date" },
        "reference_period_end": { "type": "string", "format": "date" },
        "source_released_at": { "type": "string", "format": "date-time" },
        "retrieved_at": { "type": "string", "format": "date-time" },
        "corrected_at": {
          "oneOf": [
            { "type": "string", "format": "date-time" },
            { "type": "null" }
          ]
        }
      }
    },
    "measure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "measure_key",
        "measure_family",
        "unit",
        "service_domain",
        "source_service_ref",
        "result_state",
        "value",
        "missing_reason"
      ],
      "properties": {
        "measure_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "measure_family": {
          "enum": ["TRAVEL_TIME", "DISTANCE", "PROVIDER_COUNT", "SERVICE_COVERAGE"]
        },
        "unit": { "enum": ["MINUTES", "KILOMETRES", "COUNT", "PERCENT"] },
        "service_domain": {
          "enum": [
            "HEALTHCARE",
            "BROADBAND",
            "GROCERY",
            "EMERGENCY_SERVICES",
            "EDUCATION",
            "TRANSPORT",
            "SOURCE_DEFINED"
          ]
        },
        "source_service_ref": { "$ref": "#/$defs/nullable_digest_ref" },
        "result_state": { "enum": ["OBSERVED", "SUPPRESSED", "MISSING"] },
        "value": {
          "oneOf": [
            { "type": "number", "minimum": 0 },
            { "type": "null" }
          ]
        },
        "missing_reason": {
          "enum": [
            "NOT_APPLICABLE",
            "SOURCE_SUPPRESSED",
            "SOURCE_MISSING",
            "NOT_COLLECTED",
            "NOT_AVAILABLE"
          ]
        }
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_ref",
        "method_family",
        "origin_scope",
        "destination_scope",
        "aggregation_method",
        "threshold_ref",
        "network_or_model_ref"
      ],
      "properties": {
        "method_ref": { "$ref": "#/$defs/digest_ref" },
        "method_family": {
          "enum": [
            "NETWORK_TRAVEL_TIME",
            "STRAIGHT_LINE_DISTANCE",
            "PROVIDER_INVENTORY",
            "COVERAGE_ESTIMATE"
          ]
        },
        "origin_scope": {
          "enum": [
            "COUNTY_REPRESENTATIVE_POINT",
            "POPULATION_WEIGHTED",
            "COUNTY_AGGREGATE"
          ]
        },
        "destination_scope": {
          "enum": ["NEAREST_SERVICE", "ALL_MATCHING_SERVICES", "COUNTY_AGGREGATE"]
        },
        "aggregation_method": {
          "enum": ["MEAN", "MEDIAN", "MINIMUM", "MAXIMUM", "COUNT", "PERCENT"]
        },
        "threshold_ref": { "$ref": "#/$defs/nullable_digest_ref" },
        "network_or_model_ref": { "$ref": "#/$defs/nullable_digest_ref" }
      }
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason", "method_ref"],
      "properties": {
        "status": { "enum": ["NOT_APPLICABLE", "SOURCE_SUPPRESSED"] },
        "reason": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 256 },
            { "type": "null" }
          ]
        },
        "method_ref": { "$ref": "#/$defs/nullable_digest_ref" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_descriptor_ref",
        "dataset_version_ref",
        "source_table_ref",
        "source_variable_ref",
        "source_role",
        "source_state",
        "evidence_refs",
        "rights_state",
        "sensitivity_state"
      ],
      "properties": {
        "source_descriptor_ref": { "$ref": "#/$defs/digest_ref" },
        "dataset_version_ref": { "$ref": "#/$defs/digest_ref" },
        "source_table_ref": { "$ref": "#/$defs/digest_ref" },
        "source_variable_ref": { "$ref": "#/$defs/digest_ref" },
        "source_role": { "const": "OFFICIAL_ACCESS_OR_SERVICE_AGGREGATE" },
        "source_state": { "const": "REFERENCED_NOT_RESOLVED" },
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/digest_ref" }
        },
        "rights_state": { "const": "REFERENCED_NOT_EVALUATED" },
        "sensitivity_state": { "const": "REFERENCED_NOT_EVALUATED" }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["correction_state", "predecessor_ref", "correction_record_ref"],
      "properties": {
        "correction_state": { "enum": ["ORIGINAL", "CORRECTED"] },
        "predecessor_ref": { "$ref": "#/$defs/nullable_digest_ref" },
        "correction_record_ref": { "$ref": "#/$defs/nullable_digest_ref" }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretation_limits"],
      "properties": {
        "interpretation_limits": {
          "type": "array",
          "minItems": 8,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "AGGREGATE_ONLY",
              "METHOD_BOUND",
              "NO_CAUSAL_CLAIM",
              "NO_PROVIDER_ELIGIBILITY_GUARANTEE",
              "NO_PUBLICATION_AUTHORITY",
              "NO_ROUTING_OR_EMERGENCY_GUIDANCE",
              "SOURCE_ROLE_PRESERVED",
              "VERSION_BOUND"
            ]
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "network_attempted",
        "source_data_accessed",
        "geography_resolved",
        "evidence_resolved",
        "method_executed",
        "provider_identity_resolved",
        "route_computed",
        "rights_evaluated",
        "sensitivity_evaluated",
        "policy_evaluated",
        "review_approved",
        "promotion_authorized",
        "release_authorized",
        "public_use_allowed",
        "publication_authorized"
      ],
      "properties": {
        "execution_mode": { "const": "FIXTURE_ONLY" },
        "network_attempted": { "const": false },
        "source_data_accessed": { "const": false },
        "geography_resolved": { "const": false },
        "evidence_resolved": { "const": false },
        "method_executed": { "const": false },
        "provider_identity_resolved": { "const": false },
        "route_computed": { "const": false },
        "rights_evaluated": { "const": false },
        "sensitivity_evaluated": { "const": false },
        "policy_evaluated": { "const": false },
        "review_approved": { "const": false },
        "promotion_authorized": { "const": false },
        "release_authorized": { "const": false },
        "public_use_allowed": { "const": false },
        "publication_authorized": { "const": false }
      }
    }
  }
}
