{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/hyperparameter_tuning_receipt.schema.json",
  "title": "HyperparameterTuningReceiptCandidate",
  "description": "Fixture-only declaration of a bounded hyperparameter search and selected public-safe scalar values. It does not train or evaluate a model, resolve evidence, or create review, release, deployment, publication, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type", "schema_version", "profile", "profile_spec_hash",
    "receipt_ref", "source_card", "observed_at", "intended_use",
    "tuning_state", "model", "inputs", "search", "objective",
    "selection", "reproducibility", "disclosure", "limitations",
    "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "HyperparameterTuningReceiptCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.evidence.hyperparameter-tuning-receipt.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "receipt_ref": {
      "type": "string",
      "pattern": "^kfm:hyperparameter-tuning-receipt:[a-f0-9]{64}$"
    },
    "source_card": {"const": "KFM-P18-INV-160"},
    "observed_at": {"type": "string", "format": "date-time"},
    "intended_use": {
      "enum": [
        "INTERNAL_MODEL_QA",
        "LAYER_EVALUATION",
        "PUBLIC_CLAIM_SUPPORT_CANDIDATE"
      ]
    },
    "tuning_state": {"enum": ["COMPLETE", "INCOMPLETE", "ERROR"]},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_card", "model_artifact", "layer_manifest"],
      "properties": {
        "model_card": {"$ref": "#/$defs/resolved_reference"},
        "model_artifact": {"$ref": "#/$defs/resolved_reference"},
        "layer_manifest": {"$ref": "#/$defs/resolved_reference"}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "training_run_receipt", "evaluation_split_receipt", "evaluation_report"
      ],
      "properties": {
        "training_run_receipt": {"$ref": "#/$defs/resolved_reference"},
        "evaluation_split_receipt": {"$ref": "#/$defs/resolved_reference"},
        "evaluation_report": {"$ref": "#/$defs/resolved_reference"}
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method", "method_definition", "random_seed", "planned_trials",
        "completed_trials", "failed_trials", "search_space"
      ],
      "properties": {
        "method": {
          "enum": [
            "GRID_SEARCH", "RANDOM_SEARCH", "BAYESIAN_OPTIMIZATION",
            "SUCCESSIVE_HALVING", "MANUAL", "CUSTOM", "UNRESOLVED"
          ]
        },
        "method_definition": {"$ref": "#/$defs/nullable_reference"},
        "random_seed": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 4294967295},
            {"type": "null"}
          ]
        },
        "planned_trials": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "completed_trials": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "failed_trials": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "search_space": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/search_parameter"}
        }
      }
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_ref", "direction", "validation_partition_ref",
        "selection_rule_ref"
      ],
      "properties": {
        "metric_ref": {"$ref": "#/$defs/ref"},
        "direction": {"enum": ["MINIMIZE", "MAXIMIZE"]},
        "validation_partition_ref": {"$ref": "#/$defs/ref"},
        "selection_rule_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["selected_trial_ref", "selected_trial_rank", "selected_values"],
      "properties": {
        "selected_trial_ref": {"$ref": "#/$defs/ref"},
        "selected_trial_rank": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "selected_values": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {"$ref": "#/$defs/selected_value"}
        }
      }
    },
    "reproducibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code_revision_ref", "environment_ref", "determinism_posture",
        "rerun_receipt_ref"
      ],
      "properties": {
        "code_revision_ref": {"$ref": "#/$defs/ref"},
        "environment_ref": {"$ref": "#/$defs/ref"},
        "determinism_posture": {
          "enum": [
            "DETERMINISTIC", "SEEDED_STOCHASTIC", "NONDETERMINISTIC", "UNKNOWN"
          ]
        },
        "rerun_receipt_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "search_summary", "evidence_bundle_refs", "review_record_refs",
        "generalization_assessment_ref", "release_manifest_ref"
      ],
      "properties": {
        "search_summary": {
          "oneOf": [
            {"type": "string", "minLength": 12, "maxLength": 1200, "pattern": "^[^\\r\\n]+$"},
            {"type": "null"}
          ]
        },
        "evidence_bundle_refs": {"$ref": "#/$defs/ref_array"},
        "review_record_refs": {"$ref": "#/$defs/ref_array"},
        "generalization_assessment_ref": {"$ref": "#/$defs/nullable_ref"},
        "release_manifest_ref": {"type": "null"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DECLARATION_ONLY", "NO_DATASET_ACCESS", "NO_EVIDENCE_RESOLUTION",
          "NO_METRIC_RECOMPUTATION", "NO_MODEL_EXECUTION",
          "NO_PUBLICATION_AUTHORITY", "NO_SENSITIVE_VALUES",
          "NO_TRAINING_EXECUTION"
        ]
      }
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tuning_correctness", "best_model", "model_performance",
        "generalization_authority", "evidence_authority", "policy_authority",
        "review_authority", "promotion_authority", "release_authority",
        "deployment_authority", "publication_authority", "public_use_authority"
      ],
      "properties": {
        "tuning_correctness": {"const": false},
        "best_model": {"const": false},
        "model_performance": {"const": false},
        "generalization_authority": {"const": false},
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "deployment_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {
      "type": "string",
      "minLength": 4,
      "maxLength": 256,
      "pattern": "^[a-z][a-z0-9+.-]*:[^\\s]+$"
    },
    "nullable_ref": {
      "oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]
    },
    "resolved_reference": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "digest", "resolution"],
          "properties": {
            "ref": {"$ref": "#/$defs/ref"},
            "digest": {"$ref": "#/$defs/sha256"},
            "resolution": {"const": "RESOLVED"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "digest", "resolution"],
          "properties": {
            "ref": {"$ref": "#/$defs/ref"},
            "digest": {"type": "null"},
            "resolution": {"const": "UNRESOLVED"}
          }
        }
      ]
    },
    "nullable_reference": {
      "oneOf": [{"$ref": "#/$defs/resolved_reference"}, {"type": "null"}]
    },
    "ref_array": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "search_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameter_name", "value_kind", "selection_mode", "domain_summary",
        "domain_spec_ref", "domain_digest", "candidate_count"
      ],
      "properties": {
        "parameter_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "value_kind": {"enum": ["BOOLEAN", "FLOAT", "INT", "STRING"]},
        "selection_mode": {"enum": ["DISCRETE", "RANGE", "DISTRIBUTION", "FIXED"]},
        "domain_summary": {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\\r\\n]+$"},
        "domain_spec_ref": {"$ref": "#/$defs/ref"},
        "domain_digest": {"$ref": "#/$defs/sha256"},
        "candidate_count": {
          "oneOf": [
            {"type": "integer", "minimum": 1, "maximum": 1000000},
            {"type": "null"}
          ]
        }
      }
    },
    "selected_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["parameter_name", "value_kind", "canonical_value"],
      "properties": {
        "parameter_name": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "value_kind": {"enum": ["BOOLEAN", "FLOAT", "INT", "STRING"]},
        "canonical_value": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[^\\s\\x00-\\x1f\\x7f]+$"}
      }
    }
  }
}
