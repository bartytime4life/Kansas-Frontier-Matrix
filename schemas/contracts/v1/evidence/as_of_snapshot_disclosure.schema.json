{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/evidence/as_of_snapshot_disclosure.schema.json",
  "title": "AsOfSnapshotDisclosureCandidate",
  "description": "Inactive fixture profile that declares valid-time and as-of snapshot bindings for changing report claims. It grants no snapshot, truth, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type", "schema_version", "profile", "profile_spec_hash", "source_card", "observed_at",
    "candidate_id", "output", "claim_scope", "claim_valid_time", "snapshot", "source_snapshots",
    "corrections", "disclosure", "evidence_refs", "conclusion", "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "AsOfSnapshotDisclosureCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.evidence.as-of-snapshot-disclosure.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/hash"},
    "source_card": {"const": "KFM-P18-INV-348"},
    "observed_at": {"type": "string", "format": "date-time"},
    "candidate_id": {"type": "string", "pattern": "^asd_[a-z0-9][a-z0-9._-]{7,95}$"},
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "kind"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/hash"},
        "kind": {"enum": ["REPORT", "EXPORT", "TABLE", "MAP", "STATISTIC"]}
      }
    },
    "claim_scope": {"$ref": "#/$defs/resolvedRef"},
    "claim_valid_time": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "end", "boundary"],
      "properties": {
        "start": {"type": "string", "format": "date-time"},
        "end": {"type": "string", "format": "date-time"},
        "boundary": {"const": "[)"}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "as_of", "release_manifest_ref", "transaction_snapshot_ref", "tracking_log_ref", "snapshot_digest", "resolution"],
      "properties": {
        "mode": {"enum": ["RELEASE_SNAPSHOT", "TRANSACTION_SNAPSHOT", "BITEMPORAL_SNAPSHOT"]},
        "as_of": {"type": "string", "format": "date-time"},
        "release_manifest_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
        "transaction_snapshot_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
        "tracking_log_ref": {"$ref": "#/$defs/ref"},
        "snapshot_digest": {"$ref": "#/$defs/hash"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    },
    "source_snapshots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_version_ref", "source_head_digest", "source_as_of", "resolution"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"},
          "source_version_ref": {"$ref": "#/$defs/ref"},
          "source_head_digest": {"$ref": "#/$defs/hash"},
          "source_as_of": {"type": "string", "format": "date-time"},
          "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
        }
      }
    },
    "corrections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["included_through", "correction_refs", "later_corrections_behavior", "rollback_ref"],
      "properties": {
        "included_through": {"type": "string", "format": "date-time"},
        "correction_refs": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "later_corrections_behavior": {"enum": ["EXCLUDED_AND_DISCLOSED", "SUPERSEDE_AND_VERSION", "UNKNOWN"]},
        "rollback_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intended_use", "valid_time_label", "as_of_label", "review_record_refs", "release_manifest_ref"],
      "properties": {
        "intended_use": {"enum": ["INTERNAL_REVIEW", "PUBLIC_CANDIDATE"]},
        "valid_time_label": {"type": "string", "minLength": 12, "maxLength": 256},
        "as_of_label": {"type": "string", "minLength": 12, "maxLength": 256},
        "review_record_refs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "release_manifest_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]}
      }
    },
    "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "conclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["completeness", "declared_outcome"],
      "properties": {
        "completeness": {"enum": ["COMPLETE", "INCOMPLETE", "UNKNOWN"]},
        "declared_outcome": {"enum": ["READY_FOR_REVIEW", "HOLD", "DENY"]}
      }
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_execution", "report_truth", "evidence", "correction", "policy", "review", "release", "publication", "public_use"],
      "properties": {
        "snapshot_execution": {"const": false}, "report_truth": {"const": false}, "evidence": {"const": false},
        "correction": {"const": false}, "policy": {"const": false}, "review": {"const": false},
        "release": {"const": false}, "publication": {"const": false}, "public_use": {"const": false}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "ref": {"type": "string", "minLength": 8, "maxLength": 512},
    "resolvedRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "resolution"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/hash"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    }
  }
}
