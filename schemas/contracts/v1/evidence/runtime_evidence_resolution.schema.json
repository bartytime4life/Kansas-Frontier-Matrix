{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/runtime_evidence_resolution.schema.json",
  "title": "runtime_evidence_resolution",
  "description": "Non-authoritative result shape for the internal kfm/evidence-ref-bundle-candidate/v1alpha1 evaluator.",
  "type": "object",
  "additionalProperties": false,
  "x-kfm": {
    "contract_doc": "contracts/evidence/runtime_evidence_resolution.md",
    "fixtures_root": "fixtures/contracts/v1/evidence/runtime_evidence_resolution/",
    "validator": "tests/packages/evidence_resolver/test_result_schema.py",
    "policy": "policy/evidence/",
    "status": "PROPOSED"
  },
  "required": [
    "profile",
    "status",
    "authoritative",
    "bundle_id",
    "checks_performed",
    "issues",
    "limitations"
  ],
  "properties": {
    "profile": {
      "const": "kfm/evidence-ref-bundle-candidate/v1alpha1"
    },
    "status": {
      "type": "string",
      "enum": [
        "RESOLVED",
        "UNRESOLVED",
        "DENIED",
        "ERROR"
      ]
    },
    "authoritative": {
      "const": false
    },
    "bundle_id": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-z][a-z0-9_:.-]*$"
    },
    "checks_performed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]*$"
      }
    },
    "issues": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "limitations": {
      "const": [
        "claim_scope_not_machine_checked",
        "citations_rights_and_sensitivity_not_decided",
        "policy_is_caller_supplied_not_evaluated",
        "active_verification_history_is_necessary_not_sufficient",
        "no_review_release_runtime_or_publication_authority"
      ]
    }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*(?:/[a-z][a-z0-9_-]*)+$"
        },
        "field": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_.-]*$"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "RESOLVED"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "bundle_id": {
            "type": "string"
          },
          "issues": {
            "maxItems": 0
          }
        }
      },
      "else": {
        "properties": {
          "bundle_id": {
            "type": "null"
          },
          "issues": {
            "minItems": 1
          }
        }
      }
    }
  ]
}
