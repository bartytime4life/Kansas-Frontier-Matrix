{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/classification_layer_evaluation_assessment.schema.json",
  "title": "ClassificationLayerEvaluationAssessmentCandidate",
  "description": "Fixture-only assessment of confusion-matrix arithmetic or comparable classification-evaluation references without authority effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "profile_spec_hash",
    "source_card",
    "observed_at",
    "classification_layer_ref",
    "classification_layer_digest",
    "intended_use",
    "model_card",
    "model_run_receipt",
    "evidence_bundle",
    "predictive_generalization_assessment",
    "evaluation",
    "disclosure",
    "limitations",
    "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "ClassificationLayerEvaluationAssessmentCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.evidence.classification-layer-evaluation-assessment.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_card": {"const": "KFM-P18-INV-432"},
    "observed_at": {"type": "string", "format": "date-time"},
    "classification_layer_ref": {"$ref": "#/$defs/ref"},
    "classification_layer_digest": {"$ref": "#/$defs/sha256"},
    "intended_use": {
      "enum": ["INTERNAL_QA", "EXPLORATORY_ANALYSIS", "PUBLIC_INTERPRETATION", "POLICY_CONTEXT"]
    },
    "model_card": {"$ref": "#/$defs/resolved_reference"},
    "model_run_receipt": {"$ref": "#/$defs/resolved_reference"},
    "evidence_bundle": {"$ref": "#/$defs/resolved_reference"},
    "predictive_generalization_assessment": {"$ref": "#/$defs/resolved_reference"},
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "method",
        "evaluation_dataset_ref",
        "ground_truth_posture",
        "class_labels",
        "confusion_matrix",
        "reported_metrics",
        "comparable_evaluation_refs",
        "limitation_refs"
      ],
      "properties": {
        "state": {"enum": ["COMPLETE", "INCOMPLETE", "UNKNOWN", "ERROR"]},
        "method": {
          "enum": [
            "SUPERVISED_CONFUSION_MATRIX",
            "COMPARABLE_EVALUATION",
            "WEAKLY_SUPERVISED",
            "UNSUPERVISED",
            "UNKNOWN"
          ]
        },
        "evaluation_dataset_ref": {"$ref": "#/$defs/nullable_ref"},
        "ground_truth_posture": {
          "enum": ["VERIFIED_REFERENCE", "PROXY_LABELS", "NO_LABELED_REFERENCE", "UNKNOWN"]
        },
        "class_labels": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/label"}
        },
        "confusion_matrix": {
          "anyOf": [{"$ref": "#/$defs/confusion_matrix"}, {"type": "null"}]
        },
        "reported_metrics": {
          "anyOf": [{"$ref": "#/$defs/reported_metrics"}, {"type": "null"}]
        },
        "comparable_evaluation_refs": {"$ref": "#/$defs/ref_array"},
        "limitation_refs": {"$ref": "#/$defs/ref_array"}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validation_report_refs",
        "review_record_refs",
        "evidence_drawer_section_ref",
        "public_interpretation_caveat"
      ],
      "properties": {
        "validation_report_refs": {"$ref": "#/$defs/ref_array"},
        "review_record_refs": {"$ref": "#/$defs/ref_array"},
        "evidence_drawer_section_ref": {"$ref": "#/$defs/nullable_ref"},
        "public_interpretation_caveat": {
          "anyOf": [
            {"type": "string", "minLength": 16, "maxLength": 512, "pattern": "^\\S(?:.*\\S)?$"},
            {"type": "null"}
          ]
        }
      }
    },
    "limitations": {
      "const": [
        "ARITHMETIC_CHECK_ONLY",
        "DECLARATION_ONLY",
        "NO_EVIDENCE_RESOLUTION",
        "NO_MODEL_EXECUTION",
        "NO_PUBLICATION_AUTHORITY",
        "NO_SCIENTIFIC_THRESHOLD"
      ]
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model_evaluation_authority",
        "evidence_authority",
        "layer_authority",
        "policy_authority",
        "review_authority",
        "promotion_authority",
        "release_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "model_evaluation_authority": {"const": false},
        "evidence_authority": {"const": false},
        "layer_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "nullable_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "ref_array": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "label": {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[a-z][a-z0-9_]*$"},
    "metric": {
      "anyOf": [
        {"type": "number", "minimum": 0, "maximum": 1},
        {"type": "null"}
      ]
    },
    "resolved_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "resolution"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    },
    "prediction_count": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predicted_label", "count"],
      "properties": {
        "predicted_label": {"$ref": "#/$defs/label"},
        "count": {"type": "integer", "minimum": 0, "maximum": 1000000000}
      }
    },
    "matrix_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actual_label", "predictions"],
      "properties": {
        "actual_label": {"$ref": "#/$defs/label"},
        "predictions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/prediction_count"}
        }
      }
    },
    "confusion_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["orientation", "rows"],
      "properties": {
        "orientation": {"const": "ROWS_ACTUAL_COLUMNS_PREDICTED"},
        "rows": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/matrix_row"}
        }
      }
    },
    "class_metric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "support", "precision", "recall", "f1"],
      "properties": {
        "label": {"$ref": "#/$defs/label"},
        "support": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "precision": {"$ref": "#/$defs/metric"},
        "recall": {"$ref": "#/$defs/metric"},
        "f1": {"$ref": "#/$defs/metric"}
      }
    },
    "reported_metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_count",
        "correct_count",
        "overall_accuracy",
        "macro_precision",
        "macro_recall",
        "macro_f1",
        "per_class"
      ],
      "properties": {
        "sample_count": {"type": "integer", "minimum": 1, "maximum": 1000000000},
        "correct_count": {"type": "integer", "minimum": 0, "maximum": 1000000000},
        "overall_accuracy": {"$ref": "#/$defs/metric"},
        "macro_precision": {"$ref": "#/$defs/metric"},
        "macro_recall": {"$ref": "#/$defs/metric"},
        "macro_f1": {"$ref": "#/$defs/metric"},
        "per_class": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {"$ref": "#/$defs/class_metric"}
        }
      }
    }
  }
}
