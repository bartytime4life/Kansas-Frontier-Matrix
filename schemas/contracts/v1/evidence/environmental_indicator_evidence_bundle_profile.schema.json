{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/environmental_indicator_evidence_bundle_profile.schema.json",
  "title": "EnvironmentalIndicatorEvidenceBundleProfile",
  "description": "Closed, fixture-only profile that binds one derived environmental indicator to the existing KFM EvidenceBundle contract. It creates no observation, source activation, policy, review, lifecycle, release, publication, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "status",
    "execution_mode",
    "analysis_id",
    "bundle",
    "environmental_indicator",
    "claims"
  ],
  "properties": {
    "profile": {
      "const": "kfm.environmental_indicator_evidence_bundle_profile.v1"
    },
    "status": {
      "const": "PROPOSED_INACTIVE"
    },
    "execution_mode": {
      "const": "FIXTURE_ONLY"
    },
    "analysis_id": {
      "type": "string",
      "pattern": "^kfm:environmental-indicator:sha256:[0-9a-f]{64}$"
    },
    "bundle": {
      "$ref": "https://schemas.kfm.local/contracts/v1/evidence/evidence_bundle.schema.json"
    },
    "environmental_indicator": {
      "$ref": "#/$defs/environmental_indicator"
    },
    "claims": {
      "$ref": "#/$defs/claims"
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "aware_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "county_fips": {
      "type": "string",
      "pattern": "^20[0-9]{3}$"
    },
    "reference_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 512,
      "pattern": "^[^\\s]+$"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_descriptor_ref",
        "asset_refs",
        "etag_digests",
        "source_time",
        "retrieved_at"
      ],
      "properties": {
        "source_descriptor_ref": {
          "type": "string",
          "minLength": 5,
          "maxLength": 512,
          "pattern": "^(?:kfm://source/|src:)[^\\s#]+$"
        },
        "asset_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 1024,
            "pattern": "^(?:stac://|kfm://artifact/|artifact:)[^\\s]+$"
          }
        },
        "etag_digests": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/hash"
          }
        },
        "source_time": {
          "$ref": "#/$defs/aware_datetime"
        },
        "retrieved_at": {
          "$ref": "#/$defs/aware_datetime"
        }
      }
    },
    "threshold_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "version",
        "spec_hash"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "minLength": 12,
          "maxLength": 160,
          "pattern": "^kfm:threshold-profile:[a-z0-9_.:-]+$"
        },
        "version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "spec_hash": {
          "$ref": "https://schemas.kfm.local/contracts/v1/common/spec_hash.schema.json"
        }
      }
    },
    "threshold": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "threshold_id",
        "operator",
        "value",
        "unit"
      ],
      "properties": {
        "threshold_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9_.:-]*$"
        },
        "operator": {
          "type": "string",
          "enum": [
            "gt",
            "gte",
            "lt",
            "lte",
            "eq",
            "abs_gte"
          ]
        },
        "value": {
          "type": "number"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "\\S"
        }
      }
    },
    "ranked_row": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rank",
        "county_fips",
        "indicator_value",
        "evidence_ref_ids"
      ],
      "properties": {
        "rank": {
          "type": "integer",
          "minimum": 1,
          "maximum": 105
        },
        "county_fips": {
          "$ref": "#/$defs/county_fips"
        },
        "indicator_value": {
          "type": "number"
        },
        "evidence_ref_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference_id"
          }
        }
      }
    },
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_id",
        "member_count",
        "county_fips",
        "evidence_ref_ids"
      ],
      "properties": {
        "cluster_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9_.:-]*$"
        },
        "member_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 105
        },
        "county_fips": {
          "type": "array",
          "minItems": 1,
          "maxItems": 105,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/county_fips"
          }
        },
        "evidence_ref_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/reference_id"
          }
        }
      }
    },
    "cluster_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cluster_count",
        "clusters"
      ],
      "properties": {
        "cluster_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 105
        },
        "clusters": {
          "type": "array",
          "maxItems": 105,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/cluster"
          }
        }
      }
    },
    "environmental_indicator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "source_role",
        "method",
        "window_days",
        "threshold_profile",
        "thresholds",
        "county_fips",
        "ranked_rows",
        "cluster_summary",
        "data_state",
        "computed_at",
        "spec_hash"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/source"
        },
        "source_role": {
          "const": "derived_analysis"
        },
        "method": {
          "type": "string",
          "minLength": 8,
          "maxLength": 256,
          "pattern": "\\S"
        },
        "window_days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3660
        },
        "threshold_profile": {
          "$ref": "#/$defs/threshold_profile"
        },
        "thresholds": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/threshold"
          }
        },
        "county_fips": {
          "type": "array",
          "maxItems": 105,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/county_fips"
          }
        },
        "ranked_rows": {
          "type": "array",
          "maxItems": 105,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ranked_row"
          }
        },
        "cluster_summary": {
          "$ref": "#/$defs/cluster_summary"
        },
        "data_state": {
          "type": "string",
          "enum": [
            "POPULATED",
            "EMPTY",
            "NO_DATA"
          ]
        },
        "computed_at": {
          "$ref": "#/$defs/aware_datetime"
        },
        "spec_hash": {
          "$ref": "https://schemas.kfm.local/contracts/v1/common/spec_hash.schema.json"
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_identity",
        "observation_authority",
        "evidence_resolved",
        "policy_evaluated",
        "network_access_performed",
        "source_activated",
        "lifecycle_write_performed",
        "released",
        "published"
      ],
      "properties": {
        "deterministic_identity": {
          "const": true
        },
        "observation_authority": {
          "const": false
        },
        "evidence_resolved": {
          "const": false
        },
        "policy_evaluated": {
          "const": false
        },
        "network_access_performed": {
          "const": false
        },
        "source_activated": {
          "const": false
        },
        "lifecycle_write_performed": {
          "const": false
        },
        "released": {
          "const": false
        },
        "published": {
          "const": false
        }
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "execution_mode": "FIXTURE_ONLY",
    "contract_doc": "contracts/evidence/environmental_indicator_evidence_bundle_profile.md",
    "base_contract": "contracts/evidence/evidence_bundle.md",
    "base_schema": "schemas/contracts/v1/evidence/evidence_bundle.schema.json",
    "fixtures": "fixtures/contracts/v1/evidence/environmental_indicator_evidence_bundle_profile/cases.json",
    "validator": "tools/validators/validate_environmental_indicator_evidence_bundle_profile.py",
    "tests": "tests/validators/test_validate_environmental_indicator_evidence_bundle_profile.py",
    "source_cards": [
      "KFM-P32-IDEA-0013",
      "KFM-P32-PROG-0007"
    ],
    "non_effects": [
      "no_live_source_access",
      "no_observation_authority",
      "no_evidence_resolution_claim",
      "no_policy_or_review_creation",
      "no_lifecycle_write",
      "no_release_or_publication"
    ]
  }
}
