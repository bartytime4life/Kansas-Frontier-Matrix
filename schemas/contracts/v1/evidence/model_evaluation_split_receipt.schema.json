{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/model_evaluation_split_receipt.schema.json",
  "title": "ModelEvaluationSplitReceiptCandidate",
  "description": "Bounded fixture-only declaration of model-evaluation partition method, seed, stratification, spatial and temporal holdout scope, digest-bound partitions, leakage checks, and disclosure without accessing records, executing a model, or creating evidence, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "profile_spec_hash",
    "receipt_ref",
    "source_card",
    "observed_at",
    "intended_use",
    "evaluation_state",
    "model",
    "dataset",
    "split",
    "partitions",
    "leakage_checks",
    "evaluation",
    "disclosure",
    "limitations",
    "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "ModelEvaluationSplitReceiptCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.evidence.model-evaluation-split-receipt.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "receipt_ref": {
      "type": "string",
      "pattern": "^kfm:model-evaluation-split-receipt:[a-f0-9]{64}$"
    },
    "source_card": {"const": "KFM-P18-INV-481"},
    "observed_at": {"type": "string", "format": "date-time"},
    "intended_use": {
      "enum": [
        "INTERNAL_MODEL_QA",
        "LAYER_EVALUATION",
        "PUBLIC_EXPLANATION_SUPPORT_CANDIDATE"
      ]
    },
    "evaluation_state": {"enum": ["COMPLETE", "INCOMPLETE", "ERROR"]},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_card", "model_artifact", "layer_manifest"],
      "properties": {
        "model_card": {"$ref": "#/$defs/resolved_reference"},
        "model_artifact": {"$ref": "#/$defs/resolved_reference"},
        "layer_manifest": {"$ref": "#/$defs/resolved_reference"}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_snapshot",
        "split_manifest",
        "population_digest",
        "total_count",
        "identity_basis_ref"
      ],
      "properties": {
        "source_snapshot": {"$ref": "#/$defs/resolved_reference"},
        "split_manifest": {"$ref": "#/$defs/resolved_reference"},
        "population_digest": {"$ref": "#/$defs/sha256"},
        "total_count": {
          "type": "integer",
          "minimum": 2,
          "maximum": 9007199254740991
        },
        "identity_basis_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "split": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method",
        "method_definition",
        "random_seed",
        "stratification_fields",
        "grouping_fields",
        "spatial_holdout",
        "temporal_holdout"
      ],
      "properties": {
        "method": {
          "enum": [
            "RANDOM_HOLDOUT",
            "STRATIFIED_HOLDOUT",
            "GROUP_HOLDOUT",
            "SPATIAL_BLOCK",
            "TEMPORAL_BLOCK",
            "SPATIOTEMPORAL_BLOCK",
            "K_FOLD",
            "CUSTOM",
            "UNRESOLVED"
          ]
        },
        "method_definition": {"$ref": "#/$defs/resolved_reference"},
        "random_seed": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {"type": "null"}
          ]
        },
        "stratification_fields": {"$ref": "#/$defs/field_array"},
        "grouping_fields": {"$ref": "#/$defs/field_array"},
        "spatial_holdout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "geography_ref", "policy_ref"],
          "properties": {
            "scope": {
              "enum": [
                "NOT_APPLICABLE",
                "BLOCKED",
                "LEAVE_REGION_OUT",
                "UNRESOLVED"
              ]
            },
            "geography_ref": {"$ref": "#/$defs/nullable_ref"},
            "policy_ref": {"$ref": "#/$defs/nullable_ref"}
          }
        },
        "temporal_holdout": {
          "type": "object",
          "additionalProperties": false,
          "required": ["scope", "window_ref", "policy_ref"],
          "properties": {
            "scope": {
              "enum": [
                "NOT_APPLICABLE",
                "FORWARD_CHAIN",
                "HOLDOUT_WINDOW",
                "UNRESOLVED"
              ]
            },
            "window_ref": {"$ref": "#/$defs/nullable_ref"},
            "policy_ref": {"$ref": "#/$defs/nullable_ref"}
          }
        }
      }
    },
    "partitions": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/partition"}
    },
    "leakage_checks": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/leakage_check"}
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evaluation_receipt",
        "metric_refs",
        "generalization_assessment_ref"
      ],
      "properties": {
        "evaluation_receipt": {"$ref": "#/$defs/resolved_reference"},
        "metric_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ref"}
        },
        "generalization_assessment_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "holdout_scope_note",
        "evidence_bundle_refs",
        "review_record_refs",
        "release_manifest_ref"
      ],
      "properties": {
        "holdout_scope_note": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 12,
              "maxLength": 1200,
              "pattern": "^[^\\r\\n]+$"
            },
            {"type": "null"}
          ]
        },
        "evidence_bundle_refs": {"$ref": "#/$defs/ref_array"},
        "review_record_refs": {"$ref": "#/$defs/ref_array"},
        "release_manifest_ref": {"type": "null"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DECLARATION_ONLY",
          "NO_DATASET_ACCESS",
          "NO_EVIDENCE_RESOLUTION",
          "NO_MODEL_EXECUTION",
          "NO_PUBLICATION_AUTHORITY"
        ]
      }
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dataset_truth",
        "split_correctness",
        "model_performance",
        "generalization_authority",
        "evidence_authority",
        "policy_authority",
        "review_authority",
        "promotion_authority",
        "release_authority",
        "deployment_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "dataset_truth": {"const": false},
        "split_correctness": {"const": false},
        "model_performance": {"const": false},
        "generalization_authority": {"const": false},
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "deployment_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^\\S+$"
    },
    "nullable_ref": {
      "oneOf": [
        {"$ref": "#/$defs/ref"},
        {"type": "null"}
      ]
    },
    "ref_array": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "field_array": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160,
        "pattern": "^[A-Za-z_][A-Za-z0-9_.-]*$"
      }
    },
    "resolved_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "resolution"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    },
    "partition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "role",
        "artifact_ref",
        "digest",
        "count",
        "resolution",
        "class_distribution_ref",
        "spatial_scope_ref",
        "temporal_scope_ref"
      ],
      "properties": {
        "role": {"enum": ["TRAIN", "VALIDATION", "TEST"]},
        "artifact_ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]},
        "class_distribution_ref": {"$ref": "#/$defs/nullable_ref"},
        "spatial_scope_ref": {"$ref": "#/$defs/nullable_ref"},
        "temporal_scope_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "leakage_check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["check_type", "status", "evidence_ref"],
      "properties": {
        "check_type": {
          "enum": [
            "IDENTITY_OVERLAP",
            "GROUP_OVERLAP",
            "SPATIAL_OVERLAP",
            "TEMPORAL_ORDER"
          ]
        },
        "status": {"enum": ["PASS", "FAIL", "NOT_APPLICABLE", "UNRESOLVED"]},
        "evidence_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    }
  }
}
