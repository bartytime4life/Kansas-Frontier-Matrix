{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/release_bound_run_receipt.schema.json",
  "title": "ReleaseBoundRunReceipt",
  "description": "Fixture-only proof profile that binds one runtime RunReceipt summary to immutable inputs, outputs, attestations, evidence, policy, review, correction, and rollback references without granting release or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "profile_spec_hash",
    "observed_at",
    "actor",
    "started_at",
    "finished_at",
    "runtime_receipt_binding",
    "input_artifacts",
    "output_artifacts",
    "attestations",
    "evidence_refs",
    "release_binding",
    "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "ReleaseBoundRunReceipt"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.release-bound-run-receipt.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "observed_at": {"type": "string", "format": "date-time"},
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "id"],
      "properties": {
        "kind": {"enum": ["human", "service", "workflow", "agent"]},
        "id": {"type": "string", "minLength": 3, "maxLength": 256, "pattern": "\\S"}
      }
    },
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "runtime_receipt_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run_receipt_ref", "run_id", "stage", "outcome", "spec_hash", "inputs", "outputs"],
      "properties": {
        "run_receipt_ref": {"$ref": "#/$defs/immutable_ref"},
        "run_id": {"type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[a-z][a-z0-9_:.-]*$"},
        "stage": {"const": "release_candidate"},
        "outcome": {"enum": ["SUCCESS", "PARTIAL", "FAIL"]},
        "spec_hash": {"$ref": "#/$defs/sha256"},
        "inputs": {"$ref": "#/$defs/ref_list"},
        "outputs": {"$ref": "#/$defs/ref_list"}
      }
    },
    "input_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/input_artifact"}
    },
    "output_artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/output_artifact"}
    },
    "attestations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "uri", "digest", "verification_status"],
        "properties": {
          "type": {"enum": ["DSSE", "COSIGN_BUNDLE", "IN_TOTO", "OTHER"]},
          "uri": {"$ref": "#/$defs/immutable_ref"},
          "digest": {"$ref": "#/$defs/sha256"},
          "verification_status": {"enum": ["VERIFIED", "UNVERIFIED", "FAILED", "ERROR"]}
        }
      }
    },
    "evidence_refs": {"$ref": "#/$defs/ref_list"},
    "release_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "release_candidate_ref",
        "candidate_zone",
        "evidence_status",
        "policy_status",
        "policy_decision_ref",
        "review_status",
        "review_ref",
        "signature_status",
        "correction_status",
        "correction_path_ref",
        "rollback_status",
        "rollback_ref"
      ],
      "properties": {
        "release_candidate_ref": {"$ref": "#/$defs/immutable_ref"},
        "candidate_zone": {"const": "PUBLISHED_CANDIDATE"},
        "evidence_status": {"enum": ["RESOLVED", "UNRESOLVED", "DENIED", "ERROR"]},
        "policy_status": {"enum": ["ALLOW", "HOLD", "DENY", "ERROR"]},
        "policy_decision_ref": {"$ref": "#/$defs/immutable_ref"},
        "review_status": {"enum": ["APPROVED", "PENDING", "CHANGES_REQUESTED", "REJECTED", "ERROR"]},
        "review_ref": {"$ref": "#/$defs/immutable_ref"},
        "signature_status": {"enum": ["VERIFIED", "PENDING", "FAILED", "ERROR"]},
        "correction_status": {"enum": ["READY", "MISSING", "ERROR"]},
        "correction_path_ref": {"$ref": "#/$defs/immutable_ref"},
        "rollback_status": {"enum": ["READY", "MISSING", "ERROR"]},
        "rollback_ref": {"$ref": "#/$defs/immutable_ref"}
      }
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_authority", "policy_authority", "review_authority", "promotion_authority", "release_authority", "publication_authority"],
      "properties": {
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$",
      "not": {"pattern": "^sha256:0{64}$"}
    },
    "immutable_ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1024,
      "pattern": "\\S",
      "not": {"pattern": "(?i)(^|[/:._-])latest($|[/:._-])"}
    },
    "ref_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/immutable_ref"}
    },
    "input_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest"],
      "properties": {
        "uri": {"$ref": "#/$defs/immutable_ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 3, "maxLength": 255}
      }
    },
    "output_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri", "digest", "media_type"],
      "properties": {
        "uri": {"$ref": "#/$defs/immutable_ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 3, "maxLength": 255}
      }
    }
  }
}
