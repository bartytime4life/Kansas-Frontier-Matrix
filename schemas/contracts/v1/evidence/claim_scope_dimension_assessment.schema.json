{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/claim_scope_dimension_assessment.schema.json",
  "title": "ClaimScopeDimensionAssessmentCandidate",
  "description": "Fixture-only assessment of declared time, space, and attribute roles for one claim without authority effects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_type", "schema_version", "profile", "profile_spec_hash", "source_card", "observed_at", "claim_ref", "claim_digest", "intended_use", "representation_model", "evidence_bundle_scope", "dimensions", "assessment", "authority_claims"],
  "properties": {
    "object_type": {"const": "ClaimScopeDimensionAssessmentCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.evidence.claim-scope-dimension-assessment.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_card": {"const": "KFM-P18-INV-376"},
    "observed_at": {"type": "string", "format": "date-time"},
    "claim_ref": {"$ref": "#/$defs/ref"},
    "claim_digest": {"$ref": "#/$defs/sha256"},
    "intended_use": {"enum": ["INTERNAL_QA", "EVIDENCE_ASSESSMENT", "EXPLORATORY_ANALYSIS", "PUBLIC_MAP", "PUBLIC_ANSWER", "POLICY_CONTEXT"]},
    "representation_model": {"enum": ["VECTOR_FEATURES", "RASTER_SURFACE", "TABULAR_PANEL", "GRAPH_RELATIONS", "OTHER"]},
    "evidence_bundle_scope": {"$ref": "#/$defs/resolved_reference"},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "space", "attribute"],
      "properties": {
        "time": {"$ref": "#/$defs/dimension"},
        "space": {"$ref": "#/$defs/dimension"},
        "attribute": {"$ref": "#/$defs/dimension"}
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "controlled_dimensions", "measured_dimensions", "unresolved_dimensions", "obligations", "review_record_refs"],
      "properties": {
        "state": {"enum": ["COMPLETE", "INCOMPLETE", "UNKNOWN"]},
        "controlled_dimensions": {"$ref": "#/$defs/dimension_names"},
        "measured_dimensions": {"$ref": "#/$defs/dimension_names"},
        "unresolved_dimensions": {"$ref": "#/$defs/dimension_names"},
        "obligations": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {"enum": ["ATTRIBUTE_SCOPE_DISCLOSURE", "PUBLIC_SCOPE_CAVEAT_REQUIRED", "SPACE_SCOPE_DISCLOSURE", "TIME_SCOPE_DISCLOSURE", "UNRESOLVED_DIMENSION_REVIEW_REQUIRED"]}
        },
        "review_record_refs": {"$ref": "#/$defs/ref_array"}
      }
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_authority", "scope_authority", "evidence_authority", "policy_authority", "review_authority", "lifecycle_authority", "release_authority", "publication_authority", "public_answer_authority"],
      "properties": {
        "claim_authority": {"const": false},
        "scope_authority": {"const": false},
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "lifecycle_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_answer_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^\\S+$"},
    "ref_array": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "resolved_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "resolution"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    },
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "scope_ref", "scope_digest", "resolution"],
      "properties": {
        "role": {"enum": ["CONTROLLED", "MEASURED", "UNRESOLVED"]},
        "scope_ref": {"$ref": "#/$defs/ref"},
        "scope_digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    },
    "dimension_names": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {"enum": ["ATTRIBUTE", "SPACE", "TIME"]}
    }
  },
  "x-kfm": {
    "contract_doc": "contracts/evidence/claim_scope_dimension_assessment.md",
    "fixtures_root": "fixtures/contracts/v1/evidence/claim_scope_dimension_assessment/",
    "validator": "tools/validators/evidence/validate_claim_scope_dimension_assessment.py",
    "status": "PROPOSED_INACTIVE",
    "network": false,
    "authority_effects": false
  }
}
