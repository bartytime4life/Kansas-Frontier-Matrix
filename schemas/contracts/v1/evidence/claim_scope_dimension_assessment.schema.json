{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/claim_scope_dimension_assessment.schema.json",
  "title": "ClaimScopeDimensionAssessmentCandidate",
  "description": "Fixture-only assessment of measured and controlled time, space, and attribute dimensions without authority effects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_type", "schema_version", "profile", "profile_spec_hash", "source_card", "observed_at", "claim_ref", "claim_digest", "evidence_bundle_ref", "evidence_bundle_digest", "intended_use", "assessment", "dimensions", "limitations", "authority_claims"],
  "properties": {
    "object_type": {"const": "ClaimScopeDimensionAssessmentCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.evidence.claim-scope-dimension-assessment.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_card": {"const": "KFM-P18-INV-376"},
    "observed_at": {"type": "string", "format": "date-time"},
    "claim_ref": {"$ref": "#/$defs/ref"},
    "claim_digest": {"$ref": "#/$defs/sha256"},
    "evidence_bundle_ref": {"$ref": "#/$defs/ref"},
    "evidence_bundle_digest": {"$ref": "#/$defs/sha256"},
    "intended_use": {"enum": ["INTERNAL_QA", "EXPLORATORY_ANALYSIS", "PUBLIC_CANDIDATE", "POLICY_CONTEXT"]},
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "measured_dimension", "interpretation_class", "review_record_refs"],
      "properties": {
        "state": {"enum": ["COMPLETE", "INCOMPLETE", "UNKNOWN"]},
        "measured_dimension": {"enum": ["TIME", "SPACE", "ATTRIBUTE", "UNKNOWN"]},
        "interpretation_class": {"enum": ["TIME_SERIES_AT_CONTROLLED_SPACE_ATTRIBUTE", "SPATIAL_CROSS_SECTION_AT_CONTROLLED_TIME_ATTRIBUTE", "ATTRIBUTE_COMPARISON_AT_CONTROLLED_TIME_SPACE", "UNRESOLVED"]},
        "review_record_refs": {"$ref": "#/$defs/ref_array"}
      }
    },
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "space", "attribute"],
      "properties": {
        "time": {"$ref": "#/$defs/dimension"},
        "space": {"$ref": "#/$defs/dimension"},
        "attribute": {"$ref": "#/$defs/dimension"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {"enum": ["CLAIM_SCOPE_ONLY", "NO_EVIDENCE_RESOLUTION", "NO_REPRESENTATION_AUTHORITY", "NO_PUBLICATION_AUTHORITY"]}
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["claim_truth_authority", "evidence_authority", "representation_authority", "policy_authority", "review_authority", "promotion_authority", "release_authority", "publication_authority", "public_use_authority"],
      "properties": {
        "claim_truth_authority": {"const": false},
        "evidence_authority": {"const": false},
        "representation_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^\\S+$"},
    "ref_array": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "scope_ref", "scope_digest", "resolution"],
      "properties": {
        "role": {"enum": ["MEASURED", "CONTROLLED", "UNRESOLVED"]},
        "scope_ref": {"$ref": "#/$defs/ref"},
        "scope_digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    }
  },
  "x-kfm": {
    "contract_doc": "contracts/evidence/claim_scope_dimension_assessment.md",
    "fixtures_root": "fixtures/contracts/v1/evidence/claim_scope_dimension_assessment/",
    "validator": "tools/validators/evidence/validate_claim_scope_dimension_assessment.py",
    "status": "PROPOSED_INACTIVE",
    "network": false,
    "authority_effects": false
  }
}
