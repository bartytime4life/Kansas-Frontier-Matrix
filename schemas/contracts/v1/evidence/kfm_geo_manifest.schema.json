{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/kfm_geo_manifest.schema.json",
  "title": "KFMGeoManifest fixture profile",
  "description": "Closed fixture-first metadata profile for one geospatial artifact candidate. Validation proves bounded shape and local consistency only; it does not resolve evidence, evaluate policy, approve release, publish, or implement ADR-0023 signing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile_id",
    "hash_profile",
    "id",
    "version",
    "spec_hash",
    "artifact",
    "claim_scope",
    "source_role",
    "evidence",
    "spatial",
    "derivation",
    "governance",
    "lineage",
    "limitations"
  ],
  "properties": {
    "object_type": {
      "const": "KFMGeoManifest"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "profile_id": {
      "const": "fixture-first-v1"
    },
    "hash_profile": {
      "const": "kfm-fixture-json-v1"
    },
    "id": {
      "type": "string",
      "pattern": "^geo-manifest:[a-z0-9][a-z0-9._:-]{7,240}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "spec_hash": {
      "$ref": "#/$defs/sha256_digest"
    },
    "artifact": {
      "$ref": "#/$defs/artifact"
    },
    "claim_scope": {
      "$ref": "#/$defs/claim_scope"
    },
    "source_role": {
      "type": "string",
      "enum": [
        "derived",
        "modeled",
        "context",
        "observation_projection"
      ]
    },
    "evidence": {
      "$ref": "#/$defs/evidence"
    },
    "spatial": {
      "$ref": "#/$defs/spatial"
    },
    "derivation": {
      "$ref": "#/$defs/derivation"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "lineage": {
      "$ref": "#/$defs/lineage"
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 500
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "nonempty_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 640,
      "pattern": "\\S"
    },
    "nullable_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/nonempty_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256_digest": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "aware_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullable_datetime": {
      "oneOf": [
        {
          "$ref": "#/$defs/aware_datetime"
        },
        {
          "type": "null"
        }
      ]
    },
    "required_ref_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/nonempty_ref"
      },
      "uniqueItems": true
    },
    "optional_ref_array": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/nonempty_ref"
      },
      "uniqueItems": true
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref",
        "artifact_type",
        "artifact_role",
        "media_type",
        "byte_length",
        "content_digest",
        "source_artifact_refs"
      ],
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/nonempty_ref"
        },
        "artifact_type": {
          "type": "string",
          "enum": [
            "pmtiles",
            "cog",
            "geoparquet",
            "geojson"
          ]
        },
        "artifact_role": {
          "type": "string",
          "enum": [
            "release_candidate",
            "generalized_derivative",
            "rollback_target"
          ]
        },
        "media_type": {
          "type": "string",
          "enum": [
            "application/vnd.pmtiles",
            "image/tiff; application=geotiff; profile=cloud-optimized",
            "application/vnd.apache.parquet",
            "application/geo+json"
          ]
        },
        "byte_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 67108864
        },
        "content_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "source_artifact_refs": {
          "$ref": "#/$defs/required_ref_array"
        }
      }
    },
    "claim_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_ref",
        "description",
        "geography_ref",
        "temporal_scope"
      ],
      "properties": {
        "scope_ref": {
          "$ref": "#/$defs/nonempty_ref"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "geography_ref": {
          "$ref": "#/$defs/nonempty_ref"
        },
        "temporal_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "valid_from",
            "valid_to"
          ],
          "properties": {
            "valid_from": {
              "$ref": "#/$defs/nullable_datetime"
            },
            "valid_to": {
              "$ref": "#/$defs/nullable_datetime"
            }
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_bundle_refs",
        "evidence_refs",
        "source_descriptor_refs"
      ],
      "properties": {
        "evidence_bundle_refs": {
          "$ref": "#/$defs/required_ref_array"
        },
        "evidence_refs": {
          "$ref": "#/$defs/required_ref_array"
        },
        "source_descriptor_refs": {
          "$ref": "#/$defs/required_ref_array"
        }
      }
    },
    "zoom_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "min_zoom",
        "max_zoom"
      ],
      "properties": {
        "kind": {
          "const": "zoom_range"
        },
        "min_zoom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "max_zoom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        }
      }
    },
    "ground_resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "ground_resolution_m"
        },
        "value": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000
        }
      }
    },
    "nominal_scale": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "value"
      ],
      "properties": {
        "kind": {
          "const": "nominal_scale_denominator"
        },
        "value": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000000000
        }
      }
    },
    "tiling_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme",
        "tile_size",
        "min_zoom",
        "max_zoom"
      ],
      "properties": {
        "scheme": {
          "const": "xyz"
        },
        "tile_size": {
          "type": "integer",
          "enum": [
            256,
            512
          ]
        },
        "min_zoom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        },
        "max_zoom": {
          "type": "integer",
          "minimum": 0,
          "maximum": 24
        }
      }
    },
    "spatial": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "crs",
        "bbox",
        "geometry_type",
        "scale_or_resolution",
        "tiling_profile"
      ],
      "properties": {
        "crs": {
          "type": "string",
          "pattern": "^(?:EPSG:[0-9]{4,6}|https://www\\.opengis\\.net/def/crs/\\S+)$"
        },
        "bbox": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number"
          }
        },
        "geometry_type": {
          "type": "string",
          "enum": [
            "Point",
            "MultiPoint",
            "LineString",
            "MultiLineString",
            "Polygon",
            "MultiPolygon",
            "GeometryCollection",
            "Raster",
            "VectorTileSet"
          ]
        },
        "scale_or_resolution": {
          "oneOf": [
            {
              "$ref": "#/$defs/zoom_range"
            },
            {
              "$ref": "#/$defs/ground_resolution"
            },
            {
              "$ref": "#/$defs/nominal_scale"
            }
          ]
        },
        "tiling_profile": {
          "oneOf": [
            {
              "$ref": "#/$defs/tiling_profile"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transform_id",
        "operation",
        "input_digest",
        "output_digest",
        "receipt_ref"
      ],
      "properties": {
        "transform_id": {
          "type": "string",
          "pattern": "^transform:[a-z0-9][a-z0-9._:-]{4,240}$"
        },
        "operation": {
          "type": "string",
          "enum": [
            "reproject",
            "clip",
            "simplify",
            "aggregate",
            "generalize",
            "redact",
            "join",
            "tile",
            "rasterize",
            "encode"
          ]
        },
        "input_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "output_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "receipt_ref": {
          "$ref": "#/$defs/nullable_ref"
        }
      }
    },
    "derivation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parameters_digest",
        "transforms",
        "receipt_refs"
      ],
      "properties": {
        "parameters_digest": {
          "$ref": "#/$defs/sha256_digest"
        },
        "transforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/transform"
          }
        },
        "receipt_refs": {
          "$ref": "#/$defs/required_ref_array"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_state",
        "sensitivity_state",
        "policy_decision_ref",
        "review_ref",
        "rollback_ref",
        "release_manifest_ref",
        "release_state",
        "public_use_allowed",
        "authority_created"
      ],
      "properties": {
        "rights_state": {
          "type": "string",
          "enum": [
            "verified_open",
            "verified_restricted",
            "unknown",
            "denied"
          ]
        },
        "sensitivity_state": {
          "type": "string",
          "enum": [
            "public",
            "generalized",
            "redacted",
            "restricted",
            "unknown"
          ]
        },
        "policy_decision_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "review_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "rollback_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "release_manifest_ref": {
          "type": "null"
        },
        "release_state": {
          "const": "not_released"
        },
        "public_use_allowed": {
          "const": false
        },
        "authority_created": {
          "const": false
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supersedes",
        "correction_refs",
        "rollback_of"
      ],
      "properties": {
        "supersedes": {
          "$ref": "#/$defs/nullable_ref"
        },
        "correction_refs": {
          "$ref": "#/$defs/optional_ref_array"
        },
        "rollback_of": {
          "$ref": "#/$defs/nullable_ref"
        }
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED",
    "contract_doc": "contracts/evidence/kfm_geo_manifest.md",
    "fixtures_root": "fixtures/evidence/kfm_geo_manifest/",
    "validator": "tools/validators/evidence/validate_kfm_geo_manifest.py",
    "tests": "tests/validators/test_validate_kfm_geo_manifest.py",
    "hash_profile": "kfm-fixture-json-v1",
    "authority": "fixture_first_geospatial_artifact_metadata_only",
    "non_effects": [
      "does_not_accept_adr_0023",
      "does_not_sign_or_verify_signatures",
      "does_not_resolve_evidence",
      "does_not_evaluate_policy_or_review",
      "does_not_release_or_publish"
    ]
  }
}
