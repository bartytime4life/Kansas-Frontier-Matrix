{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/planning_proxy_uncertainty_assessment.schema.json",
  "title": "PlanningProxyUncertaintyAssessmentCandidate",
  "description": "Fixture-only proxy and uncertainty disclosure assessment without planning, evidence, policy, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "profile_spec_hash",
    "source_card",
    "observed_at",
    "planning_product_ref",
    "planning_product_digest",
    "evidence_scope",
    "assessment",
    "proxy_sources",
    "uncertainty",
    "scenario_limitations",
    "authority_claims"
  ],
  "properties": {
    "object_type": {
      "const": "PlanningProxyUncertaintyAssessmentCandidate"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "profile": {
      "const": "kfm.evidence.planning-proxy-uncertainty-assessment.fixture.v1"
    },
    "profile_spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "source_card": {
      "const": "KFM-P18-INV-320"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "planning_product_ref": {
      "$ref": "#/$defs/ref"
    },
    "planning_product_digest": {
      "$ref": "#/$defs/sha256"
    },
    "evidence_scope": {
      "$ref": "#/$defs/resolved_reference"
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope_statement",
        "evidence_condition",
        "proxy_use",
        "scenario_use",
        "state",
        "known_undisclosed_limitation_count"
      ],
      "properties": {
        "scope_statement": {
          "type": "string",
          "minLength": 12,
          "maxLength": 1000
        },
        "evidence_condition": {
          "enum": [
            "SUFFICIENT",
            "DATA_POOR",
            "UNKNOWN"
          ]
        },
        "proxy_use": {
          "enum": [
            "NONE",
            "SUPPLEMENTAL",
            "PRIMARY"
          ]
        },
        "scenario_use": {
          "enum": [
            "EXPLORATORY",
            "DECISION_SUPPORT"
          ]
        },
        "state": {
          "enum": [
            "COMPLETE_FOR_DECLARED_SCOPE",
            "INCOMPLETE",
            "UNKNOWN"
          ]
        },
        "known_undisclosed_limitation_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000
        }
      }
    },
    "proxy_sources": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/proxy"
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification",
        "quantified",
        "method_ref",
        "public_disclosure"
      ],
      "properties": {
        "classification": {
          "enum": [
            "LOW",
            "MODERATE",
            "HIGH",
            "UNKNOWN"
          ]
        },
        "quantified": {
          "type": "boolean"
        },
        "method_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "public_disclosure": {
          "enum": [
            "INLINE",
            "LEGEND",
            "EVIDENCE_DRAWER",
            "REPORT",
            "NONE"
          ]
        }
      }
    },
    "scenario_limitations": {
      "$ref": "#/$defs/string_array"
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_authority",
        "policy_authority",
        "review_authority",
        "planning_decision_authority",
        "promotion_authority",
        "release_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "evidence_authority": {
          "const": false
        },
        "policy_authority": {
          "const": false
        },
        "review_authority": {
          "const": false
        },
        "planning_decision_authority": {
          "const": false
        },
        "promotion_authority": {
          "const": false
        },
        "release_authority": {
          "const": false
        },
        "publication_authority": {
          "const": false
        },
        "public_use_authority": {
          "const": false
        }
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^\\S+$"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][a-z0-9_.:-]*$"
    },
    "string_array": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 3,
        "maxLength": 500
      }
    },
    "resolved_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ref",
        "digest",
        "resolution"
      ],
      "properties": {
        "ref": {
          "$ref": "#/$defs/ref"
        },
        "digest": {
          "$ref": "#/$defs/sha256"
        },
        "resolution": {
          "enum": [
            "RESOLVED",
            "UNRESOLVED"
          ]
        }
      }
    },
    "proxy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "proxy_id",
        "evidence_ref",
        "proxy_role",
        "target_measure_ref",
        "fitness",
        "assumptions",
        "limitations"
      ],
      "properties": {
        "proxy_id": {
          "$ref": "#/$defs/id"
        },
        "evidence_ref": {
          "$ref": "#/$defs/ref"
        },
        "proxy_role": {
          "enum": [
            "SURROGATE_MEASURE",
            "SPATIAL_TRANSFER",
            "TEMPORAL_TRANSFER",
            "MODEL_DERIVATION",
            "EXPERT_ASSUMPTION"
          ]
        },
        "target_measure_ref": {
          "$ref": "#/$defs/ref"
        },
        "fitness": {
          "enum": [
            "SUITABLE_WITH_LIMITS",
            "REVIEW_REQUIRED",
            "UNKNOWN"
          ]
        },
        "assumptions": {
          "$ref": "#/$defs/string_array"
        },
        "limitations": {
          "$ref": "#/$defs/string_array"
        }
      }
    }
  },
  "x-kfm": {
    "contract_doc": "contracts/evidence/planning_proxy_uncertainty_assessment.md",
    "fixtures_root": "fixtures/contracts/v1/evidence/planning_proxy_uncertainty_assessment/",
    "validator": "tools/validators/evidence/validate_planning_proxy_uncertainty_assessment.py",
    "status": "PROPOSED_INACTIVE",
    "network": false,
    "authority_effects": false
  }
}
