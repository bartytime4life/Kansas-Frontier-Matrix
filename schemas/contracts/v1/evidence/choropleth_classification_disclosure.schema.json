{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/choropleth_classification_disclosure.schema.json",
  "title": "ChoroplethClassificationDisclosureCandidate",
  "description": "Fixture-only declaration of choropleth classification and review-facing disclosure without statistical, cartographic, policy, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "profile_spec_hash",
    "source_card",
    "observed_at",
    "layer_manifest",
    "aggregate_statistic",
    "indicator_definition",
    "geography_version",
    "intended_use",
    "classification",
    "disclosure",
    "limitations",
    "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "ChoroplethClassificationDisclosureCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.evidence.choropleth-classification-disclosure.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_card": {"const": "KFM-P18-INV-477"},
    "observed_at": {"type": "string", "format": "date-time"},
    "layer_manifest": {"$ref": "#/$defs/resolved_reference"},
    "aggregate_statistic": {"$ref": "#/$defs/resolved_reference"},
    "indicator_definition": {"$ref": "#/$defs/resolved_reference"},
    "geography_version": {"$ref": "#/$defs/resolved_reference"},
    "intended_use": {
      "enum": [
        "INTERNAL_QA",
        "EXPLORATORY_ANALYSIS",
        "PUBLIC_MAP_CANDIDATE",
        "POLICY_CONTEXT_CANDIDATE"
      ]
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "method",
        "class_count",
        "break_values",
        "boundary_rule",
        "geography_unit",
        "method_definition",
        "rationale_ref",
        "value_range",
        "null_treatment",
        "outlier_treatment"
      ],
      "properties": {
        "state": {"enum": ["COMPLETE", "INCOMPLETE", "UNKNOWN", "ERROR"]},
        "method": {
          "enum": [
            "EQUAL_INTERVAL",
            "QUANTILE",
            "NATURAL_BREAKS",
            "STANDARD_DEVIATION",
            "MANUAL",
            "CUSTOM",
            "UNKNOWN"
          ]
        },
        "class_count": {
          "oneOf": [
            {"type": "integer", "minimum": 2, "maximum": 12},
            {"type": "null"}
          ]
        },
        "break_values": {
          "type": "array",
          "maxItems": 13,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/decimal_text"}
        },
        "boundary_rule": {
          "enum": [
            "LOWER_INCLUSIVE_UPPER_EXCLUSIVE",
            "BOTH_INCLUSIVE_WITH_ORDERED_TIEBREAK",
            "METHOD_DEFINED",
            "UNKNOWN"
          ]
        },
        "geography_unit": {
          "enum": ["COUNTY", "TRACT", "BLOCK_GROUP", "HUC12", "GRID_CELL", "CUSTOM", "UNKNOWN"]
        },
        "method_definition": {"$ref": "#/$defs/resolved_reference"},
        "rationale_ref": {"$ref": "#/$defs/nullable_ref"},
        "value_range": {
          "type": "object",
          "additionalProperties": false,
          "required": ["assumption", "minimum", "maximum", "assumption_ref"],
          "properties": {
            "assumption": {
              "enum": [
                "OBSERVED_EXTENT",
                "FIXED_DOMAIN",
                "TRIMMED_EXTENT",
                "WINSORIZED_EXTENT",
                "STANDARDIZED_EXTENT",
                "CUSTOM",
                "UNKNOWN"
              ]
            },
            "minimum": {"$ref": "#/$defs/nullable_decimal_text"},
            "maximum": {"$ref": "#/$defs/nullable_decimal_text"},
            "assumption_ref": {"$ref": "#/$defs/nullable_ref"}
          }
        },
        "null_treatment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "null_count", "treatment_ref"],
          "properties": {
            "mode": {
              "enum": [
                "EXCLUDED_WITH_COUNT",
                "SEPARATE_CLASS",
                "DISPLAY_AS_NO_DATA",
                "IMPUTED_WITH_METHOD_REF",
                "UNKNOWN"
              ]
            },
            "null_count": {
              "oneOf": [{"type": "integer", "minimum": 0}, {"type": "null"}]
            },
            "treatment_ref": {"$ref": "#/$defs/nullable_ref"}
          }
        },
        "outlier_treatment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "treatment_ref"],
          "properties": {
            "mode": {
              "enum": [
                "INCLUDED",
                "CLIPPED",
                "TRIMMED",
                "WINSORIZED",
                "SEPARATE_CLASS",
                "UNKNOWN"
              ]
            },
            "treatment_ref": {"$ref": "#/$defs/nullable_ref"}
          }
        }
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "legend_ref",
        "review_record_refs",
        "evidence_drawer_section_ref",
        "public_interpretation_caveat"
      ],
      "properties": {
        "legend_ref": {"$ref": "#/$defs/nullable_ref"},
        "review_record_refs": {"$ref": "#/$defs/ref_array"},
        "evidence_drawer_section_ref": {"$ref": "#/$defs/nullable_ref"},
        "public_interpretation_caveat": {
          "oneOf": [
            {"type": "string", "minLength": 12, "maxLength": 1000},
            {"type": "null"}
          ]
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DECLARATION_ONLY",
          "NO_CLASSIFICATION_COMPUTATION",
          "NO_LEGEND_RENDERING",
          "NO_PUBLICATION_AUTHORITY"
        ]
      }
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "classification_authority",
        "analytics_authority",
        "legend_authority",
        "geography_authority",
        "evidence_authority",
        "policy_authority",
        "review_authority",
        "promotion_authority",
        "release_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "classification_authority": {"const": false},
        "analytics_authority": {"const": false},
        "legend_authority": {"const": false},
        "geography_authority": {"const": false},
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^\\S+$"},
    "nullable_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "ref_array": {
      "type": "array",
      "maxItems": 100,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "decimal_text": {
      "type": "string",
      "pattern": "^-?(?:0|[1-9][0-9]{0,15})(?:\\.[0-9]{1,12})?$"
    },
    "nullable_decimal_text": {
      "oneOf": [{"$ref": "#/$defs/decimal_text"}, {"type": "null"}]
    },
    "resolved_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "resolution"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}
      }
    }
  },
  "x-kfm": {
    "contract_doc": "contracts/evidence/choropleth_classification_disclosure.md",
    "fixtures_root": "fixtures/contracts/v1/evidence/choropleth_classification_disclosure/",
    "validator": "tools/validators/evidence/validate_choropleth_classification_disclosure.py",
    "status": "PROPOSED_INACTIVE",
    "network": false,
    "authority_effects": false
  }
}
