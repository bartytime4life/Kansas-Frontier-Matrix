{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/source_conflict_influence_assessment.schema.json",
  "title": "SourceConflictInfluenceAssessmentCandidate",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "aware_datetime": {"type":"string","format":"date-time","pattern":"(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "spec_hash": {"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "nullable_evidence_ref": {
      "oneOf": [
        {"type":"string","pattern":"^kfm:evidence:[a-z0-9][a-z0-9._:-]{2,220}$"},
        {"type":"null"}
      ]
    },
    "axis": {
      "enum": ["MISSINGNESS", "PRECISION", "SCALE", "SOURCE_ROLE", "SPATIAL_SUPPORT", "TEMPORAL_SUPPORT", "UNIT"]
    },
    "source_role": {
      "enum": [
        "authoritative_for_claim",
        "regulatory_context",
        "legal_context",
        "observation",
        "occurrence_evidence",
        "aggregator",
        "operational_context",
        "remote_sensing_observation",
        "model_context",
        "candidate_signal",
        "historical_context",
        "corroborating_context",
        "derived_public_product",
        "steward_review_source",
        "citation_source",
        "fixture_only"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_id": {"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,127}$"},
        "source_descriptor_ref": {"type":"string","pattern":"^kfm://source/[a-z0-9][a-z0-9._:-]{2,127}$"},
        "source_role": {"$ref":"#/$defs/source_role"},
        "evidence_ref": {"$ref":"#/$defs/nullable_evidence_ref"},
        "eligibility": {"enum":["ELIGIBLE","EXCLUDED","REVOKED","INAPPLICABLE"]},
        "influence_role": {"enum":["DOMINANT","CONTRIBUTING","CONTEXT_ONLY","EXCLUDED","NON_INFLUENTIAL"]},
        "reason_codes": {
          "type":"array","minItems":1,"maxItems":1,"uniqueItems":true,
          "items":{"enum":["ELIGIBLE_FOR_COMPARISON","EVIDENCE_REVOKED","PROFILE_EXCLUDED","SOURCE_INAPPLICABLE"]}
        }
      },
      "required":["source_id","source_descriptor_ref","source_role","evidence_ref","eligibility","influence_role","reason_codes"]
    },
    "comparison": {
      "type":"object",
      "additionalProperties":false,
      "properties":{
        "pair_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,127}::[a-z0-9][a-z0-9._-]{2,127}$"},
        "left_source_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,127}$"},
        "right_source_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,127}$"},
        "axes":{"type":"array","minItems":1,"maxItems":7,"uniqueItems":true,"items":{"$ref":"#/$defs/axis"}},
        "relationship":{"enum":["CONSISTENT","DIVERGENT","CONFLICTING","INSUFFICIENT","INAPPLICABLE","REVOKED_EVIDENCE"]},
        "reason_codes":{
          "type":"array","minItems":1,"maxItems":1,"uniqueItems":true,
          "items":{"enum":["COMPARISON_CONFLICTING","COMPARISON_CONSISTENT","COMPARISON_DIVERGENT","COMPARISON_INSUFFICIENT","COMPARISON_INAPPLICABLE","COMPARISON_REVOKED_EVIDENCE"]}
        }
      },
      "required":["pair_id","left_source_id","right_source_id","axes","relationship","reason_codes"]
    },
    "governance": {
      "type":"object",
      "additionalProperties":false,
      "properties":{
        "execution_mode":{"const":"FIXTURE_ONLY"},
        "network_attempted":{"const":false},
        "source_payload_compared":{"const":false},
        "source_role_changed":{"const":false},
        "evidence_resolved":{"const":false},
        "truth_selected":{"const":false},
        "claim_authorized":{"const":false},
        "policy_evaluated":{"const":false},
        "review_approved":{"const":false},
        "release_authorized":{"const":false},
        "publication_authorized":{"const":false},
        "public_use_allowed":{"const":false}
      },
      "required":["execution_mode","network_attempted","source_payload_compared","source_role_changed","evidence_resolved","truth_selected","claim_authorized","policy_evaluated","review_approved","release_authorized","publication_authorized","public_use_allowed"]
    }
  },
  "properties": {
    "object_type":{"const":"SourceConflictInfluenceAssessmentCandidate"},
    "schema_version":{"const":"1.0.0"},
    "profile":{"const":"kfm.source-conflict-influence.fixture.v1"},
    "assessment_id":{"type":"string","pattern":"^kfm:source-conflict-influence:[0-9a-f]{24}$"},
    "subject_ref":{"type":"string","pattern":"^kfm:[a-z0-9][a-z0-9._:/-]{5,220}$"},
    "assessed_at":{"$ref":"#/$defs/aware_datetime"},
    "comparison_profile":{
      "type":"object","additionalProperties":false,
      "properties":{
        "profile_ref":{"type":"string","pattern":"^kfm:source-conflict-profile:[a-z0-9][a-z0-9._:-]{2,127}$"},
        "profile_spec_hash":{"$ref":"#/$defs/spec_hash"},
        "axes":{"type":"array","minItems":2,"maxItems":7,"uniqueItems":true,"items":{"$ref":"#/$defs/axis"}},
        "order_invariant":{"const":true}
      },
      "required":["profile_ref","profile_spec_hash","axes","order_invariant"]
    },
    "sources":{"type":"array","minItems":2,"maxItems":8,"items":{"$ref":"#/$defs/source"}},
    "comparisons":{"type":"array","minItems":1,"maxItems":28,"items":{"$ref":"#/$defs/comparison"}},
    "summary":{
      "type":"object","additionalProperties":false,
      "properties":{
        "source_count":{"type":"integer","minimum":2,"maximum":8},
        "comparison_count":{"type":"integer","minimum":1,"maximum":28},
        "overall_relationship":{"enum":["CONSISTENT","DIVERGENT","CONFLICTING","INSUFFICIENT","INAPPLICABLE","REVOKED_EVIDENCE"]},
        "dominant_source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
        "contributing_source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
        "context_only_source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
        "excluded_source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
        "non_influential_source_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
        "claim_resolution_allowed":{"const":false},
        "separate_policy_gate_required":{"const":true}
      },
      "required":["source_count","comparison_count","overall_relationship","dominant_source_ids","contributing_source_ids","context_only_source_ids","excluded_source_ids","non_influential_source_ids","claim_resolution_allowed","separate_policy_gate_required"]
    },
    "governance":{"$ref":"#/$defs/governance"},
    "spec_hash":{"$ref":"#/$defs/spec_hash"}
  },
  "required":["object_type","schema_version","profile","assessment_id","subject_ref","assessed_at","comparison_profile","sources","comparisons","summary","governance","spec_hash"],
  "x-kfm":{
    "status":"PROPOSED_INACTIVE",
    "authority":"NONE",
    "contract_doc":"contracts/evidence/source_conflict_influence_assessment.md",
    "fixtures_root":"fixtures/contracts/v1/evidence/source_conflict_influence_assessment/",
    "validator":"tools/validators/evidence/validate_source_conflict_influence_assessment.py"
  }
}
