{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfm://schema/evidence/spatial-transform-receipt/v1",
  "title": "KFM SpatialTransformReceipt",
  "type": "object",
  "additionalProperties": false,
  "required": ["receipt_id", "input_ref", "output_ref", "source_crs", "target_crs", "operations", "input_digest", "output_digest", "changed", "evidence_refs", "network_access", "outcome", "reason_codes"],
  "properties": {
    "receipt_id": {"type": "string", "minLength": 1},
    "input_ref": {"type": "string", "minLength": 1},
    "output_ref": {"type": "string", "minLength": 1},
    "source_crs": {"type": "string", "minLength": 1},
    "target_crs": {"type": "string", "minLength": 1},
    "operations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "input_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "output_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "changed": {"type": "boolean"},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "network_access": {"const": false},
    "outcome": {"enum": ["PASS", "DENY", "ERROR"]},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
