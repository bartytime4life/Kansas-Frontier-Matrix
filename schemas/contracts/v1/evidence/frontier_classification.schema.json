{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/evidence/frontier_classification.schema.json",
  "title": "FrontierClassification",
  "description": "Synthetic-only, fixture-bound assessment of one CountyYearPanel against one FrontierDefinition with finite classification and separate review posture.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "assessment_id",
    "method",
    "subject",
    "inputs",
    "criteria",
    "classification",
    "posture",
    "lineage",
    "metadata",
    "governance",
    "spec_hash"
  ],
  "properties": {
    "object_type": {"const": "FrontierClassification"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.frontier-classification.fixture.v1"},
    "assessment_id": {
      "type": "string",
      "pattern": "^kfm:frontier-classification:[a-f0-9]{64}$"
    },
    "method": {"$ref": "#/$defs/method"},
    "subject": {"$ref": "#/$defs/subject"},
    "inputs": {"$ref": "#/$defs/inputs"},
    "criteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/criterion_trace"}
    },
    "classification": {"$ref": "#/$defs/classification"},
    "posture": {"$ref": "#/$defs/posture"},
    "lineage": {"$ref": "#/$defs/lineage"},
    "metadata": {"$ref": "#/$defs/metadata"},
    "governance": {"$ref": "#/$defs/governance"},
    "spec_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "digest_ref": {
      "type": "string",
      "pattern": "^kfm://[a-z0-9][a-z0-9._:/-]{2,191}@sha256:[a-f0-9]{64}$"
    },
    "nullable_digest_ref": {
      "oneOf": [
        {"$ref": "#/$defs/digest_ref"},
        {"type": "null"}
      ]
    },
    "nullable_sha256": {
      "oneOf": [
        {"$ref": "#/$defs/sha256"},
        {"type": "null"}
      ]
    },
    "nullable_string": {
      "oneOf": [
        {"type": "string", "minLength": 1, "maxLength": 320},
        {"type": "null"}
      ]
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,79}$"
    },
    "codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/code"}
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method_ref",
        "method_profile",
        "method_version",
        "combination_rule"
      ],
      "properties": {
        "method_ref": {"$ref": "#/$defs/digest_ref"},
        "method_profile": {"const": "kfm.frontier-classification.synthetic.v1"},
        "method_version": {"const": "1.0.0"},
        "combination_rule": {"enum": ["ALL_CRITERIA", "ANY_CRITERION"]}
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "county_identifier_digest",
        "calendar_year",
        "geography_version_ref",
        "synthetic_subject"
      ],
      "properties": {
        "county_identifier_digest": {"$ref": "#/$defs/sha256"},
        "calendar_year": {"type": "integer", "minimum": 1800, "maximum": 2200},
        "geography_version_ref": {"$ref": "#/$defs/digest_ref"},
        "synthetic_subject": {"const": true}
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "county_year_panel_ref",
        "county_year_panel_id",
        "county_year_panel_spec_hash",
        "frontier_definition_ref",
        "frontier_definition_id",
        "frontier_definition_spec_hash",
        "dependency_validation_state"
      ],
      "properties": {
        "county_year_panel_ref": {"$ref": "#/$defs/digest_ref"},
        "county_year_panel_id": {
          "type": "string",
          "pattern": "^kfm:county-year-panel:[a-f0-9]{24}$"
        },
        "county_year_panel_spec_hash": {"$ref": "#/$defs/sha256"},
        "frontier_definition_ref": {"$ref": "#/$defs/digest_ref"},
        "frontier_definition_id": {
          "type": "string",
          "pattern": "^kfm:frontier-definition:[a-f0-9]{24}$"
        },
        "frontier_definition_spec_hash": {"$ref": "#/$defs/sha256"},
        "dependency_validation_state": {"const": "VALIDATED_LOCAL_FIXTURES"}
      }
    },
    "criterion_trace": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_key",
        "indicator_definition_ref",
        "observation_kind",
        "panel_observation_ref",
        "source_role_ref",
        "source_role",
        "observation_identity",
        "observation_spec_hash",
        "observation_state",
        "uncertainty_ref",
        "uncertainty_posture",
        "evidence_ref",
        "evidence_bundle_id",
        "evidence_bundle_spec_hash",
        "evidence_posture",
        "geography_alignment",
        "geography_crosswalk_ref",
        "time_alignment",
        "threshold_policy_ref",
        "threshold_policy_posture",
        "comparison_operator",
        "comparison_state",
        "reason_codes"
      ],
      "properties": {
        "criterion_key": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,63}$"
        },
        "indicator_definition_ref": {"$ref": "#/$defs/digest_ref"},
        "observation_kind": {"enum": ["ACCESS", "POPULATION"]},
        "panel_observation_ref": {"$ref": "#/$defs/nullable_digest_ref"},
        "source_role_ref": {"$ref": "#/$defs/nullable_digest_ref"},
        "source_role": {
          "oneOf": [
            {"enum": ["OFFICIAL_ACCESS_OR_SERVICE_AGGREGATE", "OFFICIAL_STATISTICAL_AGGREGATE"]},
            {"type": "null"}
          ]
        },
        "observation_identity": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^kfm:(?:access|population)-observation:[a-f0-9]{24}$"
            },
            {"type": "null"}
          ]
        },
        "observation_spec_hash": {"$ref": "#/$defs/nullable_sha256"},
        "observation_state": {
          "enum": [
            "CURRENT",
            "MISSING",
            "SUPPRESSED",
            "STALE",
            "SUPERSEDED",
            "WITHDRAWN",
            "CORRECTED_PENDING"
          ]
        },
        "uncertainty_ref": {"$ref": "#/$defs/nullable_digest_ref"},
        "uncertainty_posture": {
          "enum": [
            "ADMITTED",
            "MISSING",
            "UNRESOLVED",
            "EXCEEDS_ADMITTED",
            "CROSSES_THRESHOLD",
            "NOT_APPLICABLE"
          ]
        },
        "evidence_ref": {"$ref": "#/$defs/nullable_digest_ref"},
        "evidence_bundle_id": {"$ref": "#/$defs/nullable_string"},
        "evidence_bundle_spec_hash": {"$ref": "#/$defs/nullable_sha256"},
        "evidence_posture": {"enum": ["VERIFIED", "MISSING", "UNRESOLVED", "MISMATCHED"]},
        "geography_alignment": {"enum": ["SAME_VERSION", "CROSSWALK_REFERENCED", "UNRESOLVED"]},
        "geography_crosswalk_ref": {"$ref": "#/$defs/nullable_digest_ref"},
        "time_alignment": {
          "enum": [
            "ALIGNED",
            "OUTSIDE_PANEL_YEAR",
            "OUTSIDE_DEFINITION_INTERVAL",
            "UNRESOLVED"
          ]
        },
        "threshold_policy_ref": {"$ref": "#/$defs/nullable_digest_ref"},
        "threshold_policy_posture": {"enum": ["ADMITTED", "MISSING", "MISMATCHED", "NOT_ADMITTED"]},
        "comparison_operator": {
          "enum": ["LESS_THAN", "LESS_THAN_OR_EQUAL", "GREATER_THAN", "GREATER_THAN_OR_EQUAL"]
        },
        "comparison_state": {"enum": ["SATISFIED", "UNSATISFIED", "INDETERMINATE"]},
        "reason_codes": {"$ref": "#/$defs/codes"}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "combination_rule", "reason_codes"],
      "properties": {
        "value": {"enum": ["FRONTIER", "NOT_FRONTIER", "UNCLASSIFIED"]},
        "combination_rule": {"enum": ["ALL_CRITERIA", "ANY_CRITERION"]},
        "reason_codes": {"$ref": "#/$defs/codes"}
      }
    },
    "posture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution", "review", "obligations"],
      "properties": {
        "execution": {"enum": ["CALCULATED", "ABSTAIN"]},
        "review": {"enum": ["REVIEW_CANDIDATE", "HOLD"]},
        "obligations": {"$ref": "#/$defs/codes"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "supersedes_assessment_ref",
        "correction_record_ref",
        "corrected_input_refs"
      ],
      "properties": {
        "state": {"enum": ["ORIGINAL", "CORRECTED"]},
        "supersedes_assessment_ref": {"$ref": "#/$defs/nullable_digest_ref"},
        "correction_record_ref": {"$ref": "#/$defs/nullable_digest_ref"},
        "corrected_input_refs": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest_ref"}
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at"],
      "properties": {
        "generated_at": {"type": "string", "format": "date-time"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_only",
        "no_network",
        "synthetic_inputs_only",
        "real_county_classified",
        "source_data_accessed",
        "source_activation",
        "threshold_policy_changed",
        "lifecycle_write",
        "policy_authority",
        "review_authority",
        "release_authority",
        "publication_authority",
        "deployment_authority",
        "public_api_output",
        "map_output"
      ],
      "properties": {
        "fixture_only": {"const": true},
        "no_network": {"const": true},
        "synthetic_inputs_only": {"const": true},
        "real_county_classified": {"const": false},
        "source_data_accessed": {"const": false},
        "source_activation": {"const": false},
        "threshold_policy_changed": {"const": false},
        "lifecycle_write": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "deployment_authority": {"const": false},
        "public_api_output": {"const": false},
        "map_output": {"const": false}
      }
    }
  }
}
