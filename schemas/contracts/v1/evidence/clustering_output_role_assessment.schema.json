  "x-kfm": {
    "contract_doc": "contracts/evidence/clustering_output_role_assessment.md",
    "fixtures_root": "fixtures/contracts/v1/evidence/clustering_output_role_assessment/",
    "validator": "tools/validators/evidence/validate_clustering_output_role_assessment.py",
