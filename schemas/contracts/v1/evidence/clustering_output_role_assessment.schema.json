{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/clustering_output_role_assessment.schema.json",
  "title": "ClusteringOutputRoleAssessmentCandidate",
  "description": "Fixture-only assessment of an unsupervised clustering output's declared exploratory role without evidence, policy, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_type", "schema_version", "profile", "profile_spec_hash", "source_card", "observed_at", "model_output_ref", "model_output_digest", "intended_visibility", "method", "labeling", "evaluation", "review", "authority_claims"],
  "properties": {
    "object_type": {"const": "ClusteringOutputRoleAssessmentCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.evidence.clustering-output-role-assessment.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_card": {"const": "KFM-P18-INV-370"},
    "observed_at": {"type": "string", "format": "date-time"},
    "model_output_ref": {"$ref": "#/$defs/ref"},
    "model_output_digest": {"$ref": "#/$defs/sha256"},
