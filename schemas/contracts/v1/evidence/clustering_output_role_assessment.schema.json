      "properties": {
        "algorithm_family": {"enum": ["K_MEANS", "K_MEDOIDS", "HIERARCHICAL", "DBSCAN", "OTHER_UNSUPERVISED"]},
        "declared_cluster_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "observed_cluster_count": {"type": "integer", "minimum": 1, "maximum": 100000},
        "initialization_strategy": {"enum": ["RANDOM", "DETERMINISTIC", "NOT_APPLICABLE"]},
        "initialization_seed": {"type": ["integer", "null"], "minimum": 0, "maximum": 2147483647},
        "feature_space_ref": {"$ref": "#/$defs/ref"},
        "feature_space_digest": {"$ref": "#/$defs/sha256"},
        "preprocessing_receipt_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "labeling": {
      "type": "object",
      "additionalProperties": false,
      "required": ["output_role", "claim_posture", "label_origin", "label_set_ref", "public_caveat_surface"],
      "properties": {
        "output_role": {"enum": ["EXPLORATORY_GROUPING", "AUTHORITATIVE_DOMAIN_CLASSIFICATION"]},
        "claim_posture": {"enum": ["EXPLORATORY_ONLY", "DOMAIN_CATEGORY_CLAIM"]},
        "label_origin": {"enum": ["ALGORITHM_GENERATED", "ANALYST_ASSIGNED", "UNLABELED"]},
        "label_set_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
        "public_caveat_surface": {"enum": ["NONE", "LAYER_NOTE", "LEGEND", "EVIDENCE_DRAWER"]}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_state", "evaluation_metric_refs", "sensitivity_state", "sensitivity_run_refs"],
      "properties": {
        "evaluation_state": {"enum": ["COMPLETE", "PARTIAL", "NOT_RUN"]},
        "evaluation_metric_refs": {"$ref": "#/$defs/ref_array"},
        "sensitivity_state": {"enum": ["COMPLETE", "PARTIAL", "NOT_RUN"]},
        "sensitivity_run_refs": {"$ref": "#/$defs/ref_array"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_state", "review_record_refs", "independent_validation_state", "independent_validation_refs"],
      "properties": {
        "review_state": {"enum": ["PENDING", "REVIEWED", "REJECTED"]},
        "review_record_refs": {"$ref": "#/$defs/ref_array"},
        "independent_validation_state": {"enum": ["NOT_PERFORMED", "PENDING", "PASSED", "FAILED"]},
        "independent_validation_refs": {"$ref": "#/$defs/ref_array"}
