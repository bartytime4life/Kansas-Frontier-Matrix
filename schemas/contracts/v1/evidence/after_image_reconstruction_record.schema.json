{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/evidence/after_image_reconstruction_record.schema.json",
  "title": "AfterImageReconstructionRecordCandidate",
  "description": "Fixture-only reference and retention declaration for a tracking-log after-image without payload storage, temporal execution, correction, evidence, policy, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "profile_spec_hash",
    "source_card",
    "recorded_at",
    "subject_ref",
    "subject_identity_digest",
    "tracking_log_binding",
    "transition",
    "after_image",
    "reconstruction_scope",
    "retention",
    "review",
    "limitations",
    "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "AfterImageReconstructionRecordCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.evidence.after-image-reconstruction-record.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_card": {"const": "KFM-P18-INV-145"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "subject_ref": {"$ref": "#/$defs/ref"},
    "subject_identity_digest": {"$ref": "#/$defs/sha256"},
    "tracking_log_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "ref", "digest"],
      "properties": {
        "state": {"enum": ["RESOLVED", "UNRESOLVED"]},
        "ref": {"$ref": "#/$defs/nullable_ref"},
        "digest": {"$ref": "#/$defs/nullable_sha256"}
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "transaction_time", "valid_time_start", "valid_time_end", "event_ref", "event_digest"],
      "properties": {
        "sequence": {"type": "integer", "minimum": 0, "maximum": 2147483647},
        "transaction_time": {"type": "string", "format": "date-time"},
        "valid_time_start": {"type": "string", "format": "date-time"},
        "valid_time_end": {
          "anyOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "event_ref": {"$ref": "#/$defs/ref"},
        "event_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "after_image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "ref", "digest", "schema_ref", "schema_digest", "withholding_reason_ref", "inline_payload_present"],
      "properties": {
        "mode": {"enum": ["EXTERNAL_REFERENCE", "MINIMIZED_REFERENCE", "DIGEST_ONLY", "WITHHELD"]},
        "ref": {"$ref": "#/$defs/nullable_ref"},
        "digest": {"$ref": "#/$defs/nullable_sha256"},
        "schema_ref": {"$ref": "#/$defs/nullable_ref"},
        "schema_digest": {"$ref": "#/$defs/nullable_sha256"},
        "withholding_reason_ref": {"$ref": "#/$defs/nullable_ref"},
        "inline_payload_present": {"const": false}
      }
    },
    "reconstruction_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["use_cases", "run_receipt_refs", "correction_notice_refs", "release_manifest_refs", "rollback_refs", "as_of_snapshot_ref"],
      "properties": {
        "use_cases": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["AUDIT", "CORRECTION", "DISPUTED_RELEASE", "ROLLBACK_ANALYSIS"]}
        },
        "run_receipt_refs": {"$ref": "#/$defs/ref_array"},
        "correction_notice_refs": {"$ref": "#/$defs/ref_array"},
        "release_manifest_refs": {"$ref": "#/$defs/ref_array"},
        "rollback_refs": {"$ref": "#/$defs/ref_array"},
        "as_of_snapshot_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "retention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "expires_at", "policy_binding", "minimization_state", "sensitivity_state"],
      "properties": {
        "class": {"enum": ["TRANSIENT", "BOUNDED", "ARCHIVAL", "WITHHELD"]},
        "expires_at": {
          "anyOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        },
        "policy_binding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "ref", "digest"],
          "properties": {
            "state": {"enum": ["RESOLVED", "UNRESOLVED"]},
            "ref": {"$ref": "#/$defs/nullable_ref"},
            "digest": {"$ref": "#/$defs/nullable_sha256"}
          }
        },
        "minimization_state": {"enum": ["APPLIED", "NOT_REQUIRED", "UNRESOLVED"]},
        "sensitivity_state": {"enum": ["PUBLIC_SAFE", "RESTRICTED", "UNRESOLVED"]}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "record_refs", "rationale_summary"],
      "properties": {
        "state": {"enum": ["COMPLETE_FOR_DECLARED_SCOPE", "PENDING", "UNKNOWN"]},
        "record_refs": {"$ref": "#/$defs/ref_array"},
        "rationale_summary": {
          "anyOf": [
            {"type": "string", "minLength": 24, "maxLength": 1024, "pattern": "^[^\\r\\n]+$"},
            {"type": "null"}
          ]
        }
      }
    },
    "limitations": {
      "const": [
        "DECLARATION_ONLY",
        "NO_AFTER_IMAGE_OR_STATE_PAYLOAD",
        "NO_TEMPORAL_RECONSTRUCTION_OR_TRACKING_LOG_WRITE",
        "NO_CORRECTION_OR_LIFECYCLE_MUTATION",
        "NO_EVIDENCE_POLICY_OR_REVIEW_AUTHORITY",
        "NO_PROMOTION_RELEASE_OR_DEPLOYMENT_AUTHORITY",
        "NO_PUBLICATION_OR_PUBLIC_USE_AUTHORITY"
      ]
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "payload_storage_authority",
        "reconstruction_execution_authority",
        "tracking_log_write_authority",
        "correction_mutation_authority",
        "evidence_authority",
        "policy_authority",
        "review_authority",
        "lifecycle_authority",
        "promotion_authority",
        "release_authority",
        "deployment_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "payload_storage_authority": {"const": false},
        "reconstruction_execution_authority": {"const": false},
        "tracking_log_write_authority": {"const": false},
        "correction_mutation_authority": {"const": false},
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "lifecycle_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "deployment_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "nullable_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "nullable_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "ref_array": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    }
  }
}
