{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfm://schema/ai/evaluator-harness/v1",
  "title": "KFM AI Evaluator Harness Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evaluation_id",
    "artifact_kind",
    "candidate_ref",
    "evidence_refs",
    "metrics",
    "policy_outcome",
    "deterministic",
    "network_access",
    "result",
    "reason_codes",
    "spec_hash"
  ],
  "properties": {
    "evaluation_id": {"type": "string", "minLength": 1},
    "artifact_kind": {"enum": ["raster", "vector", "tabular", "text", "mixed"]},
    "candidate_ref": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metrics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value", "threshold", "comparison"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "value": {"type": "number"},
          "threshold": {"type": "number"},
          "comparison": {"enum": ["gte", "lte"]}
        }
      }
    },
    "policy_outcome": {"enum": ["ALLOW", "DENY", "HOLD", "ERROR"]},
    "deterministic": {"const": true},
    "network_access": {"const": false},
    "result": {"enum": ["PASS", "FAIL", "ERROR"]},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "profile": {"enum": ["GENERIC_DECLARED_METRICS", "PUBLIC_SAFE_RASTER_V1", "PUBLIC_SAFE_TEXT_V1"]},
    "profile_spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$", "not": {"pattern": "^sha256:0{64}$"}},
    "profile_input": {
      "oneOf": [
        {"$ref": "#/$defs/raster_profile_input"},
        {"$ref": "#/$defs/text_profile_input"}
      ]
    }
  },
  "$defs": {
    "decimal_string": {"type": "string", "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"},
    "grid": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "array",
        "minItems": 1,
        "maxItems": 32,
        "items": {"type": ["integer", "null"], "minimum": -1000000, "maximum": 1000000}
      }
    },
    "raster_profile_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "reference_grid", "candidate_grid", "thresholds"],
      "properties": {
        "kind": {"const": "raster"},
        "reference_grid": {"$ref": "#/$defs/grid"},
        "candidate_grid": {"$ref": "#/$defs/grid"},
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["max_rmse", "min_coverage", "max_abs_error"],
          "properties": {
            "max_rmse": {"$ref": "#/$defs/decimal_string"},
            "min_coverage": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"},
            "max_abs_error": {"$ref": "#/$defs/decimal_string"}
          }
        }
      }
    },
    "text_profile_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "claims", "allowed_citation_refs", "sensitive_terms", "thresholds"],
      "properties": {
        "kind": {"const": "text"},
        "claims": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["claim_id", "text", "citation_refs"],
            "properties": {
              "claim_id": {"type": "string", "minLength": 1},
              "text": {"type": "string", "minLength": 1, "maxLength": 10000},
              "citation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
            }
          }
        },
        "allowed_citation_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "sensitive_terms": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 2}},
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min_citation_coverage", "max_unsupported_claims", "max_sensitive_hits", "max_characters"],
          "properties": {
            "min_citation_coverage": {"type": "string", "pattern": "^(0(\\.[0-9]+)?|1(\\.0+)?)$"},
            "max_unsupported_claims": {"type": "integer", "minimum": 0},
            "max_sensitive_hits": {"type": "integer", "minimum": 0},
            "max_characters": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"profile": {"const": "PUBLIC_SAFE_RASTER_V1"}}, "required": ["profile"]},
      "then": {
        "required": ["profile_input", "profile_spec_hash"],
        "properties": {
          "artifact_kind": {"const": "raster"},
          "profile_input": {"properties": {"kind": {"const": "raster"}}, "required": ["kind"]}
        }
      }
    },
    {
      "if": {"properties": {"profile": {"const": "PUBLIC_SAFE_TEXT_V1"}}, "required": ["profile"]},
      "then": {
        "required": ["profile_input", "profile_spec_hash"],
        "properties": {
          "artifact_kind": {"const": "text"},
          "profile_input": {"properties": {"kind": {"const": "text"}}, "required": ["kind"]}
        }
      }
    }
  ]
}
