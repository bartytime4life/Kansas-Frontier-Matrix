{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfm://schema/ai/evaluator-harness/v1",
  "title": "KFM AI Evaluator Harness Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["evaluation_id", "artifact_kind", "candidate_ref", "evidence_refs", "metrics", "policy_outcome", "deterministic", "network_access", "result", "reason_codes", "spec_hash"],
  "properties": {
    "evaluation_id": {"type": "string", "minLength": 1},
    "artifact_kind": {"enum": ["raster", "vector", "tabular", "text", "mixed"]},
    "candidate_ref": {"type": "string", "minLength": 1},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "metrics": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["name", "value", "threshold", "comparison"], "properties": {"name": {"type": "string", "minLength": 1}, "value": {"type": "number"}, "threshold": {"type": "number"}, "comparison": {"enum": ["gte", "lte"]}}}},
    "policy_outcome": {"enum": ["ALLOW", "DENY", "HOLD", "ERROR"]},
    "deterministic": {"const": true},
    "network_access": {"const": false},
    "result": {"enum": ["PASS", "FAIL", "ERROR"]},
    "reason_codes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
