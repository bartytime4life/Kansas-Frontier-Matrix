{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/security/security_scan_receipt.schema.json",
  "title": "KFM security scan receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "subject_commit",
    "scanner",
    "scan",
    "findings",
    "suppressions",
    "raw_result",
    "authentication",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": "kfm.security-scan-receipt/v1"},
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "subject_commit": {"$ref": "#/$defs/sha"},
    "scanner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "rules_digest"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "rules_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "scan": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "completeness"],
      "properties": {
        "started_at": {"$ref": "#/$defs/timestamp"},
        "finished_at": {"$ref": "#/$defs/timestamp"},
        "completeness": {"enum": ["complete", "partial", "failed"]}
      }
    },
    "findings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["critical", "high", "medium", "low", "informational"],
      "properties": {
        "critical": {"type": "integer", "minimum": 0},
        "high": {"type": "integer", "minimum": 0},
        "medium": {"type": "integer", "minimum": 0},
        "low": {"type": "integer", "minimum": 0},
        "informational": {"type": "integer", "minimum": 0}
      }
    },
    "suppressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["identifier", "reason", "expires_at"],
        "properties": {
          "identifier": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "expires_at": {"$ref": "#/$defs/timestamp"}
        }
      }
    },
    "raw_result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_ref", "artifact_digest"],
      "properties": {
        "artifact_ref": {"type": "string", "minLength": 1},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "authentication": {
      "enum": ["self_asserted", "github_actions", "operator", "independent"]
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["merge_authority", "independent_acceptance", "release_authority"],
      "properties": {
        "merge_authority": {"const": false},
        "independent_acceptance": {"const": false},
        "release_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    }
  }
}
