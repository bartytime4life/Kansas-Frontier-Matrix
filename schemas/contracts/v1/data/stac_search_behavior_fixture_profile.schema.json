{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/data/stac_search_behavior_fixture_profile.schema.json",
  "title": "StacSearchBehaviorFixtureProfileCandidate",
  "description": "Fixture-only STAC search request/response declaration with no live HTTP, catalog, policy, review, promotion, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "spec_hash", "status", "request", "pages", "controls", "non_effects"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile_id": {"type": "string", "pattern": "^kfm:stac-search-behavior:[a-f0-9]{24}$"},
    "spec_hash": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "status": {"const": "PROPOSED_INACTIVE"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint_ref", "method", "bbox", "datetime", "limit", "fields", "sortby", "constraint_mode", "filter", "query"],
      "properties": {
        "endpoint_ref": {"const": "fixture://stac/search"},
        "method": {"const": "POST"},
        "bbox": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": -180, "maximum": 180}},
        "datetime": {"type": "string", "pattern": "^[^/]+/[^/]+$", "maxLength": 128},
        "limit": {"type": "integer", "minimum": 1, "maximum": 1000},
        "fields": {
          "type": "object",
          "additionalProperties": false,
          "required": ["include", "exclude"],
          "properties": {
            "include": {"$ref": "#/$defs/field_paths_nonempty"},
            "exclude": {"$ref": "#/$defs/field_paths"}
          }
        },
        "sortby": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "direction"],
            "properties": {"field": {"$ref": "#/$defs/field_path"}, "direction": {"enum": ["ASC", "DESC"]}}
          }
        },
        "constraint_mode": {"enum": ["FILTER", "QUERY"]},
        "filter": {"type": ["object", "null"]},
        "query": {"type": ["object", "null"]}
      },
      "allOf": [
        {
          "if": {"properties": {"constraint_mode": {"const": "FILTER"}}, "required": ["constraint_mode"]},
          "then": {"properties": {"filter": {"type": "object", "minProperties": 1}, "query": {"type": "null"}}},
          "else": {"properties": {"filter": {"type": "null"}, "query": {"type": "object", "minProperties": 1}}}
        }
      ]
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["request_token", "response_next_token", "returned_field_paths", "items"],
        "properties": {
          "request_token": {"$ref": "#/$defs/nullable_token"},
          "response_next_token": {"$ref": "#/$defs/nullable_token"},
          "returned_field_paths": {"$ref": "#/$defs/field_paths_nonempty"},
          "items": {
            "type": "array",
            "minItems": 1,
            "maxItems": 1000,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "sort_values"],
              "properties": {
                "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
                "sort_values": {"type": "array", "minItems": 1, "maxItems": 8, "items": {"type": "string", "minLength": 1, "maxLength": 256}}
              }
            }
          }
        }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_only", "live_http_performed", "live_catalog_discovered", "catalog_mutated", "server_conformance_claimed", "source_admitted", "policy_evaluated", "review_approved", "promotion_eligible", "release_authorized", "publication_authorized"],
      "properties": {
        "fixture_only": {"const": true},
        "live_http_performed": {"const": false},
        "live_catalog_discovered": {"const": false},
        "catalog_mutated": {"const": false},
        "server_conformance_claimed": {"const": false},
        "source_admitted": {"const": false},
        "policy_evaluated": {"const": false},
        "review_approved": {"const": false},
        "promotion_eligible": {"const": false},
        "release_authorized": {"const": false},
        "publication_authorized": {"const": false}
      }
    },
    "non_effects": {"const": ["NO_CATALOG_MUTATION", "NO_LIVE_CATALOG_DISCOVERY", "NO_LIVE_HTTP", "NO_POLICY_DECISION", "NO_PROMOTION", "NO_PUBLICATION", "NO_RELEASE", "NO_SERVER_CONFORMANCE_CLAIM", "NO_SOURCE_ADMISSION"]}
  },
  "$defs": {
    "field_path": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{0,127}$"},
    "field_paths": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/field_path"}},
    "field_paths_nonempty": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/field_path"}},
    "nullable_token": {"oneOf": [{"type": "string", "pattern": "^fixture-token:[a-z0-9][a-z0-9._-]{0,127}$"}, {"type": "null"}]}
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "source_card": "KFM-P31-PROG-0005",
    "contract_doc": "contracts/data/stac_search_behavior_fixture_profile.md",
    "fixture_root": "fixtures/contracts/v1/data/stac_search_behavior_fixture_profile/",
    "authority": "bounded synthetic STAC search behavior only"
  }
}
