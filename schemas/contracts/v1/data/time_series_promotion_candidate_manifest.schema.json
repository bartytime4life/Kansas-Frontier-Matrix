{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/data/time_series_promotion_candidate_manifest.schema.json",
  "title": "TimeSeriesPromotionCandidateManifest",
  "description": "Fixture-only normalized metadata for a station time-series promotion candidate. Shape validity grants no source, evidence, policy, review, promotion, release, publication, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile_id",
    "manifest_id",
    "lifecycle_state",
    "dataset_ref",
    "batch",
    "bindings",
    "governance",
    "spec_hash"
  ],
  "properties": {
    "object_type": { "const": "TimeSeriesPromotionCandidateManifest" },
    "schema_version": { "const": "1.0.0" },
    "profile_id": { "const": "kfm.data.time-series-promotion-candidate-manifest.v1" },
    "manifest_id": {
      "type": "string",
      "pattern": "^kfm:time-series-promotion-candidate:[a-f0-9]{24}$"
    },
    "lifecycle_state": { "const": "CANDIDATE" },
    "dataset_ref": { "$ref": "#/$defs/digest_ref" },
    "batch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spatial_scope",
        "temporal_extent",
        "station_ids",
        "variable_ids",
        "encoding",
        "record_count"
      ],
      "properties": {
        "spatial_scope": {
          "type": "object",
          "additionalProperties": false,
          "required": ["crs", "bbox"],
          "properties": {
            "crs": { "const": "EPSG:4326" },
            "bbox": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "prefixItems": [
                { "type": "number", "minimum": -180, "maximum": 180 },
                { "type": "number", "minimum": -90, "maximum": 90 },
                { "type": "number", "minimum": -180, "maximum": 180 },
                { "type": "number", "minimum": -90, "maximum": 90 }
              ],
              "items": false
            }
          }
        },
        "temporal_extent": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {
            "start": { "type": "string", "format": "date-time" },
            "end": { "type": "string", "format": "date-time" }
          }
        },
        "station_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "variable_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 512,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/stable_id" }
        },
        "encoding": {
          "type": "object",
          "additionalProperties": false,
          "required": ["media_type", "format", "compression"],
          "properties": {
            "media_type": {
              "type": "string",
              "minLength": 3,
              "maxLength": 160,
              "pattern": "^[a-z0-9.+-]+/[a-z0-9.+-]+$"
            },
            "format": {
              "enum": ["CSV", "JSON_LINES", "NETCDF", "PARQUET", "ZARR"]
            },
            "compression": {
              "enum": ["GZIP", "NONE", "SNAPPY", "ZSTD"]
            }
          }
        },
        "record_count": { "type": "integer", "minimum": 1 }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_descriptor_ref",
        "evidence_bundle_ref",
        "policy_decision_ref",
        "run_receipt_ref",
        "release_manifest_ref"
      ],
      "properties": {
        "source_descriptor_ref": { "$ref": "#/$defs/ref" },
        "evidence_bundle_ref": { "$ref": "#/$defs/nullable_ref" },
        "policy_decision_ref": { "$ref": "#/$defs/nullable_ref" },
        "run_receipt_ref": { "$ref": "#/$defs/ref" },
        "release_manifest_ref": { "type": "null" }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_role",
        "promotion_required",
        "evidence_resolved",
        "policy_evaluated",
        "review_approved",
        "promotion_authorized",
        "release_authorized",
        "publication_authorized"
      ],
      "properties": {
        "source_role": { "const": "candidate" },
        "promotion_required": { "const": true },
        "evidence_resolved": { "const": false },
        "policy_evaluated": { "const": false },
        "review_approved": { "const": false },
        "promotion_authorized": { "const": false },
        "release_authorized": { "const": false },
        "publication_authorized": { "const": false }
      }
    },
    "spec_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "stable_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 720,
      "pattern": "^(?:kfm://|urn:)[^\\s]+$"
    },
    "nullable_ref": {
      "oneOf": [
        { "$ref": "#/$defs/ref" },
        { "type": "null" }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "digest_ref": {
      "type": "string",
      "minLength": 80,
      "maxLength": 720,
      "pattern": "^(?:kfm://|urn:)[^\\s@]+@sha256:[a-f0-9]{64}$"
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "execution_mode": "FIXTURE_ONLY",
    "source_card": "KFM-P22-PROG-0020",
    "contract_doc": "contracts/data/time_series_promotion_candidate_manifest.md",
    "fixtures_root": "fixtures/contracts/v1/data/time_series_promotion_candidate_manifest/",
    "validator": "tools/validators/data/validate_time_series_promotion_candidate_manifest.py",
    "tests": "tests/validators/test_validate_time_series_promotion_candidate_manifest.py",
    "non_effects": [
      "does_not_fetch_or_admit_station_data",
      "does_not_resolve_evidence_or_evaluate_policy",
      "does_not_authenticate_review_or_authorize_promotion",
      "does_not_release_deploy_publish_or_update_aliases"
    ]
  }
}

