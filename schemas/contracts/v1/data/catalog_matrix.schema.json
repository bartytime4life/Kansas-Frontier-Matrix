{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/data/catalog_matrix.schema.json",
  "title": "CatalogMatrix",
  "description": "Proposed KFM STAC/DCAT/PROV release-candidate alignment record. Validation is not evidence, policy, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "matrix_id",
    "version",
    "generated_at",
    "artifact",
    "records",
    "evidence_refs",
    "source_refs",
    "policy_decision_ref",
    "review_ref",
    "correction_path_ref",
    "rollback_ref",
    "decision",
    "reason_codes",
    "spec_hash"
  ],
  "properties": {
    "matrix_id": {
      "type": "string",
      "pattern": "^kfm:catalog-matrix:[A-Za-z0-9][A-Za-z0-9._:-]{2,170}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "digest",
        "release_ref"
      ],
      "properties": {
        "artifact_id": {
          "type": "string",
          "pattern": "^kfm:artifact:[A-Za-z0-9][A-Za-z0-9._:-]{2,180}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "release_ref": {
          "type": "string",
          "pattern": "^kfm:release:[A-Za-z0-9][A-Za-z0-9._:-]{2,180}$"
        }
      }
    },
    "records": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stac",
        "dcat",
        "prov"
      ],
      "properties": {
        "stac": {
          "allOf": [
            {
              "$ref": "#/$defs/binding"
            }
          ],
          "properties": {
            "record_ref": {
              "pattern": "^kfm:catalog:stac:[A-Za-z0-9][A-Za-z0-9._:-]{2,170}$"
            }
          }
        },
        "dcat": {
          "allOf": [
            {
              "$ref": "#/$defs/binding"
            }
          ],
          "properties": {
            "record_ref": {
              "pattern": "^kfm:catalog:dcat:[A-Za-z0-9][A-Za-z0-9._:-]{2,170}$"
            }
          }
        },
        "prov": {
          "allOf": [
            {
              "$ref": "#/$defs/binding"
            }
          ],
          "properties": {
            "record_ref": {
              "pattern": "^kfm:catalog:prov:[A-Za-z0-9][A-Za-z0-9._:-]{2,170}$"
            }
          }
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 320
      }
    },
    "source_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 320
      }
    },
    "policy_decision_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "review_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "correction_path_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "rollback_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "decision": {
      "enum": [
        "READY",
        "HOLD",
        "DENY"
      ]
    },
    "reason_codes": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
      }
    },
    "spec_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "record_ref",
        "artifact_id",
        "digest",
        "release_ref"
      ],
      "properties": {
        "record_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 320
        },
        "artifact_id": {
          "type": "string",
          "pattern": "^kfm:artifact:[A-Za-z0-9][A-Za-z0-9._:-]{2,180}$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "release_ref": {
          "type": "string",
          "pattern": "^kfm:release:[A-Za-z0-9][A-Za-z0-9._:-]{2,180}$"
        }
      }
    }
  },
  "x-kfm": {
    "contract_doc": "contracts/data/catalog_matrix.md",
    "fixtures_root": "fixtures/data/catalog_matrix/",
    "validator": "tools/validators/validate_catalog_matrix.py",
    "policy": "policy/data/",
    "status": "PROPOSED",
    "authority_boundary": "local-alignment-only"
  }
}
