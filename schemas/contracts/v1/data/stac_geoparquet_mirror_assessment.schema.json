{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfm://schema/contracts/v1/data/stac-geoparquet-mirror-assessment",
  "title": "StacGeoParquetMirrorAssessment",
  "description": "Fixture-only content-parity assessment for a declared STAC Item set and a declared STAC GeoParquet collection mirror. Shape validity grants no catalog, evidence, policy, review, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "object_type", "assessment_id", "spec_hash", "assessment_state", "assessment_scope", "mapping_profile", "source_collection", "source_items", "mirror", "report", "governance"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "object_type": {"const": "StacGeoParquetMirrorAssessment"},
    "assessment_id": {"type": "string", "pattern": "^kfm:stac-geoparquet-mirror-assessment:[0-9a-f]{24}$"},
    "spec_hash": {"$ref": "#/$defs/sha256"},
    "assessment_state": {"enum": ["COMPLETE", "ERROR"]},
    "assessment_scope": {"enum": ["FULL_COLLECTION", "PARTIAL_SAMPLE"]},
    "mapping_profile": {"$ref": "#/$defs/mapping_profile"},
    "source_collection": {"$ref": "#/$defs/collection_entry"},
    "source_items": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/item_projection"}},
    "mirror": {"$ref": "#/$defs/mirror"},
    "report": {"$ref": "#/$defs/report"},
    "governance": {"$ref": "#/$defs/governance"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "git_blob_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "uri": {"type": "string", "minLength": 8, "maxLength": 512, "format": "uri"},
    "collection_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "item_id": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "item_key": {"type": "string", "minLength": 3, "maxLength": 321, "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*/[A-Za-z0-9][A-Za-z0-9._:-]*$"},
    "canonical_strings": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 256}},
    "mapping_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_id", "spec_repository", "spec_document", "spec_blob_sha", "mapping_version", "stability", "stac_version", "geoparquet_version"],
      "properties": {
        "profile_id": {"const": "kfm.stac-geoparquet-mirror.experimental.v1"},
        "spec_repository": {"const": "https://github.com/radiantearth/stac-geoparquet-spec"},
        "spec_document": {"const": "stac-geoparquet-spec.md"},
        "spec_blob_sha": {"$ref": "#/$defs/git_blob_sha"},
        "mapping_version": {"enum": ["1.0.0", "1.1.0"]},
        "stability": {"const": "EXPERIMENTAL_PINNED_REVISION"},
        "stac_version": {"const": "1.1.0"},
        "geoparquet_version": {"const": "1.1.0"}
      }
    },
    "collection_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection_id", "collection_digest"],
      "properties": {
        "collection_id": {"$ref": "#/$defs/collection_id"},
        "collection_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "bbox": {
      "oneOf": [
        {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number"}},
        {"type": "array", "minItems": 6, "maxItems": 6, "items": {"type": "number"}}
      ]
    },
    "item_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["collection_id", "item_id", "stac_extensions", "geometry_digest", "bbox", "links_digest", "assets_digest", "properties_digest", "property_names", "datetime", "start_datetime", "end_datetime"],
      "properties": {
        "collection_id": {"$ref": "#/$defs/collection_id"},
        "item_id": {"$ref": "#/$defs/item_id"},
        "stac_extensions": {"$ref": "#/$defs/canonical_strings"},
        "geometry_digest": {"$ref": "#/$defs/sha256"},
        "bbox": {"$ref": "#/$defs/bbox"},
        "links_digest": {"$ref": "#/$defs/sha256"},
        "assets_digest": {"$ref": "#/$defs/sha256"},
        "properties_digest": {"$ref": "#/$defs/sha256"},
        "property_names": {"$ref": "#/$defs/canonical_strings"},
        "datetime": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "start_datetime": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "end_datetime": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]}
      }
    },
    "mirror": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_href", "asset_media_type", "asset_roles", "geometry_encoding", "datetime_storage", "metadata_version", "collections", "rows"],
      "properties": {
        "asset_href": {"$ref": "#/$defs/uri"},
        "asset_media_type": {"const": "application/vnd.apache.parquet"},
        "asset_roles": {"type": "array", "contains": {"const": "collection-mirror"}, "minContains": 1, "maxContains": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 80}},
        "geometry_encoding": {"enum": ["WKB", "GEOARROW_SINGLE_GEOMETRY"]},
        "datetime_storage": {"const": "NATIVE_TIMESTAMP"},
        "metadata_version": {"enum": ["1.0.0", "1.1.0"]},
        "collections": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"$ref": "#/$defs/collection_entry"}},
        "rows": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/item_projection"}}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "reason_code", "matched_item_keys", "missing_mirror_item_keys", "unexpected_mirror_item_keys", "divergent_item_keys", "catalog_authority_granted", "release_authorized", "publication_authorized"],
      "properties": {
        "result": {"enum": ["PARITY_CONFIRMED", "PARTIAL_SAMPLE", "PARITY_CONFLICT", "ERROR"]},
        "reason_code": {"enum": ["FULL_COLLECTION_PARITY_CONFIRMED", "PARTIAL_SAMPLE_PARITY_ONLY", "MIRROR_CONTENT_CONFLICT", "ASSESSMENT_ERROR"]},
        "matched_item_keys": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/item_key"}},
        "missing_mirror_item_keys": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/item_key"}},
        "unexpected_mirror_item_keys": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/item_key"}},
        "divergent_item_keys": {"type": "array", "maxItems": 64, "uniqueItems": true, "items": {"$ref": "#/$defs/item_key"}},
        "catalog_authority_granted": {"const": false},
        "release_authorized": {"const": false},
        "publication_authorized": {"const": false}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["execution_mode", "network_attempted", "parquet_opened", "source_items_resolved", "catalog_mutated", "evidence_resolved", "policy_decided", "review_approved", "release_authorized", "publication_authorized", "public_use_allowed"],
      "properties": {
        "execution_mode": {"const": "FIXTURE_ONLY"},
        "network_attempted": {"const": false},
        "parquet_opened": {"const": false},
        "source_items_resolved": {"const": false},
        "catalog_mutated": {"const": false},
        "evidence_resolved": {"const": false},
        "policy_decided": {"const": false},
        "review_approved": {"const": false},
        "release_authorized": {"const": false},
        "publication_authorized": {"const": false},
        "public_use_allowed": {"const": false}
      }
    }
  }
}
