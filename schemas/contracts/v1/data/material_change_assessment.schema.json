{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/data/material_change_assessment.schema.json",
  "title": "material_change_assessment",
  "description": "Fixture-first profile for deterministic byte, semantic, and material-change classification. A valid assessment is process memory only and does not authorize policy, promotion, release, or publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "assessment_id",
    "subject_ref",
    "baseline_ref",
    "candidate_ref",
    "profile",
    "comparison",
    "criteria",
    "classification",
    "evidence",
    "timing",
    "lineage",
    "governance"
  ],
  "properties": {
    "object_type": {"const": "MaterialChangeAssessment"},
    "schema_version": {"const": "1.0.0"},
    "assessment_id": {
      "type": "string",
      "pattern": "^material-change:[a-z0-9][a-z0-9_:.-]{7,240}$"
    },
    "subject_ref": {"$ref": "#/$defs/ref"},
    "baseline_ref": {"$ref": "#/$defs/ref"},
    "candidate_ref": {"$ref": "#/$defs/ref"},
    "profile": {"$ref": "#/$defs/profile"},
    "comparison": {"$ref": "#/$defs/comparison"},
    "criteria": {
      "type": "array",
      "maxItems": 64,
      "items": {"$ref": "#/$defs/criterion"}
    },
    "classification": {"$ref": "#/$defs/classification"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "timing": {"$ref": "#/$defs/timing"},
    "lineage": {"$ref": "#/$defs/lineage"},
    "governance": {"$ref": "#/$defs/governance"}
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 640,
      "pattern": "\\S"
    },
    "nullable_ref": {
      "oneOf": [
        {"$ref": "#/$defs/ref"},
        {"type": "null"}
      ]
    },
    "ref_array": {
      "type": "array",
      "items": {"$ref": "#/$defs/ref"},
      "uniqueItems": true
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "aware_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullable_datetime": {
      "oneOf": [
        {"$ref": "#/$defs/aware_datetime"},
        {"type": "null"}
      ]
    },
    "scalar": {
      "oneOf": [
        {"type": "number"},
        {"type": "string", "maxLength": 256},
        {"type": "boolean"},
        {"type": "null"}
      ]
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "spec_hash",
        "digest_algorithm",
        "canonicalization_profile"
      ],
      "properties": {
        "profile_id": {"$ref": "#/$defs/ref"},
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "spec_hash": {"$ref": "#/$defs/sha256"},
        "digest_algorithm": {"const": "sha256"},
        "canonicalization_profile": {
          "type": "string",
          "enum": [
            "byte-exact",
            "canonical-json-rfc8785",
            "kfm-canonical-json-v1",
            "domain-declared"
          ]
        }
      }
    },
    "comparison": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "baseline_digest",
        "candidate_digest",
        "byte_changed",
        "semantic_changed"
      ],
      "properties": {
        "baseline_digest": {"$ref": "#/$defs/sha256"},
        "candidate_digest": {"$ref": "#/$defs/sha256"},
        "byte_changed": {"type": "boolean"},
        "semantic_changed": {
          "oneOf": [
            {"type": "boolean"},
            {"type": "null"}
          ]
        }
      }
    },
    "criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "criterion_id",
        "metric",
        "required",
        "result",
        "observed_value",
        "threshold",
        "unit",
        "evidence_refs"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9_.:-]{2,120}$"
        },
        "metric": {"$ref": "#/$defs/ref"},
        "required": {"type": "boolean"},
        "result": {
          "type": "string",
          "enum": ["PASS", "FAIL", "UNKNOWN", "ERROR"]
        },
        "observed_value": {"$ref": "#/$defs/scalar"},
        "threshold": {"$ref": "#/$defs/scalar"},
        "unit": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 64},
            {"type": "null"}
          ]
        },
        "evidence_refs": {"$ref": "#/$defs/ref_array"}
      }
    },
    "classification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["change_class", "material", "outcome", "reason_codes"],
      "properties": {
        "change_class": {
          "type": "string",
          "enum": [
            "UNCHANGED",
            "BYTE_ONLY",
            "SEMANTIC_NON_MATERIAL",
            "MATERIAL",
            "UNDETERMINED",
            "ERROR"
          ]
        },
        "material": {
          "oneOf": [
            {"type": "boolean"},
            {"type": "null"}
          ]
        },
        "outcome": {
          "type": "string",
          "enum": ["NON_EVENT", "PROMOTION_CANDIDATE", "HOLD", "ERROR"]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "NO_BYTE_CHANGE",
              "BYTE_ONLY_CHANGE",
              "CANONICAL_EQUIVALENT",
              "BELOW_MATERIALITY_THRESHOLD",
              "MATERIALITY_THRESHOLD_MET",
              "DOMAIN_STATUS_CHANGE",
              "MISSING_BASELINE",
              "PROFILE_UNRESOLVED",
              "METRIC_UNAVAILABLE",
              "INSUFFICIENT_EVIDENCE",
              "INPUT_INVALID",
              "PROFILE_INVALID",
              "EVALUATION_ERROR"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diff_report_ref", "validation_report_refs", "source_refs"],
      "properties": {
        "diff_report_ref": {"$ref": "#/$defs/nullable_ref"},
        "validation_report_refs": {"$ref": "#/$defs/ref_array"},
        "source_refs": {"$ref": "#/$defs/ref_array"}
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assessed_at", "baseline_as_of", "candidate_as_of"],
      "properties": {
        "assessed_at": {"$ref": "#/$defs/aware_datetime"},
        "baseline_as_of": {"$ref": "#/$defs/nullable_datetime"},
        "candidate_as_of": {"$ref": "#/$defs/nullable_datetime"}
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["supersedes", "superseded_by"],
      "properties": {
        "supersedes": {"$ref": "#/$defs/nullable_ref"},
        "superseded_by": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_created",
        "policy_evaluated",
        "promotion_authorized",
        "public_use_allowed",
        "release_ref",
        "spec_hash"
      ],
      "properties": {
        "authority_created": {"const": false},
        "policy_evaluated": {"const": false},
        "promotion_authorized": {"const": false},
        "public_use_allowed": {"const": false},
        "release_ref": {"type": "null"},
        "spec_hash": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED",
    "contract_doc": "contracts/data/material_change_assessment.md",
    "fixtures_root": "fixtures/contracts/v1/data/material_change_assessment/",
    "validator": "tools/validators/validate_material_change_assessment.py",
    "tests": "tests/validators/test_validate_material_change_assessment.py",
    "authority": "shape_and_local_consistency_only",
    "non_effects": [
      "does_not_define_domain_thresholds",
      "does_not_evaluate_policy",
      "does_not_authorize_promotion",
      "does_not_release_or_publish"
    ]
  }
}
