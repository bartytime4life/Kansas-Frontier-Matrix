{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://schemas.kfm.local/contracts/v1/data/baseline_cohort_assessment.schema.json",
  "title":"BaselineCohortAssessmentCandidate",
  "type":"object",
  "additionalProperties":false,
  "$defs":{
    "aware_datetime":{"type":"string","format":"date-time","pattern":"(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "spec_hash":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"},
    "nullable_ref":{"oneOf":[{"type":"string","pattern":"^kfm:[a-z0-9][a-z0-9._:/-]{5,220}$"},{"type":"null"}]},
    "baseline":{
      "type":"object","additionalProperties":false,
      "properties":{
        "baseline_ref":{"type":"string","pattern":"^kfm:baseline:[a-z0-9][a-z0-9._:-]{2,127}$"},
        "baseline_version":{"type":"string","pattern":"^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "baseline_spec_hash":{"$ref":"#/$defs/spec_hash"},
        "valid_start":{"$ref":"#/$defs/aware_datetime"},
        "valid_end":{"$ref":"#/$defs/aware_datetime"},
        "recorded_at":{"$ref":"#/$defs/aware_datetime"},
        "method_profile_ref":{"type":"string","pattern":"^kfm:baseline-method:[a-z0-9][a-z0-9._:-]{2,127}$"},
        "method_profile_hash":{"$ref":"#/$defs/spec_hash"},
        "parameters_digest":{"$ref":"#/$defs/spec_hash"},
        "prior_baseline_ref":{"$ref":"#/$defs/nullable_ref"}
      },
      "required":["baseline_ref","baseline_version","baseline_spec_hash","valid_start","valid_end","recorded_at","method_profile_ref","method_profile_hash","parameters_digest","prior_baseline_ref"]
    },
    "candidate":{
      "type":"object","additionalProperties":false,
      "properties":{
        "member_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,127}$"},
        "observation_ref":{"type":"string","pattern":"^kfm:observation:[a-z0-9][a-z0-9._:-]{2,127}$"},
        "source_descriptor_ref":{"type":"string","pattern":"^kfm://source/[a-z0-9][a-z0-9._:-]{2,127}$"},
        "observed_at":{"$ref":"#/$defs/aware_datetime"},
        "recorded_at":{"$ref":"#/$defs/aware_datetime"},
        "method_profile_ref":{"type":"string","pattern":"^kfm:baseline-method:[a-z0-9][a-z0-9._:-]{2,127}$"},
        "missingness":{"enum":["COMPLETE","PARTIAL","MISSING"]},
        "eligibility":{"enum":["INCLUDE","EXCLUDE","HOLD"]},
        "reason_codes":{"type":"array","minItems":1,"maxItems":3,"uniqueItems":true,"items":{"enum":["ELIGIBLE","OUTSIDE_WINDOW","METHOD_MISMATCH","MISSING_SUPPORT","RELOCATION_DISCONTINUITY","METHOD_DISCONTINUITY","INSTRUMENT_DISCONTINUITY","GAP_DISCONTINUITY","CORRECTION_DISCONTINUITY","QUALITY_HOLD","DISCONTINUITY_REVIEW_PENDING"]}},
        "discontinuity_ref":{"$ref":"#/$defs/nullable_ref"},
        "evidence_refs":{"type":"array","maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^kfm:evidence:[a-z0-9][a-z0-9._:-]{2,220}$"}}
      },
      "required":["member_id","observation_ref","source_descriptor_ref","observed_at","recorded_at","method_profile_ref","missingness","eligibility","reason_codes","discontinuity_ref","evidence_refs"]
    },
    "discontinuity":{
      "type":"object","additionalProperties":false,
      "properties":{
        "discontinuity_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,127}$"},
        "member_id":{"type":"string","pattern":"^[a-z0-9][a-z0-9._-]{2,127}$"},
        "class":{"enum":["RELOCATION","METHOD_CHANGE","INSTRUMENT_CHANGE","GAP","CORRECTION"]},
        "effective_at":{"$ref":"#/$defs/aware_datetime"},
        "recorded_at":{"$ref":"#/$defs/aware_datetime"},
        "disposition":{"enum":["EXCLUDE","SEGMENT","HOLD"]},
        "evidence_refs":{"type":"array","minItems":1,"maxItems":8,"uniqueItems":true,"items":{"type":"string","pattern":"^kfm:evidence:[a-z0-9][a-z0-9._:-]{2,220}$"}},
        "correction_of":{"$ref":"#/$defs/nullable_ref"}
      },
      "required":["discontinuity_id","member_id","class","effective_at","recorded_at","disposition","evidence_refs","correction_of"]
    },
    "governance":{
      "type":"object","additionalProperties":false,
      "properties":{
        "execution_mode":{"const":"FIXTURE_ONLY"},
        "network_attempted":{"const":false},
        "source_accessed":{"const":false},
        "observation_values_stored":{"const":false},
        "baseline_calculated":{"const":false},
        "baseline_rebuilt":{"const":false},
        "anomaly_evaluated":{"const":false},
        "materiality_decided":{"const":false},
        "data_mutated":{"const":false},
        "evidence_authenticated":{"const":false},
        "policy_evaluated":{"const":false},
        "review_approved":{"const":false},
        "release_authorized":{"const":false},
        "publication_authorized":{"const":false},
        "public_use_allowed":{"const":false}
      },
      "required":["execution_mode","network_attempted","source_accessed","observation_values_stored","baseline_calculated","baseline_rebuilt","anomaly_evaluated","materiality_decided","data_mutated","evidence_authenticated","policy_evaluated","review_approved","release_authorized","publication_authorized","public_use_allowed"]
    }
  },
  "properties":{
    "object_type":{"const":"BaselineCohortAssessmentCandidate"},
    "schema_version":{"const":"1.0.0"},
    "profile":{"const":"kfm.baseline-cohort.fixture.v1"},
    "assessment_id":{"type":"string","pattern":"^kfm:baseline-cohort:[0-9a-f]{24}$"},
    "subject_ref":{"type":"string","pattern":"^kfm:[a-z0-9][a-z0-9._:/-]{5,220}$"},
    "assessed_at":{"$ref":"#/$defs/aware_datetime"},
    "baseline":{"$ref":"#/$defs/baseline"},
    "candidates":{"type":"array","minItems":2,"maxItems":32,"items":{"$ref":"#/$defs/candidate"}},
    "discontinuities":{"type":"array","maxItems":32,"items":{"$ref":"#/$defs/discontinuity"}},
    "summary":{
      "type":"object","additionalProperties":false,
      "properties":{
        "candidate_count":{"type":"integer","minimum":2,"maximum":32},
        "included_count":{"type":"integer","minimum":0,"maximum":32},
        "excluded_count":{"type":"integer","minimum":0,"maximum":32},
        "hold_count":{"type":"integer","minimum":0,"maximum":32},
        "discontinuity_count":{"type":"integer","minimum":0,"maximum":32},
        "cohort_outcome":{"enum":["COMPLETE","HOLD","ABSTAIN"]},
        "rebuild_required":{"type":"boolean"},
        "baseline_use_authorized":{"const":false},
        "baseline_publishable":{"const":false},
        "separate_materiality_policy_required":{"const":true}
      },
      "required":["candidate_count","included_count","excluded_count","hold_count","discontinuity_count","cohort_outcome","rebuild_required","baseline_use_authorized","baseline_publishable","separate_materiality_policy_required"]
    },
    "governance":{"$ref":"#/$defs/governance"},
    "spec_hash":{"$ref":"#/$defs/spec_hash"}
  },
  "required":["object_type","schema_version","profile","assessment_id","subject_ref","assessed_at","baseline","candidates","discontinuities","summary","governance","spec_hash"],
  "x-kfm":{
    "status":"PROPOSED_INACTIVE",
    "authority":"NONE",
    "contract_doc":"contracts/data/baseline_cohort_assessment.md",
    "fixtures_root":"fixtures/contracts/v1/data/baseline_cohort_assessment/",
    "validator":"tools/validators/data/validate_baseline_cohort_assessment.py"
  }
}
