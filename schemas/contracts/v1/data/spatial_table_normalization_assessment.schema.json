{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/data/spatial_table_normalization_assessment.schema.json",
  "title": "SpatialTableNormalizationAssessmentCandidate",
  "description": "Fixture-only declaration of spatial-table keys, dependencies, relationships, normal-form posture, and intentional derivative denormalization without authority effects.",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_type", "schema_version", "profile", "profile_spec_hash", "source_card", "observed_at", "table_artifact_ref", "table_artifact_digest", "schema_registry", "lifecycle_role", "field_inventory", "entity_key_fields", "dependencies", "relationships", "assessment", "authority_claims"],
  "properties": {
    "object_type": {"const": "SpatialTableNormalizationAssessmentCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.data.spatial-table-normalization-assessment.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_card": {"const": "KFM-P18-INV-402"},
    "observed_at": {"type": "string", "format": "date-time"},
    "table_artifact_ref": {"$ref": "#/$defs/ref"},
    "table_artifact_digest": {"$ref": "#/$defs/sha256"},
    "schema_registry": {"$ref": "#/$defs/resolvable_ref"},
    "lifecycle_role": {"enum": ["PROCESSED_CANONICAL_CANDIDATE", "RELEASE_DERIVATIVE_CANDIDATE"]},
    "field_inventory": {"$ref": "#/$defs/nonempty_name_array"},
    "entity_key_fields": {"$ref": "#/$defs/nonempty_name_array"},
    "dependencies": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"$ref": "#/$defs/dependency"}},
    "relationships": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/relationship"}},
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "declared_normal_form", "anomaly_codes", "canonical_source_ref", "canonical_source_digest", "denormalization_purpose", "review_record_refs"],
      "properties": {
        "state": {"enum": ["COMPLETE_FOR_DECLARED_SCOPE", "INCOMPLETE", "UNKNOWN"]},
        "declared_normal_form": {"enum": ["FIRST_NORMAL_FORM", "SECOND_NORMAL_FORM", "THIRD_NORMAL_FORM", "BOYCE_CODD_NORMAL_FORM", "DENORMALIZED_DERIVATIVE", "UNASSESSED"]},
        "anomaly_codes": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["DERIVATIVE_DUPLICATION", "MULTIVALUED_DEPENDENCY", "PARTIAL_DEPENDENCY", "TRANSITIVE_DEPENDENCY"]}},
        "canonical_source_ref": {"oneOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
        "canonical_source_digest": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "denormalization_purpose": {"oneOf": [{"type": "string", "minLength": 16, "maxLength": 500}, {"type": "null"}]},
        "review_record_refs": {"$ref": "#/$defs/ref_array"}
      }
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_authority", "data_authority", "evidence_authority", "policy_authority", "review_authority", "promotion_authority", "release_authority", "publication_authority", "public_use_authority"],
      "properties": {
        "schema_authority": {"const": false},
        "data_authority": {"const": false},
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "ref": {"type": "string", "minLength": 5, "maxLength": 300, "pattern": "^kfm:[a-z0-9][a-z0-9._:/-]+$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[a-z][a-z0-9_]*$"},
    "name_array": {"type": "array", "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "nonempty_name_array": {"type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "ref_array": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
    "resolvable_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "digest", "resolution"],
      "properties": {"ref": {"$ref": "#/$defs/ref"}, "digest": {"$ref": "#/$defs/sha256"}, "resolution": {"enum": ["RESOLVED", "UNRESOLVED"]}}
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dependency_id", "determinant_fields", "dependent_fields", "kind", "rationale", "evidence_refs"],
      "properties": {
        "dependency_id": {"type": "string", "pattern": "^dependency:[a-z0-9][a-z0-9._-]{2,80}$"},
        "determinant_fields": {"$ref": "#/$defs/nonempty_name_array"},
        "dependent_fields": {"$ref": "#/$defs/nonempty_name_array"},
        "kind": {"enum": ["FULL", "PARTIAL", "TRANSITIVE", "MULTIVALUED", "DERIVATIVE_DUPLICATION"]},
        "rationale": {"type": "string", "minLength": 12, "maxLength": 500},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}}
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationship_id", "local_fields", "target_entity_ref", "target_key_fields", "cardinality"],
      "properties": {
        "relationship_id": {"type": "string", "pattern": "^relationship:[a-z0-9][a-z0-9._-]{2,80}$"},
        "local_fields": {"$ref": "#/$defs/nonempty_name_array"},
        "target_entity_ref": {"$ref": "#/$defs/ref"},
        "target_key_fields": {"$ref": "#/$defs/nonempty_name_array"},
        "cardinality": {"enum": ["ONE_TO_ONE", "MANY_TO_ONE", "ONE_TO_MANY", "MANY_TO_MANY"]}
      }
    }
  }
}
