{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/data/analytical_view_manifest.schema.json",
  "title": "AnalyticalViewManifestCandidate",
  "description": "Fixture-only analytical database/materialized-view manifest with no SQL execution, view creation, data mutation, or authority effects.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "profile_spec_hash",
    "source_cards",
    "assessed_at",
    "view_id",
    "view_kind",
    "purpose",
    "definition",
    "upstream",
    "semantic_dependencies",
    "validation",
    "materialization",
    "mutation",
    "disclosure",
    "limitations",
    "authority_claims"
  ],
  "properties": {
    "object_type": {"const": "AnalyticalViewManifestCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.data.analytical-view-manifest.fixture.v1"},
    "profile_spec_hash": {"$ref": "#/$defs/sha256"},
    "source_cards": {"const": ["KFM-P18-INV-107", "KFM-P18-INV-311"]},
    "assessed_at": {"type": "string", "format": "date-time"},
    "view_id": {"$ref": "#/$defs/ref"},
    "view_kind": {"enum": ["DATABASE_VIEW", "MATERIALIZED_VIEW", "EQUIVALENT_DERIVED_VIEW", "UNRESOLVED"]},
    "purpose": {"type": "string", "minLength": 12, "maxLength": 256, "pattern": "^[^\\r\\n]+$"},
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition_digest", "dialect_profile_ref", "raw_sql_stored"],
      "properties": {
        "definition_digest": {"$ref": "#/$defs/sha256"},
        "dialect_profile_ref": {"$ref": "#/$defs/nullable_ref"},
        "raw_sql_stored": {"const": false}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_refs", "lineage_ref"],
      "properties": {
        "dataset_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ref"}
        },
        "lineage_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "semantic_dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "join_assessment_refs",
        "filter_predicate_ref",
        "aggregate_disclosure_refs",
        "deduplication_assessment_ref",
        "window_disclosure_refs"
      ],
      "properties": {
        "join_assessment_refs": {"$ref": "#/$defs/ref_array"},
        "filter_predicate_ref": {"$ref": "#/$defs/nullable_ref"},
        "aggregate_disclosure_refs": {"$ref": "#/$defs/ref_array"},
        "deduplication_assessment_ref": {"$ref": "#/$defs/nullable_ref"},
        "window_disclosure_refs": {"$ref": "#/$defs/ref_array"}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "validation_report_refs", "fixture_receipt_ref"],
      "properties": {
        "state": {"enum": ["VALIDATED", "PARTIAL", "NOT_VALIDATED", "ERROR"]},
        "validation_report_refs": {"$ref": "#/$defs/ref_array"},
        "fixture_receipt_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "materialization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["refresh_mode", "freshness_profile_ref"],
      "properties": {
        "refresh_mode": {"enum": ["ON_QUERY", "SCHEDULED", "EVENT_DRIVEN", "MANUAL", "NOT_APPLICABLE", "UNRESOLVED"]},
        "freshness_profile_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "mutation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture", "predicate_ref", "check_option_mode", "mutation_policy_ref"],
      "properties": {
        "posture": {"enum": ["READ_ONLY", "UPDATABLE_GOVERNED", "DIRECT_MUTATION_PROHIBITED", "UNRESOLVED"]},
        "predicate_ref": {"$ref": "#/$defs/nullable_ref"},
        "check_option_mode": {"enum": ["LOCAL", "CASCADED", "EQUIVALENT_GUARD", "NOT_APPLICABLE", "UNRESOLVED"]},
        "mutation_policy_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intended_use",
        "summary",
        "review_record_refs",
        "correction_policy_ref",
        "rollback_target_ref"
      ],
      "properties": {
        "intended_use": {"enum": ["INTERNAL_ANALYSIS", "REPRODUCIBILITY_PACKET", "PUBLIC_CANDIDATE"]},
        "summary": {"type": "string", "minLength": 12, "maxLength": 512, "pattern": "^[^\\r\\n]+$"},
        "review_record_refs": {"$ref": "#/$defs/ref_array"},
        "correction_policy_ref": {"$ref": "#/$defs/ref"},
        "rollback_target_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "limitations": {
      "const": [
        "DECLARATION_ONLY",
        "NO_RAW_SQL_OR_DATABASE_ENDPOINTS",
        "NO_VIEW_CREATION_OR_QUERY_EXECUTION",
        "NO_DATA_MUTATION_OR_REFRESH_AUTHORITY",
        "NO_EVIDENCE_POLICY_OR_REVIEW_AUTHORITY",
        "NO_RELEASE_OR_PUBLICATION_AUTHORITY"
      ]
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "view_creation_authority",
        "query_execution_authority",
        "data_mutation_authority",
        "refresh_authority",
        "evidence_authority",
        "policy_authority",
        "review_authority",
        "promotion_authority",
        "release_authority",
        "deployment_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "view_creation_authority": {"const": false},
        "query_execution_authority": {"const": false},
        "data_mutation_authority": {"const": false},
        "refresh_authority": {"const": false},
        "evidence_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "release_authority": {"const": false},
        "deployment_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 5,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "nullable_ref": {"anyOf": [{"$ref": "#/$defs/ref"}, {"type": "null"}]},
    "ref_array": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"}
  }
}
