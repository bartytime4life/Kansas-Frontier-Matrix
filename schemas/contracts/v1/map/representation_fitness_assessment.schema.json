{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfm.example/schemas/contracts/v1/map/representation_fitness_assessment.schema.json",
  "title": "RepresentationFitnessAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "assessment_id", "representation_ref", "evidence_refs", "intended_use", "source_role", "fidelity", "geometry_character", "scale", "temporal", "outcome", "effects"],
  "properties": {
    "profile": {"const": "kfm.map.representation-fitness.v1"},
    "assessment_id": {"type": "string", "pattern": "^kfm:representation-fitness:[a-f0-9]{64}$"},
    "representation_ref": {"type": "string", "minLength": 1, "maxLength": 512},
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "intended_use": {"enum": ["BROWSE", "CONTEXT", "ANALYSIS", "MEASUREMENT", "DECISION_SUPPORT"]},
    "source_role": {"enum": ["OBSERVATION", "AUTHORITATIVE_STATIC", "DERIVED", "MODELED", "CONTEXTUAL", "SYNTHETIC"]},
    "fidelity": {"enum": ["EXACT", "GENERALIZED", "AGGREGATED", "MODELED", "SYNTHETIC"]},
    "geometry_character": {"enum": ["EXACT", "GENERALIZED", "AGGREGATED", "SYNTHETIC"]},
    "scale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_denominator", "min_supported_denominator", "max_supported_denominator"],
      "properties": {
        "requested_denominator": {"type": "integer", "minimum": 1},
        "min_supported_denominator": {"type": "integer", "minimum": 1},
        "max_supported_denominator": {"type": "integer", "minimum": 1}
      }
    },
    "temporal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requested_at", "support_start", "support_end"],
      "properties": {
        "requested_at": {"type": "string", "format": "date-time"},
        "support_start": {"type": "string", "format": "date-time"},
        "support_end": {"type": "string", "format": "date-time"}
      }
    },
    "reality_boundary_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 512},
    "outcome": {"enum": ["FIT", "HOLD", "ERROR"]},
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy_evaluated", "release_authorized", "published", "public_use_authorized"],
      "properties": {
        "policy_evaluated": {"const": false},
        "release_authorized": {"const": false},
        "published": {"const": false},
        "public_use_authorized": {"const": false}
      }
    }
  }
}
