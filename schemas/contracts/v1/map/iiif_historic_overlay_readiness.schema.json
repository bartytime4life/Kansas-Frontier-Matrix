{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/map/iiif_historic_overlay_readiness.schema.json",
  "title": "IIIFHistoricOverlayReadinessAssessment",
  "description": "Fixture-only no-network readiness assessment for IIIF historic-map overlays.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "fixture_only",
    "network_access",
    "assessed_at",
    "source",
    "raw_capture",
    "overlay",
    "rights",
    "care",
    "renderer",
    "public_boundary",
    "decision",
    "governance"
  ],
  "properties": {
    "object_type": {
      "const": "IIIFHistoricOverlayReadinessAssessment"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "profile": {
      "const": "kfm.iiif.historic-overlay-readiness.v1"
    },
    "fixture_only": {
      "const": true
    },
    "network_access": {
      "const": "forbidden"
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_descriptor_ref",
        "manifest_url",
        "info_json_url",
        "presentation_api_version",
        "image_api_version",
        "legacy_normalization_ref",
        "freshness"
      ],
      "properties": {
        "source_descriptor_ref": {
          "$ref": "#/$defs/ref"
        },
        "manifest_url": {
          "$ref": "#/$defs/https_url"
        },
        "info_json_url": {
          "oneOf": [
            {
              "$ref": "#/$defs/https_url"
            },
            {
              "type": "null"
            }
          ]
        },
        "presentation_api_version": {
          "enum": [
            "2.1.1",
            "3.0",
            "4.0-preview"
          ]
        },
        "image_api_version": {
          "enum": [
            "2.1.1",
            "3.0"
          ]
        },
        "legacy_normalization_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "freshness": {
          "enum": [
            "CURRENT",
            "STALE",
            "UNKNOWN"
          ]
        }
      }
    },
    "raw_capture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "manifest_digest",
        "info_digest",
        "annotation_digest",
        "annotation_payload_utf8",
        "bytes_preserved",
        "capture_metadata_present"
      ],
      "properties": {
        "manifest_digest": {
          "$ref": "#/$defs/sha256"
        },
        "info_digest": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "annotation_digest": {
          "$ref": "#/$defs/sha256"
        },
        "annotation_payload_utf8": {
          "type": "string",
          "minLength": 2,
          "maxLength": 262144
        },
        "bytes_preserved": {
          "type": "boolean"
        },
        "capture_metadata_present": {
          "type": "boolean"
        }
      }
    },
    "overlay": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "georeference_present",
        "gcp_count",
        "gcps",
        "resource_mask",
        "transform_method",
        "original_crs",
        "transform_rms",
        "overlay_uncertainty"
      ],
      "properties": {
        "georeference_present": {
          "type": "boolean"
        },
        "gcp_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "gcps": {
          "type": "array",
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/gcp"
          }
        },
        "resource_mask": {
          "type": "array",
          "minItems": 0,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/point"
          }
        },
        "transform_method": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "original_crs": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "transform_rms": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "overlay_uncertainty": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_uri",
        "required_statement_present",
        "rights_propagated",
        "kfm_rights_state"
      ],
      "properties": {
        "rights_uri": {
          "oneOf": [
            {
              "$ref": "#/$defs/https_url"
            },
            {
              "type": "null"
            }
          ]
        },
        "required_statement_present": {
          "type": "boolean"
        },
        "rights_propagated": {
          "type": "boolean"
        },
        "kfm_rights_state": {
          "enum": [
            "RESOLVED",
            "UNKNOWN",
            "CONTROLLED",
            "DENIED"
          ]
        }
      }
    },
    "care": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "authority_to_control",
        "consent_grant_ref"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_APPLICABLE",
            "CLEARED",
            "REVIEW_REQUIRED",
            "UNKNOWN",
            "DENIED"
          ]
        },
        "authority_to_control": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "uniqueItems": true
        },
        "consent_grant_ref": {
          "$ref": "#/$defs/nullable_ref"
        }
      }
    },
    "renderer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "plugin_required",
        "plugin_name",
        "plugin_version",
        "allowlisted"
      ],
      "properties": {
        "plugin_required": {
          "type": "boolean"
        },
        "plugin_name": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            {
              "type": "null"
            }
          ]
        },
        "plugin_version": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "allowlisted": {
          "type": "boolean"
        }
      }
    },
    "public_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "raw_route_exposed",
        "unreleased_fetch_allowed",
        "evidence_bundle_ref",
        "map_release_manifest_ref",
        "rollback_target_ref"
      ],
      "properties": {
        "raw_route_exposed": {
          "type": "boolean"
        },
        "unreleased_fetch_allowed": {
          "type": "boolean"
        },
        "evidence_bundle_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "map_release_manifest_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "rollback_target_ref": {
          "$ref": "#/$defs/nullable_ref"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reasons"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "READY",
            "HOLD",
            "DENY",
            "ERROR"
          ]
        },
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9_]+$"
          },
          "uniqueItems": true
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_created",
        "policy_evaluated",
        "promotion_authorized",
        "release_authorized",
        "publication_authorized",
        "public_use_allowed",
        "release_ref"
      ],
      "properties": {
        "authority_created": {
          "const": false
        },
        "policy_evaluated": {
          "const": false
        },
        "promotion_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        },
        "public_use_allowed": {
          "const": false
        },
        "release_ref": {
          "type": "null"
        }
      }
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 640,
      "pattern": "^\\S(?:.*\\S)?$"
    },
    "nullable_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "https_url": {
      "type": "string",
      "pattern": "^https://[^\\s]+$",
      "maxLength": 2048
    },
    "point": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "gcp": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "resource",
        "geo"
      ],
      "properties": {
        "resource": {
          "$ref": "#/$defs/point"
        },
        "geo": {
          "$ref": "#/$defs/point"
        }
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "contract_doc": "contracts/map/iiif_historic_overlay_readiness.md",
    "fixtures_root": "fixtures/contracts/v1/map/iiif_historic_overlay_readiness/",
    "validator": "tools/validators/map/validate_iiif_historic_overlay_readiness.py",
    "authority": "fixture_readiness_only",
    "non_effects": [
      "no_network",
      "no_georeference_execution",
      "no_policy",
      "no_release",
      "no_public_use"
    ]
  }
}
