{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/map/georeference_control_point_evidence_assessment.schema.json",
  "title": "GeoreferenceControlPointEvidenceAssessmentCandidate",
  "description": "Inactive fixture-only assessment of declared GCP visibility, contrast, coordinate-source, and image-matching evidence without accuracy, policy, release, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type", "schema_version", "profile", "status", "assessment_id",
    "spec_hash", "source_idea_id", "evaluated_at", "control_point_set_ref",
    "coordinate_source", "matching", "control_point_count", "control_points",
    "summary", "evidence_refs", "recommendation", "review_state",
    "limitations", "effects"
  ],
  "properties": {
    "object_type": {"const": "GeoreferenceControlPointEvidenceAssessmentCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.map.georeference-control-point-evidence-assessment.fixture.v1"},
    "status": {"const": "PROPOSED_INACTIVE"},
    "assessment_id": {"type": "string", "pattern": "^gcp-evidence-assessment:[a-f0-9]{24}$"},
    "spec_hash": {"$ref": "#/$defs/sha256"},
    "source_idea_id": {"const": "KFM-P18-INV-317"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "control_point_set_ref": {
      "type": "string",
      "pattern": "^kfm:georeference-gcp-set:sha256:[a-f0-9]{64}$"
    },
    "coordinate_source": {"$ref": "#/$defs/coordinate_source"},
    "matching": {"$ref": "#/$defs/matching"},
    "control_point_count": {"type": "integer", "minimum": 3, "maximum": 256},
    "control_points": {
      "type": "array",
      "minItems": 3,
      "maxItems": 256,
      "items": {"$ref": "#/$defs/control_point_evidence"}
    },
    "summary": {"$ref": "#/$defs/summary"},
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "recommendation": {"enum": ["READY_FOR_REVIEW", "HOLD", "DENY"]},
    "review_state": {"const": "HOLD"},
    "limitations": {
      "const": [
        "ASSESSMENT_ONLY",
        "FIXTURE_ONLY_REFERENCES_UNRESOLVED",
        "NO_IMAGE_OR_COORDINATE_DEREFERENCE",
        "NO_ACCURACY_DISTRIBUTION_OR_TRANSFORM_DECISION",
        "NO_POLICY_RELEASE_PUBLICATION_OR_PUBLIC_USE_AUTHORITY"
      ]
    },
    "effects": {"$ref": "#/$defs/effects"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {
      "type": "string",
      "minLength": 10,
      "maxLength": 512,
      "pattern": "^kfm:[A-Za-z0-9][A-Za-z0-9._~:/-]+$"
    },
    "nullable_ref": {
      "oneOf": [
        {"$ref": "#/$defs/ref"},
        {"type": "null"}
      ]
    },
    "coordinate_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "status", "reference_system_ref", "evidence_ref"],
      "properties": {
        "method": {
          "enum": ["RTK_GNSS", "PPK_GNSS", "TOTAL_STATION", "SURVEY_NETWORK", "OTHER_REVIEWED", "UNKNOWN"]
        },
        "status": {"enum": ["VERIFIED", "UNKNOWN", "INVALID"]},
        "reference_system_ref": {"$ref": "#/$defs/nullable_ref"},
        "evidence_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "matching": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "status", "image_observation_set_ref", "evidence_ref"],
      "properties": {
        "method": {
          "enum": ["MANUAL_VERIFIED", "AUTOMATED_WITH_MANUAL_REVIEW", "AUTOMATED_UNREVIEWED", "UNKNOWN"]
        },
        "status": {"enum": ["VERIFIED", "UNKNOWN", "INVALID"]},
        "image_observation_set_ref": {"$ref": "#/$defs/nullable_ref"},
        "evidence_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "control_point_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "visibility", "contrast", "marker_scale", "match_status", "evidence_ref"],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80, "pattern": "^[A-Za-z0-9_.:-]+$"},
        "visibility": {"enum": ["CLEAR", "PARTIAL", "OBSCURED", "UNKNOWN"]},
        "contrast": {"enum": ["HIGH", "ADEQUATE", "LOW", "UNKNOWN"]},
        "marker_scale": {"enum": ["ADEQUATE", "INADEQUATE", "UNKNOWN"]},
        "match_status": {"enum": ["VERIFIED", "UNVERIFIED", "UNKNOWN"]},
        "evidence_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clear_visibility_count", "acceptable_contrast_count", "adequate_scale_count", "verified_match_count"],
      "properties": {
        "clear_visibility_count": {"type": "integer", "minimum": 0, "maximum": 256},
        "acceptable_contrast_count": {"type": "integer", "minimum": 0, "maximum": 256},
        "adequate_scale_count": {"type": "integer", "minimum": 0, "maximum": 256},
        "verified_match_count": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_refs_resolved", "imagery_opened", "coordinate_accuracy_verified",
        "distribution_evaluated", "transform_quality_evaluated", "policy_decided",
        "human_review_approved", "release_authorized", "published", "public_use_authorized"
      ],
      "properties": {
        "input_refs_resolved": {"const": false},
        "imagery_opened": {"const": false},
        "coordinate_accuracy_verified": {"const": false},
        "distribution_evaluated": {"const": false},
        "transform_quality_evaluated": {"const": false},
        "policy_decided": {"const": false},
        "human_review_approved": {"const": false},
        "release_authorized": {"const": false},
        "published": {"const": false},
        "public_use_authorized": {"const": false}
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "source_idea_id": "KFM-P18-INV-317",
    "authority": "fixture_internal_coherence_only",
    "non_effects": ["no_network", "no_reference_resolution", "no_accuracy_claim", "no_distribution_decision", "no_transform_decision", "no_policy", "no_release", "no_public_use"]
  }
}
