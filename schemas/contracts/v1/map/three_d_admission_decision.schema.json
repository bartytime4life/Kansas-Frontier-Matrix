{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/map/three_d_admission_decision.schema.json",
  "title": "ThreeDAdmissionDecision candidate profile",
  "description": "Inactive fixture-only 3D admission candidate. Validation has no renderer, policy, review, release, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "status",
    "decision_id",
    "version",
    "spec_hash",
    "scene_manifest_ref",
    "layer_manifest_ref",
    "view_state_ref",
    "representation_fitness_ref",
    "reality_boundary_note_ref",
    "evidence_bundle_refs",
    "source_descriptor_refs",
    "domain_contexts",
    "requested_mode",
    "representation_kind",
    "geometry_label",
    "requested_use",
    "source_roles",
    "sensitivity",
    "plugin_dependencies",
    "parity",
    "limitations",
    "review_state",
    "public_use_allowed",
    "effects"
  ],
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^\\S+$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "optional_ref_array": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    },
    "label_array": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    }
  },
  "properties": {
    "profile": {
      "const": "kfm.map.three-d-admission-decision.v1"
    },
    "status": {
      "const": "PROPOSED_INACTIVE"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^three-d-admission:[a-f0-9]{24}$"
    },
    "version": {
      "const": "1.0.0"
    },
    "spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "scene_manifest_ref": {
      "$ref": "#/$defs/ref"
    },
    "layer_manifest_ref": {
      "$ref": "#/$defs/ref"
    },
    "view_state_ref": {
      "$ref": "#/$defs/ref"
    },
    "representation_fitness_ref": {
      "$ref": "#/$defs/ref"
    },
    "reality_boundary_note_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidence_bundle_refs": {
      "$ref": "#/$defs/ref_array"
    },
    "source_descriptor_refs": {
      "$ref": "#/$defs/ref_array"
    },
    "domain_contexts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "requested_mode": {
      "enum": [
        "TERRAIN_3D",
        "GLOBE",
        "FILL_EXTRUSION_2_5D",
        "OGC_3D_TILES",
        "GLTF",
        "POINT_CLOUD"
      ]
    },
    "representation_kind": {
      "enum": [
        "OBSERVED",
        "DERIVED",
        "MODELED",
        "SYNTHETIC",
        "RECONSTRUCTED",
        "GENERALIZED"
      ]
    },
    "geometry_label": {
      "enum": [
        "FLAT",
        "TWO_POINT_FIVE_D",
        "TRUE_3D",
        "GLOBE"
      ]
    },
    "requested_use": {
      "enum": [
        "TERRAIN_EXPLANATION",
        "HYDROLOGY_EXPLANATION",
        "LINE_OF_SIGHT",
        "HISTORICAL_RECONSTRUCTION",
        "STORY_TRANSITION",
        "VERTICAL_EVIDENCE",
        "SPECTACLE_ONLY"
      ]
    },
    "source_roles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "enum": [
          "OBSERVATION",
          "MODEL",
          "SYNTHETIC",
          "HISTORICAL_SOURCE",
          "DERIVED",
          "CONTEXT"
        ]
      }
    },
    "sensitivity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tier",
        "living_person_present",
        "rare_species_precision",
        "archaeology_present",
        "archaeology_generalization_meters",
        "critical_infrastructure_precision",
        "transformation_receipt_refs"
      ],
      "properties": {
        "tier": {
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3",
            "T4"
          ]
        },
        "living_person_present": {
          "type": "boolean"
        },
        "rare_species_precision": {
          "enum": [
            "NONE",
            "GENERALIZED",
            "PRECISE"
          ]
        },
        "archaeology_present": {
          "type": "boolean"
        },
        "archaeology_generalization_meters": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "critical_infrastructure_precision": {
          "enum": [
            "NONE",
            "GENERALIZED",
            "PRECISE"
          ]
        },
        "transformation_receipt_refs": {
          "$ref": "#/$defs/optional_ref_array"
        }
      }
    },
    "plugin_dependencies": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "version",
          "integrity_sha256",
          "attestation_ref",
          "admission_ref",
          "license_status",
          "cve_watch_ref"
        ],
        "properties": {
          "name": {
            "enum": [
              "three",
              "3d-tiles-renderer",
              "maplibre-three-plugin",
              "maplibre-gl-lidar",
              "deck.gl"
            ]
          },
          "version": {
            "type": "string",
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
          },
          "integrity_sha256": {
            "$ref": "#/$defs/sha256"
          },
          "attestation_ref": {
            "$ref": "#/$defs/ref"
          },
          "admission_ref": {
            "$ref": "#/$defs/ref"
          },
          "license_status": {
            "enum": [
              "VERIFIED",
              "UNKNOWN",
              "DENIED"
            ]
          },
          "cve_watch_ref": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    },
    "parity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "two_d_evidence_refs",
        "three_d_evidence_refs",
        "drawer_fields_2d",
        "drawer_fields_3d",
        "correction_refs_2d",
        "correction_refs_3d",
        "release_refs_2d",
        "release_refs_3d",
        "sensitivity_labels_2d",
        "sensitivity_labels_3d"
      ],
      "properties": {
        "two_d_evidence_refs": {
          "$ref": "#/$defs/ref_array"
        },
        "three_d_evidence_refs": {
          "$ref": "#/$defs/ref_array"
        },
        "drawer_fields_2d": {
          "$ref": "#/$defs/label_array"
        },
        "drawer_fields_3d": {
          "$ref": "#/$defs/label_array"
        },
        "correction_refs_2d": {
          "$ref": "#/$defs/ref_array"
        },
        "correction_refs_3d": {
          "$ref": "#/$defs/ref_array"
        },
        "release_refs_2d": {
          "$ref": "#/$defs/ref_array"
        },
        "release_refs_3d": {
          "$ref": "#/$defs/ref_array"
        },
        "sensitivity_labels_2d": {
          "$ref": "#/$defs/label_array"
        },
        "sensitivity_labels_3d": {
          "$ref": "#/$defs/label_array"
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 280,
        "pattern": "\\S"
      }
    },
    "review_state": {
      "enum": [
        "HOLD",
        "APPROVED"
      ]
    },
    "public_use_allowed": {
      "type": "boolean"
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "renderer_booted",
        "plugin_installed",
        "policy_evaluated",
        "human_review_approved",
        "release_authorized",
        "deployed",
        "published"
      ],
      "properties": {
        "renderer_booted": {
          "type": "boolean"
        },
        "plugin_installed": {
          "type": "boolean"
        },
        "policy_evaluated": {
          "type": "boolean"
        },
        "human_review_approved": {
          "type": "boolean"
        },
        "release_authorized": {
          "type": "boolean"
        },
        "deployed": {
          "type": "boolean"
        },
        "published": {
          "type": "boolean"
        }
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "contract_doc": "contracts/map/three_d_admission_decision.md",
    "fixtures_root": "fixtures/contracts/v1/map/three_d_admission_decision/",
    "validator": "tools/validators/map/validate_three_d_admission_decision.py",
    "authority": "fixture_candidate_only",
    "renderer_boot_authority": false,
    "public_release_authority": false
  }
}
