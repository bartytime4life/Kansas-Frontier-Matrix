{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/map/georeference_spatial_distribution.schema.json",
  "title": "GeoreferenceSpatialDistributionAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "fixture_only",
    "network_access",
    "assessed_at",
    "transform_quality_ref",
    "support",
    "gcp_count",
    "gcps",
    "thresholds",
    "computed",
    "decision",
    "governance"
  ],
  "properties": {
    "object_type": {"const": "GeoreferenceSpatialDistributionAssessment"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.georeference.spatial-distribution.v1"},
    "fixture_only": {"const": true},
    "network_access": {"const": "forbidden"},
    "assessed_at": {"type": "string", "format": "date-time"},
    "transform_quality_ref": {"type": "string", "minLength": 1, "maxLength": 256},
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resource_width_px", "resource_height_px", "resource_mask"],
      "properties": {
        "resource_width_px": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "resource_height_px": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "resource_mask": {
          "type": "array",
          "minItems": 4,
          "maxItems": 257,
          "items": {"$ref": "#/$defs/point"}
        }
      }
    },
    "gcp_count": {"type": "integer", "minimum": 3, "maximum": 256},
    "gcps": {
      "type": "array",
      "minItems": 3,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "resource"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "maxLength": 80},
          "resource": {"$ref": "#/$defs/point"}
        }
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_gcps",
        "min_hull_area_ratio",
        "max_extrapolation_ratio",
        "max_centroid_offset_ratio",
        "minimum_occupied_quadrants"
      ],
      "properties": {
        "minimum_gcps": {"const": 4},
        "min_hull_area_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "max_extrapolation_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "max_centroid_offset_ratio": {"type": "number", "minimum": 0, "maximum": 1},
        "minimum_occupied_quadrants": {"type": "integer", "minimum": 1, "maximum": 4}
      }
    },
    "computed": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hull_vertex_count",
        "hull_area_ratio",
        "max_extrapolation_ratio",
        "centroid_offset_ratio",
        "occupied_quadrants"
      ],
      "properties": {
        "hull_vertex_count": {"type": "integer", "minimum": 3, "maximum": 256},
        "hull_area_ratio": {"type": "number", "minimum": 0},
        "max_extrapolation_ratio": {"type": "number", "minimum": 0},
        "centroid_offset_ratio": {"type": "number", "minimum": 0},
        "occupied_quadrants": {"type": "integer", "minimum": 0, "maximum": 4}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reasons"],
      "properties": {
        "outcome": {"enum": ["READY", "HOLD", "ERROR"]},
        "reasons": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Z0-9_]+$"}
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_created",
        "policy_evaluated",
        "promotion_authorized",
        "release_authorized",
        "publication_authorized",
        "public_use_allowed",
        "release_ref"
      ],
      "properties": {
        "authority_created": {"const": false},
        "policy_evaluated": {"const": false},
        "promotion_authorized": {"const": false},
        "release_authorized": {"const": false},
        "publication_authorized": {"const": false},
        "public_use_allowed": {"const": false},
        "release_ref": {"type": "null"}
      }
    }
  },
  "$defs": {
    "point": {
      "type": "array",
      "prefixItems": [{"type": "number"}, {"type": "number"}],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "authority": "fixture_gcp_distribution_quality_only",
    "non_effects": [
      "no_network",
      "no_image_open",
      "no_warp",
      "no_reprojection",
      "no_gcp_authentication",
      "no_policy",
      "no_release",
      "no_public_use"
    ]
  }
}
