{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/crosswalks/geography_crosswalk.schema.json",
  "title": "GeographyCrosswalk",
  "description": "Fixture-only declaration of a forward mapping between two pinned geography versions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "crosswalk_id",
    "scope",
    "mappings",
    "support",
    "disclosure",
    "governance",
    "spec_hash"
  ],
  "properties": {
    "object_type": {"const": "GeographyCrosswalk"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.geography-crosswalk.fixture.v1"},
    "crosswalk_id": {
      "type": "string",
      "pattern": "^kfm:geography-crosswalk:[a-f0-9]{24}$"
    },
    "scope": {"$ref": "#/$defs/scope"},
    "mappings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {"$ref": "#/$defs/mapping"}
    },
    "support": {"$ref": "#/$defs/support"},
    "disclosure": {"$ref": "#/$defs/disclosure"},
    "governance": {"$ref": "#/$defs/governance"},
    "spec_hash": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "digest_ref": {
      "type": "string",
      "pattern": "^kfm://[a-z0-9][a-z0-9._:/-]{2,191}@sha256:[a-f0-9]{64}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_geography_version_ref",
        "target_geography_version_ref",
        "direction",
        "method_profile_ref",
        "valid_from",
        "valid_to"
      ],
      "properties": {
        "source_geography_version_ref": {"$ref": "#/$defs/digest_ref"},
        "target_geography_version_ref": {"$ref": "#/$defs/digest_ref"},
        "direction": {"const": "SOURCE_TO_TARGET"},
        "method_profile_ref": {"$ref": "#/$defs/digest_ref"},
        "valid_from": {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "valid_to": {
          "oneOf": [
            {"type": "string", "format": "date", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
            {"type": "null"}
          ]
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_feature_id_digest", "weight_millionths"],
      "properties": {
        "target_feature_id_digest": {"$ref": "#/$defs/sha256"},
        "weight_millionths": {"type": "integer", "minimum": 1, "maximum": 1000000}
      }
    },
    "mapping": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_feature_id_digest", "relation", "targets", "reason_code"],
      "properties": {
        "source_feature_id_digest": {"$ref": "#/$defs/sha256"},
        "relation": {"enum": ["EXACT", "SPLIT", "MERGE", "PARTIAL_OVERLAP", "UNMAPPED"]},
        "targets": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/target"}
        },
        "reason_code": {
          "oneOf": [
            {"enum": ["NO_SUPPORTED_TARGET"]},
            {"type": "null"}
          ]
        }
      }
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_role_preserved",
        "evidence_state",
        "evidence_refs",
        "rights_state",
        "sensitivity_state",
        "review_state"
      ],
      "properties": {
        "source_role_preserved": {"const": true},
        "evidence_state": {"const": "REFERENCED_NOT_RESOLVED"},
        "evidence_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/digest_ref"}
        },
        "rights_state": {"const": "REFERENCED_NOT_EVALUATED"},
        "sensitivity_state": {"const": "REFERENCED_NOT_EVALUATED"},
        "review_state": {"const": "PENDING"}
      }
    },
    "disclosure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["interpretation_limits"],
      "properties": {
        "interpretation_limits": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "NO_IDENTITY_EQUIVALENCE_INFERENCE",
              "NO_PUBLICATION_AUTHORITY",
              "NO_REVERSE_JOIN_INFERENCE",
              "SOURCE_ROLE_PRESERVED",
              "WEIGHTS_ARE_DECLARATIONS_NOT_MEASUREMENTS"
            ]
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_mode",
        "network_attempted",
        "geographies_resolved",
        "mapping_executed",
        "evidence_resolved",
        "rights_evaluated",
        "sensitivity_evaluated",
        "policy_evaluated",
        "review_approved",
        "promotion_authorized",
        "release_authorized",
        "public_use_allowed",
        "publication_authorized"
      ],
      "properties": {
        "execution_mode": {"const": "FIXTURE_ONLY"},
        "network_attempted": {"const": false},
        "geographies_resolved": {"const": false},
        "mapping_executed": {"const": false},
        "evidence_resolved": {"const": false},
        "rights_evaluated": {"const": false},
        "sensitivity_evaluated": {"const": false},
        "policy_evaluated": {"const": false},
        "review_approved": {"const": false},
        "promotion_authorized": {"const": false},
        "release_authorized": {"const": false},
        "public_use_allowed": {"const": false},
        "publication_authorized": {"const": false}
      }
    }
  }
}
