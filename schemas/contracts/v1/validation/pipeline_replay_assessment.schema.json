{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/validation/pipeline_replay_assessment.schema.json",
  "title": "PipelineReplayAssessmentCandidate",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "aware_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "kfm_ref": {
      "type": "string",
      "pattern": "^kfm:[a-z0-9][a-z0-9._:/-]{4,220}$"
    },
    "source_pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_ref": {"$ref": "#/$defs/kfm_ref"},
        "snapshot_digest": {"$ref": "#/$defs/digest"}
      },
      "required": ["source_ref", "snapshot_digest"]
    },
    "model_identity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "provider": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"},
        "model": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,95}$"},
        "version": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$"},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      },
      "required": ["provider", "model", "version", "artifact_digest"]
    },
    "validator_pin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "validator_ref": {"$ref": "#/$defs/kfm_ref"},
        "version": {"type": "string", "pattern": "^[0-9A-Za-z][0-9A-Za-z.+_-]{0,63}$"},
        "artifact_digest": {"$ref": "#/$defs/digest"}
      },
      "required": ["validator_ref", "version", "artifact_digest"]
    },
    "replay_pins": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"$ref": "#/$defs/source_pin"}
        },
        "transform_parameters_digest": {"$ref": "#/$defs/digest"},
        "model_identity": {"$ref": "#/$defs/model_identity"},
        "validators": {
          "type": "array", "minItems": 1, "maxItems": 32,
          "items": {"$ref": "#/$defs/validator_pin"}
        }
      },
      "required": ["sources", "transform_parameters_digest", "model_identity", "validators"]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_mode": {"const": "FIXTURE_ONLY"},
        "network_attempted": {"const": false},
        "sources_resolved": {"const": false},
        "pipeline_executed": {"const": false},
        "transform_executed": {"const": false},
        "model_invoked": {"const": false},
        "validators_executed": {"const": false},
        "receipt_attested": {"const": false},
        "policy_evaluated": {"const": false},
        "review_approved": {"const": false},
        "release_authorized": {"const": false},
        "publication_authorized": {"const": false},
        "public_use_allowed": {"const": false}
      },
      "required": [
        "execution_mode", "network_attempted", "sources_resolved", "pipeline_executed",
        "transform_executed", "model_invoked", "validators_executed", "receipt_attested",
        "policy_evaluated", "review_approved", "release_authorized",
        "publication_authorized", "public_use_allowed"
      ]
    }
  },
  "properties": {
    "object_type": {"const": "PipelineReplayAssessmentCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.pipeline-replay-assessment.fixture.v1"},
    "assessment_id": {"type": "string", "pattern": "^kfm:pipeline-replay-assessment:[0-9a-f]{24}$"},
    "spec_hash": {"$ref": "#/$defs/digest"},
    "pipeline_ref": {"$ref": "#/$defs/kfm_ref"},
    "assessed_at": {"$ref": "#/$defs/aware_datetime"},
    "replay_profile": {
      "allOf": [
        {"$ref": "#/$defs/replay_pins"},
        {
          "type": "object",
          "properties": {
            "profile_ref": {"$ref": "#/$defs/kfm_ref"},
            "expected_output_digest": {"$ref": "#/$defs/digest"}
          },
          "required": ["profile_ref", "expected_output_digest"]
        }
      ],
      "unevaluatedProperties": false
    },
    "replay_observation": {
      "allOf": [
        {"$ref": "#/$defs/replay_pins"},
        {
          "type": "object",
          "properties": {
            "replay_ref": {"$ref": "#/$defs/kfm_ref"},
            "profile_ref": {"$ref": "#/$defs/kfm_ref"},
            "observed_output_digest": {"$ref": "#/$defs/digest"},
            "observation_mode": {"const": "SYNTHETIC_DECLARATION"}
          },
          "required": ["replay_ref", "profile_ref", "observed_output_digest", "observation_mode"]
        }
      ],
      "unevaluatedProperties": false
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {"enum": ["PASS", "FAIL"]},
        "drift_codes": {
          "type": "array", "maxItems": 5, "uniqueItems": true,
          "items": {"enum": ["MODEL_IDENTITY_DRIFT", "OUTPUT_DRIFT", "SOURCE_SNAPSHOT_DRIFT", "TRANSFORM_PARAMETERS_DRIFT", "VALIDATOR_SET_DRIFT"]}
        },
        "replay_execution_claimed": {"const": false},
        "replay_equivalence_authoritative": {"const": false},
        "separate_review_required": {"const": true}
      },
      "required": ["outcome", "drift_codes", "replay_execution_claimed", "replay_equivalence_authoritative", "separate_review_required"]
    },
    "governance": {"$ref": "#/$defs/governance"}
  },
  "required": [
    "object_type", "schema_version", "profile", "assessment_id", "spec_hash",
    "pipeline_ref", "assessed_at", "replay_profile", "replay_observation", "report", "governance"
  ],
  "x-kfm": {
    "status": "PROPOSED",
    "authority": "fixture-only replay pin comparison; never pipeline execution, receipt attestation, or release authority",
    "canonicalization": "RFC 8785 JCS plus SHA-256 excluding assessment_id and spec_hash"
  }
}
