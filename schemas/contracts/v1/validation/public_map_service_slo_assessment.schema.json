{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/validation/public_map_service_slo_assessment.schema.json",
  "title": "PublicMapServiceSLOAssessmentCandidate",
  "description": "Fixture-only declaration of public-map-service SLO and error-budget arithmetic with no live monitoring or promotion, rollback, release, deployment, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "aware_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "kfm_ref": {
      "type": "string",
      "pattern": "^kfm:[a-z0-9][a-z0-9._:/-]{4,220}$"
    },
    "nullable_ref": {
      "oneOf": [
        {"$ref": "#/$defs/kfm_ref"},
        {"type": "null"}
      ]
    },
    "ref_array": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/kfm_ref"}
    }
  },
  "properties": {
    "object_type": {"const": "PublicMapServiceSLOAssessmentCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.validation.public-map-service-slo-assessment.fixture.v1"},
    "assessment_id": {
      "type": "string",
      "pattern": "^kfm:public-map-service-slo-assessment:[0-9a-f]{24}$"
    },
    "spec_hash": {"$ref": "#/$defs/digest"},
    "source_card": {"const": "KFM-P18-INV-500"},
    "service_ref": {"$ref": "#/$defs/kfm_ref"},
    "service_kind": {
      "enum": [
        "COMPOSITE_MAP_SURFACE",
        "GOVERNED_MAP_API",
        "SERVER_MEDIATED_LAYER",
        "STATIC_COG",
        "STATIC_PMTILES"
      ]
    },
    "assessed_at": {"$ref": "#/$defs/aware_datetime"},
    "assessment_state": {"enum": ["COMPLETE", "INCOMPLETE", "ERROR"]},
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "FIXTURE_ONLY"},
        "network_attempted": {"const": false},
        "live_service_queried": {"const": false},
        "telemetry_authenticated": {"const": false}
      },
      "required": ["mode", "network_attempted", "live_service_queried", "telemetry_authenticated"]
    },
    "measurement_window": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "started_at": {"$ref": "#/$defs/aware_datetime"},
        "ended_at": {"$ref": "#/$defs/aware_datetime"},
        "status": {"enum": ["COMPLETE", "INCOMPLETE"]}
      },
      "required": ["started_at", "ended_at", "status"]
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "objective_status": {"enum": ["RESOLVED", "UNRESOLVED"]},
        "slo_policy_ref": {"$ref": "#/$defs/nullable_ref"}
      },
      "required": ["objective_status", "slo_policy_ref"]
    },
    "availability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "target_basis_points": {"type": "integer", "minimum": 1, "maximum": 10000},
        "eligible_events": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "good_events": {"type": "integer", "minimum": 0, "maximum": 9007199254740991}
      },
      "required": ["target_basis_points", "eligible_events", "good_events"]
    },
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "percentile": {"enum": ["P50", "P90", "P95", "P99"]},
        "target_milliseconds": {"type": "integer", "minimum": 1, "maximum": 86400000},
        "observed_milliseconds": {
          "oneOf": [
            {"type": "integer", "minimum": 0, "maximum": 86400000},
            {"type": "null"}
          ]
        },
        "sample_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "state": {"enum": ["WITHIN_TARGET", "BREACHED", "UNASSESSED"]}
      },
      "required": ["percentile", "target_milliseconds", "observed_milliseconds", "sample_count", "state"]
    },
    "error_budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_bad_events": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "observed_bad_events": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        "remaining_bad_events": {"type": "integer", "minimum": -9007199254740991, "maximum": 9007199254740991},
        "state": {"enum": ["WITHIN_BUDGET", "EXHAUSTED"]}
      },
      "required": ["allowed_bad_events", "observed_bad_events", "remaining_bad_events", "state"]
    },
    "support": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "telemetry_receipt_refs": {"$ref": "#/$defs/ref_array"},
        "review_record_refs": {"$ref": "#/$defs/ref_array"},
        "rollback_ref": {"$ref": "#/$defs/nullable_ref"},
        "release_manifest_ref": {"type": "null"}
      },
      "required": ["telemetry_receipt_refs", "review_record_refs", "rollback_ref", "release_manifest_ref"]
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessment_outcome": {"enum": ["PASS", "ABSTAIN", "DENY", "ERROR"]},
        "finding_codes": {
          "type": "array",
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ASSESSMENT_ERROR",
              "ASSESSMENT_INCOMPLETE",
              "BUDGET_EXHAUSTED",
              "LATENCY_BREACH",
              "LATENCY_OBSERVATION_UNRESOLVED",
              "LATENCY_SAMPLE_REQUIRED",
              "MEASUREMENT_WINDOW_INCOMPLETE",
              "REVIEW_REFERENCE_REQUIRED",
              "ROLLBACK_REFERENCE_REQUIRED",
              "SLO_POLICY_UNRESOLVED",
              "TELEMETRY_REFERENCE_REQUIRED"
            ]
          }
        },
        "promotion_effect": {"const": "NO_AUTOMATIC_EFFECT"},
        "rollback_effect": {"const": "REVIEW_ONLY"}
      },
      "required": ["assessment_outcome", "finding_codes", "promotion_effect", "rollback_effect"]
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "DECLARATION_ONLY",
          "NO_LIVE_MONITORING",
          "NO_PROMOTION_AUTHORITY",
          "NO_RELEASE_AUTHORITY",
          "TELEMETRY_NOT_TRUTH"
        ]
      }
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "telemetry_truth_authority": {"const": false},
        "policy_authority": {"const": false},
        "review_authority": {"const": false},
        "promotion_authority": {"const": false},
        "rollback_authority": {"const": false},
        "release_authority": {"const": false},
        "deployment_authority": {"const": false},
        "publication_authority": {"const": false},
        "public_use_authority": {"const": false}
      },
      "required": [
        "telemetry_truth_authority",
        "policy_authority",
        "review_authority",
        "promotion_authority",
        "rollback_authority",
        "release_authority",
        "deployment_authority",
        "publication_authority",
        "public_use_authority"
      ]
    }
  },
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "assessment_id",
    "spec_hash",
    "source_card",
    "service_ref",
    "service_kind",
    "assessed_at",
    "assessment_state",
    "execution",
    "measurement_window",
    "policy",
    "availability",
    "latency",
    "error_budget",
    "support",
    "report",
    "limitations",
    "authority_claims"
  ],
  "x-kfm": {
    "status": "PROPOSED",
    "authority": "fixture-only SLO and error-budget declaration validation; never live monitoring, policy, promotion, rollback, release, deployment, publication, or public-use authority",
    "canonicalization": "sorted-key compact JSON plus SHA-256 excluding assessment_id and spec_hash; controlled profile contains no floating-point values"
  }
}
