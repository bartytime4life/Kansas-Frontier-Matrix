{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/validation/action_point_reference_check.schema.json",
  "title": "ActionPointReferenceCheck",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "profile_status",
    "execution_mode",
    "authority",
    "check_id",
    "action",
    "authoritative_source",
    "pointer",
    "report",
    "permissions",
    "non_effects",
    "spec_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.validation.action-point-reference-check.v1"},
    "profile_status": {"const": "PROPOSED_INACTIVE"},
    "execution_mode": {"const": "FIXTURE_ONLY_NO_EXTERNAL_EFFECT"},
    "authority": {"const": "NONE"},
    "check_id": {"type": "string", "pattern": "^kfm:action-point-check:[0-9a-f]{64}$"},
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "literal_class", "literal", "acted_at", "residue_status"],
      "properties": {
        "kind": {"enum": ["TOOL_CALL", "COMMAND", "OUTBOUND_CLAIM"]},
        "literal_class": {"enum": ["OPAQUE_IDENTIFIER", "COMMAND_TEXT", "PROSE_CLAIM"]},
        "literal": {"type": ["string", "null"], "minLength": 1, "maxLength": 4096},
        "acted_at": {"type": "string", "format": "date-time"},
        "residue_status": {"enum": ["PRESERVED", "MISSING"]}
      },
      "allOf": [
        {
          "if": {"properties": {"residue_status": {"const": "PRESERVED"}}},
          "then": {"properties": {"literal": {"type": "string"}}}
        },
        {
          "if": {"properties": {"residue_status": {"const": "MISSING"}}},
          "then": {"properties": {"literal": {"type": "null"}}}
        }
      ]
    },
    "authoritative_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ref", "source_digest", "literal", "dereferenced_at", "method"],
      "properties": {
        "source_ref": {"$ref": "#/$defs/kfm_ref"},
        "source_digest": {"$ref": "#/$defs/spec_hash"},
        "literal": {"type": "string", "minLength": 1, "maxLength": 4096},
        "dereferenced_at": {"type": "string", "format": "date-time"},
        "method": {"enum": ["PINNED_BLOB", "DETERMINISTIC_COMMAND", "LIVE_SOURCE_READ"]}
      }
    },
    "pointer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "locator"],
      "properties": {
        "kind": {"enum": ["FULL_LITERAL", "DETERMINISTIC_COMMAND"]},
        "locator": {"type": "string", "minLength": 3, "maxLength": 512}
      }
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "reason_codes"],
      "properties": {
        "outcome": {"enum": ["MATCH", "MISMATCH", "BLOCKED", "UNCLASSIFIABLE"]},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"enum": ["ABBREVIATED_LITERAL", "ACTION_RESIDUE_MISSING", "DEREFERENCE_AFTER_ACTION", "LITERAL_MATCH", "LITERAL_MISMATCH"]}
        }
      }
    },
    "permissions": {
      "const": {
        "action_allowed": false,
        "repository_write_allowed": false,
        "lifecycle_write_allowed": false,
        "release_allowed": false,
        "publication_allowed": false,
        "public_use_allowed": false
      }
    },
    "non_effects": {
      "const": [
        "does_not_dereference_a_live_source",
        "does_not_execute_the_action",
        "does_not_authorize_agent_or_repository_writes",
        "does_not_release_deploy_publish_or_authorize_public_use"
      ]
    },
    "spec_hash": {"$ref": "#/$defs/spec_hash"}
  },
  "$defs": {
    "spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "kfm_ref": {"type": "string", "pattern": "^kfm:(//)?[A-Za-z0-9][A-Za-z0-9._:/-]{3,255}$"}
  }
}
