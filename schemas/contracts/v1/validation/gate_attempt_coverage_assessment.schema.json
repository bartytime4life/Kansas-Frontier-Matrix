{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/validation/gate_attempt_coverage_assessment.schema.json",
  "title": "GateAttemptCoverageAssessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "profile_status",
    "execution_mode",
    "authority",
    "assessment_id",
    "gate_id",
    "window",
    "counts",
    "attempt_classes",
    "denominator_policies",
    "class_semantics",
    "terminal_coverage_state",
    "permissions",
    "non_effects",
    "spec_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.validation.gate-attempt-coverage-assessment.v1"},
    "profile_status": {"const": "PROPOSED_INACTIVE"},
    "execution_mode": {"const": "FIXTURE_ONLY_NO_EXTERNAL_EFFECT"},
    "authority": {"const": "NONE"},
    "assessment_id": {"type": "string", "pattern": "^kfm:gate-attempt-coverage:[0-9a-f]{64}$"},
    "gate_id": {"$ref": "#/$defs/kfm_ref"},
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": ["opens_at", "closes_at"],
      "properties": {
        "opens_at": {"type": "string", "format": "date-time"},
        "closes_at": {"type": "string", "format": "date-time"}
      }
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "admitted", "refused", "error", "unobserved"],
      "properties": {
        "attempted": {"type": "integer", "minimum": 1, "maximum": 256},
        "admitted": {"type": "integer", "minimum": 0, "maximum": 256},
        "refused": {"type": "integer", "minimum": 0, "maximum": 256},
        "error": {"type": "integer", "minimum": 0, "maximum": 256},
        "unobserved": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    },
    "attempt_classes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["admitted", "refused", "error", "unobserved"],
      "properties": {
        "admitted": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/terminal_entry"}},
        "refused": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/terminal_entry"}},
        "error": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/terminal_entry"}},
        "unobserved": {"type": "array", "maxItems": 256, "items": {"$ref": "#/$defs/unobserved_entry"}}
      }
    },
    "denominator_policies": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/denominator_policy"}
    },
    "class_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ADMITTED", "REFUSED", "ERROR", "UNOBSERVED"],
      "properties": {
        "ADMITTED": {"$ref": "#/$defs/class_semantics"},
        "REFUSED": {"$ref": "#/$defs/class_semantics"},
        "ERROR": {"$ref": "#/$defs/class_semantics"},
        "UNOBSERVED": {"$ref": "#/$defs/class_semantics"}
      }
    },
    "terminal_coverage_state": {"enum": ["COMPLETE", "INCOMPLETE"]},
    "permissions": {
      "const": {
        "guarded_action_allowed": false,
        "gate_configuration_write_allowed": false,
        "feedback_write_allowed": false,
        "source_admission_allowed": false,
        "lifecycle_write_allowed": false,
        "release_allowed": false,
        "deployment_allowed": false,
        "publication_allowed": false,
        "public_use_allowed": false
      }
    },
    "non_effects": {
      "const": [
        "does_not_execute_or_authenticate_a_guarded_action",
        "does_not_store_submitted_or_rejected_payloads_or_sensitive_values",
        "does_not_activate_reconfigure_or_feed_a_gate",
        "does_not_bind_the_unresolved_run_receipt_family",
        "does_not_admit_sources_mutate_lifecycle_release_deploy_publish_or_authorize_public_use"
      ]
    },
    "spec_hash": {"$ref": "#/$defs/spec_hash"}
  },
  "$defs": {
    "spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "kfm_ref": {"type": "string", "pattern": "^kfm:(//)?[A-Za-z0-9][A-Za-z0-9._:/-]{3,255}$"},
    "signature_domain": {"type": "string", "pattern": "^kfm\\.gate\\.attempt\\.(admitted|refused|error|unobserved)\\.v1$"},
    "terminal_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_ref", "record_ref", "signature_domain"],
      "properties": {
        "attempt_ref": {"$ref": "#/$defs/kfm_ref"},
        "record_ref": {"$ref": "#/$defs/kfm_ref"},
        "signature_domain": {"$ref": "#/$defs/signature_domain"}
      }
    },
    "unobserved_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempt_ref", "signature_domain"],
      "properties": {
        "attempt_ref": {"$ref": "#/$defs/kfm_ref"},
        "signature_domain": {"$ref": "#/$defs/signature_domain"}
      }
    },
    "attempt_class": {"enum": ["ADMITTED", "ERROR", "REFUSED", "UNOBSERVED"]},
    "denominator_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["metric_id", "included_classes", "excluded_classes", "denominator_count"],
      "properties": {
        "metric_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$"},
        "included_classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/attempt_class"}
        },
        "excluded_classes": {
          "type": "array",
          "maxItems": 4,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/attempt_class"}
        },
        "denominator_count": {"type": "integer", "minimum": 0, "maximum": 256}
      }
    },
    "class_semantics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["guarded_action_occurrence", "same_gate_feedback_allowed"],
      "properties": {
        "guarded_action_occurrence": {"enum": ["CONFIRMED", "DID_NOT_OCCUR", "NOT_CONFIRMED", "UNKNOWN"]},
        "same_gate_feedback_allowed": {"type": "boolean"}
      }
    }
  }
}
