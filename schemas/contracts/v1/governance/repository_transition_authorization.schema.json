{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/governance/repository_transition_authorization.schema.json",
  "title": "RepositoryTransitionAuthorization",
  "description": "A short-lived, exact-PR and exact-head owner decision that may satisfy the advisory repository-control ready/merge check. Schema validity does not prove human authorship, independent review, client identity, ruleset enforcement, or merge authority outside the recorded scope.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "authorization_id",
    "repository",
    "control_issue",
    "pr_number",
    "base_sha",
    "head_sha",
    "authorizing_actor",
    "decision",
    "expires_at",
    "reason",
    "evidence_refs"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "authorization_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,191}$"
    },
    "repository": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
    },
    "control_issue": {
      "type": "integer",
      "minimum": 1
    },
    "pr_number": {
      "type": "integer",
      "minimum": 1
    },
    "base_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "head_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "authorizing_actor": {
      "type": "string",
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9-]{0,38})$"
    },
    "decision": {
      "const": "ALLOW_READY_AND_MERGE"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 2048
      }
    }
  },
  "x-kfm": {
    "contract_doc": "contracts/governance/repository_control_state.md",
    "validator": "tools/validators/repository_control/validate_transition_authorization.py",
    "tests": "tests/validators/test_repository_transition_authorization.py",
    "status": "PROPOSED"
  }
}
