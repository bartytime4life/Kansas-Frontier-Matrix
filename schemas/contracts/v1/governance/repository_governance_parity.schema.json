{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansas-frontier-matrix.local/schemas/contracts/v1/governance/repository_governance_parity.schema.json",
  "title": "KFM Repository Governance Parity Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile_id",
    "status",
    "authority_mode",
    "base_ref",
    "governing_refs",
    "lanes",
    "coverage",
    "expected_topology",
    "required_non_effects"
  ],
  "properties": {
    "schema_version": {"const": "kfm.repository-governance-parity.v1"},
    "profile_id": {"type": "string", "pattern": "^kfm://governance-parity/[a-z0-9-]+$"},
    "status": {"const": "PROPOSED"},
    "authority_mode": {"const": "validation_projection_only"},
    "base_ref": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "governing_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/governing_ref"}
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/lane"}
    },
    "coverage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/coverage"}
    },
    "expected_topology": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_count",
        "fail_invariant",
        "fail_new_drift",
        "baselined_warning",
        "stale_fingerprints"
      ],
      "properties": {
        "rule_count": {"const": 20},
        "fail_invariant": {"type": "integer", "minimum": 0, "maximum": 2000},
        "fail_new_drift": {"type": "integer", "minimum": 0, "maximum": 2000},
        "baselined_warning": {"type": "integer", "minimum": 0, "maximum": 2000},
        "stale_fingerprints": {"type": "integer", "minimum": 0, "maximum": 2000}
      }
    },
    "required_non_effects": {
      "type": "array",
      "minItems": 8,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    }
  },
  "$defs": {
    "repo_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/()-]+$"
    },
    "governing_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/repo_path"},
        "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lane_id", "owner_path", "expected_outcome"],
      "properties": {
        "lane_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "owner_path": {"$ref": "#/$defs/repo_path"},
        "expected_outcome": {"enum": ["PASS", "HOLD_INHERITED"]}
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterion_id", "lane_ids", "topology_rule_ids"],
      "properties": {
        "criterion_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
        "lane_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z0-9-]+$"}
        },
        "topology_rule_ids": {
          "type": "array",
          "maxItems": 20,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^KFM-TOPO-[0-9]{3}$"}
        }
      }
    }
  }
}
