{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/governance/sensitive_release_review_closure.schema.json",
  "title": "SensitiveReleaseReviewClosure",
  "description": "Fixture-only T3/T4 independent-review closure over the existing ReviewAuthorityBinding contract. Conformance grants no policy, promotion, release, deployment, publication, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "profile",
    "profile_status",
    "execution_mode",
    "authority",
    "closure_id",
    "subject",
    "release_context",
    "review_binding",
    "checks",
    "outcome",
    "reason_codes",
    "permissions",
    "non_effects",
    "spec_hash"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "object_type": {"const": "SensitiveReleaseReviewClosure"},
    "profile": {"const": "kfm.governance.sensitive-release-review-closure.v1"},
    "profile_status": {"const": "PROPOSED_INACTIVE"},
    "execution_mode": {"const": "FIXTURE_ONLY"},
    "authority": {"const": "NONE"},
    "closure_id": {
      "type": "string",
      "pattern": "^kfm:sensitive-release-review-closure:[0-9a-f]{64}$"
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "spec_hash", "sensitivity_tier", "author_actor_ref", "author_role_chain_actor_refs"],
      "properties": {
        "ref": {"$ref": "#/$defs/kfm_ref"},
        "spec_hash": {"$ref": "#/$defs/spec_hash"},
        "sensitivity_tier": {"enum": ["T3", "T4"]},
        "author_actor_ref": {"$ref": "#/$defs/kfm_ref"},
        "author_role_chain_actor_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/kfm_ref"}
        }
      }
    },
    "release_context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "promotion_decision_ref",
        "promotion_decision_spec_hash",
        "policy_decision_ref",
        "policy_decision_spec_hash",
        "policy_outcome",
        "release_manifest_candidate_ref",
        "release_manifest_candidate_spec_hash",
        "release_state",
        "evidence_bundle_refs",
        "correction_path_ref",
        "rollback_card_ref"
      ],
      "properties": {
        "promotion_decision_ref": {"$ref": "#/$defs/kfm_ref"},
        "promotion_decision_spec_hash": {"$ref": "#/$defs/spec_hash"},
        "policy_decision_ref": {"$ref": "#/$defs/kfm_ref"},
        "policy_decision_spec_hash": {"$ref": "#/$defs/spec_hash"},
        "policy_outcome": {"enum": ["ALLOW", "HOLD", "DENY", "ABSTAIN"]},
        "release_manifest_candidate_ref": {"$ref": "#/$defs/kfm_ref"},
        "release_manifest_candidate_spec_hash": {"$ref": "#/$defs/spec_hash"},
        "release_state": {"const": "CANDIDATE"},
        "evidence_bundle_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/kfm_ref"}
        },
        "correction_path_ref": {"$ref": "#/$defs/kfm_ref"},
        "rollback_card_ref": {"$ref": "#/$defs/kfm_ref"}
      }
    },
    "review_binding": {
      "$ref": "https://schemas.kfm.local/contracts/v1/governance/review_authority_binding.schema.json"
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_binding_valid",
        "review_bound",
        "subject_bound",
        "author_bound",
        "author_in_role_chain",
        "author_reviewer_distinct",
        "reviewer_outside_author_role_chain",
        "release_review_responsibility",
        "policy_allows",
        "evidence_present",
        "correction_path_present",
        "rollback_present",
        "no_authority"
      ],
      "properties": {
        "review_binding_valid": {"type": "boolean"},
        "review_bound": {"type": "boolean"},
        "subject_bound": {"type": "boolean"},
        "author_bound": {"type": "boolean"},
        "author_in_role_chain": {"type": "boolean"},
        "author_reviewer_distinct": {"type": "boolean"},
        "reviewer_outside_author_role_chain": {"type": "boolean"},
        "release_review_responsibility": {"type": "boolean"},
        "policy_allows": {"type": "boolean"},
        "evidence_present": {"type": "boolean"},
        "correction_path_present": {"type": "boolean"},
        "rollback_present": {"type": "boolean"},
        "no_authority": {"type": "boolean"}
      }
    },
    "outcome": {"enum": ["CLOSED_FOR_SEPARATE_RELEASE_GATE", "HOLD", "DENY"]},
    "reason_codes": {
      "type": "array",
      "minItems": 11,
      "maxItems": 24,
      "uniqueItems": true,
      "items": {
        "enum": [
          "AUTHOR_BOUND",
          "AUTHOR_IN_ROLE_CHAIN",
          "AUTHOR_MISMATCH",
          "AUTHOR_NOT_IN_ROLE_CHAIN",
          "CORRECTION_PATH_PRESENT",
          "EVIDENCE_PRESENT",
          "INDEPENDENT_REVIEWER",
          "NO_AUTHORITY",
          "POLICY_ABSTAINS",
          "POLICY_ALLOWS",
          "POLICY_DENIES",
          "POLICY_HOLDS",
          "RELEASE_REVIEW_RESPONSIBILITY",
          "RELEASE_REVIEW_RESPONSIBILITY_MISSING",
          "REVIEW_BINDING_DENY",
          "REVIEW_BINDING_HOLD",
          "REVIEW_BINDING_INVALID",
          "REVIEW_BOUND",
          "REVIEWER_IN_AUTHOR_ROLE_CHAIN",
          "ROLLBACK_PRESENT",
          "SELF_REVIEW_DENIED",
          "SUBJECT_BOUND",
          "SUBJECT_MISMATCH"
        ]
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository_write_allowed",
        "lifecycle_write_allowed",
        "policy_override_allowed",
        "promotion_allowed",
        "release_allowed",
        "deployment_allowed",
        "publication_allowed",
        "public_use_allowed"
      ],
      "properties": {
        "repository_write_allowed": {"const": false},
        "lifecycle_write_allowed": {"const": false},
        "policy_override_allowed": {"const": false},
        "promotion_allowed": {"const": false},
        "release_allowed": {"const": false},
        "deployment_allowed": {"const": false},
        "publication_allowed": {"const": false},
        "public_use_allowed": {"const": false}
      }
    },
    "non_effects": {
      "const": [
        "does_not_authenticate_actor_or_signature",
        "does_not_create_or_override_policy",
        "does_not_create_promotion_or_release_authority",
        "does_not_expose_sensitive_material",
        "does_not_release_deploy_or_publish",
        "does_not_write_repository_or_lifecycle_state"
      ]
    },
    "spec_hash": {"$ref": "#/$defs/spec_hash"}
  },
  "$defs": {
    "spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "kfm_ref": {
      "type": "string",
      "minLength": 8,
      "maxLength": 512,
      "pattern": "^kfm:(//)?[A-Za-z0-9][A-Za-z0-9._:/-]+$"
    }
  }
}
