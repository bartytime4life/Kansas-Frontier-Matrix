{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansas-frontier-matrix.local/schemas/contracts/v1/governance/recommendation_decision_authority_assessment.schema.json",
  "title": "RecommendationDecisionAuthorityAssessmentCandidate",
  "description": "Inactive, fixture-only comparison that keeps an advisory recommendation distinct from a formal decision, implementation, and outcome.",
  "type": "object",
  "additionalProperties": false,
  "required": ["profile", "status", "version", "assessment_id", "spec_hash", "governance_event_ref", "recommendation", "decision", "linkage", "limitations", "effects"],
  "properties": {
    "profile": {"const": "kfm.governance.recommendation-decision-authority-assessment.v1"},
    "status": {"const": "PROPOSED_INACTIVE"},
    "version": {"const": "1.0.0"},
    "assessment_id": {"type": "string", "pattern": "^recommendation-decision-authority-assessment:[0-9a-f]{24}$"},
    "spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "governance_event_ref": {"$ref": "#/$defs/reference"},
    "recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation_ref", "state", "issued_at", "issuer_ref", "advisory_scope_digest", "source_snapshot_refs", "evidence_refs"],
      "properties": {
        "recommendation_ref": {"$ref": "#/$defs/reference"},
        "state": {"enum": ["DRAFT", "ISSUED", "WITHDRAWN", "STATUS_UNCONFIRMED"]},
        "issued_at": {"type": ["string", "null"], "format": "date-time"},
        "issuer_ref": {"$ref": "#/$defs/reference"},
        "advisory_scope_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "source_snapshot_refs": {"$ref": "#/$defs/nonemptyReferences"},
        "evidence_refs": {"$ref": "#/$defs/nonemptyReferences"}
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision_ref", "state", "decided_at", "authority_ref", "instrument_digest", "authority_basis_refs", "source_snapshot_refs", "evidence_refs"],
      "properties": {
        "decision_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 512, "pattern": "^kfm(?::|://)[^\\s]+$"},
        "state": {"enum": ["NO_DECISION_RECORDED", "ADOPTED", "ADOPTED_WITH_CHANGES", "REJECTED", "DEFERRED", "STATUS_UNCONFIRMED"]},
        "decided_at": {"type": ["string", "null"], "format": "date-time"},
        "authority_ref": {"type": ["string", "null"], "minLength": 1, "maxLength": 512, "pattern": "^kfm(?::|://)[^\\s]+$"},
        "instrument_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "authority_basis_refs": {"$ref": "#/$defs/references"},
        "source_snapshot_refs": {"$ref": "#/$defs/nonemptyReferences"},
        "evidence_refs": {"$ref": "#/$defs/nonemptyReferences"}
      }
    },
    "linkage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["disposition", "comparison_digest", "implementation_refs", "outcome_observation_refs", "boundary_outcome", "reason_codes"],
      "properties": {
        "disposition": {"enum": ["NO_DECISION", "ADOPTED_AS_RECOMMENDED", "ADOPTED_WITH_CHANGES", "REJECTED", "DEFERRED", "UNRESOLVED"]},
        "comparison_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "implementation_refs": {"$ref": "#/$defs/references"},
        "outcome_observation_refs": {"$ref": "#/$defs/references"},
        "boundary_outcome": {"enum": ["CONSISTENT", "HOLD", "ABSTAIN"]},
        "reason_codes": {"$ref": "#/$defs/codes"}
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {"enum": ["DECISION_IS_NOT_IMPLEMENTATION", "IMPLEMENTATION_IS_NOT_OUTCOME", "NO_BINDING_AUTHORITY_CREATED", "RECOMMENDATION_IS_ADVISORY", "RECOMMENDATION_IS_NOT_DECISION"]}
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommendation_adopted", "decision_created", "implementation_started", "implementation_completed", "outcome_measured", "policy_evaluated", "released", "published"],
      "properties": {
        "recommendation_adopted": {"type": "boolean"},
        "decision_created": {"type": "boolean"},
        "implementation_started": {"type": "boolean"},
        "implementation_completed": {"type": "boolean"},
        "outcome_measured": {"type": "boolean"},
        "policy_evaluated": {"type": "boolean"},
        "released": {"type": "boolean"},
        "published": {"type": "boolean"}
      }
    }
  },
  "$defs": {
    "reference": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^kfm(?::|://)[^\\s]+$"},
    "references": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
    "nonemptyReferences": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"$ref": "#/$defs/reference"}},
    "codes": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{2,63}$"}}
  }
}
