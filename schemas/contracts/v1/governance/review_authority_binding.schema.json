{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/governance/review_authority_binding.schema.json",
  "title": "ReviewAuthorityBinding",
  "description": "Strict fixture-only bridge that deterministically binds a declared review projection, stewardship projection, and exact subject. BOUND is structural agreement only and creates no authentication or write authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "profile",
    "profile_status",
    "execution_mode",
    "authority",
    "binding_id",
    "subject",
    "review",
    "assignment",
    "checks",
    "outcome",
    "reason_codes",
    "spec_hash",
    "permissions",
    "non_effects"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "object_type": {"const": "ReviewAuthorityBinding"},
    "profile": {"const": "kfm.governance.review-authority-binding.v1"},
    "profile_status": {"const": "PROPOSED_INACTIVE"},
    "execution_mode": {"const": "FIXTURE_ONLY"},
    "authority": {"const": "NONE"},
    "binding_id": {"type": "string", "pattern": "^kfm:review-authority-binding:[0-9a-f]{64}$"},
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "spec_hash", "author_actor_ref"],
      "properties": {
        "ref": {"type": "string", "pattern": "^kfm:[A-Za-z0-9][A-Za-z0-9._:/-]{3,255}$"},
        "spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "author_actor_ref": {"type": "string", "pattern": "^kfm:[A-Za-z0-9][A-Za-z0-9._:/-]{3,255}$"}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_ref", "review_spec_hash", "reviewed_at", "reviewer_actor_ref", "reviewer_role", "disposition", "conditions", "basis_refs", "policy_context_refs", "independent_review_required", "author_reviewer_distinct"],
      "properties": {
        "review_ref": {"type": "string", "pattern": "^kfm:[A-Za-z0-9][A-Za-z0-9._:/-]{3,255}$"},
        "review_spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "reviewed_at": {"type": "string", "format": "date-time"},
        "reviewer_actor_ref": {"type": "string", "pattern": "^kfm:[A-Za-z0-9][A-Za-z0-9._:/-]{3,255}$"},
        "reviewer_role": {"enum": ["contract_steward", "schema_steward", "policy_steward", "domain_steward", "source_steward", "sensitivity_reviewer", "release_authority", "ai_surface_steward", "ui_api_steward", "validation_steward"]},
        "disposition": {"enum": ["APPROVE", "APPROVE_WITH_CONDITIONS", "REQUEST_CHANGES", "ABSTAIN", "DENY", "ESCALATE", "INFORMATIONAL"]},
        "conditions": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
        "basis_refs": {"type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": {"type": "string", "pattern": "^kfm:[A-Za-z0-9][A-Za-z0-9._:/-]{3,255}$"}},
        "policy_context_refs": {"type": "array", "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^kfm:[A-Za-z0-9][A-Za-z0-9._:/-]{3,255}$"}},
        "independent_review_required": {"type": "boolean"},
        "author_reviewer_distinct": {"type": "boolean"}
      }
    },
    "assignment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assignment_ref", "assignment_spec_hash", "target_ref", "steward_actor_ref", "steward_role", "status", "starts_at", "expires_at", "authority_basis_refs", "responsibility_actions", "required_partner_roles", "escalation_ref"],
      "properties": {
        "assignment_ref": {"type": "string", "pattern": "^kfm:[A-Za-z0-9][A-Za-z0-9._:/-]{3,255}$"},
        "assignment_spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "target_ref": {"type": "string", "pattern": "^kfm:[A-Za-z0-9][A-Za-z0-9._:/-]{3,255}$"},
        "steward_actor_ref": {"type": "string", "pattern": "^kfm:[A-Za-z0-9][A-Za-z0-9._:/-]{3,255}$"},
        "steward_role": {"enum": ["contract_steward", "schema_steward", "policy_steward", "domain_steward", "source_steward", "sensitivity_reviewer", "release_authority", "ai_surface_steward", "ui_api_steward", "validation_steward"]},
        "status": {"enum": ["ACTIVE", "PROVISIONAL", "EXPIRED", "SUPERSEDED", "REVOKED", "UNKNOWN"]},
        "starts_at": {"type": "string", "format": "date-time"},
        "expires_at": {"oneOf": [{"type": "string", "format": "date-time"}, {"type": "null"}]},
        "authority_basis_refs": {"type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": {"type": "string", "pattern": "^kfm:[A-Za-z0-9][A-Za-z0-9._:/-]{3,255}$"}},
        "responsibility_actions": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["REVIEW", "PREFLIGHT_WORK_APPLY", "VALIDATE", "ESCALATE", "RELEASE_REVIEW"]}},
        "required_partner_roles": {"type": "array", "maxItems": 16, "uniqueItems": true, "items": {"enum": ["contract_steward", "schema_steward", "policy_steward", "domain_steward", "source_steward", "sensitivity_reviewer", "release_authority", "ai_surface_steward", "ui_api_steward", "validation_steward"]}},
        "escalation_ref": {"type": "string", "pattern": "^kfm:[A-Za-z0-9][A-Za-z0-9._:/-]{3,255}$"}
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor_match", "role_match", "subject_match", "effective_window_match", "active_assignment", "approved_review", "separation_of_duties_satisfied"],
      "properties": {
        "actor_match": {"type": "boolean"},
        "role_match": {"type": "boolean"},
        "subject_match": {"type": "boolean"},
        "effective_window_match": {"type": "boolean"},
        "active_assignment": {"type": "boolean"},
        "approved_review": {"type": "boolean"},
        "separation_of_duties_satisfied": {"type": "boolean"}
      }
    },
    "outcome": {"enum": ["BOUND", "HOLD", "DENY"]},
    "reason_codes": {
      "type": "array",
      "minItems": 7,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"enum": ["ACTIVE_ASSIGNMENT", "ACTOR_MISMATCH", "ACTOR_MATCH", "APPROVED_REVIEW", "ASSIGNMENT_EXPIRED", "ASSIGNMENT_NOT_ACTIVE", "ASSIGNMENT_PROVISIONAL", "EFFECTIVE_WINDOW_MATCH", "EFFECTIVE_WINDOW_MISMATCH", "REVIEW_CONDITIONAL", "REVIEW_NOT_APPROVED", "ROLE_MATCH", "ROLE_MISMATCH", "SOD_FAILED", "SOD_SATISFIED", "SUBJECT_MATCH", "SUBJECT_MISMATCH"]}
    },
    "spec_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_write_allowed", "lifecycle_write_allowed", "canonical_write_allowed", "promotion_allowed", "release_allowed", "deployment_allowed", "publication_allowed", "public_use_allowed"],
      "properties": {
        "repository_write_allowed": {"const": false},
        "lifecycle_write_allowed": {"const": false},
        "canonical_write_allowed": {"const": false},
        "promotion_allowed": {"const": false},
        "release_allowed": {"const": false},
        "deployment_allowed": {"const": false},
        "publication_allowed": {"const": false},
        "public_use_allowed": {"const": false}
      }
    },
    "non_effects": {"const": ["does_not_authenticate_actor_or_platform_identity", "does_not_authorize_apply_or_emit_write_request", "does_not_create_policy_promotion_or_release_authority", "does_not_merge_release_deploy_or_publish", "does_not_write_repository_or_lifecycle_state"]}
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "authority": "structural_binding_only",
    "contract_doc": "contracts/governance/review_authority_binding.md",
    "validator": "tools/validators/governance/validate_review_authority_binding.py",
    "fixtures_root": "fixtures/contracts/v1/governance/review_authority_binding/"
  }
}
