{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/governance/repository_issue_mutation_intent.schema.json",
  "title": "RepositoryIssueMutationIntentCandidate",
  "description": "Fixture-only repository-control evaluation for one target-pinned ADD_LABEL needs-review issue action. The evaluator has no network or external mutation path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "profile",
    "execution_mode",
    "evaluated_at",
    "intent",
    "preflight",
    "attempt",
    "readback",
    "receipt",
    "spec_hash",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "object_type": {"const": "RepositoryIssueMutationIntentCandidate"},
    "profile": {"const": "kfm.governance.repository-control.issue-mutation-intent.v1"},
    "execution_mode": {"const": "FIXTURE_ONLY_DECLARATION"},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "intent": {"$ref": "#/$defs/intent"},
    "preflight": {"$ref": "#/$defs/preflight"},
    "attempt": {"$ref": "#/$defs/attempt"},
    "readback": {
      "oneOf": [
        {"$ref": "#/$defs/readback"},
        {"type": "null"}
      ]
    },
    "receipt": {"$ref": "#/$defs/receipt"},
    "spec_hash": {"$ref": "#/$defs/sha256"},
    "claims": {"$ref": "#/$defs/claims"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bounded_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "repository_id"],
      "properties": {
        "full_name": {
          "type": "string",
          "minLength": 3,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "repository_id": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "issue_number", "issue_node_id"],
      "properties": {
        "kind": {"const": "ISSUE"},
        "issue_number": {"type": "integer", "minimum": 1},
        "issue_node_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        }
      }
    },
    "expected": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "revision", "expected_head_sha"],
      "properties": {
        "state": {"const": "OPEN"},
        "revision": {"type": "string", "format": "date-time"},
        "expected_head_sha": {"type": "null"}
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "label"],
      "properties": {
        "type": {"const": "ADD_LABEL"},
        "label": {"const": "needs-review"}
      }
    },
    "intent_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "actor_class", "expires_at"],
      "properties": {
        "reference": {
          "oneOf": [
            {"$ref": "#/$defs/bounded_ref"},
            {"type": "null"}
          ]
        },
        "actor_class": {"const": "ISSUE_MAINTAINER"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_id",
        "repository",
        "target",
        "expected",
        "action",
        "authority",
        "idempotency_key"
      ],
      "properties": {
        "intent_id": {
          "type": "string",
          "pattern": "^kfm:repository-issue-mutation-intent:[0-9a-f]{64}$"
        },
        "repository": {"$ref": "#/$defs/repository"},
        "target": {"$ref": "#/$defs/target"},
        "expected": {"$ref": "#/$defs/expected"},
        "action": {"$ref": "#/$defs/action"},
        "authority": {"$ref": "#/$defs/intent_authority"},
        "idempotency_key": {"$ref": "#/$defs/sha256"}
      }
    },
    "observed_target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "issue_number", "issue_node_id", "state", "revision", "head_sha", "labels"],
      "properties": {
        "kind": {"const": "ISSUE"},
        "issue_number": {"type": "integer", "minimum": 1},
        "issue_node_id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "state": {"type": "string", "enum": ["OPEN", "CLOSED"]},
        "revision": {"type": "string", "format": "date-time"},
        "head_sha": {"type": "null"},
        "labels": {
          "type": "array",
          "maxItems": 100,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "pattern": "\\S"
          }
        }
      }
    },
    "observed_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reference", "actor_class", "decision", "expires_at"],
      "properties": {
        "reference": {
          "oneOf": [
            {"$ref": "#/$defs/bounded_ref"},
            {"type": "null"}
          ]
        },
        "actor_class": {
          "type": "string",
          "enum": ["ISSUE_MAINTAINER", "LIFECYCLE_WRITER", "OBSERVER"]
        },
        "decision": {"type": "string", "enum": ["ALLOW", "DENY", "UNKNOWN"]},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "replay": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "idempotency_key", "intent_fingerprint", "previous_outcome"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["UNSEEN", "SAME_PARAMETERS", "DIFFERENT_PARAMETERS"]
        },
        "idempotency_key": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "intent_fingerprint": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "previous_outcome": {
          "oneOf": [
            {"type": "string", "enum": ["ATTEMPTED", "APPLIED", "NO_OP", "DENIED", "ERROR"]},
            {"type": "null"}
          ]
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_only", "observed_at", "repository", "target", "authority", "replay"],
      "properties": {
        "read_only": {"const": true},
        "observed_at": {"type": "string", "format": "date-time"},
        "repository": {"$ref": "#/$defs/repository"},
        "target": {"$ref": "#/$defs/observed_target"},
        "authority": {"$ref": "#/$defs/observed_authority"},
        "replay": {"$ref": "#/$defs/replay"}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "transport", "request_emitted", "response_status", "error_code"],
      "properties": {
        "status": {
          "type": "string",
          "enum": ["NOT_REQUESTED", "ATTEMPTED", "SUCCEEDED", "FAILED"]
        },
        "transport": {"type": "string", "enum": ["NONE", "DECLARED_GITHUB_API"]},
        "request_emitted": {"type": "boolean"},
        "response_status": {
          "oneOf": [
            {"type": "integer", "minimum": 100, "maximum": 599},
            {"type": "null"}
          ]
        },
        "error_code": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 64, "pattern": "^[A-Z0-9_]+$"},
            {"type": "null"}
          ]
        }
      }
    },
    "readback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["observed_at", "repository", "target"],
      "properties": {
        "observed_at": {"type": "string", "format": "date-time"},
        "repository": {"$ref": "#/$defs/repository"},
        "target": {"$ref": "#/$defs/observed_target"}
      }
    },
    "receipt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "receipt_id",
        "outcome",
        "reason_codes",
        "attempted",
        "applied",
        "readback_status",
        "intent_fingerprint",
        "target_fingerprint",
        "readback_fingerprint"
      ],
      "properties": {
        "receipt_id": {
          "type": "string",
          "pattern": "^kfm:repository-issue-mutation-receipt:[0-9a-f]{64}$"
        },
        "outcome": {
          "type": "string",
          "enum": ["ATTEMPTED", "APPLIED", "NO_OP", "DENIED", "ERROR"]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "ACTION_ALREADY_SATISFIED",
              "ACTION_APPLIED_READBACK_EXACT",
              "ACTION_ATTEMPT_RECORDED",
              "ATTEMPT_AFTER_DENIAL",
              "AUTHORITY_MISMATCH",
              "AUTHORITY_NOT_ALLOWED",
              "EXPIRED_INTENT",
              "IDEMPOTENCY_KEY_REUSED",
              "MISSING_AUTHORITY",
              "READBACK_MISMATCH",
              "REPLAY_CONVERGED",
              "REPLAY_RECORD_INVALID",
              "REPLAY_STATE_DIVERGENCE",
              "STALE_TARGET_REVISION",
              "STALE_TARGET_STATE",
              "TARGET_SUBSTITUTION",
              "TRANSPORT_FAILURE",
              "WRONG_REPOSITORY"
            ]
          }
        },
        "attempted": {"type": "boolean"},
        "applied": {"type": "boolean"},
        "readback_status": {
          "type": "string",
          "enum": ["EXACT", "NOT_AVAILABLE", "UNKNOWN"]
        },
        "intent_fingerprint": {"$ref": "#/$defs/sha256"},
        "target_fingerprint": {"$ref": "#/$defs/sha256"},
        "readback_fingerprint": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_evaluation",
        "validator_network_accessed",
        "validator_external_mutation_performed",
        "external_state_authenticated",
        "authority_authenticated",
        "subject_execution_authenticated",
        "live_mutation_adapter_present",
        "mutation_verified",
        "pull_request_lifecycle_changed",
        "repository_settings_changed",
        "release_deployment_promotion_or_publication_changed"
      ],
      "properties": {
        "deterministic_evaluation": {"const": true},
        "validator_network_accessed": {"const": false},
        "validator_external_mutation_performed": {"const": false},
        "external_state_authenticated": {"const": false},
        "authority_authenticated": {"const": false},
        "subject_execution_authenticated": {"const": false},
        "live_mutation_adapter_present": {"const": false},
        "mutation_verified": {"const": false},
        "pull_request_lifecycle_changed": {"const": false},
        "repository_settings_changed": {"const": false},
        "release_deployment_promotion_or_publication_changed": {"const": false}
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "authority": "fixture_only_repository_control_profile",
    "contract_doc": "contracts/governance/repository_issue_mutation_intent.md",
    "validator": "tools/validators/repository_control/validate_issue_mutation_intent.py",
    "fixtures_root": "fixtures/contracts/v1/governance/repository_issue_mutation_intent/"
  }
}
