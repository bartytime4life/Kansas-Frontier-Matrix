    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture", "reason_codes", "simulation_assessment_allowed", "real_tee_authorized"],
      "properties": {
        "posture": {
          "enum": [
            "NO_TRE",
            "SIMULATED_ASSESSMENT",
            "DEFER_REAL_TEE",
            "DENY_UNVERIFIED_ATTESTATION"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ASSESSMENT_ERROR",
              "ATTESTATION_BOUNDARY_INCOMPLETE",
              "BOUNDARY_COMPONENT_UNRESOLVED",
              "CONTROL_REVIEW_INCOMPLETE",
              "DECISION_DEFERRED",
              "EXISTING_CONTROLS_SUFFICIENT",
              "REAL_TEE_DEFERRED",
              "RESIDUAL_PROBLEM_UNRESOLVED",
              "SIMULATION_PLAN_INCOMPLETE",
              "SYNTHETIC_BOUNDARY_COMPLETE",
              "UNVERIFIED_ATTESTATION_DENIED"
            ]
          }
        },
        "simulation_assessment_allowed": {"type": "boolean"},
        "real_tee_authorized": {"const": false}
      }
    },
    "safeguards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_mode", "network_allowed", "credentials_allowed", "external_verification_allowed", "simulation_plan_ref"],
      "properties": {
        "data_mode": {"const": "NO_DATA_SYNTHETIC_ONLY"},
