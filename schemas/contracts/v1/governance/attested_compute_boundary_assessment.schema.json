    "correction_and_rollback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["invalidation_action", "dependent_outputs_release_allowed", "rollback_ref"],
      "properties": {
        "invalidation_action": {"const": "VOID_ASSESSMENT_AND_REVIEW_DEPENDENTS"},
        "dependent_outputs_release_allowed": {"const": false},
        "rollback_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "authority_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "real_sensitive_input_use",
        "credential_use",
        "cloud_or_tee_selection",
        "key_enrollment",
        "external_attestation_verification",
        "compute_execution",
        "output_release",
        "deployment",
        "publication"
      ],
      "properties": {
        "real_sensitive_input_use": {"const": false},
        "credential_use": {"const": false},
        "cloud_or_tee_selection": {"const": false},
        "key_enrollment": {"const": false},
        "external_attestation_verification": {"const": false},
        "compute_execution": {"const": false},
        "output_release": {"const": false},
        "deployment": {"const": false},
        "publication": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": "string", "minLength": 3, "maxLength": 512, "pattern": "^\\S+$"},
    "nullable_ref": {
      "oneOf": [
        {"$ref": "#/$defs/ref"},
        {"type": "null"}
      ]
    },
    "control_state": {
      "enum": ["REVIEWED_SUFFICIENT", "REVIEWED_INSUFFICIENT", "NOT_REVIEWED"]
    },
    "boundary_declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "resolution"],
      "properties": {
        "ref": {"$ref": "#/$defs/ref"},
        "resolution": {"enum": ["RESOLVED", "UNRESOLVED", "NOT_REQUIRED"]}
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "contract_doc": "contracts/governance/attested_compute_boundary_assessment.md",
    "fixtures_root": "fixtures/contracts/v1/governance/attested_compute_boundary_assessment/",
    "validator": "tools/validators/governance/validate_attested_compute_boundary_assessment.py",
    "network": false,
    "compute": false,
    "authority_effects": false
  }
}
