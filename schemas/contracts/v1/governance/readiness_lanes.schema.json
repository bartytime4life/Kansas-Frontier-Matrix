{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/governance/readiness_lanes.schema.json",
  "title": "KFM bounded readiness lanes",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "repository", "lanes"],
  "properties": {
    "schema_version": {"const": "kfm.readiness-lanes/v1"},
    "repository": {"const": "bartytime4life/Kansas-Frontier-Matrix"},
    "lanes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "scope",
          "command",
          "required_paths",
          "hold_reason",
          "authority_boundary"
        ],
        "properties": {
          "id": {"enum": ["policy", "fixtures", "proof-slice", "catalog"]},
          "status": {"enum": ["IMPLEMENTED", "HOLD"]},
          "scope": {"type": "string", "minLength": 1, "maxLength": 512},
          "command": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "array",
                "minItems": 1,
                "maxItems": 16,
                "items": {"type": "string", "minLength": 1, "maxLength": 256}
              }
            ]
          },
          "required_paths": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {"type": "string", "minLength": 1, "maxLength": 512},
            "uniqueItems": true
          },
          "hold_reason": {
            "oneOf": [
              {"type": "null"},
              {"type": "string", "minLength": 1, "maxLength": 512}
            ]
          },
          "authority_boundary": {"type": "string", "minLength": 1, "maxLength": 512}
        }
      }
    }
  }
}
