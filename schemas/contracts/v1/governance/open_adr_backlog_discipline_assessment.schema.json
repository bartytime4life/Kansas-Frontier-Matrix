{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/governance/open_adr_backlog_discipline_assessment.schema.json",
  "title": "OpenAdrBacklogDisciplineAssessmentCandidate",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "ref": {
      "type": "string",
      "pattern": "^kfm:[A-Za-z0-9._:/-]{3,240}$"
    },
    "refs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/ref"}
    },
    "ownerRoles": {
      "type": "array",
      "maxItems": 16,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]{2,63}$"
      }
    },
    "adrPath": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^docs/adr/ADR-[0-9]{4}-[A-Za-z0-9._-]+\\.md$"
        },
        {"type": "null"}
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "backlog_id": {
          "type": "string",
          "pattern": "^ADR-S-[0-9]{2}$"
        },
        "state": {
          "enum": ["OPEN", "IN_REVIEW", "BLOCKED", "RESOLVED", "WITHDRAWN", "SUPERSEDED"]
        },
        "decision_class": {
          "enum": ["AUTHORITY_BOUNDARY", "SCHEMA_HOME", "POLICY_BOUNDARY", "REVIEW_DUTY", "LIFECYCLE", "OTHER"]
        },
        "canonical_home_ref": {"$ref": "#/$defs/ref"},
        "candidate_adr_ref": {"$ref": "#/$defs/adrPath"},
        "owner_roles": {"$ref": "#/$defs/ownerRoles"},
        "blocker_refs": {"$ref": "#/$defs/refs"},
        "evidence_refs": {"$ref": "#/$defs/refs"},
        "superseded_by": {
          "oneOf": [
            {"type": "string", "pattern": "^ADR-S-[0-9]{2}$"},
            {"type": "null"}
          ]
        },
        "decision_required": {"type": "boolean"}
      },
      "required": [
        "backlog_id",
        "state",
        "decision_class",
        "canonical_home_ref",
        "candidate_adr_ref",
        "owner_roles",
        "blocker_refs",
        "evidence_refs",
        "superseded_by",
        "decision_required"
      ]
    }
  },
  "properties": {
    "profile": {
      "const": "kfm.governance.open-adr-backlog-discipline-assessment.fixture.v1"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^kfm:open-adr-backlog:[a-f0-9]{64}$"
    },
    "snapshot_ref": {"$ref": "#/$defs/ref"},
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 99,
      "items": {"$ref": "#/$defs/entry"}
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "state": {"enum": ["COMPLETE", "PENDING", "UNKNOWN"]},
        "record_refs": {"$ref": "#/$defs/refs"}
      },
      "required": ["state", "record_refs"]
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "creates_adr": {"type": "boolean"},
        "changes_backlog": {"type": "boolean"},
        "assigns_owner": {"type": "boolean"},
        "approves_decision": {"type": "boolean"},
        "promotes": {"type": "boolean"},
        "releases": {"type": "boolean"},
        "publishes": {"type": "boolean"}
      },
      "required": [
        "creates_adr",
        "changes_backlog",
        "assigns_owner",
        "approves_decision",
        "promotes",
        "releases",
        "publishes"
      ]
    }
  },
  "required": ["profile", "assessment_id", "snapshot_ref", "entries", "review", "effects"]
}
