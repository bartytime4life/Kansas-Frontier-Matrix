{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/governance/terminal_state_assessment.schema.json",
  "title": "TerminalStateAssessment",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "spec": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dt": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mutation_performed": {
          "const": false
        },
        "ready_transition_authorized": {
          "const": false
        },
        "merge_authorized": {
          "const": false
        },
        "settings_changed": {
          "const": false
        },
        "history_rewritten": {
          "const": false
        },
        "execution_mode": {
          "const": "FIXTURE_ONLY"
        }
      },
      "required": [
        "execution_mode",
        "mutation_performed",
        "ready_transition_authorized",
        "merge_authorized",
        "settings_changed",
        "history_rewritten"
      ]
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": {
          "enum": [
            "OPENED_DRAFT",
            "READY_FOR_REVIEW",
            "CONVERTED_TO_DRAFT",
            "CLOSED",
            "MERGED"
          ]
        },
        "actor": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]{1,100}$"
        },
        "at": {
          "$ref": "#/$defs/dt"
        }
      },
      "required": [
        "type",
        "actor",
        "at"
      ]
    }
  },
  "properties": {
    "object_type": {
      "const": "TerminalStateAssessment"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "profile": {
      "const": "kfm.repository-control.terminal-state-assessment.fixture.v1"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^kfm:terminal-state-assessment:[a-f0-9]{24}$"
    },
    "evaluated_at": {
      "$ref": "#/$defs/dt"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "full_name": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "default_branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "main_sha": {
          "$ref": "#/$defs/sha"
        }
      },
      "required": [
        "full_name",
        "default_branch",
        "main_sha"
      ]
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_:.-]{8,160}$"
        },
        "branch": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "head_sha": {
          "$ref": "#/$defs/sha"
        },
        "terminal_ceiling": {
          "enum": [
            "DRAFT_PR",
            "READY_PR"
          ]
        },
        "authorization_state": {
          "enum": [
            "PRESENT",
            "MISSING",
            "EXPIRED"
          ]
        },
        "expires_at": {
          "oneOf": [
            {
              "$ref": "#/$defs/dt"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "operation_id",
        "branch",
        "head_sha",
        "terminal_ceiling",
        "authorization_state",
        "expires_at"
      ]
    },
    "observed": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "pr_number": {
          "type": "integer",
          "minimum": 1
        },
        "state": {
          "enum": [
            "OPEN_DRAFT",
            "OPEN_READY",
            "CLOSED_UNMERGED",
            "MERGED",
            "UNKNOWN"
          ]
        },
        "head_sha": {
          "$ref": "#/$defs/sha"
        },
        "merge_commit_sha": {
          "oneOf": [
            {
              "$ref": "#/$defs/sha"
            },
            {
              "type": "null"
            }
          ]
        },
        "events": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/event"
          }
        }
      },
      "required": [
        "pr_number",
        "state",
        "head_sha",
        "merge_commit_sha",
        "events"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "outcome": {
          "enum": [
            "WITHIN_CEILING",
            "DIVERGENCE",
            "HOLD",
            "ERROR"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "TERMINAL_STATE_WITHIN_CEILING",
              "TERMINAL_STATE_DIVERGENCE",
              "AUTHORIZATION_MISSING",
              "AUTHORIZATION_EXPIRED",
              "HOST_STATE_UNKNOWN",
              "ASSESSMENT_ERROR"
            ]
          }
        }
      },
      "required": [
        "outcome",
        "reason_codes"
      ]
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "spec_hash": {
      "$ref": "#/$defs/spec"
    }
  },
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "assessment_id",
    "evaluated_at",
    "repository",
    "authorization",
    "observed",
    "result",
    "governance",
    "spec_hash"
  ]
}
