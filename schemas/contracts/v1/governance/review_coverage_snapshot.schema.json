{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/governance/review_coverage_snapshot.schema.json",
  "title": "ReviewCoverageSnapshot",
  "description": "Strict fixture-only review coverage observation for one pull-request head. CURRENT is exact-head review-coverage evidence only and creates no approval or write authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "profile",
    "profile_status",
    "execution_mode",
    "authority",
    "repository",
    "pull_request",
    "captured_at",
    "requirements",
    "reviews",
    "checks",
    "outcome",
    "reason_codes",
    "permissions",
    "non_effects"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "object_type": {"const": "ReviewCoverageSnapshot"},
    "profile": {"const": "kfm.governance.review-coverage-snapshot.v1"},
    "profile_status": {"const": "PROPOSED_INACTIVE"},
    "execution_mode": {"const": "FIXTURE_ONLY"},
    "authority": {"const": "NONE"},
    "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
    "pull_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "base_sha", "head_sha"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "captured_at": {"type": "string", "format": "date-time"},
    "requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_roles", "independence_required"],
      "properties": {
        "required_roles": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"}
        },
        "independence_required": {"type": "boolean"}
      }
    },
    "reviews": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_ref", "reviewer_ref", "reviewer_role", "state", "reviewed_head_sha", "submitted_at", "independent"],
        "properties": {
          "review_ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "reviewer_ref": {"type": "string", "minLength": 1, "maxLength": 256},
          "reviewer_role": {"type": "string", "pattern": "^[a-z][a-z0-9_]{1,63}$"},
          "state": {"enum": ["APPROVED", "CHANGES_REQUESTED", "SUBMITTED", "DISMISSED", "PENDING"]},
          "reviewed_head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "submitted_at": {"type": "string", "format": "date-time"},
          "independent": {"type": "boolean"}
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["all_counted_reviews_exact_head", "required_roles_covered", "independence_satisfied"],
      "properties": {
        "all_counted_reviews_exact_head": {"type": "boolean"},
        "required_roles_covered": {"type": "boolean"},
        "independence_satisfied": {"type": "boolean"}
      }
    },
    "outcome": {"enum": ["CURRENT", "HOLD", "STALE"]},
    "reason_codes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ALL_COUNTED_REVIEWS_EXACT_HEAD",
          "STALE_COUNTED_REVIEW_PRESENT",
          "REQUIRED_ROLES_COVERED",
          "REQUIRED_ROLES_MISSING",
          "INDEPENDENCE_SATISFIED",
          "INDEPENDENCE_INCOMPLETE"
        ]
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository_write_allowed", "merge_allowed", "promotion_allowed", "release_allowed", "deployment_allowed", "publication_allowed"],
      "properties": {
        "repository_write_allowed": {"const": false},
        "merge_allowed": {"const": false},
        "promotion_allowed": {"const": false},
        "release_allowed": {"const": false},
        "deployment_allowed": {"const": false},
        "publication_allowed": {"const": false}
      }
    },
    "non_effects": {
      "const": [
        "does_not_authenticate_reviewer_identity",
        "does_not_prove_host_review_requirements",
        "does_not_authorize_merge_or_repository_write",
        "does_not_create_policy_promotion_or_release_authority",
        "does_not_deploy_or_publish"
      ]
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "authority": "review_coverage_observation_only",
    "contract_doc": "contracts/governance/review_coverage_snapshot.md",
    "validator": "tools/validators/governance/validate_review_coverage_snapshot.py",
    "fixtures_root": "fixtures/contracts/v1/governance/review_coverage_snapshot/"
  }
}
