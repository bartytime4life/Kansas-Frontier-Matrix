{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfm.invalid/schemas/contracts/v1/governance/automation_pr_proposal.schema.json",
  "title": "AutomationPrProposal",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "proposal_id",
    "base_ref",
    "base_sha",
    "head_branch",
    "title",
    "changed_paths",
    "artifacts",
    "receipt_ref",
    "policy_outcome",
    "policy_reasons",
    "draft",
    "merge_allowed",
    "release_allowed",
    "deploy_allowed",
    "promote_allowed",
    "publish_allowed"
  ],
  "properties": {
    "profile": {"const": "kfm.automation.pr-proposal.v1"},
    "proposal_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$"},
    "base_ref": {"const": "main"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "head_branch": {"type": "string", "pattern": "^automation/[A-Za-z0-9._/-]{3,100}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 120},
    "changed_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))data/work/automation/[A-Za-z0-9._/-]+$"
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))data/work/automation/[A-Za-z0-9._/-]+$"
          },
          "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
        }
      }
    },
    "receipt_ref": {"type": "string", "minLength": 1, "maxLength": 200},
    "policy_outcome": {"enum": ["PASS", "HOLD", "DENY", "ERROR"]},
    "policy_reasons": {
      "type": "array",
      "maxItems": 16,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"},
      "uniqueItems": true
    },
    "draft": {"const": true},
    "merge_allowed": {"const": false},
    "release_allowed": {"const": false},
    "deploy_allowed": {"const": false},
    "promote_allowed": {"const": false},
    "publish_allowed": {"const": false}
  }
}
