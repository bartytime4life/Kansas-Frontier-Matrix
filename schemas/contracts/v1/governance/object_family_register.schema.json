{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/governance/object_family_register.schema.json",
  "title": "KFM Object Family Register",
  "description": "Strict shape for the non-authoritative KFM object-family navigation and repository-surface catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "registry",
    "status",
    "authority",
    "updated_at",
    "base_ref",
    "coverage_scope",
    "implementation_status",
    "completeness",
    "owner_role",
    "description",
    "required_family_count",
    "required_registered_count",
    "other_registered_count",
    "conflicted_required_count",
    "unresolved_items",
    "non_effects",
    "entries"
  ],
  "properties": {
    "version": {"const": "v1"},
    "registry": {"const": "object_family_register"},
    "status": {"const": "PROPOSED"},
    "authority": {"const": "navigational_index_only"},
    "updated_at": {"type": "string", "format": "date"},
    "base_ref": {"$ref": "#/$defs/sha"},
    "coverage_scope": {"type": "string", "pattern": "^[a-z][a-z0-9_]{4,96}$"},
    "implementation_status": {"$ref": "#/$defs/implementationStatus"},
    "completeness": {"type": "string", "enum": ["partial", "complete"]},
    "owner_role": {"$ref": "#/$defs/ownerRole"},
    "description": {"type": "string", "minLength": 1, "maxLength": 2048},
    "required_family_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "required_registered_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "other_registered_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "conflicted_required_count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "unresolved_items": {"$ref": "#/$defs/tokens"},
    "non_effects": {
      "type": "array",
      "minItems": 7,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/token"},
      "uniqueItems": true
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"coverage_scope": {"const": "milestone_trust_spine_v1"}},
        "required": ["coverage_scope"]
      },
      "then": {
        "properties": {
          "implementation_status": {"const": "PARTIAL"},
          "completeness": {"const": "partial"},
          "required_family_count": {"const": 16},
          "required_registered_count": {"const": 16},
          "entries": {"minItems": 16}
        }
      }
    }
  ],
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\\\/][^\\\\]*$"
    },
    "paths": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/path"},
      "uniqueItems": true
    },
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,160}$"},
    "tokens": {
      "type": "array",
      "maxItems": 128,
      "items": {"$ref": "#/$defs/token"},
      "uniqueItems": true
    },
    "ownerRole": {
      "anyOf": [
        {"const": "UNKNOWN"},
        {"$ref": "#/$defs/token"}
      ]
    },
    "implementationStatus": {
      "type": "string",
      "enum": [
        "IMPLEMENTED",
        "PARTIAL",
        "ABSENT",
        "SUPERSEDED",
        "CONFLICTED",
        "DEPRECATED",
        "NOT_INSPECTED"
      ]
    },
    "surfaceStatusMap": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contracts",
        "schemas",
        "policy",
        "fixtures",
        "validators",
        "tests",
        "workflows",
        "emitters"
      ],
      "properties": {
        "contracts": {"$ref": "#/$defs/implementationStatus"},
        "schemas": {"$ref": "#/$defs/implementationStatus"},
        "policy": {"$ref": "#/$defs/implementationStatus"},
        "fixtures": {"$ref": "#/$defs/implementationStatus"},
        "validators": {"$ref": "#/$defs/implementationStatus"},
        "tests": {"$ref": "#/$defs/implementationStatus"},
        "workflows": {"$ref": "#/$defs/implementationStatus"},
        "emitters": {"$ref": "#/$defs/implementationStatus"}
      }
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "rule_refs", "notes"],
      "properties": {
        "status": {"$ref": "#/$defs/implementationStatus"},
        "rule_refs": {"$ref": "#/$defs/paths", "minItems": 1},
        "notes": {"type": "string", "minLength": 1, "maxLength": 1024}
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["posture", "candidate_paths", "reason_codes", "notes"],
      "properties": {
        "posture": {
          "type": "string",
          "enum": [
            "single_surface",
            "multiple_complementary",
            "multiple_candidates_unresolved",
            "legacy_alias_retained",
            "not_inspected"
          ]
        },
        "candidate_paths": {"$ref": "#/$defs/paths"},
        "reason_codes": {"$ref": "#/$defs/tokens", "minItems": 1},
        "notes": {"type": "string", "minLength": 1, "maxLength": 1024}
      },
      "allOf": [
        {
          "if": {
            "properties": {"posture": {"const": "multiple_candidates_unresolved"}},
            "required": ["posture"]
          },
          "then": {"properties": {"candidate_paths": {"minItems": 2}}}
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "family_id",
        "display_name",
        "required_by_milestone",
        "family_kind",
        "maturity",
        "implementation_status",
        "owner_role",
        "lifecycle_stage",
        "producer_classes",
        "consumer_classes",
        "contract_paths",
        "schema_paths",
        "policy_paths",
        "fixture_paths",
        "validator_paths",
        "test_paths",
        "workflow_paths",
        "emitter_paths",
        "surface_status",
        "identity",
        "compatibility",
        "dependency_family_ids",
        "evidence_family_ids",
        "release_family_ids",
        "correction_family_ids",
        "rollback_family_ids",
        "notes"
      ],
      "properties": {
        "family_id": {"$ref": "#/$defs/token"},
        "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
        "required_by_milestone": {"type": "boolean"},
        "family_kind": {
          "type": "string",
          "enum": [
            "shared_kernel",
            "runtime",
            "governance",
            "evidence",
            "release",
            "domain_extension",
            "registry",
            "source"
          ]
        },
        "maturity": {"type": "string", "enum": ["seed", "partial", "covered", "hardened"]},
        "implementation_status": {"$ref": "#/$defs/implementationStatus"},
        "owner_role": {"$ref": "#/$defs/ownerRole"},
        "lifecycle_stage": {"$ref": "#/$defs/token"},
        "producer_classes": {"$ref": "#/$defs/tokens", "minItems": 1},
        "consumer_classes": {"$ref": "#/$defs/tokens", "minItems": 1},
        "contract_paths": {"$ref": "#/$defs/paths", "minItems": 1},
        "schema_paths": {"$ref": "#/$defs/paths", "minItems": 1},
        "policy_paths": {"$ref": "#/$defs/paths"},
        "fixture_paths": {"$ref": "#/$defs/paths"},
        "validator_paths": {"$ref": "#/$defs/paths"},
        "test_paths": {"$ref": "#/$defs/paths"},
        "workflow_paths": {"$ref": "#/$defs/paths"},
        "emitter_paths": {"$ref": "#/$defs/paths"},
        "surface_status": {"$ref": "#/$defs/surfaceStatusMap"},
        "identity": {"$ref": "#/$defs/identity"},
        "compatibility": {"$ref": "#/$defs/compatibility"},
        "dependency_family_ids": {"$ref": "#/$defs/tokens"},
        "evidence_family_ids": {"$ref": "#/$defs/tokens"},
        "release_family_ids": {"$ref": "#/$defs/tokens"},
        "correction_family_ids": {"$ref": "#/$defs/tokens"},
        "rollback_family_ids": {"$ref": "#/$defs/tokens"},
        "notes": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED",
    "contract_doc": "docs/registers/OBJECT_FAMILY.md",
    "instance": "control_plane/object_family_register.yaml",
    "validator": "tools/validators/control_plane/validate_object_family_register.py",
    "fixtures_root": "fixtures/contracts/v1/governance/object_family_register/",
    "tests": "tests/validators/test_validate_object_family_register.py",
    "authority": "navigational_index_shape_only",
    "non_effects": [
      "does_not_create_object_family_authority",
      "does_not_select_conflicting_candidates",
      "does_not_override_contract_schema_policy_evidence_or_release"
    ]
  }
}
