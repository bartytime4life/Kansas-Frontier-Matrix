{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kfm.example/schemas/contracts/v1/governance/evidence_resolution_record.schema.json",
  "title": "EvidenceResolutionRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "record_id",
    "query_run_id",
    "requested_refs",
    "resolutions",
    "outcome",
    "evaluated_at",
    "effects"
  ],
  "properties": {
    "profile": {
      "const": "kfm.governance.evidence-resolution-record.v1"
    },
    "record_id": {
      "type": "string",
      "pattern": "^kfm:evidence-resolution:[a-f0-9]{64}$"
    },
    "query_run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "requested_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "resolutions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "evidence_ref",
          "status",
          "reason_code"
        ],
        "properties": {
          "evidence_ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "status": {
            "enum": [
              "RESOLVED",
              "UNRESOLVED",
              "DENIED"
            ]
          },
          "reason_code": {
            "type": "string",
            "pattern": "^[A-Z0-9_]{2,64}$"
          },
          "bundle_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "bundle_digest": {
            "type": "string",
            "pattern": "^sha256:[a-f0-9]{64}$"
          }
        }
      }
    },
    "outcome": {
      "enum": [
        "COMPLETE",
        "PARTIAL",
        "UNRESOLVED",
        "DENIED",
        "ERROR"
      ]
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence_created",
        "policy_evaluated",
        "lifecycle_written",
        "promoted",
        "released",
        "deployed",
        "published",
        "public_use_authorized"
      ],
      "properties": {
        "evidence_created": {"const": false},
        "policy_evaluated": {"const": false},
        "lifecycle_written": {"const": false},
        "promoted": {"const": false},
        "released": {"const": false},
        "deployed": {"const": false},
        "published": {"const": false},
        "public_use_authorized": {"const": false}
      }
    }
  }
}
