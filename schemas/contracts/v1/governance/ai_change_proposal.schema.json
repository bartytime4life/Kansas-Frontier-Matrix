{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/governance/ai_change_proposal.schema.json",
  "title": "AIChangeProposal",
  "description": "Closed fixture-only governance record for a deterministic compare-and-set JSON patch proposed by an AI proposal engine. Conformance creates no repository mutation, source, evidence, policy, review, promotion, release, publication, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "profile_status",
    "execution_mode",
    "authority",
    "proposal_id",
    "created_at",
    "producer",
    "evidence_refs",
    "subject",
    "patch",
    "policy_projection",
    "human_attestation",
    "readiness",
    "permissions",
    "non_effects"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "profile": {
      "const": "kfm.governance.ai-change-proposal.v1"
    },
    "profile_status": {
      "const": "PROPOSED_INACTIVE"
    },
    "execution_mode": {
      "const": "FIXTURE_ONLY"
    },
    "authority": {
      "const": "NONE"
    },
    "proposal_id": {
      "type": "string",
      "pattern": "^kfm:ai-change-proposal:[0-9a-f]{64}$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "provider",
        "model",
        "model_version",
        "prompt_hash",
        "input_bundle_hash"
      ],
      "properties": {
        "kind": {
          "const": "AI_PROPOSAL_ENGINE"
        },
        "provider": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "model_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "prompt_hash": {
          "$ref": "#/$defs/spec_hash"
        },
        "input_bundle_hash": {
          "$ref": "#/$defs/spec_hash"
        }
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subject_ref",
        "target_zone",
        "input_spec_hash",
        "expected_output_spec_hash"
      ],
      "properties": {
        "subject_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "target_zone": {
          "const": "WORK"
        },
        "input_spec_hash": {
          "$ref": "#/$defs/spec_hash"
        },
        "expected_output_spec_hash": {
          "$ref": "#/$defs/spec_hash"
        }
      }
    },
    "patch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "operations",
        "patch_spec_hash",
        "claims"
      ],
      "properties": {
        "algorithm": {
          "const": "kfm-json-compare-and-set-v1"
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "patch_spec_hash": {
          "$ref": "#/$defs/spec_hash"
        },
        "claims": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "deterministic",
            "idempotent",
            "minimal"
          ],
          "properties": {
            "deterministic": {
              "const": true
            },
            "idempotent": {
              "const": true
            },
            "minimal": {
              "const": true
            }
          }
        }
      }
    },
    "policy_projection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "decision_ref",
        "required_obligations",
        "satisfied_obligations"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "ALLOW",
            "HOLD",
            "DENY"
          ]
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        },
        "required_obligations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/obligation"
          }
        },
        "satisfied_obligations": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/obligation"
          }
        }
      }
    },
    "human_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required",
        "state",
        "review_record_ref"
      ],
      "properties": {
        "required": {
          "const": true
        },
        "state": {
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED"
          ]
        },
        "review_record_ref": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 512
            }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "state": {
                "const": "PENDING"
              }
            }
          },
          "then": {
            "properties": {
              "review_record_ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "state": {
                "enum": [
                  "APPROVED",
                  "REJECTED"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "review_record_ref": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "reason_codes"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "READY_FOR_STEWARD_APPLY",
            "HOLD",
            "DENY"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PATCH_VERIFIED",
              "POLICY_ALLOWED",
              "POLICY_HELD",
              "POLICY_DENIED",
              "OBLIGATIONS_SATISFIED",
              "OBLIGATIONS_PENDING",
              "HUMAN_APPROVED",
              "HUMAN_PENDING",
              "HUMAN_REJECTED",
              "READY_FOR_STEWARD_APPLY",
              "READINESS_HELD",
              "READINESS_DENIED"
            ]
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "may_mutate_repository",
        "may_write_canonical",
        "may_promote",
        "may_release",
        "may_publish"
      ],
      "properties": {
        "may_mutate_repository": {
          "const": false
        },
        "may_write_canonical": {
          "const": false
        },
        "may_promote": {
          "const": false
        },
        "may_release": {
          "const": false
        },
        "may_publish": {
          "const": false
        }
      }
    },
    "non_effects": {
      "const": [
        "no_repository_mutation",
        "no_canonical_write",
        "no_evidence_resolution",
        "no_policy_evaluation",
        "no_human_approval_creation",
        "no_promotion_release_or_publication"
      ]
    }
  },
  "$defs": {
    "spec_hash": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "json_pointer": {
      "type": "string",
      "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$"
    },
    "json_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "present"
      ],
      "properties": {
        "present": {
          "type": "boolean"
        },
        "value": {}
      },
      "oneOf": [
        {
          "properties": {
            "present": {
              "const": true
            }
          },
          "required": [
            "value"
          ]
        },
        {
          "properties": {
            "present": {
              "const": false
            }
          },
          "not": {
            "required": [
              "value"
            ]
          }
        }
      ]
    },
    "operation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "op",
        "path",
        "before",
        "after"
      ],
      "properties": {
        "op": {
          "enum": [
            "add",
            "replace",
            "remove"
          ]
        },
        "path": {
          "$ref": "#/$defs/json_pointer"
        },
        "before": {
          "$ref": "#/$defs/json_state"
        },
        "after": {
          "$ref": "#/$defs/json_state"
        }
      }
    },
    "obligation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "parameters"
      ],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{2,63}$"
        },
        "parameters": {
          "type": "object",
          "maxProperties": 16,
          "additionalProperties": true
        }
      }
    }
  }
}
