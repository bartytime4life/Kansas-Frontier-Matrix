{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/governance/ci_conformance_report.schema.json",
  "title": "KFM milestone CI conformance report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "milestone",
    "repository",
    "status",
    "authority_mode",
    "observed_at",
    "authority_refs",
    "registries",
    "schemas",
    "policies",
    "validators",
    "fixture",
    "checks",
    "failures",
    "generated_artifacts",
    "unresolved_items",
    "closure",
    "controls",
    "edit_policy",
    "generated_from",
    "generator",
    "generator_version",
    "sha256",
    "report_digest"
  ],
  "properties": {
    "schema_version": {
      "const": "kfm.ci-conformance-report.v1"
    },
    "report_id": {
      "type": "string",
      "pattern": "^kfm://qa/milestone-[1-9][0-9]*/ci-conformance/[a-z0-9._-]+$"
    },
    "milestone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "id", "title", "state"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "id": {"type": "string", "minLength": 3},
        "title": {"type": "string", "minLength": 3},
        "state": {"enum": ["OPEN", "CLOSED"]}
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["full_name", "base_sha", "candidate_ref", "final_sha"],
      "properties": {
        "full_name": {"const": "bartytime4life/Kansas-Frontier-Matrix"},
        "base_sha": {"$ref": "#/$defs/git_sha"},
        "candidate_ref": {"type": "string", "minLength": 3},
        "final_sha": {
          "oneOf": [
            {"$ref": "#/$defs/git_sha"},
            {"type": "null"}
          ]
        }
      }
    },
    "status": {
      "enum": ["CONFORMANT", "NONCONFORMANT", "BLOCKED"]
    },
    "authority_mode": {
      "const": "process_evidence_only"
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "authority_refs": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/versioned_ref"}
    },
    "registries": {
      "type": "array",
      "minItems": 3,
      "items": {"$ref": "#/$defs/versioned_ref"}
    },
    "schemas": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/versioned_ref"}
    },
    "policies": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/versioned_ref"}
    },
    "validators": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/versioned_ref"}
    },
    "fixture": {"$ref": "#/$defs/fixture_ref"},
    "checks": {
      "type": "array",
      "minItems": 8,
      "items": {"$ref": "#/$defs/check"}
    },
    "failures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["inherited", "introduced"],
      "properties": {
        "inherited": {
          "type": "array",
          "items": {"$ref": "#/$defs/failure"}
        },
        "introduced": {
          "type": "array",
          "items": {"$ref": "#/$defs/failure"}
        }
      }
    },
    "generated_artifacts": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "#/$defs/generated_artifact"}
    },
    "unresolved_items": {
      "type": "array",
      "items": {"$ref": "#/$defs/unresolved"}
    },
    "closure": {"$ref": "#/$defs/closure"},
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_used",
        "receipt_self_approves",
        "release_authorized",
        "deployment_authorized",
        "promotion_authorized",
        "publication_authorized",
        "milestone_close_authorized"
      ],
      "properties": {
        "network_used": {"const": false},
        "receipt_self_approves": {"const": false},
        "release_authorized": {"const": false},
        "deployment_authorized": {"const": false},
        "promotion_authorized": {"const": false},
        "publication_authorized": {"const": false},
        "milestone_close_authorized": {"const": false}
      }
    },
    "edit_policy": {
      "const": "regenerate_only"
    },
    "generated_from": {
      "const": "milestone-1-trust-spine-evidence-checkpoint"
    },
    "generator": {
      "const": "tools/validators/governance/validate_ci_conformance_report.py"
    },
    "generator_version": {
      "const": "kfm.ci-conformance-report-generator.v1"
    },
    "sha256": {"$ref": "#/$defs/sha256"},
    "report_digest": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "git_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "scope", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "scope": {"enum": ["BASE_TREE", "CANDIDATE_TREE"]},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "versioned_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "scope", "sha256", "version", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "scope": {"enum": ["BASE_TREE", "CANDIDATE_TREE"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 2}
      }
    },
    "fixture_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "scope",
        "sha256",
        "version",
        "status",
        "review_state"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "scope": {"enum": ["BASE_TREE", "CANDIDATE_TREE"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "version": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 2},
        "review_state": {
          "enum": ["MERGED", "READY_FOR_REVIEW", "PENDING", "REJECTED"]
        }
      }
    },
    "generated_artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "scope", "sha256", "truth_label"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$"},
        "path": {"type": "string", "pattern": "^[A-Za-z0-9._/-]+$"},
        "scope": {"enum": ["BASE_TREE", "CANDIDATE_TREE"]},
        "sha256": {"$ref": "#/$defs/sha256"},
        "truth_label": {
          "enum": ["CONFIRMED", "PROPOSED", "NEEDS_VERIFICATION"]
        }
      }
    },
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "required_for_closure",
        "command",
        "execution_state",
        "outcome",
        "scope",
        "evidence"
      ],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "required_for_closure": {"type": "boolean"},
        "command": {
          "oneOf": [
            {"type": "string", "minLength": 3},
            {"type": "null"}
          ]
        },
        "execution_state": {
          "enum": ["EXECUTED_LOCAL", "EXECUTED_HOSTED", "CHECK_NOT_RUN", "SKIPPED"]
        },
        "outcome": {
          "enum": ["PASS", "FAIL", "HOLD_INHERITED", "CHECK_NOT_RUN", "SKIPPED"]
        },
        "scope": {"type": "string", "minLength": 3},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 3}
        }
      }
    },
    "failure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "count", "scope", "blocking"],
      "properties": {
        "code": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "count": {"type": "integer", "minimum": 0},
        "scope": {"type": "string", "minLength": 3},
        "blocking": {"type": "boolean"}
      }
    },
    "unresolved": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "detail", "blocking"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "detail": {"type": "string", "minLength": 3},
        "blocking": {"type": "boolean"}
      }
    },
    "hosted_run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow", "run_url", "head_sha", "conclusion"],
      "properties": {
        "workflow": {"type": "string", "minLength": 1},
        "run_url": {"type": "string", "format": "uri"},
        "head_sha": {"$ref": "#/$defs/git_sha"},
        "conclusion": {"enum": ["SUCCESS", "FAILURE", "CANCELLED"]}
      }
    },
    "exit_criterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "satisfied", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Z0-9_]+$"},
        "satisfied": {"type": "boolean"},
        "evidence": {
          "oneOf": [
            {"type": "string", "minLength": 3},
            {"type": "null"}
          ]
        }
      }
    },
    "closure": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "target_sha",
        "hosted_runs",
        "human_review",
        "exit_criteria",
        "unresolved_count",
        "closer",
        "closed_at"
      ],
      "properties": {
        "state": {"enum": ["BLOCKED", "READY", "CLOSED"]},
        "target_sha": {
          "oneOf": [
            {"$ref": "#/$defs/git_sha"},
            {"type": "null"}
          ]
        },
        "hosted_runs": {
          "type": "array",
          "items": {"$ref": "#/$defs/hosted_run"}
        },
        "human_review": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reviewer_ids", "timestamp"],
          "properties": {
            "state": {"enum": ["PENDING", "APPROVED", "REJECTED"]},
            "reviewer_ids": {
              "type": "array",
              "items": {"type": "string", "minLength": 1}
            },
            "timestamp": {
              "oneOf": [
                {"type": "string", "format": "date-time"},
                {"type": "null"}
              ]
            }
          }
        },
        "exit_criteria": {
          "type": "array",
          "minItems": 5,
          "items": {"$ref": "#/$defs/exit_criterion"}
        },
        "unresolved_count": {"type": "integer", "minimum": 0},
        "closer": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"type": "null"}
          ]
        },
        "closed_at": {
          "oneOf": [
            {"type": "string", "format": "date-time"},
            {"type": "null"}
          ]
        }
      }
    }
  }
}
