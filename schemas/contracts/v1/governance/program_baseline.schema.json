{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/governance/program_baseline.schema.json",
  "title": "KFM M01 Program Baseline",
  "description": "Pinned, non-authoritative M01 projection of repository authority, ownership, issue/PR overlap, advisory Drive lineage, validation outcomes, correction triggers, and rollback.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "profile",
    "baseline_id",
    "repository",
    "projection_status",
    "implementation_status",
    "authority_mode",
    "observed_at",
    "base",
    "placement",
    "authority_snapshot",
    "tracked_surfaces",
    "tracker_snapshot",
    "drive_lineage",
    "validation_observations",
    "unresolved_items",
    "non_effects",
    "correction"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.program-baseline.m01.v1"},
    "baseline_id": {"type": "string", "pattern": "^kfm-program-baseline-main-[a-f0-9]{12}$"},
    "repository": {"const": "bartytime4life/Kansas-Frontier-Matrix"},
    "projection_status": {"const": "PROPOSED"},
    "implementation_status": {"const": "PARTIAL"},
    "authority_mode": {"const": "evidence_projection_only"},
    "observed_at": {"type": "string", "format": "date-time"},
    "base": {"$ref": "#/$defs/base"},
    "placement": {"$ref": "#/$defs/placement"},
    "authority_snapshot": {"$ref": "#/$defs/authoritySnapshot"},
    "tracked_surfaces": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/trackedSurface"}
    },
    "tracker_snapshot": {
      "type": "array",
      "minItems": 3,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/tracker"}
    },
    "drive_lineage": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {"$ref": "#/$defs/driveLineage"}
    },
    "validation_observations": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {"$ref": "#/$defs/validationObservation"}
    },
    "unresolved_items": {"$ref": "#/$defs/tokens", "minItems": 1},
    "non_effects": {"$ref": "#/$defs/tokens", "minItems": 8},
    "correction": {"$ref": "#/$defs/correction"}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "digest": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^[^\\\\/][^\\\\]*$"
    },
    "token": {"type": "string", "pattern": "^[a-z][a-z0-9_]{2,180}$"},
    "tokens": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/token"},
      "uniqueItems": true
    },
    "issueNumbers": {
      "type": "array",
      "maxItems": 256,
      "items": {"type": "integer", "minimum": 1},
      "uniqueItems": true
    },
    "implementationStatus": {
      "enum": ["IMPLEMENTED", "PARTIAL", "ABSENT", "SUPERSEDED", "CONFLICTED", "DEPRECATED", "NOT_INSPECTED"]
    },
    "pathDigest": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"$ref": "#/$defs/path"},
        "sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["branch", "sha", "milestone_number", "milestone_issue_number", "milestone_title", "open_pull_requests"],
      "properties": {
        "branch": {"const": "main"},
        "sha": {"$ref": "#/$defs/sha"},
        "milestone_number": {"const": 2},
        "milestone_issue_number": {"const": 3365},
        "milestone_title": {"const": "M01 - Authority, Directory Rules & Program Baseline"},
        "open_pull_requests": {"$ref": "#/$defs/issueNumbers"}
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "responsibility_root", "canonical_path", "adjacent_readme_path", "base_path_status", "slice_status", "consumer_paths", "alias_paths"],
      "properties": {
        "owner": {"pattern": "^@[A-Za-z0-9-]+$"},
        "responsibility_root": {"const": "control_plane/"},
        "canonical_path": {"const": "control_plane/program_baseline.json"},
        "adjacent_readme_path": {"const": "control_plane/README.md"},
        "base_path_status": {"const": "ABSENT"},
        "slice_status": {"const": "PARTIAL"},
        "consumer_paths": {
          "type": "array",
          "minItems": 6,
          "maxItems": 32,
          "items": {"$ref": "#/$defs/path"},
          "uniqueItems": true
        },
        "alias_paths": {
          "type": "array",
          "maxItems": 16,
          "items": {"$ref": "#/$defs/path"},
          "uniqueItems": true
        }
      }
    },
    "directoryRules": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/pathDigest"},
        {
          "type": "object",
          "required": ["decision_ref", "implementation_status"],
          "properties": {
            "decision_ref": {"const": "ADR-0029"},
            "implementation_status": {"const": "IMPLEMENTED"}
          }
        }
      ]
    },
    "adrIndex": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/pathDigest"},
        {
          "type": "object",
          "required": ["accepted_ids", "accepted_count", "proposed_count", "unassigned_scaffold_count", "implementation_status"],
          "properties": {
            "accepted_ids": {
              "type": "array",
              "minItems": 1,
              "maxItems": 128,
              "items": {"type": "string", "pattern": "^ADR-[0-9]{4}$"},
              "uniqueItems": true
            },
            "accepted_count": {"type": "integer", "minimum": 1, "maximum": 128},
            "proposed_count": {"type": "integer", "minimum": 0, "maximum": 512},
            "unassigned_scaffold_count": {"type": "integer", "minimum": 0, "maximum": 512},
            "implementation_status": {"const": "IMPLEMENTED"}
          }
        }
      ]
    },
    "ownedPathDigest": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/pathDigest"},
        {
          "type": "object",
          "required": ["owner", "implementation_status"],
          "properties": {
            "owner": {"pattern": "^@[A-Za-z0-9-]+$"},
            "implementation_status": {"$ref": "#/$defs/implementationStatus"}
          }
        }
      ]
    },
    "authoritySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["directory_rules", "adr_index", "codeowners", "root_registry"],
      "properties": {
        "directory_rules": {"$ref": "#/$defs/directoryRules"},
        "adr_index": {"$ref": "#/$defs/adrIndex"},
        "codeowners": {"$ref": "#/$defs/ownedPathDigest"},
        "root_registry": {"$ref": "#/$defs/ownedPathDigest"}
      }
    },
    "trackedSurface": {
      "unevaluatedProperties": false,
      "allOf": [
        {"$ref": "#/$defs/pathDigest"},
        {
          "type": "object",
          "required": ["id", "implementation_status", "reason"],
          "properties": {
            "id": {"$ref": "#/$defs/token"},
            "implementation_status": {"$ref": "#/$defs/implementationStatus"},
            "reason": {"$ref": "#/$defs/token"}
          }
        }
      ]
    },
    "tracker": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "state", "role", "updated_at", "recorded_baseline_sha", "implementation_status", "stale_at_base", "url"],
      "properties": {
        "number": {"type": "integer", "minimum": 1},
        "state": {"enum": ["OPEN", "CLOSED"]},
        "role": {"enum": ["milestone_checkpoint", "program_tracker", "source_corpus_tracker"]},
        "updated_at": {"type": "string", "format": "date-time"},
        "recorded_baseline_sha": {"$ref": "#/$defs/sha"},
        "implementation_status": {"$ref": "#/$defs/implementationStatus"},
        "stale_at_base": {"type": "boolean"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://github\\.com/"}
      }
    },
    "driveLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["file_id", "title", "modified_at", "role", "url", "repository_authority", "mutated"],
      "properties": {
        "file_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{10,128}$"},
        "title": {"type": "string", "minLength": 3, "maxLength": 240},
        "modified_at": {"type": "string", "format": "date-time"},
        "role": {"enum": ["advisory_operating_contract", "advisory_repository_structure", "doctrine_synthesis_not_implementation_evidence"]},
        "url": {"type": "string", "format": "uri", "pattern": "^https://docs\\.google\\.com/"},
        "repository_authority": {"const": false},
        "mutated": {"const": false}
      }
    },
    "validationObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "command", "run_state", "outcome", "failure_class", "finding_count", "scope"],
      "properties": {
        "id": {"$ref": "#/$defs/token"},
        "command": {"type": "string", "minLength": 3, "maxLength": 800},
        "run_state": {"enum": ["EXECUTED", "NOT_RUN", "SKIPPED"]},
        "outcome": {"enum": ["PASS", "FAIL", "NOT_RUN", "SKIPPED", "HOLD", "UNKNOWN"]},
        "failure_class": {"enum": ["NONE", "INHERITED", "INTRODUCED", "UNKNOWN"]},
        "finding_count": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "scope": {"$ref": "#/$defs/token"}
      }
    },
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "rollback_target", "external_correction", "stale_triggers", "receipt_history"],
      "properties": {
        "method": {"const": "same_path_forward_fix_or_reviewed_git_revert"},
        "rollback_target": {"type": "string", "pattern": "^git:[a-f0-9]{40}$"},
        "external_correction": {"const": "append_corrective_issue_comment"},
        "stale_triggers": {"$ref": "#/$defs/tokens", "minItems": 4},
        "receipt_history": {"const": "append_only"}
      }
    }
  }
}
