{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/governance/briefing_signal.schema.json",
  "title": "briefing_signal",
  "description": "Non-authoritative discovery and routing signal derived from a KFM briefing. A valid signal cannot authorize source activation, repository mutation, proof, release, deployment, publication, or public use.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "signal_id",
    "briefing_date",
    "status",
    "headline",
    "story_type",
    "domains",
    "materiality",
    "geographic_scope",
    "claims",
    "official_source_candidates",
    "existing_kfm_links",
    "proposed_object_families",
    "next_action",
    "permissions",
    "public_use_allowed",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "signal_id": {
      "type": "string",
      "pattern": "^kfm-briefing-[0-9]{4}-[0-9]{2}-[0-9]{2}-[0-9]{3}$"
    },
    "briefing_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "enum": [
        "DISCOVERED",
        "DUPLICATE",
        "NEEDS_VERIFICATION",
        "CONFLICTED",
        "ACCEPTED_FOR_MODELING",
        "IMPLEMENTATION_TRACKED",
        "REJECTED",
        "CLOSED"
      ]
    },
    "headline": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "story_type": {
      "enum": [
        "repository_governance",
        "volatile_advisory",
        "condition_observation",
        "governance_event",
        "funding_project",
        "geospatial_source",
        "regional_development",
        "other"
      ]
    },
    "domains": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$"
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "materiality": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "priority",
        "safety",
        "operational_impact",
        "geospatial_relevance",
        "reuse_value",
        "rationale"
      ],
      "properties": {
        "priority": {
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3",
            "IGNORE"
          ]
        },
        "safety": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "operational_impact": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "geospatial_relevance": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "reuse_value": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024
        }
      }
    },
    "geographic_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identifiers",
        "geometry_ref",
        "geometry_status"
      ],
      "properties": {
        "kind": {
          "enum": [
            "repository",
            "statewide",
            "region",
            "county",
            "municipality",
            "waterbody",
            "watershed",
            "district",
            "point",
            "none"
          ]
        },
        "identifiers": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "uniqueItems": true
        },
        "geometry_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 1024
        },
        "geometry_status": {
          "enum": [
            "resolved",
            "unresolved",
            "not_applicable"
          ]
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      },
      "minItems": 1
    },
    "official_source_candidates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source_candidate"
      },
      "minItems": 1
    },
    "existing_kfm_links": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "issues",
        "paths",
        "object_refs"
      ],
      "properties": {
        "issues": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1
          },
          "uniqueItems": true
        },
        "paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true
        },
        "object_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 512
          },
          "uniqueItems": true
        }
      }
    },
    "proposed_object_families": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_]{1,127}$"
      },
      "uniqueItems": true
    },
    "next_action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "disposition",
        "scope",
        "repository_mutation_allowed"
      ],
      "properties": {
        "disposition": {
          "enum": [
            "UPDATE_EXISTING_ISSUE",
            "OPEN_SOURCE_DISCOVERY_ISSUE",
            "OPEN_OBJECT_MODEL_ISSUE",
            "NO_ACTION"
          ]
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "repository_mutation_allowed": {
          "const": false
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_activation",
        "proof_construction",
        "release",
        "deployment",
        "publication"
      ],
      "properties": {
        "source_activation": {
          "const": false
        },
        "proof_construction": {
          "const": false
        },
        "release": {
          "const": false
        },
        "deployment": {
          "const": false
        },
        "publication": {
          "const": false
        }
      }
    },
    "public_use_allowed": {
      "const": false
    },
    "candidate_payload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "object_family",
        "candidate_state",
        "authority_boundary",
        "attributes"
      ],
      "properties": {
        "object_family": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_]{1,127}$"
        },
        "candidate_state": {
          "enum": [
            "SOURCE_ANNOUNCED",
            "STATUS_UNCONFIRMED",
            "LINKED_BY_AUTHORITY_INDEX",
            "NEEDS_VERIFICATION"
          ]
        },
        "authority_boundary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "attributes": {
          "type": "object"
        }
      }
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "text",
        "truth_label",
        "evidence_refs"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^claim-[0-9]{3}$"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "truth_label": {
          "enum": [
            "CONFIRMED",
            "INFERRED",
            "PROPOSED",
            "UNKNOWN",
            "NEEDS_VERIFICATION",
            "CONFLICTED",
            "EXTERNAL"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          },
          "uniqueItems": true
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "truth_label": {
                "const": "CONFIRMED"
              }
            },
            "required": [
              "truth_label"
            ]
          },
          "then": {
            "properties": {
              "evidence_refs": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "source_candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "authority_name",
        "locator",
        "observed_at",
        "snapshot_status"
      ],
      "properties": {
        "source_kind": {
          "enum": [
            "official_web_page",
            "official_document",
            "repository",
            "github_issue",
            "github_pull_request",
            "other"
          ]
        },
        "authority_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "locator": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2048
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "snapshot_status": {
          "enum": [
            "LOCATOR_ONLY",
            "SNAPSHOT_PENDING",
            "SNAPSHOT_CAPTURED",
            "CONFLICTED",
            "UNAVAILABLE"
          ]
        }
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED",
    "contract_doc": "contracts/governance/briefing_signal.md",
    "fixtures_root": "fixtures/contracts/v1/governance/briefing_signal/",
    "validator": "tools/validators/governance/validate_briefing_signal.py",
    "tests": "tests/governance/test_briefing_signal.py",
    "authority": "non_authoritative_discovery_only"
  }
}
