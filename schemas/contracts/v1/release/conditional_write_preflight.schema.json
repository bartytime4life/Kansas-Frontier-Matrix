{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/release/conditional_write_preflight.schema.json",
  "title": "ConditionalWritePreflightCandidate",
  "description": "Fixture-only optimistic conditional-write preflight. A conforming object proposes, suppresses, conflicts, or holds a write request but emits no request and performs no write, lifecycle transition, release, deployment, publication, or public-use action.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "object_type",
    "profile",
    "execution_mode",
    "intent_id",
    "target",
    "request",
    "upstream",
    "preflight",
    "spec_hash",
    "claims"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "object_type": {"const": "ConditionalWritePreflightCandidate"},
    "profile": {"const": "kfm.release.conditional-write-preflight.v1"},
    "execution_mode": {"const": "FIXTURE_ONLY"},
    "intent_id": {
      "type": "string",
      "pattern": "^kfm:conditional-write-intent:[0-9a-f]{64}$"
    },
    "target": {"$ref": "#/$defs/target"},
    "request": {"$ref": "#/$defs/request"},
    "upstream": {"$ref": "#/$defs/upstream"},
    "preflight": {"$ref": "#/$defs/preflight"},
    "spec_hash": {"$ref": "#/$defs/sha256"},
    "claims": {"$ref": "#/$defs/claims"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bounded_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "\\S"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_ref",
        "operation",
        "observed_state",
        "observed_etag",
        "observed_content_digest"
      ],
      "properties": {
        "target_ref": {"$ref": "#/$defs/bounded_ref"},
        "operation": {
          "type": "string",
          "enum": ["CREATE_IF_ABSENT", "REPLACE_IF_MATCH"]
        },
        "observed_state": {
          "type": "string",
          "enum": ["ABSENT", "PRESENT"]
        },
        "observed_etag": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "observed_content_digest": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {"observed_state": {"const": "ABSENT"}},
            "required": ["observed_state"]
          },
          "then": {
            "properties": {
              "observed_etag": {"type": "null"},
              "observed_content_digest": {"type": "null"}
            }
          }
        },
        {
          "if": {
            "properties": {"observed_state": {"const": "PRESENT"}},
            "required": ["observed_state"]
          },
          "then": {
            "properties": {
              "observed_etag": {"$ref": "#/$defs/sha256"},
              "observed_content_digest": {"$ref": "#/$defs/sha256"}
            }
          }
        }
      ]
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expected_etag",
        "proposed_content_digest",
        "proposed_content_length",
        "content_type",
        "idempotency_key"
      ],
      "properties": {
        "expected_etag": {
          "oneOf": [
            {"$ref": "#/$defs/sha256"},
            {"type": "null"}
          ]
        },
        "proposed_content_digest": {"$ref": "#/$defs/sha256"},
        "proposed_content_length": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1073741824
        },
        "content_type": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "^[A-Za-z0-9!#$&^_.+*-]+/[A-Za-z0-9!#$&^_.+*-]+(?:;[ -~]+)?$"
        },
        "idempotency_key": {"$ref": "#/$defs/sha256"}
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_decision_ref",
        "policy_outcome",
        "review_record_ref",
        "review_state",
        "promotion_decision_ref",
        "promotion_state",
        "release_manifest_candidate_ref",
        "rollback_ref"
      ],
      "properties": {
        "policy_decision_ref": {"$ref": "#/$defs/bounded_ref"},
        "policy_outcome": {
          "type": "string",
          "enum": ["ALLOW", "DENY", "UNKNOWN"]
        },
        "review_record_ref": {"$ref": "#/$defs/bounded_ref"},
        "review_state": {
          "type": "string",
          "enum": ["APPROVED", "PENDING", "REJECTED"]
        },
        "promotion_decision_ref": {"$ref": "#/$defs/bounded_ref"},
        "promotion_state": {
          "type": "string",
          "enum": ["APPROVED", "HELD", "DENIED"]
        },
        "release_manifest_candidate_ref": {
          "oneOf": [
            {"$ref": "#/$defs/bounded_ref"},
            {"type": "null"}
          ]
        },
        "rollback_ref": {
          "oneOf": [
            {"$ref": "#/$defs/bounded_ref"},
            {"type": "null"}
          ]
        }
      }
    },
    "preflight": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "reason_codes",
        "request_headers",
        "condition_fingerprint"
      ],
      "properties": {
        "outcome": {
          "type": "string",
          "enum": ["PROPOSE_WRITE", "NO_ACTION", "CONFLICT", "HOLD"]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "CONDITION_SATISFIED",
              "CONTENT_ALREADY_PRESENT",
              "ETAG_MISMATCH",
              "POLICY_NOT_ALLOWED",
              "PROMOTION_NOT_APPROVED",
              "RELEASE_MANIFEST_MISSING",
              "REVIEW_NOT_APPROVED",
              "ROLLBACK_TARGET_MISSING",
              "TARGET_ABSENT",
              "TARGET_EXISTS"
            ]
          }
        },
        "request_headers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["if_match", "if_none_match"],
          "properties": {
            "if_match": {
              "oneOf": [
                {"$ref": "#/$defs/sha256"},
                {"type": "null"}
              ]
            },
            "if_none_match": {
              "oneOf": [
                {"const": "*"},
                {"type": "null"}
              ]
            }
          }
        },
        "condition_fingerprint": {"$ref": "#/$defs/sha256"}
      }
    },
    "claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "deterministic_preflight",
        "network_accessed",
        "external_state_resolved",
        "upstream_authority_verified",
        "write_request_emitted",
        "write_performed",
        "lifecycle_write_performed",
        "release_created",
        "published",
        "public_use_authorized"
      ],
      "properties": {
        "deterministic_preflight": {"const": true},
        "network_accessed": {"const": false},
        "external_state_resolved": {"const": false},
        "upstream_authority_verified": {"const": false},
        "write_request_emitted": {"const": false},
        "write_performed": {"const": false},
        "lifecycle_write_performed": {"const": false},
        "release_created": {"const": false},
        "published": {"const": false},
        "public_use_authorized": {"const": false}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "target": {
            "properties": {"operation": {"const": "CREATE_IF_ABSENT"}},
            "required": ["operation"]
          }
        },
        "required": ["target"]
      },
      "then": {
        "properties": {
          "request": {
            "properties": {"expected_etag": {"type": "null"}},
            "required": ["expected_etag"]
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "target": {
            "properties": {"operation": {"const": "REPLACE_IF_MATCH"}},
            "required": ["operation"]
          }
        },
        "required": ["target"]
      },
      "then": {
        "properties": {
          "request": {
            "properties": {"expected_etag": {"$ref": "#/$defs/sha256"}},
            "required": ["expected_etag"]
          }
        }
      }
    }
  ],
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "authority": "fixture_preflight_shape_only",
    "contract_doc": "contracts/release/conditional_write_preflight.md",
    "validator": "tools/validators/release/validate_conditional_write_preflight.py",
    "fixtures_root": "fixtures/contracts/v1/release/conditional_write_preflight/"
  }
}
