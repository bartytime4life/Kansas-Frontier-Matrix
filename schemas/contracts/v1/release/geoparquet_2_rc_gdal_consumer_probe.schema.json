{
  "$defs": {
    "carrier_result": {
      "additionalProperties": false,
      "properties": {
        "coordinates": {
          "items": {
            "oneOf": [
              {
                "items": { "type": "number" },
                "maxItems": 2,
                "minItems": 2,
                "type": "array"
              },
              { "type": "null" }
            ]
          },
          "maxItems": 4,
          "type": "array"
        },
        "command": {
          "items": { "minLength": 1, "type": "string" },
          "minItems": 1,
          "type": "array"
        },
        "feature_ids": {
          "items": { "type": "integer" },
          "maxItems": 4,
          "type": "array"
        },
        "geometry_types": {
          "items": { "type": ["string", "null"] },
          "maxItems": 4,
          "type": "array"
        },
        "labels": {
          "items": { "type": "string" },
          "maxItems": 4,
          "type": "array"
        },
        "path": {
          "pattern": "^[A-Za-z0-9._-]+\\.parquet$",
          "type": "string"
        },
        "read_status": {
          "enum": ["PASS", "NOT_SUPPORTED", "FAIL"]
        },
        "row_count": {
          "maximum": 4,
          "minimum": 0,
          "type": ["integer", "null"]
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "stderr_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "stdout_sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "command",
        "read_status",
        "row_count",
        "feature_ids",
        "labels",
        "geometry_types",
        "coordinates",
        "stdout_sha256",
        "stderr_sha256"
      ],
      "type": "object"
    }
  },
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/release/geoparquet_2_rc_gdal_consumer_probe.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "candidate_version": { "const": "2.0.0-rc.1" },
    "carriers": {
      "additionalProperties": false,
      "properties": {
        "geoparquet_1_1": { "$ref": "#/$defs/carrier_result" },
        "geoparquet_2_rc_geometry": { "$ref": "#/$defs/carrier_result" }
      },
      "required": ["geoparquet_1_1", "geoparquet_2_rc_geometry"],
      "type": "object"
    },
    "checks": {
      "additionalProperties": false,
      "properties": {
        "crs84_same_crs_transform": {
          "enum": ["PASS", "NOT_SUPPORTED", "FAIL", "ERROR"]
        },
        "gdal_distribution_authenticated": { "enum": ["PASS", "ERROR"] },
        "gdal_producer_route": { "const": "NOT_RUN" },
        "geospatial_row_group_pruning": { "const": "NOT_RUN" },
        "legacy_1_1_consumer_read": {
          "enum": ["PASS", "NOT_SUPPORTED", "FAIL", "ERROR"]
        },
        "parquet_driver": {
          "enum": ["PASS", "NOT_SUPPORTED", "ERROR"]
        },
        "pyarrow_to_gdal_consumer_read": {
          "enum": ["PASS", "NOT_SUPPORTED", "FAIL", "ERROR"]
        },
        "rc_geometry_consumer_read": {
          "enum": ["PASS", "NOT_SUPPORTED", "FAIL", "ERROR"]
        }
      },
      "required": [
        "gdal_distribution_authenticated",
        "parquet_driver",
        "legacy_1_1_consumer_read",
        "rc_geometry_consumer_read",
        "crs84_same_crs_transform",
        "pyarrow_to_gdal_consumer_read",
        "gdal_producer_route",
        "geospatial_row_group_pruning"
      ],
      "type": "object"
    },
    "declared_default": { "const": "1.1.0" },
    "governance": {
      "additionalProperties": false,
      "properties": {
        "adoption_authorized": { "const": false },
        "default_changed": { "const": false },
        "deployment_authorized": { "const": false },
        "migration_authorized": { "const": false },
        "publication_authorized": { "const": false },
        "release_authorized": { "const": false }
      },
      "required": [
        "default_changed",
        "adoption_authorized",
        "migration_authorized",
        "release_authorized",
        "deployment_authorized",
        "publication_authorized"
      ],
      "type": "object"
    },
    "outcome": { "enum": ["PARTIAL", "HOLD", "FAIL", "ERROR"] },
    "profile": { "const": "kfm.geoparquet-2-rc-gdal-consumer-probe.v1" },
    "reason_codes": {
      "items": { "pattern": "^[A-Z0-9_]+$", "type": "string" },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "scope": { "const": "pyarrow-25-producer-to-gdal-3.13.2-consumer-read" },
    "source_carrier_manifest": {
      "additionalProperties": false,
      "properties": {
        "outcome": { "const": "PARTIAL" },
        "path": { "const": "manifest.json" },
        "profile": { "const": "kfm.geoparquet-2-rc-pyarrow-carrier-probe.v1" },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        }
      },
      "required": ["path", "sha256", "profile", "outcome"],
      "type": "object"
    },
    "toolchain": {
      "additionalProperties": false,
      "properties": {
        "gdal": { "const": "3.13.2" },
        "gdal_source_tag_commit": {
          "const": "b40672525acf3f5c4f29d8541aa7dcff1e18eb92"
        },
        "gdal_version_output": {
          "type": ["string", "null"]
        },
        "image_id": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": ["string", "null"]
        },
        "image_index_sha256": {
          "const": "sha256:6960891693c3463b8e2b498a915c7c9b10eeb93f155d5be14c2e3ffbede9fbb1"
        },
        "image_platform": { "const": "linux/amd64" },
        "image_platform_manifest_sha256": {
          "const": "sha256:6611b649465826c623869861447be58cd75962da2312d8ab656a1f4e32acf98d"
        },
        "image_reference": {
          "const": "ghcr.io/osgeo/gdal:alpine-normal-3.13.2@sha256:6960891693c3463b8e2b498a915c7c9b10eeb93f155d5be14c2e3ffbede9fbb1"
        },
        "repo_digests": {
          "items": { "minLength": 1, "type": "string" },
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "gdal",
        "gdal_version_output",
        "gdal_source_tag_commit",
        "image_reference",
        "image_index_sha256",
        "image_platform",
        "image_platform_manifest_sha256",
        "image_id",
        "repo_digests"
      ],
      "type": "object"
    }
  },
  "required": [
    "profile",
    "declared_default",
    "candidate_version",
    "scope",
    "source_carrier_manifest",
    "toolchain",
    "carriers",
    "checks",
    "outcome",
    "reason_codes",
    "governance"
  ],
  "title": "KFM GeoParquet 2.0 RC GDAL Consumer Probe",
  "type": "object"
}
