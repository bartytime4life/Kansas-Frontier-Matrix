{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/release/geoparquet_2_rc_compatibility_assessment.schema.json",
  "title": "GeoParquet 2.0 RC Compatibility Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "candidate_version",
    "declared_default",
    "release_kind",
    "upstream_commit",
    "format_expectations",
    "engine_checks",
    "governance",
    "outcome"
  ],
  "properties": {
    "profile": {"type": "string", "minLength": 1},
    "candidate_version": {"type": "string", "minLength": 1},
    "declared_default": {"type": "string", "minLength": 1},
    "release_kind": {"enum": ["RELEASE_CANDIDATE", "FINAL"]},
    "upstream_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "format_expectations": {"$ref": "#/$defs/format_expectations"},
    "engine_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["GDAL", "DUCKDB", "SEDONA"],
      "properties": {
        "GDAL": {"$ref": "#/$defs/gdal"},
        "DUCKDB": {"$ref": "#/$defs/duckdb"},
        "SEDONA": {"$ref": "#/$defs/sedona"}
      }
    },
    "governance": {"$ref": "#/$defs/governance"},
    "outcome": {"enum": ["READY", "HOLD", "ERROR"]}
  },
  "$defs": {
    "status": {"enum": ["PASS", "FAIL", "NOT_RUN"]},
    "common_engine": {
      "type": "object",
      "properties": {
        "tool_version": {"type": "string", "minLength": 1},
        "pinned": {"type": "boolean"},
        "native_type_inspection": {"$ref": "#/$defs/status"},
        "crs_round_trip": {"$ref": "#/$defs/status"},
        "legacy_1_1_read": {"$ref": "#/$defs/status"},
        "unknown_metadata_preservation": {"$ref": "#/$defs/status"},
        "unsupported_assumption_behavior": {"enum": ["REJECT", "WARN", "UNKNOWN"]},
        "evidence_ref": {"type": "string", "minLength": 1}
      }
    },
    "gdal": {
      "allOf": [
        {"$ref": "#/$defs/common_engine"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_version", "pinned", "native_geometry_write", "native_geometry_read",
            "native_type_inspection", "crs_round_trip", "row_group_spatial_statistics",
            "legacy_1_1_read", "unknown_metadata_preservation",
            "unsupported_assumption_behavior", "evidence_ref"
          ],
          "properties": {
            "tool_version": {"type": "string", "minLength": 1},
            "pinned": {"type": "boolean"},
            "native_geometry_write": {"$ref": "#/$defs/status"},
            "native_geometry_read": {"$ref": "#/$defs/status"},
            "native_type_inspection": {"$ref": "#/$defs/status"},
            "crs_round_trip": {"$ref": "#/$defs/status"},
            "row_group_spatial_statistics": {"$ref": "#/$defs/status"},
            "legacy_1_1_read": {"$ref": "#/$defs/status"},
            "unknown_metadata_preservation": {"$ref": "#/$defs/status"},
            "unsupported_assumption_behavior": {"enum": ["REJECT", "WARN", "UNKNOWN"]},
            "evidence_ref": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "duckdb": {
      "allOf": [
        {"$ref": "#/$defs/common_engine"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_version", "pinned", "native_geometry_read", "native_type_inspection",
            "crs_round_trip", "row_group_spatial_pruning", "legacy_1_1_read",
            "unknown_metadata_preservation", "unsupported_assumption_behavior", "evidence_ref"
          ],
          "properties": {
            "tool_version": {"type": "string", "minLength": 1},
            "pinned": {"type": "boolean"},
            "native_geometry_read": {"$ref": "#/$defs/status"},
            "native_type_inspection": {"$ref": "#/$defs/status"},
            "crs_round_trip": {"$ref": "#/$defs/status"},
            "row_group_spatial_pruning": {"$ref": "#/$defs/status"},
            "legacy_1_1_read": {"$ref": "#/$defs/status"},
            "unknown_metadata_preservation": {"$ref": "#/$defs/status"},
            "unsupported_assumption_behavior": {"enum": ["REJECT", "WARN", "UNKNOWN"]},
            "evidence_ref": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "sedona": {
      "allOf": [
        {"$ref": "#/$defs/common_engine"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "tool_version", "pinned", "workflow_round_trip", "native_type_inspection",
            "crs_round_trip", "row_group_spatial_pruning", "legacy_1_1_read",
            "unknown_metadata_preservation", "unsupported_assumption_behavior", "evidence_ref"
          ],
          "properties": {
            "tool_version": {"type": "string", "minLength": 1},
            "pinned": {"type": "boolean"},
            "workflow_round_trip": {"$ref": "#/$defs/status"},
            "native_type_inspection": {"$ref": "#/$defs/status"},
            "crs_round_trip": {"$ref": "#/$defs/status"},
            "row_group_spatial_pruning": {"$ref": "#/$defs/status"},
            "legacy_1_1_read": {"$ref": "#/$defs/status"},
            "unknown_metadata_preservation": {"$ref": "#/$defs/status"},
            "unsupported_assumption_behavior": {"enum": ["REJECT", "WARN", "UNKNOWN"]},
            "evidence_ref": {"type": "string", "minLength": 1}
          }
        }
      ]
    },
    "format_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_type", "physical_type", "encoding", "root_geometry",
        "parquet_crs_source_of_truth", "geo_metadata_crs_inline_projjson",
        "crs_semantically_equivalent", "parquet_native_spatial_statistics",
        "covering_bbox_column_required", "legacy_1_1_fixtures_preserved"
      ],
      "properties": {
        "logical_type": {"enum": ["GEOMETRY", "GEOGRAPHY"]},
        "physical_type": {"enum": ["BYTE_ARRAY", "OTHER"]},
        "encoding": {"enum": ["WKB", "OTHER"]},
        "root_geometry": {"type": "boolean"},
        "parquet_crs_source_of_truth": {"type": "boolean"},
        "geo_metadata_crs_inline_projjson": {"type": "boolean"},
        "crs_semantically_equivalent": {"type": "boolean"},
        "parquet_native_spatial_statistics": {"type": "boolean"},
        "covering_bbox_column_required": {"type": "boolean"},
        "legacy_1_1_fixtures_preserved": {"type": "boolean"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_changed", "adoption_authorized", "migration_authorized",
        "release_authorized", "publication_authorized"
      ],
      "properties": {
        "default_changed": {"type": "boolean"},
        "adoption_authorized": {"type": "boolean"},
        "migration_authorized": {"type": "boolean"},
        "release_authorized": {"type": "boolean"},
        "publication_authorized": {"type": "boolean"}
      }
    }
  }
}
