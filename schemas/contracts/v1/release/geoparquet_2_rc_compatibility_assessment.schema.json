{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/release/geoparquet_2_rc_compatibility_assessment.schema.json",
  "title": "GeoParquet 2.0 RC Compatibility Assessment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile",
    "candidate_version",
    "declared_default",
    "release_kind",
    "upstream_commit",
    "format_expectations",
    "toolchain_matrix",
    "inspector",
    "governance",
    "outcome"
  ],
  "properties": {
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "candidate_version": {
      "type": "string",
      "minLength": 1
    },
    "declared_default": {
      "type": "string",
      "minLength": 1
    },
    "release_kind": {
      "enum": [
        "RELEASE_CANDIDATE",
        "FINAL"
      ]
    },
    "upstream_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "format_expectations": {
      "$ref": "#/$defs/format_expectations"
    },
    "toolchain_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GDAL",
        "DUCKDB",
        "SEDONA_SPARK",
        "SEDONA_DB"
      ],
      "properties": {
        "GDAL": {
          "$ref": "#/$defs/gdal"
        },
        "DUCKDB": {
          "$ref": "#/$defs/duckdb"
        },
        "SEDONA_SPARK": {
          "$ref": "#/$defs/sedona_spark"
        },
        "SEDONA_DB": {
          "$ref": "#/$defs/sedona_db"
        }
      }
    },
    "inspector": {
      "$ref": "#/$defs/inspector"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "outcome": {
      "enum": [
        "READY",
        "HOLD",
        "ERROR"
      ]
    }
  },
  "$defs": {
    "status": {
      "enum": [
        "PASS",
        "FAIL",
        "NOT_RUN"
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gdal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_version",
        "source_ref",
        "artifact_digest",
        "pinned",
        "native_type_inspection",
        "crs_round_trip",
        "legacy_1_1_read",
        "unknown_metadata_preservation",
        "unsupported_assumption_behavior",
        "evidence_ref",
        "native_geometry_write",
        "native_geometry_read",
        "row_group_spatial_statistics"
      ],
      "properties": {
        "tool_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "$ref": "#/$defs/sha256"
        },
        "pinned": {
          "type": "boolean"
        },
        "native_type_inspection": {
          "$ref": "#/$defs/status"
        },
        "crs_round_trip": {
          "$ref": "#/$defs/status"
        },
        "legacy_1_1_read": {
          "$ref": "#/$defs/status"
        },
        "unknown_metadata_preservation": {
          "$ref": "#/$defs/status"
        },
        "unsupported_assumption_behavior": {
          "enum": [
            "REJECT",
            "WARN",
            "UNKNOWN"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^(fixture|repo|receipt|artifact|upstream):.+"
        },
        "native_geometry_write": {
          "$ref": "#/$defs/status"
        },
        "native_geometry_read": {
          "$ref": "#/$defs/status"
        },
        "row_group_spatial_statistics": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "duckdb": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_version",
        "source_ref",
        "artifact_digest",
        "pinned",
        "native_type_inspection",
        "crs_round_trip",
        "legacy_1_1_read",
        "unknown_metadata_preservation",
        "unsupported_assumption_behavior",
        "evidence_ref",
        "extension_version",
        "extension_digest",
        "native_geometry_read",
        "row_group_spatial_pruning"
      ],
      "properties": {
        "tool_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "$ref": "#/$defs/sha256"
        },
        "pinned": {
          "type": "boolean"
        },
        "native_type_inspection": {
          "$ref": "#/$defs/status"
        },
        "crs_round_trip": {
          "$ref": "#/$defs/status"
        },
        "legacy_1_1_read": {
          "$ref": "#/$defs/status"
        },
        "unknown_metadata_preservation": {
          "$ref": "#/$defs/status"
        },
        "unsupported_assumption_behavior": {
          "enum": [
            "REJECT",
            "WARN",
            "UNKNOWN"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^(fixture|repo|receipt|artifact|upstream):.+"
        },
        "extension_version": {
          "type": "string",
          "pattern": "^spatial@[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "extension_digest": {
          "$ref": "#/$defs/sha256"
        },
        "native_geometry_read": {
          "$ref": "#/$defs/status"
        },
        "row_group_spatial_pruning": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "sedona_spark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_version",
        "source_ref",
        "artifact_digest",
        "pinned",
        "native_type_inspection",
        "crs_round_trip",
        "legacy_1_1_read",
        "unknown_metadata_preservation",
        "unsupported_assumption_behavior",
        "evidence_ref",
        "spark_version",
        "spark_source_ref",
        "spark_distribution_digest",
        "java_major",
        "scala_version",
        "parquet_java_version",
        "workflow_round_trip",
        "row_group_spatial_pruning"
      ],
      "properties": {
        "tool_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "$ref": "#/$defs/sha256"
        },
        "pinned": {
          "type": "boolean"
        },
        "native_type_inspection": {
          "$ref": "#/$defs/status"
        },
        "crs_round_trip": {
          "$ref": "#/$defs/status"
        },
        "legacy_1_1_read": {
          "$ref": "#/$defs/status"
        },
        "unknown_metadata_preservation": {
          "$ref": "#/$defs/status"
        },
        "unsupported_assumption_behavior": {
          "enum": [
            "REJECT",
            "WARN",
            "UNKNOWN"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^(fixture|repo|receipt|artifact|upstream):.+"
        },
        "spark_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "spark_source_ref": {
          "type": "string",
          "minLength": 1
        },
        "spark_distribution_digest": {
          "$ref": "#/$defs/sha256"
        },
        "java_major": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "scala_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "parquet_java_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "workflow_round_trip": {
          "$ref": "#/$defs/status"
        },
        "row_group_spatial_pruning": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "sedona_db": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_version",
        "source_ref",
        "artifact_digest",
        "pinned",
        "native_type_inspection",
        "crs_round_trip",
        "legacy_1_1_read",
        "unknown_metadata_preservation",
        "unsupported_assumption_behavior",
        "evidence_ref",
        "workflow_round_trip",
        "native_geometry_write",
        "native_geography_write",
        "row_group_spatial_pruning"
      ],
      "properties": {
        "tool_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][0-9A-Za-z.-]+)?$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "$ref": "#/$defs/sha256"
        },
        "pinned": {
          "type": "boolean"
        },
        "native_type_inspection": {
          "$ref": "#/$defs/status"
        },
        "crs_round_trip": {
          "$ref": "#/$defs/status"
        },
        "legacy_1_1_read": {
          "$ref": "#/$defs/status"
        },
        "unknown_metadata_preservation": {
          "$ref": "#/$defs/status"
        },
        "unsupported_assumption_behavior": {
          "enum": [
            "REJECT",
            "WARN",
            "UNKNOWN"
          ]
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^(fixture|repo|receipt|artifact|upstream):.+"
        },
        "workflow_round_trip": {
          "$ref": "#/$defs/status"
        },
        "native_geometry_write": {
          "$ref": "#/$defs/status"
        },
        "native_geography_write": {
          "$ref": "#/$defs/status"
        },
        "row_group_spatial_pruning": {
          "$ref": "#/$defs/status"
        }
      }
    },
    "inspector": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tool_name",
        "tool_version",
        "source_ref",
        "artifact_digest",
        "pinned",
        "logical_type_footer_inspection",
        "row_group_statistics_inspection",
        "evidence_ref"
      ],
      "properties": {
        "tool_name": {
          "enum": [
            "PYARROW"
          ]
        },
        "tool_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "artifact_digest": {
          "$ref": "#/$defs/sha256"
        },
        "pinned": {
          "type": "boolean"
        },
        "logical_type_footer_inspection": {
          "$ref": "#/$defs/status"
        },
        "row_group_statistics_inspection": {
          "$ref": "#/$defs/status"
        },
        "evidence_ref": {
          "type": "string",
          "pattern": "^(fixture|repo|receipt|artifact|upstream):.+"
        }
      }
    },
    "format_expectations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_type",
        "physical_type",
        "encoding",
        "root_geometry",
        "parquet_crs_source_of_truth",
        "geo_metadata_crs_inline_projjson",
        "crs_semantically_equivalent",
        "parquet_native_spatial_statistics",
        "covering_bbox_column_required",
        "legacy_1_1_fixtures_preserved"
      ],
      "properties": {
        "logical_type": {
          "enum": [
            "GEOMETRY",
            "GEOGRAPHY"
          ]
        },
        "physical_type": {
          "enum": [
            "BYTE_ARRAY",
            "OTHER"
          ]
        },
        "encoding": {
          "enum": [
            "WKB",
            "OTHER"
          ]
        },
        "root_geometry": {
          "type": "boolean"
        },
        "parquet_crs_source_of_truth": {
          "type": "boolean"
        },
        "geo_metadata_crs_inline_projjson": {
          "type": "boolean"
        },
        "crs_semantically_equivalent": {
          "type": "boolean"
        },
        "parquet_native_spatial_statistics": {
          "type": "boolean"
        },
        "covering_bbox_column_required": {
          "type": "boolean"
        },
        "legacy_1_1_fixtures_preserved": {
          "type": "boolean"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "default_changed",
        "adoption_authorized",
        "migration_authorized",
        "release_authorized",
        "publication_authorized"
      ],
      "properties": {
        "default_changed": {
          "type": "boolean"
        },
        "adoption_authorized": {
          "type": "boolean"
        },
        "migration_authorized": {
          "type": "boolean"
        },
        "release_authorized": {
          "type": "boolean"
        },
        "publication_authorized": {
          "type": "boolean"
        }
      }
    }
  }
}
