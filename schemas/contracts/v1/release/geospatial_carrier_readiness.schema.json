{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/release/geospatial_carrier_readiness.schema.json",
  "title": "GeospatialCarrierReadinessCheck",
  "type": "object",
  "additionalProperties": false,
  "required": ["object_type", "schema_version", "profile", "network_access", "carrier_kind", "artifact", "bindings", "carrier", "governance"],
  "properties": {
    "object_type": {"const": "GeospatialCarrierReadinessCheck"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.geospatial-carrier-readiness.v1"},
    "network_access": {"const": "forbidden"},
    "carrier_kind": {"enum": ["COG", "MVT", "GEOPARQUET"]},
    "artifact": {"$ref": "#/$defs/artifact"},
    "bindings": {"$ref": "#/$defs/bindings"},
    "carrier": {"type": "object"},
    "governance": {"$ref": "#/$defs/governance"}
  },
  "allOf": [
    {"if": {"properties": {"carrier_kind": {"const": "COG"}}}, "then": {"properties": {"carrier": {"$ref": "#/$defs/cog"}}}},
    {"if": {"properties": {"carrier_kind": {"const": "MVT"}}}, "then": {"properties": {"carrier": {"$ref": "#/$defs/mvt"}}}},
    {"if": {"properties": {"carrier_kind": {"const": "GEOPARQUET"}}}, "then": {"properties": {"carrier": {"$ref": "#/$defs/geoparquet"}}}}
  ],
  "$defs": {
    "ref": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^\\S(?:.*\\S)?$"},
    "sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_ref", "digest", "media_type", "file_name", "immutable"],
      "properties": {
        "artifact_ref": {"$ref": "#/$defs/ref"},
        "digest": {"$ref": "#/$defs/sha256"},
        "media_type": {"type": "string", "minLength": 3, "maxLength": 256, "pattern": "^[^\\s/]+/[^\\s]+$"},
        "file_name": {"type": "string", "minLength": 1, "maxLength": 255, "pattern": "^[^/\\\\]+$"},
        "immutable": {"type": "boolean"}
      }
    },
    "bindings": {
      "type": "object", "additionalProperties": false,
      "required": ["source_descriptor_ref", "run_receipt_ref", "stac_item_ref"],
      "properties": {
        "source_descriptor_ref": {"$ref": "#/$defs/ref"},
        "run_receipt_ref": {"$ref": "#/$defs/ref"},
        "stac_item_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "governance": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_created", "evidence_closure_claimed", "policy_evaluated", "promotion_authorized", "release_authorized", "publication_authorized", "public_use_allowed", "release_ref"],
      "properties": {
        "authority_created": {"const": false},
        "evidence_closure_claimed": {"const": false},
        "policy_evaluated": {"const": false},
        "promotion_authorized": {"const": false},
        "release_authorized": {"const": false},
        "publication_authorized": {"const": false},
        "public_use_allowed": {"const": false},
        "release_ref": {"type": "null"}
      }
    },
    "cog": {
      "type": "object", "additionalProperties": false,
      "required": ["width", "height", "internal_tiling", "block_width", "block_height", "overview_count", "compression", "crs", "nodata_policy", "range_read_supported", "stac_extensions"],
      "properties": {
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "internal_tiling": {"type": "boolean"},
        "block_width": {"type": "integer", "minimum": 64, "maximum": 1024},
        "block_height": {"type": "integer", "minimum": 64, "maximum": 1024},
        "overview_count": {"type": "integer", "minimum": 0},
        "compression": {"enum": ["DEFLATE", "ZSTD", "LZW", "JPEG"]},
        "crs": {"type": "string", "minLength": 1},
        "nodata_policy": {"enum": ["EXPLICIT_NODATA", "INTERNAL_MASK"]},
        "range_read_supported": {"type": "boolean"},
        "stac_extensions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["datacube", "projection", "raster"]}}
      }
    },
    "mvt": {
      "type": "object", "additionalProperties": false,
      "required": ["mvt_version", "extent", "tile_scheme", "container_kind", "source_layer", "manifest_source_layer", "style_source_layers", "stable_feature_ids", "source_ref_attribute", "attribute_whitelist", "encoded_attributes", "sensitive_attributes", "max_tile_bytes", "geometry_drop_count", "area_drift_pct", "area_drift_limit_pct", "tiler_parameters_hash", "range_read_supported"],
      "properties": {
        "mvt_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"},
        "extent": {"type": "integer", "minimum": 1, "maximum": 16384},
        "tile_scheme": {"enum": ["XYZ", "TMS"]},
        "container_kind": {"enum": ["PMTILES", "MVT_STANDALONE"]},
        "source_layer": {"$ref": "#/$defs/ref"},
        "manifest_source_layer": {"$ref": "#/$defs/ref"},
        "style_source_layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "stable_feature_ids": {"type": "boolean"},
        "source_ref_attribute": {"type": "boolean"},
        "attribute_whitelist": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "encoded_attributes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "sensitive_attributes": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "max_tile_bytes": {"type": "integer", "minimum": 0},
        "geometry_drop_count": {"type": "integer", "minimum": 0},
        "area_drift_pct": {"type": "number", "minimum": 0},
        "area_drift_limit_pct": {"type": "number", "minimum": 0},
        "tiler_parameters_hash": {"$ref": "#/$defs/sha256"},
        "range_read_supported": {"type": "boolean"}
      }
    },
    "geoparquet": {
      "type": "object", "additionalProperties": false,
      "required": ["format_version", "geometry_column", "root_geometry_column", "encoding", "crs_format", "explicit_crs", "geometry_types", "stable_row_grouping", "deterministic_ordering", "null_policy", "bbox_covering", "unknown_metadata_preserved", "numeric_unit_coverage"],
      "properties": {
        "format_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
        "geometry_column": {"$ref": "#/$defs/ref"},
        "root_geometry_column": {"type": "boolean"},
        "encoding": {"enum": ["WKB", "GEOARROW"]},
        "crs_format": {"enum": ["PROJJSON", "NONE"]},
        "explicit_crs": {"type": "boolean"},
        "geometry_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/ref"}},
        "stable_row_grouping": {"type": "boolean"},
        "deterministic_ordering": {"type": "boolean"},
        "null_policy": {"enum": ["NULL_ONLY", "NAN_ALLOWED", "SENTINEL_ALLOWED"]},
        "bbox_covering": {"type": "boolean"},
        "unknown_metadata_preserved": {"type": "boolean"},
        "numeric_unit_coverage": {"type": "boolean"}
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "contract_doc": "contracts/release/geospatial_carrier_readiness.md",
    "validator": "tools/validators/release/validate_geospatial_carrier_readiness.py",
    "fixtures": "fixtures/contracts/v1/release/geospatial_carrier_readiness/cases.json",
    "authority": "metadata_preflight_only",
    "non_effects": ["no_binary_validation", "no_source_resolution", "no_policy_evaluation", "no_promotion", "no_release", "no_publication"]
  }
}
