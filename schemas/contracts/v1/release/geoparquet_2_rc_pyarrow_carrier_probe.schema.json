          "type": "object"
        },
        "path": {
          "pattern": "^[A-Za-z0-9._-]+\\.parquet$",
          "type": "string"
        },
        "row_count": {
          "const": 4
        },
        "row_group_count": {
          "const": 2
        },
        "sha256": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "type": "string"
        },
        "size_bytes": {
          "minimum": 1,
          "type": "integer"
        },
        "unknown_metadata_preserved": {
          "const": true
        }
