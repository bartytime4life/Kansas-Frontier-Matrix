{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/release/tile_delivery_strategy_assessment.schema.json",
  "title": "TileDeliveryStrategyAssessment",
  "description": "Fixture-only, no-network assessment of a declared PMTiles, XYZ, Martin/PostGIS, or local MBTiles delivery strategy without hosting, release, deployment, publication, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "assessment_id",
    "assessment_state",
    "subject_ref",
    "subject_spec_hash",
    "declaration",
    "controls",
    "assessment",
    "authority",
    "limitations",
    "spec_hash"
  ],
  "properties": {
    "object_type": { "const": "TileDeliveryStrategyAssessment" },
    "schema_version": { "const": "1.0.0" },
    "profile": { "const": "kfm.release.tile-delivery-strategy.fixture.v1" },
    "assessment_id": {
      "type": "string",
      "pattern": "^kfm:tile-delivery-strategy:[a-f0-9]{24}$"
    },
    "assessment_state": { "enum": ["COMPLETE", "ERROR"] },
    "subject_ref": { "$ref": "#/$defs/ref" },
    "subject_spec_hash": { "$ref": "#/$defs/sha256" },
    "declaration": { "$ref": "#/$defs/declaration" },
    "controls": { "$ref": "#/$defs/controls" },
    "assessment": { "$ref": "#/$defs/assessment" },
    "authority": { "$ref": "#/$defs/authority" },
    "limitations": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "fixture_only",
          "no_network_artifact_service_or_database_verification",
          "no_rights_sensitivity_policy_or_review_authority",
          "no_hosting_cache_release_or_deployment_effect",
          "no_publication_or_public_use"
        ]
      }
    },
    "spec_hash": { "$ref": "#/$defs/sha256" }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "pattern": "^kfm://[a-z][a-z0-9-]*/[A-Za-z0-9][A-Za-z0-9._~:/@-]{2,255}$"
    },
    "nullable_ref": {
      "oneOf": [
        { "$ref": "#/$defs/ref" },
        { "type": "null" }
      ]
    },
    "nullable_strategy": {
      "oneOf": [
        {
          "enum": [
            "PMTILES_ARCHIVE",
            "XYZ_SERVICE",
            "MARTIN_POSTGIS",
            "MBTILES_LOCAL"
          ]
        },
        { "type": "null" }
      ]
    },
    "declaration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "selected_strategy",
        "update_pattern",
        "audience",
        "public_safe_input",
        "immutable_versioned_artifact",
        "range_hosting_ready",
        "per_tile_invalidation_required",
        "server_mediation_required",
        "postgis_slicing_required",
        "offline_required",
        "access_control_required"
      ],
      "properties": {
        "selected_strategy": {
          "enum": [
            "PMTILES_ARCHIVE",
            "XYZ_SERVICE",
            "MARTIN_POSTGIS",
            "MBTILES_LOCAL"
          ]
        },
        "update_pattern": {
          "enum": [
            "IMMUTABLE_SNAPSHOT",
            "APPEND_ONLY_VERSIONED",
            "PARTIAL_MUTATION",
            "DYNAMIC_QUERY"
          ]
        },
        "audience": { "enum": ["PUBLIC", "STEWARD", "LOCAL"] },
        "public_safe_input": { "type": "boolean" },
        "immutable_versioned_artifact": { "type": "boolean" },
        "range_hosting_ready": { "type": "boolean" },
        "per_tile_invalidation_required": { "type": "boolean" },
        "server_mediation_required": { "type": "boolean" },
        "postgis_slicing_required": { "type": "boolean" },
        "offline_required": { "type": "boolean" },
        "access_control_required": { "type": "boolean" }
      }
    },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tile_artifact_manifest_ref",
        "map_service_protocol_assessment_ref",
        "cache_policy_ref",
        "rights_assessment_ref",
        "sensitivity_assessment_ref",
        "correction_plan_ref"
      ],
      "properties": {
        "tile_artifact_manifest_ref": { "$ref": "#/$defs/nullable_ref" },
        "map_service_protocol_assessment_ref": { "$ref": "#/$defs/nullable_ref" },
        "cache_policy_ref": { "$ref": "#/$defs/nullable_ref" },
        "rights_assessment_ref": { "$ref": "#/$defs/ref" },
        "sensitivity_assessment_ref": { "$ref": "#/$defs/ref" },
        "correction_plan_ref": { "$ref": "#/$defs/ref" }
      }
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "recommended_strategy",
        "reason_codes",
        "review_required",
        "execution_authorized"
      ],
      "properties": {
        "outcome": { "enum": ["PASS", "HOLD", "DENY", "ERROR"] },
        "recommended_strategy": { "$ref": "#/$defs/nullable_strategy" },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "CACHE_POLICY_REF_REQUIRED",
              "MARTIN_MEDIATION_NEED_REQUIRED",
              "MBTILES_LOCAL_REQUIREMENTS_MISSING",
              "MBTILES_PUBLIC_DELIVERY_DENIED",
              "TILE_ARTIFACT_MANIFEST_REQUIRED",
              "PMTILES_IMMUTABILITY_REQUIRED",
              "PMTILES_RANGE_HOSTING_UNREADY",
              "PUBLIC_ACCESS_CONTROL_CONFLICT",
              "PUBLIC_UNSAFE_INPUT_DENIED",
              "SERVICE_PROTOCOL_ASSESSMENT_REQUIRED",
              "STATIC_DELIVERY_BYPASSES_MEDIATION",
              "STRATEGY_COHERENT",
              "STRATEGY_MISMATCH",
              "STRATEGY_UNRESOLVED",
              "VALIDATOR_ERROR",
              "XYZ_INVALIDATION_REQUIREMENT_MISSING"
            ]
          }
        },
        "review_required": { "const": true },
        "execution_authorized": { "const": false }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_attempted",
        "service_activated",
        "artifact_hosted",
        "database_queried",
        "cache_mutated",
        "release_authority",
        "deployment_authority",
        "publication_authority",
        "public_use_authority"
      ],
      "properties": {
        "network_attempted": { "const": false },
        "service_activated": { "const": false },
        "artifact_hosted": { "const": false },
        "database_queried": { "const": false },
        "cache_mutated": { "const": false },
        "release_authority": { "const": false },
        "deployment_authority": { "const": false },
        "publication_authority": { "const": false },
        "public_use_authority": { "const": false }
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "contract_doc": "contracts/release/tile_delivery_strategy_assessment.md",
    "fixtures": "fixtures/contracts/v1/release/tile_delivery_strategy_assessment/cases.json",
    "validator": "tools/validators/release/validate_tile_delivery_strategy_assessment.py",
    "tests": "tests/release/test_tile_delivery_strategy_assessment.py",
    "authority": "NONE"
  }
}
