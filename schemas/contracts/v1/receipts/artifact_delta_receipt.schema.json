{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/receipts/artifact_delta_receipt.schema.json",
  "title": "ArtifactDeltaReceiptCandidate",
  "description": "Fixture-first KFM process-memory candidate binding before and after artifact revisions, policy/review metadata, rollback or correction references, and declared attestation metadata. Shape and local consistency only; no cryptographic verification, promotion, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "receipt_id",
    "recorded_at",
    "change_kind",
    "before",
    "after",
    "decision",
    "review",
    "attestation",
    "rollback_target_ref",
    "correction_notice_ref",
    "canonicalization",
    "governance"
  ],
  "properties": {
    "object_type": {
      "const": "ArtifactDeltaReceiptCandidate"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^artifact-delta-receipt:[a-z0-9][a-z0-9_.:-]{7,240}$"
    },
    "recorded_at": {
      "$ref": "#/$defs/aware_datetime"
    },
    "change_kind": {
      "type": "string",
      "enum": [
        "PROMOTION",
        "CORRECTION",
        "ROLLBACK",
        "SUPERSESSION"
      ]
    },
    "before": {
      "$ref": "#/$defs/revision_snapshot"
    },
    "after": {
      "$ref": "#/$defs/revision_snapshot"
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "review": {
      "$ref": "#/$defs/review"
    },
    "attestation": {
      "$ref": "#/$defs/attestation"
    },
    "rollback_target_ref": {
      "$ref": "#/$defs/nullable_ref"
    },
    "correction_notice_ref": {
      "$ref": "#/$defs/nullable_ref"
    },
    "canonicalization": {
      "$ref": "#/$defs/canonicalization"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 640,
      "pattern": "\\S"
    },
    "nullable_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "aware_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "revision_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_receipt_ref",
        "artifact_ref",
        "spec_hash",
        "artifact_digest",
        "release_ref"
      ],
      "properties": {
        "run_receipt_ref": {
          "$ref": "#/$defs/ref"
        },
        "artifact_ref": {
          "$ref": "#/$defs/ref"
        },
        "spec_hash": {
          "$ref": "#/$defs/sha256"
        },
        "artifact_digest": {
          "$ref": "#/$defs/sha256"
        },
        "release_ref": {
          "$ref": "#/$defs/nullable_ref"
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "policy_decision_ref",
        "outcome",
        "policy_version",
        "obligations"
      ],
      "properties": {
        "policy_decision_ref": {
          "$ref": "#/$defs/ref"
        },
        "outcome": {
          "type": "string",
          "enum": [
            "APPROVE",
            "REJECT",
            "HOLD",
            "ABSTAIN"
          ]
        },
        "policy_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "obligations": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,96}$"
          }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "review_record_ref",
        "state",
        "actor_ref",
        "steward_kid"
      ],
      "properties": {
        "review_record_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "state": {
          "type": "string",
          "enum": [
            "APPROVED",
            "REJECTED",
            "PENDING"
          ]
        },
        "actor_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "steward_kid": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^kfm:kid:[a-z0-9][a-z0-9_.:-]{4,240}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format",
        "verification_state",
        "attestation_ref",
        "signer_kid",
        "oci_referrer_uri"
      ],
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "COSE_SIGN1",
            "DSSE",
            "SIGSTORE_BUNDLE",
            "NONE"
          ]
        },
        "verification_state": {
          "type": "string",
          "enum": [
            "VERIFIED",
            "UNVERIFIED",
            "FAILED",
            "NOT_PRESENT"
          ]
        },
        "attestation_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "signer_kid": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^kfm:kid:[a-z0-9][a-z0-9_.:-]{4,240}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "oci_referrer_uri": {
          "oneOf": [
            {
              "type": "string",
              "pattern": "^oci://[^\\s]+@sha256:[a-f0-9]{64}$"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "canonicalization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile",
        "hash_algorithm",
        "payload_digest"
      ],
      "properties": {
        "profile": {
          "const": "RFC8785-JCS-SAFE-SUBSET-v1"
        },
        "hash_algorithm": {
          "const": "sha256"
        },
        "payload_digest": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "candidate_only",
        "cryptographic_verification_performed",
        "policy_authority_created",
        "review_authority_created",
        "promotion_authorized",
        "release_authorized",
        "publication_authorized",
        "public_use_allowed"
      ],
      "properties": {
        "candidate_only": {
          "const": true
        },
        "cryptographic_verification_performed": {
          "const": false
        },
        "policy_authority_created": {
          "const": false
        },
        "review_authority_created": {
          "const": false
        },
        "promotion_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        },
        "public_use_allowed": {
          "const": false
        }
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED",
    "contract_doc": "contracts/receipts/artifact_delta_receipt.md",
    "fixtures_root": "fixtures/contracts/v1/receipts/artifact_delta_receipt/",
    "validator": "tools/validators/validate_artifact_delta_receipt.py",
    "authority": "shape_and_local_consistency_only",
    "canonicalization_scope": "Strings, booleans, nulls, arrays, and objects only; payload_digest omitted from the hashed payload.",
    "non_effects": [
      "does_not_verify_cose_or_dsse_or_sigstore",
      "does_not_contact_an_oci_registry",
      "does_not_evaluate_policy",
      "does_not_complete_review",
      "does_not_authorize_promotion",
      "does_not_authorize_release",
      "does_not_publish"
    ]
  }
}
