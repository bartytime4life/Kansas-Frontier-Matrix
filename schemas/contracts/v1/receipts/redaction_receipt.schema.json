{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/receipts/redaction_receipt.schema.json",
  "title": "RedactionReceipt",
  "description": "PROPOSED_INACTIVE fixture-only machine profile paired to contracts/shared/redaction_receipt.md.",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "spec": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dt": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "ref": {
      "type": "string",
      "pattern": "^kfm:[a-z0-9][a-z0-9._:/-]{5,220}$"
    },
    "nullable_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "nullable_spec": {
      "oneOf": [
        {
          "$ref": "#/$defs/spec"
        },
        {
          "type": "null"
        }
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_mode": {
          "const": "FIXTURE_ONLY"
        },
        "policy_executed": {
          "const": false
        },
        "human_review_authenticated": {
          "const": false
        },
        "restricted_input_opened": {
          "const": false
        },
        "lifecycle_mutated": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        }
      },
      "required": [
        "execution_mode",
        "policy_executed",
        "human_review_authenticated",
        "restricted_input_opened",
        "lifecycle_mutated",
        "release_authorized",
        "publication_authorized"
      ]
    }
  },
  "properties": {
    "object_type": {
      "const": "RedactionReceipt"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "profile": {
      "const": "kfm.redaction-receipt.fixture.v1"
    },
    "receipt_id": {
      "type": "string",
      "pattern": "^kfm:redaction-receipt:[a-f0-9]{24}$"
    },
    "issued_at": {
      "$ref": "#/$defs/dt"
    },
    "processing_state": {
      "enum": [
        "COMPLETE",
        "HOLD",
        "ERROR"
      ]
    },
    "target_ref": {
      "$ref": "#/$defs/ref"
    },
    "input_digest": {
      "$ref": "#/$defs/spec"
    },
    "output_digest": {
      "$ref": "#/$defs/nullable_spec"
    },
    "transform": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "classes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "uniqueItems": true,
          "items": {
            "enum": [
              "REMOVE",
              "MASK",
              "FUZZ",
              "GENERALIZE",
              "AGGREGATE",
              "SUPPRESS",
              "DELAY",
              "CLIP",
              "SIMPLIFY",
              "WITHHOLD"
            ]
          }
        },
        "profile_ref": {
          "$ref": "#/$defs/ref"
        },
        "hidden_parameters_withheld": {
          "const": true
        },
        "public_summary": {
          "type": "string",
          "minLength": 3,
          "maxLength": 240
        }
      },
      "required": [
        "classes",
        "profile_ref",
        "hidden_parameters_withheld",
        "public_summary"
      ]
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy_decision_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "review_record_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "validation_report_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "evidence_refs": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/ref"
          }
        },
        "source_descriptor_refs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^kfm://source/[a-z0-9][a-z0-9._:-]{2,127}$"
          }
        }
      },
      "required": [
        "policy_decision_ref",
        "review_record_ref",
        "validation_report_ref",
        "evidence_refs",
        "source_descriptor_refs"
      ]
    },
    "exposure": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "input_sensitivity": {
          "enum": [
            "T0",
            "T1",
            "T2",
            "T3",
            "T4"
          ]
        },
        "output_sensitivity": {
          "oneOf": [
            {
              "enum": [
                "T0",
                "T1",
                "T2",
                "T3",
                "T4"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "output_public_candidate": {
          "type": "boolean"
        },
        "protected_value_present": {
          "const": false
        },
        "reversal_material_present": {
          "const": false
        }
      },
      "required": [
        "input_sensitivity",
        "output_sensitivity",
        "output_public_candidate",
        "protected_value_present",
        "reversal_material_present"
      ]
    },
    "release_context": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "release_candidate_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "correction_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "rollback_ref": {
          "$ref": "#/$defs/nullable_ref"
        }
      },
      "required": [
        "release_candidate_ref",
        "correction_ref",
        "rollback_ref"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "RECORDED",
            "WITHHELD",
            "HOLD",
            "ERROR"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {
            "enum": [
              "PUBLIC_SAFE_TRANSFORM_RECORDED",
              "CONTENT_WITHHELD",
              "REDACTION_REVIEW_HOLD",
              "REDACTION_PROCESSING_ERROR"
            ]
          }
        }
      },
      "required": [
        "status",
        "reason_codes"
      ]
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "spec_hash": {
      "$ref": "#/$defs/spec"
    }
  },
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "receipt_id",
    "issued_at",
    "processing_state",
    "target_ref",
    "input_digest",
    "output_digest",
    "transform",
    "basis",
    "exposure",
    "release_context",
    "result",
    "governance",
    "spec_hash"
  ],
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "path": "schemas/contracts/v1/receipts/redaction_receipt.schema.json",
    "contract_doc": "contracts/shared/redaction_receipt.md",
    "authority": "NONE"
  }
}
