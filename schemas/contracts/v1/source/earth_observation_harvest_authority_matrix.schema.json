{
  "$defs": {
    "entry": {
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "harvest": {
                "properties": {
                  "state": {
                    "const": "DOCUMENTED_ONLY"
                  }
                }
              }
            },
            "required": [
              "harvest"
            ]
          },
          "then": {
            "properties": {
              "activation_ref": {
                "type": "null"
              },
              "harvest": {
                "properties": {
                  "allowed_operations": {
                    "maxItems": 0
                  },
                  "candidate_target_zones": {
                    "maxItems": 0
                  },
                  "network_authorized": {
                    "const": false
                  }
                }
              },
              "source_authority_ref": {
                "type": "null"
              },
              "source_descriptor_ref": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "harvest": {
                "properties": {
                  "state": {
                    "const": "ACTIVE"
                  }
                }
              }
            },
            "required": [
              "harvest"
            ]
          },
          "then": {
            "properties": {
              "access": {
                "properties": {
                  "conditional_request_mode": {
                    "not": {
                      "const": "NEEDS_VERIFICATION"
                    }
                  },
                  "endpoint_ref": {
                    "minLength": 1,
                    "type": "string"
                  },
                  "pagination_mode": {
                    "not": {
                      "const": "NEEDS_VERIFICATION"
                    }
                  },
                  "rate_limit_mode": {
                    "not": {
                      "const": "NEEDS_VERIFICATION"
                    }
                  }
                }
              },
              "activation_ref": {
                "minLength": 1,
                "type": "string"
              },
              "harvest": {
                "properties": {
                  "allowed_operations": {
                    "minItems": 1
                  },
                  "candidate_target_zones": {
                    "minItems": 1
                  },
                  "network_authorized": {
                    "const": true
                  }
                }
              },
              "review_state": {
                "const": "APPROVED"
              },
              "rights_state": {
                "const": "REVIEWED"
              },
              "sensitivity_state": {
                "const": "REVIEWED"
              },
              "source_authority_ref": {
                "minLength": 1,
                "type": "string"
              },
              "source_descriptor_ref": {
                "minLength": 1,
                "type": "string"
              }
            }
          }
        }
      ],
      "properties": {
        "access": {
          "additionalProperties": false,
          "properties": {
            "auth_mode": {
              "enum": [
                "CREDENTIAL_REFERENCE_REQUIRED",
                "PUBLIC_NO_CREDENTIAL",
                "UPSTREAM_ACCESS_SURFACE",
                "NEEDS_VERIFICATION"
              ]
            },
            "conditional_request_mode": {
              "enum": [
                "DOCUMENTED_PROFILE",
                "UPSTREAM_ACCESS_SURFACE",
                "NEEDS_VERIFICATION"
              ]
            },
            "credential_exposure": {
              "const": "SERVER_SIDE_ONLY_OR_NONE"
            },
            "discovery_mode": {
              "enum": [
                "CMR",
                "STAC",
                "UPSTREAM_ACCESS_SURFACE",
                "PROVIDER_NATIVE",
                "NEEDS_VERIFICATION"
              ]
            },
            "endpoint_ref": {
              "$ref": "#/$defs/nullableRef"
            },
            "pagination_mode": {
              "enum": [
                "CURSOR",
                "PAGE",
                "TOKEN",
                "UPSTREAM_ACCESS_SURFACE",
                "NEEDS_VERIFICATION"
              ]
            },
            "rate_limit_mode": {
              "enum": [
                "DOCUMENTED_PROFILE",
                "UPSTREAM_ACCESS_SURFACE",
                "NEEDS_VERIFICATION"
              ]
            }
          },
          "required": [
            "discovery_mode",
            "endpoint_ref",
            "auth_mode",
            "credential_exposure",
            "pagination_mode",
            "rate_limit_mode",
            "conditional_request_mode"
          ],
          "type": "object"
        },
        "access_surface_ref": {
          "$ref": "#/$defs/nullableRef"
        },
        "activation_ref": {
          "$ref": "#/$defs/nullableRef"
        },
        "authority_id": {
          "pattern": "^kfm\\.eo\\.[a-z0-9][a-z0-9_.-]{2,126}$",
          "type": "string"
        },
        "authority_role": {
          "enum": [
            "ACCESS_SURFACE",
            "CATALOG_ENDPOINT",
            "PRODUCT_CONTEXT",
            "PROVIDER_DISTRIBUTION"
          ]
        },
        "catalog_doc_ref": {
          "$ref": "#/$defs/repoPath"
        },
        "connector_ref": {
          "$ref": "#/$defs/repoPath"
        },
        "governance": {
          "additionalProperties": false,
          "properties": {
            "browser_credential_exposure_allowed": {
              "const": false
            },
            "evidence_resolved": {
              "const": false
            },
            "policy_evaluated": {
              "const": false
            },
            "promotion_authorized": {
              "const": false
            },
            "publication_authorized": {
              "const": false
            },
            "raw_admission_authorized": {
              "const": false
            },
            "release_authorized": {
              "const": false
            },
            "source_admitted": {
              "const": false
            }
          },
          "required": [
            "source_admitted",
            "raw_admission_authorized",
            "evidence_resolved",
            "policy_evaluated",
            "promotion_authorized",
            "release_authorized",
            "publication_authorized",
            "browser_credential_exposure_allowed"
          ],
          "type": "object"
        },
        "harvest": {
          "additionalProperties": false,
          "properties": {
            "allowed_operations": {
              "items": {
                "enum": [
                  "DISCOVER_METADATA",
                  "FETCH_METADATA",
                  "FETCH_PAYLOAD"
                ]
              },
              "maxItems": 3,
              "type": "array",
              "uniqueItems": true
            },
            "candidate_target_zones": {
              "items": {
                "enum": [
                  "RAW",
                  "QUARANTINE"
                ]
              },
              "maxItems": 2,
              "type": "array",
              "uniqueItems": true
            },
            "network_authorized": {
              "type": "boolean"
            },
            "state": {
              "enum": [
                "DOCUMENTED_ONLY",
                "REVIEWED_INACTIVE",
                "ACTIVE",
                "SUSPENDED",
                "RETIRED"
              ]
            }
          },
          "required": [
            "state",
            "network_authorized",
            "allowed_operations",
            "candidate_target_zones"
          ],
          "type": "object"
        },
        "product_family": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
              "type": "string"
            }
          ]
        },
        "reason_codes": {
          "items": {
            "pattern": "^[A-Z][A-Z0-9_]{2,63}$",
            "type": "string"
          },
          "maxItems": 16,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "review_state": {
          "enum": [
            "PENDING",
            "APPROVED",
            "CHANGES_REQUESTED",
            "REJECTED"
          ]
        },
        "rights_state": {
          "enum": [
            "NEEDS_VERIFICATION",
            "REVIEWED",
            "DENIED"
          ]
        },
        "sensitivity_state": {
          "enum": [
            "NEEDS_VERIFICATION",
            "REVIEWED",
            "DENIED"
          ]
        },
        "source_authority_ref": {
          "$ref": "#/$defs/nullableRef"
        },
        "source_descriptor_ref": {
          "$ref": "#/$defs/nullableRef"
        },
        "source_family": {
          "pattern": "^[a-z0-9][a-z0-9_-]{1,63}$",
          "type": "string"
        }
      },
      "required": [
        "authority_id",
        "authority_role",
        "source_family",
        "product_family",
        "catalog_doc_ref",
        "connector_ref",
        "access_surface_ref",
        "source_descriptor_ref",
        "source_authority_ref",
        "activation_ref",
        "access",
        "harvest",
        "rights_state",
        "sensitivity_state",
        "review_state",
        "reason_codes",
        "governance"
      ],
      "type": "object"
    },
    "nullableRef": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        }
      ]
    },
    "repoPath": {
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\)[A-Za-z0-9._/-]+$",
      "type": "string"
    },
    "sha256": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    }
  },
  "$id": "https://schemas.kfm.local/contracts/v1/source/earth_observation_harvest_authority_matrix.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonicalization_profile": {
      "const": "RFC8785-JCS"
    },
    "entries": {
      "items": {
        "$ref": "#/$defs/entry"
      },
      "maxItems": 256,
      "minItems": 1,
      "type": "array"
    },
    "governance": {
      "additionalProperties": false,
      "properties": {
        "network_execution_authorized": {
          "const": false
        },
        "promotion_authorized": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        },
        "raw_admission_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "source_activation_authorized": {
          "const": false
        },
        "source_authority_created": {
          "const": false
        }
      },
      "required": [
        "source_authority_created",
        "source_activation_authorized",
        "network_execution_authorized",
        "raw_admission_authorized",
        "promotion_authorized",
        "release_authorized",
        "publication_authorized"
      ],
      "type": "object"
    },
    "matrix_id": {
      "const": "kfm://control-plane/earth-observation-harvest-authority-matrix/v1"
    },
    "object_type": {
      "const": "EarthObservationHarvestAuthorityMatrix"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "status": {
      "const": "PROPOSED_INACTIVE"
    }
  },
  "required": [
    "object_type",
    "schema_version",
    "matrix_id",
    "status",
    "canonicalization_profile",
    "spec_hash",
    "entries",
    "governance"
  ],
  "title": "EarthObservationHarvestAuthorityMatrix",
  "type": "object",
  "x-kfm": {
    "authority": "control_plane_crosswalk_only",
    "contract_doc": "contracts/source/earth_observation_harvest_authority_matrix.md",
    "instance": "control_plane/earth_observation_harvest_authority_matrix.json",
    "non_effects": [
      "does_not_store_endpoints_or_secrets",
      "does_not_activate_connectors",
      "does_not_admit_sources",
      "does_not_authorize_network",
      "does_not_release_or_publish"
    ]
  }
}
