{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/source/source_obligation_propagation_assessment.schema.json",
  "title": "SourceObligationPropagationAssessment",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "spec": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "dt": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "ref": {
      "type": "string",
      "pattern": "^kfm:[a-z0-9][a-z0-9._:/-]{5,220}$"
    },
    "nullableRef": {
      "anyOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "notices": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ATTRIBUTION",
          "LICENSE",
          "TERMS",
          "SOURCE_VERSION",
          "MODIFICATION"
        ]
      }
    },
    "obligations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rights_status": {
          "enum": [
            "VERIFIED_OPEN",
            "VERIFIED_RESTRICTED",
            "PERMISSION_REQUIRED",
            "UNKNOWN",
            "DENIED"
          ]
        },
        "attribution_status": {
          "enum": [
            "NOT_REQUIRED",
            "REQUIRED_DOCUMENTED",
            "UNKNOWN"
          ]
        },
        "attribution_ref": {
          "$ref": "#/$defs/nullableRef"
        },
        "terms_ref": {
          "$ref": "#/$defs/ref"
        },
        "redistribution_status": {
          "enum": [
            "ALLOWED",
            "RESTRICTED",
            "UNKNOWN",
            "DENIED"
          ]
        },
        "derivative_use_status": {
          "enum": [
            "ALLOWED",
            "RESTRICTED",
            "UNKNOWN",
            "DENIED"
          ]
        },
        "required_notices": {
          "$ref": "#/$defs/notices"
        }
      },
      "required": [
        "rights_status",
        "attribution_status",
        "attribution_ref",
        "terms_ref",
        "redistribution_status",
        "derivative_use_status",
        "required_notices"
      ]
    },
    "carrier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stage": {
          "enum": [
            "SOURCE_ARTIFACT",
            "PROCESSED_DERIVATIVE",
            "CATALOG_RECORD",
            "EXPORT_CANDIDATE"
          ]
        },
        "artifact_ref": {
          "$ref": "#/$defs/ref"
        },
        "content_digest": {
          "$ref": "#/$defs/spec"
        },
        "attribution_ref": {
          "$ref": "#/$defs/nullableRef"
        },
        "terms_ref": {
          "$ref": "#/$defs/ref"
        },
        "notices": {
          "$ref": "#/$defs/notices"
        },
        "transform_receipt_ref": {
          "$ref": "#/$defs/nullableRef"
        },
        "public_candidate": {
          "type": "boolean"
        }
      },
      "required": [
        "stage",
        "artifact_ref",
        "content_digest",
        "attribution_ref",
        "terms_ref",
        "notices",
        "transform_receipt_ref",
        "public_candidate"
      ]
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "status": {
          "enum": [
            "COMPLETE",
            "REVIEW_DUE",
            "BLOCKED",
            "ERROR"
          ]
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 15,
          "uniqueItems": true,
          "items": {
            "enum": [
              "OBLIGATIONS_PROPAGATED",
              "SOURCE_REVIEW_DUE",
              "SOURCE_REVIEW_BLOCKED",
              "RIGHTS_NOT_VERIFIED",
              "ATTRIBUTION_NOT_RESOLVED",
              "REDISTRIBUTION_NOT_VERIFIED",
              "DERIVATIVE_USE_NOT_VERIFIED",
              "CARRIER_CHAIN_INCOMPLETE",
              "CARRIER_STAGE_ORDER_INVALID",
              "ATTRIBUTION_MISSING",
              "TERMS_REFERENCE_MISMATCH",
              "REQUIRED_NOTICE_MISSING",
              "TRANSFORM_RECEIPT_MISSING",
              "TRANSFORM_RECEIPT_UNEXPECTED",
              "RESTRICTED_PUBLIC_CANDIDATE",
              "ASSESSMENT_ERROR"
            ]
          }
        }
      },
      "required": [
        "status",
        "reason_codes"
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "execution_mode": {
          "const": "FIXTURE_ONLY"
        },
        "network_attempted": {
          "const": false
        },
        "source_activated": {
          "const": false
        },
        "artifact_created": {
          "const": false
        },
        "evidence_created": {
          "const": false
        },
        "lifecycle_write_performed": {
          "const": false
        },
        "policy_decision_created": {
          "const": false
        },
        "export_executed": {
          "const": false
        },
        "promotion_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        },
        "public_use_allowed": {
          "const": false
        }
      },
      "required": [
        "execution_mode",
        "network_attempted",
        "source_activated",
        "artifact_created",
        "evidence_created",
        "lifecycle_write_performed",
        "policy_decision_created",
        "export_executed",
        "promotion_authorized",
        "release_authorized",
        "publication_authorized",
        "public_use_allowed"
      ]
    }
  },
  "properties": {
    "object_type": {
      "const": "SourceObligationPropagationAssessment"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "profile": {
      "const": "kfm.source-obligation-propagation.fixture.v1"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^kfm:source-obligation-propagation:[a-f0-9]{24}$"
    },
    "assessed_at": {
      "$ref": "#/$defs/dt"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "source_descriptor_ref": {
      "type": "string",
      "pattern": "^kfm://source/[a-z0-9][a-z0-9._:-]{2,127}$"
    },
    "source_rights_currentness_assessment_ref": {
      "type": "string",
      "pattern": "^kfm:source-rights-currentness:[a-f0-9]{24}$"
    },
    "source_review_state": {
      "enum": [
        "CURRENT",
        "REVIEW_DUE",
        "BLOCKED",
        "ERROR"
      ]
    },
    "target_stage": {
      "enum": [
        "INTERNAL_DERIVATIVE",
        "CATALOG_CANDIDATE",
        "EXPORT_CANDIDATE"
      ]
    },
    "obligations": {
      "$ref": "#/$defs/obligations"
    },
    "carrier_chain": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/carrier"
      }
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "spec_hash": {
      "$ref": "#/$defs/spec"
    }
  },
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "assessment_id",
    "assessed_at",
    "source_id",
    "source_descriptor_ref",
    "source_rights_currentness_assessment_ref",
    "source_review_state",
    "target_stage",
    "obligations",
    "carrier_chain",
    "result",
    "governance",
    "spec_hash"
  ],
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "contract_doc": "contracts/source/source_obligation_propagation_assessment.md",
    "authority": "NONE"
  }
}
