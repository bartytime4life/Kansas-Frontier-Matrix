{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/source/biodiversity_occurrence_retrieval_plan.schema.json",
  "title": "BiodiversityOccurrenceRetrievalPlanCandidate",
  "description": "Fixture-first, no-network candidate that binds retrieval intent, a sanitized query snapshot, sampling support, and finite transfer state for eBird EBD/SED and GBIF occurrence downloads. Schema validity grants no source admission, rights, evidence, policy, release, or publication authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "plan_id",
    "hash_profile",
    "spec_hash",
    "domain_scope",
    "source_profile",
    "retrieval_intent",
    "query_snapshot",
    "sampling_support",
    "transfer",
    "provenance",
    "governance"
  ],
  "properties": {
    "object_type": {
      "const": "BiodiversityOccurrenceRetrievalPlanCandidate"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "plan_id": {
      "type": "string",
      "pattern": "^retrieval-plan:biodiversity:[a-z0-9][a-z0-9_.:-]{7,220}$"
    },
    "hash_profile": {
      "const": "kfm-fixture-json-v1"
    },
    "spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "domain_scope": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string",
        "enum": [
          "fauna",
          "flora",
          "habitat"
        ]
      },
      "uniqueItems": true
    },
    "source_profile": {
      "$ref": "#/$defs/source_profile"
    },
    "retrieval_intent": {
      "$ref": "#/$defs/retrieval_intent"
    },
    "query_snapshot": {
      "$ref": "#/$defs/query_snapshot"
    },
    "sampling_support": {
      "$ref": "#/$defs/sampling_support"
    },
    "transfer": {
      "$ref": "#/$defs/transfer"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    }
  },
  "$defs": {
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 640,
      "pattern": "\\S"
    },
    "nullable_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "ref_array": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/ref"
      },
      "uniqueItems": true
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_]{2,96}$"
      },
      "uniqueItems": true
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "nullable_sha256": {
      "oneOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "aware_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "nullable_datetime": {
      "oneOf": [
        {
          "$ref": "#/$defs/aware_datetime"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_family",
        "product",
        "source_descriptor_ref",
        "source_role",
        "rights_status",
        "sensitivity_status",
        "live_source_activated"
      ],
      "properties": {
        "source_family": {
          "type": "string",
          "enum": [
            "EBIRD",
            "GBIF"
          ]
        },
        "product": {
          "type": "string",
          "enum": [
            "EBIRD_EBD_SED",
            "GBIF_OCCURRENCE_PREDICATE",
            "GBIF_OCCURRENCE_SQL"
          ]
        },
        "source_descriptor_ref": {
          "$ref": "#/$defs/ref"
        },
        "source_role": {
          "type": "string",
          "enum": [
            "CITIZEN_SCIENCE_OBSERVATION",
            "AGGREGATED_OCCURRENCE"
          ]
        },
        "rights_status": {
          "const": "NEEDS_VERIFICATION"
        },
        "sensitivity_status": {
          "const": "NEEDS_VERIFICATION"
        },
        "live_source_activated": {
          "const": false
        }
      }
    },
    "geography": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "identifier",
        "geometry_ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "STATE",
            "COUNTY",
            "HUC12"
          ]
        },
        "identifier": {
          "type": "string",
          "minLength": 2,
          "maxLength": 32
        },
        "geometry_ref": {
          "type": "null"
        }
      }
    },
    "time_window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "$ref": "#/$defs/aware_datetime"
        },
        "end": {
          "$ref": "#/$defs/aware_datetime"
        }
      }
    },
    "retrieval_intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "purpose",
        "requested_claim_role",
        "geography",
        "time_window",
        "result_granularity",
        "non_detection_inference_requested",
        "absence_claim_requested",
        "public_output_requested",
        "exact_coordinate_output_requested"
      ],
      "properties": {
        "purpose": {
          "type": "string",
          "enum": [
            "OCCURRENCE_RESEARCH",
            "EFFORT_AWARE_OCCURRENCE",
            "AGGREGATE_SUMMARY"
          ]
        },
        "requested_claim_role": {
          "type": "string",
          "enum": [
            "CANDIDATE_OCCURRENCE_SUPPORT",
            "CANDIDATE_SAMPLING_SUPPORT",
            "CANDIDATE_AGGREGATE_SUPPORT"
          ]
        },
        "geography": {
          "$ref": "#/$defs/geography"
        },
        "time_window": {
          "$ref": "#/$defs/time_window"
        },
        "result_granularity": {
          "type": "string",
          "enum": [
            "RECORD",
            "CHECKLIST",
            "AGGREGATE"
          ]
        },
        "non_detection_inference_requested": {
          "type": "boolean"
        },
        "absence_claim_requested": {
          "const": false
        },
        "public_output_requested": {
          "const": false
        },
        "exact_coordinate_output_requested": {
          "const": false
        }
      }
    },
    "query_parameter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,64}$"
        },
        "value": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 2048
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "boolean"
            },
            {
              "type": "array",
              "maxItems": 64,
              "items": {
                "type": "string",
                "maxLength": 512
              },
              "uniqueItems": true
            }
          ]
        }
      }
    },
    "query_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "query_language",
        "query_version",
        "query_text",
        "query_digest",
        "parameters",
        "credentials_excluded",
        "notification_addresses_excluded",
        "volatile_values_excluded"
      ],
      "properties": {
        "query_language": {
          "type": "string",
          "enum": [
            "EBIRD_FILTER_PROFILE",
            "GBIF_PREDICATE_JSON",
            "GBIF_SQL"
          ]
        },
        "query_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "query_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 8192,
          "pattern": "\\S"
        },
        "query_digest": {
          "$ref": "#/$defs/sha256"
        },
        "parameters": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/query_parameter"
          }
        },
        "credentials_excluded": {
          "const": true
        },
        "notification_addresses_excluded": {
          "const": true
        },
        "volatile_values_excluded": {
          "const": true
        }
      }
    },
    "sampling_support": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "support_units",
        "complete_checklists_required",
        "paired_product_required",
        "paired_product",
        "zero_fill_allowed",
        "non_detection_inference_allowed",
        "absence_claim_allowed",
        "observer_effort_fields",
        "source_role_preserved",
        "specimen_equivalence_claimed",
        "no_detection_is_not_absence",
        "missing_row_is_not_absence"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "PRESENCE_ONLY",
            "CHECKLIST_EFFORT",
            "AGGREGATE_ONLY"
          ]
        },
        "support_units": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "string",
            "enum": [
              "OCCURRENCE_RECORD",
              "CHECKLIST",
              "SAMPLING_EVENT",
              "DATASET_AGGREGATE"
            ]
          },
          "uniqueItems": true
        },
        "complete_checklists_required": {
          "type": "boolean"
        },
        "paired_product_required": {
          "type": "boolean"
        },
        "paired_product": {
          "oneOf": [
            {
              "const": "SED"
            },
            {
              "type": "null"
            }
          ]
        },
        "zero_fill_allowed": {
          "type": "boolean"
        },
        "non_detection_inference_allowed": {
          "type": "boolean"
        },
        "absence_claim_allowed": {
          "const": false
        },
        "observer_effort_fields": {
          "type": "array",
          "maxItems": 5,
          "items": {
            "type": "string",
            "enum": [
              "ALL_SPECIES_REPORTED",
              "PROTOCOL_TYPE",
              "DURATION_MINUTES",
              "DISTANCE_KM",
              "PARTY_SIZE"
            ]
          },
          "uniqueItems": true
        },
        "source_role_preserved": {
          "const": true
        },
        "specimen_equivalence_claimed": {
          "const": false
        },
        "no_detection_is_not_absence": {
          "const": true
        },
        "missing_row_is_not_absence": {
          "const": true
        }
      }
    },
    "transfer_history_item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "state",
        "at"
      ],
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "PLANNED",
            "SUBMITTED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "EXPIRED",
            "UNKNOWN"
          ]
        },
        "at": {
          "$ref": "#/$defs/aware_datetime"
        }
      }
    },
    "transfer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "state",
        "transfer_id",
        "submitted_at",
        "updated_at",
        "terminal_at",
        "artifact_ref",
        "artifact_digest",
        "citation_ref",
        "retry_count",
        "reason_codes",
        "state_history",
        "terminal_success_confirmed",
        "bytes_available",
        "status_unknown_preserved",
        "failed_state_not_promoted"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "MANUAL_APPROVED_BULK_FILE",
            "ASYNCHRONOUS_JOB"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "PLANNED",
            "SUBMITTED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "EXPIRED",
            "UNKNOWN"
          ]
        },
        "transfer_id": {
          "$ref": "#/$defs/nullable_ref"
        },
        "submitted_at": {
          "$ref": "#/$defs/nullable_datetime"
        },
        "updated_at": {
          "$ref": "#/$defs/aware_datetime"
        },
        "terminal_at": {
          "$ref": "#/$defs/nullable_datetime"
        },
        "artifact_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "artifact_digest": {
          "$ref": "#/$defs/nullable_sha256"
        },
        "citation_ref": {
          "$ref": "#/$defs/nullable_ref"
        },
        "retry_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10
        },
        "reason_codes": {
          "$ref": "#/$defs/reason_codes"
        },
        "state_history": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/transfer_history_item"
          }
        },
        "terminal_success_confirmed": {
          "type": "boolean"
        },
        "bytes_available": {
          "type": "boolean"
        },
        "status_unknown_preserved": {
          "const": true
        },
        "failed_state_not_promoted": {
          "const": true
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "recorded_at",
        "planner_id",
        "planner_version",
        "run_receipt_ref",
        "input_refs"
      ],
      "properties": {
        "recorded_at": {
          "$ref": "#/$defs/aware_datetime"
        },
        "planner_id": {
          "$ref": "#/$defs/ref"
        },
        "planner_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"
        },
        "run_receipt_ref": {
          "$ref": "#/$defs/ref"
        },
        "input_refs": {
          "$ref": "#/$defs/ref_array"
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_cleared",
        "sensitivity_cleared",
        "source_admitted",
        "evidence_closure_claimed",
        "policy_evaluated",
        "review_complete",
        "promotion_authorized",
        "release_authorized",
        "publication_authorized",
        "public_use_allowed",
        "release_state",
        "release_ref"
      ],
      "properties": {
        "rights_cleared": {
          "const": false
        },
        "sensitivity_cleared": {
          "const": false
        },
        "source_admitted": {
          "const": false
        },
        "evidence_closure_claimed": {
          "const": false
        },
        "policy_evaluated": {
          "const": false
        },
        "review_complete": {
          "const": false
        },
        "promotion_authorized": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "publication_authorized": {
          "const": false
        },
        "public_use_allowed": {
          "const": false
        },
        "release_state": {
          "const": "HOLD"
        },
        "release_ref": {
          "type": "null"
        }
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED",
    "contract_doc": "contracts/source/biodiversity_occurrence_retrieval_plan.md",
    "fixtures_root": "fixtures/contracts/v1/source/biodiversity_occurrence_retrieval_plan/",
    "validator": "tools/validators/validate_biodiversity_occurrence_retrieval_plan.py",
    "tests": "tests/validators/test_validate_biodiversity_occurrence_retrieval_plan.py",
    "authority": "source_retrieval_intent_query_snapshot_sampling_support_and_transfer_state_only",
    "non_effects": [
      "does_not_activate_ebird_or_gbif",
      "does_not_store_credentials_or_notification_addresses",
      "does_not_convert_non_detection_or_missing_rows_into_absence",
      "does_not_create_evidence_policy_release_or_publication_authority"
    ]
  }
}
