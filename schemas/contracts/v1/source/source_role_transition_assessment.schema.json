{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/source/source_role_transition_assessment.schema.json",
  "title": "SourceRoleTransitionAssessment",
  "description": "Fixture-first anti-collapse assessment for declared transformations between source roles.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "assessment_id",
    "operation",
    "inputs",
    "output",
    "receipts",
    "outcome",
    "reason_codes",
    "obligations",
    "validator_error_ref",
    "evaluated_at",
    "governance",
    "spec_hash"
  ],
  "properties": {
    "object_type": {
      "const": "SourceRoleTransitionAssessment"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "assessment_id": {
      "$ref": "#/$defs/ref"
    },
    "operation": {
      "enum": [
        "PASSTHROUGH",
        "AGGREGATE",
        "MODEL",
        "SYNTHESIZE",
        "GENERALIZE",
        "PROMOTE_LIFECYCLE"
      ]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "source_role",
          "evidence_bundle_ref"
        ],
        "properties": {
          "source_ref": {
            "$ref": "#/$defs/ref"
          },
          "source_role": {
            "$ref": "#/$defs/sourceRole"
          },
          "evidence_bundle_ref": {
            "$ref": "#/$defs/ref"
          }
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_ref",
        "source_role",
        "lineage_roles"
      ],
      "properties": {
        "artifact_ref": {
          "$ref": "#/$defs/ref"
        },
        "source_role": {
          "$ref": "#/$defs/sourceRole"
        },
        "lineage_roles": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceRole"
          }
        }
      }
    },
    "receipts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "aggregation_receipt_ref",
        "model_run_receipt_ref",
        "representation_receipt_ref",
        "reality_boundary_note_ref"
      ],
      "properties": {
        "aggregation_receipt_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "model_run_receipt_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "representation_receipt_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        },
        "reality_boundary_note_ref": {
          "oneOf": [
            {
              "$ref": "#/$defs/ref"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "outcome": {
      "enum": [
        "PASS",
        "DENY",
        "HOLD",
        "ERROR"
      ]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/code"
      }
    },
    "obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/code"
      }
    },
    "validator_error_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "spec_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 8,
      "maxLength": 320
    },
    "code": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]{2,79}$"
    },
    "sourceRole": {
      "enum": [
        "OBSERVED",
        "REGULATORY",
        "MODELED",
        "AGGREGATE",
        "ADMINISTRATIVE",
        "CANDIDATE",
        "SYNTHETIC"
      ]
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_only",
        "lifecycle_write",
        "source_activation",
        "truth_authority",
        "policy_authority",
        "review_authority",
        "release_authority",
        "publication_authority"
      ],
      "properties": {
        "fixture_only": {
          "const": true
        },
        "lifecycle_write": {
          "const": false
        },
        "source_activation": {
          "const": false
        },
        "truth_authority": {
          "const": false
        },
        "policy_authority": {
          "const": false
        },
        "review_authority": {
          "const": false
        },
        "release_authority": {
          "const": false
        },
        "publication_authority": {
          "const": false
        }
      }
    }
  }
}
