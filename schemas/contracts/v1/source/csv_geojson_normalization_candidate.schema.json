{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "kfm://schemas/contracts/v1/source/csv-geojson-normalization-candidate",
  "title": "CSV to GeoJSON Normalization Candidate",
  "description": "Fixture-only, non-authoritative review candidate produced by the governed CSV-to-GeoJSON preflight.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "candidate_id",
    "contract",
    "profile",
    "input",
    "result",
    "governance",
    "spec_hash"
  ],
  "properties": {
    "candidate_id": {
      "type": "string",
      "pattern": "^kfm:csv-geojson-normalization:[0-9a-f]{32}$"
    },
    "contract": {
      "const": "kfm.source.csv-geojson-normalization-candidate.v1"
    },
    "profile": {
      "$ref": "#/$defs/profile"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "result": {
      "$ref": "#/$defs/result"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    },
    "spec_hash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "fieldName": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
    },
    "reference": {
      "type": "string",
      "minLength": 3,
      "maxLength": 512,
      "pattern": "^[A-Za-z][A-Za-z0-9+.-]*:[^\\s]+$"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "source_event_ref",
        "source_descriptor_ref",
        "source_role",
        "mapping",
        "expected_headers",
        "coordinate_precision",
        "max_rows",
        "execution_mode",
        "geometry_policy"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "source_event_ref": {
          "$ref": "#/$defs/reference"
        },
        "source_descriptor_ref": {
          "$ref": "#/$defs/reference"
        },
        "source_role": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
        },
        "mapping": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id_field", "latitude_field", "longitude_field", "property_fields"],
          "properties": {
            "id_field": {"$ref": "#/$defs/fieldName"},
            "latitude_field": {"$ref": "#/$defs/fieldName"},
            "longitude_field": {"$ref": "#/$defs/fieldName"},
            "property_fields": {
              "type": "array",
              "minItems": 1,
              "maxItems": 61,
              "uniqueItems": true,
              "items": {"$ref": "#/$defs/fieldName"}
            }
          }
        },
        "expected_headers": {
          "type": "array",
          "minItems": 4,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/fieldName"}
        },
        "coordinate_precision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 8
        },
        "max_rows": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "execution_mode": {"const": "FIXTURE_ONLY"},
        "geometry_policy": {"const": "PUBLIC_SAFE_SYNTHETIC_POINTS"}
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["media_type", "content_digest", "byte_length", "row_count", "header_digest"],
      "properties": {
        "media_type": {"const": "text/csv"},
        "content_digest": {"$ref": "#/$defs/sha256"},
        "byte_length": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "row_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "header_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "feature_count", "feature_collection_digest", "feature_collection"],
      "properties": {
        "outcome": {"const": "NORMALIZED_CANDIDATE"},
        "feature_count": {"type": "integer", "minimum": 1, "maximum": 10000},
        "feature_collection_digest": {"$ref": "#/$defs/sha256"},
        "feature_collection": {"$ref": "#/$defs/featureCollection"}
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "authority_created",
        "evidence_created",
        "fixture_only",
        "lifecycle_write_allowed",
        "network_accessed",
        "policy_decided",
        "publication_allowed",
        "release_created",
        "source_activated"
      ],
      "properties": {
        "authority_created": {"const": false},
        "evidence_created": {"const": false},
        "fixture_only": {"const": true},
        "lifecycle_write_allowed": {"const": false},
        "network_accessed": {"const": false},
        "policy_decided": {"const": false},
        "publication_allowed": {"const": false},
        "release_created": {"const": false},
        "source_activated": {"const": false}
      }
    },
    "featureCollection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "features"],
      "properties": {
        "type": {"const": "FeatureCollection"},
        "features": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/feature"}
        }
      }
    },
    "feature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "id", "geometry", "properties"],
      "properties": {
        "type": {"const": "Feature"},
        "id": {
          "type": "string",
          "pattern": "^kfm:csv-feature:sha256:[0-9a-f]{64}$"
        },
        "geometry": {
          "$ref": "#/$defs/point"
        },
        "properties": {
          "type": "object",
          "minProperties": 2,
          "maxProperties": 62,
          "propertyNames": {
            "pattern": "^[A-Za-z_][A-Za-z0-9_]{0,63}$"
          },
          "required": ["source_row_id"],
          "additionalProperties": {
            "type": "string",
            "maxLength": 2048
          }
        }
      }
    },
    "point": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "coordinates"],
      "properties": {
        "type": {"const": "Point"},
        "coordinates": {
          "type": "array",
          "prefixItems": [
            {"type": "number", "minimum": -180, "maximum": 180},
            {"type": "number", "minimum": -90, "maximum": 90}
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        }
      }
    }
  }
}
