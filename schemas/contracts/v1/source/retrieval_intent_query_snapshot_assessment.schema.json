{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/source/retrieval_intent_query_snapshot_assessment.schema.json",
  "title": "RetrievalIntentQuerySnapshotAssessmentCandidate",
  "description": "Inactive fixture-only comparison of declared retrieval intent with an executed normalized query; no network, secret, source, evidence, policy, release, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type", "schema_version", "profile", "status", "assessment_id",
    "spec_hash", "source_idea_ids", "assessed_at", "source_descriptor_ref",
    "source_descriptor_version", "retrieval_intent", "query_snapshot",
    "retrieval_receipt", "decision", "limitations", "effects"
  ],
  "properties": {
    "object_type": {"const": "RetrievalIntentQuerySnapshotAssessmentCandidate"},
    "schema_version": {"const": "1.0.0"},
    "profile": {"const": "kfm.source.retrieval-intent-query-snapshot-assessment.fixture.v1"},
    "status": {"const": "PROPOSED_INACTIVE"},
    "assessment_id": {"type": "string", "pattern": "^retrieval-query-assessment:[a-f0-9]{24}$"},
    "spec_hash": {"$ref": "#/$defs/sha256"},
    "source_idea_ids": {
      "const": ["KFM-CAND-0127", "KFM-CAND-0128", "KFM-CAND-0129"]
    },
    "assessed_at": {"$ref": "#/$defs/utc_datetime"},
    "source_descriptor_ref": {"type": "string", "pattern": "^kfm://source/[a-z0-9][a-z0-9._:-]{2,127}$"},
    "source_descriptor_version": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,63}$"},
    "retrieval_intent": {"$ref": "#/$defs/retrieval_intent"},
    "query_snapshot": {"$ref": "#/$defs/query_snapshot"},
    "retrieval_receipt": {"$ref": "#/$defs/retrieval_receipt"},
    "decision": {"$ref": "#/$defs/decision"},
    "limitations": {
      "const": [
        "FIXTURE_ONLY_REFERENCES_UNRESOLVED",
        "NO_RAW_QUERY_VALUES_OR_SECRETS",
        "ZERO_RECORDS_IS_NOT_ABSENCE",
        "NO_SOURCE_EVIDENCE_POLICY_RELEASE_OR_PUBLIC_USE_AUTHORITY"
      ]
    },
    "effects": {"$ref": "#/$defs/effects"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "nullable_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "utc_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "nullable_datetime": {"oneOf": [{"$ref": "#/$defs/utc_datetime"}, {"type": "null"}]},
    "safe_ref": {"type": "string", "pattern": "^kfm:[A-Za-z0-9][A-Za-z0-9._~:/-]{8,511}$"},
    "nullable_ref": {"oneOf": [{"$ref": "#/$defs/safe_ref"}, {"type": "null"}]},
    "field_list": {
      "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"}
    },
    "exclusion_list": {
      "type": "array", "maxItems": 128, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]{1,63}$"}
    },
    "filter": {
      "type": "object", "additionalProperties": false,
      "required": ["field", "operator", "value_digest"],
      "properties": {
        "field": {"type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"},
        "operator": {"enum": ["EQ", "NE", "IN", "NOT_IN", "GT", "GTE", "LT", "LTE", "INTERSECTS", "WITHIN"]},
        "value_digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "filter_list": {
      "type": "array", "maxItems": 256,
      "items": {"$ref": "#/$defs/filter"}
    },
    "geographic_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "value_digest"],
      "properties": {
        "mode": {"enum": ["WHOLE_SOURCE", "ADMIN_AREA", "BOUNDING_BOX", "FEATURE_SET", "NOT_APPLICABLE"]},
        "value_digest": {"$ref": "#/$defs/nullable_sha256"}
      }
    },
    "temporal_scope": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "semantics", "start", "end"],
      "properties": {
        "mode": {"enum": ["ALL_AVAILABLE", "INTERVAL", "AS_OF", "NOT_APPLICABLE"]},
        "semantics": {"enum": ["VALID_TIME", "ISSUE_TIME", "TRANSACTION_TIME", "SOURCE_DEFINED", "NOT_APPLICABLE"]},
        "start": {"$ref": "#/$defs/nullable_datetime"},
        "end": {"$ref": "#/$defs/nullable_datetime"}
      }
    },
    "sampling": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "profile_ref"],
      "properties": {
        "mode": {"enum": ["COMPLETE", "SYSTEMATIC", "RANDOM", "SOURCE_DEFINED", "NOT_APPLICABLE"]},
        "profile_ref": {"$ref": "#/$defs/nullable_ref"}
      }
    },
    "pagination_intent": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "planned_unit_count"],
      "properties": {
        "mode": {"enum": ["NONE", "PAGE", "CURSOR", "ASYNC_JOB"]},
        "planned_unit_count": {"oneOf": [{"type": "integer", "minimum": 1, "maximum": 1000000}, {"type": "null"}]}
      }
    },
    "pagination_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": ["mode", "units_observed", "complete"],
      "properties": {
        "mode": {"enum": ["NONE", "PAGE", "CURSOR", "ASYNC_JOB"]},
        "units_observed": {"type": "integer", "minimum": 0, "maximum": 1000000},
        "complete": {"type": "boolean"}
      }
    },
    "retrieval_intent": {
      "type": "object", "additionalProperties": false,
      "required": [
        "purpose", "geographic_scope", "temporal_scope", "requested_fields",
        "filters", "exclusions", "sampling", "pagination", "result_selection",
        "authentication_posture", "secrets_embedded"
      ],
      "properties": {
        "purpose": {"enum": ["DATASET_BASELINE", "TEMPORAL_UPDATE", "GAP_REPAIR", "VALIDATION_SAMPLE", "EXPLORATORY_REVIEW"]},
        "geographic_scope": {"$ref": "#/$defs/geographic_scope"},
        "temporal_scope": {"$ref": "#/$defs/temporal_scope"},
        "requested_fields": {"$ref": "#/$defs/field_list"},
        "filters": {"$ref": "#/$defs/filter_list"},
        "exclusions": {"$ref": "#/$defs/exclusion_list"},
        "sampling": {"$ref": "#/$defs/sampling"},
        "pagination": {"$ref": "#/$defs/pagination_intent"},
        "result_selection": {"enum": ["ALL_MATCHES", "FIRST_N", "TOP_N", "SOURCE_DEFINED"]},
        "authentication_posture": {"enum": ["NONE", "REFERENCE_ONLY", "REDACTED_REFERENCE"]},
        "secrets_embedded": {"const": false}
      }
    },
    "query_snapshot": {
      "type": "object", "additionalProperties": false,
      "required": [
        "query_hash", "request_method", "source_interface_ref", "geographic_scope",
        "temporal_scope", "requested_fields", "filters", "exclusions", "sampling",
        "pagination", "result_selection", "authentication_posture",
        "secret_values_recorded", "request_digest", "response_digest",
        "result_count", "execution_state"
      ],
      "properties": {
        "query_hash": {"$ref": "#/$defs/sha256"},
        "request_method": {"enum": ["GET", "POST", "BULK_JOB"]},
        "source_interface_ref": {"$ref": "#/$defs/safe_ref"},
        "geographic_scope": {"$ref": "#/$defs/geographic_scope"},
        "temporal_scope": {"$ref": "#/$defs/temporal_scope"},
        "requested_fields": {"$ref": "#/$defs/field_list"},
        "filters": {"$ref": "#/$defs/filter_list"},
        "exclusions": {"$ref": "#/$defs/exclusion_list"},
        "sampling": {"$ref": "#/$defs/sampling"},
        "pagination": {"$ref": "#/$defs/pagination_snapshot"},
        "result_selection": {"enum": ["ALL_MATCHES", "FIRST_N", "TOP_N", "SOURCE_DEFINED"]},
        "authentication_posture": {"enum": ["NONE", "REFERENCE_ONLY", "REDACTED_REFERENCE"]},
        "secret_values_recorded": {"const": false},
        "request_digest": {"$ref": "#/$defs/sha256"},
        "response_digest": {"$ref": "#/$defs/nullable_sha256"},
        "result_count": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1000000000}, {"type": "null"}]},
        "execution_state": {"enum": ["COMPLETE", "PARTIAL", "FAILED"]}
      }
    },
    "retrieval_receipt": {
      "type": "object", "additionalProperties": false,
      "required": [
        "started_at", "finished_at", "retrieval_episode_ref", "outcome",
        "deviation_codes", "pagination_complete", "result_interpretation"
      ],
      "properties": {
        "started_at": {"$ref": "#/$defs/utc_datetime"},
        "finished_at": {"$ref": "#/$defs/utc_datetime"},
        "retrieval_episode_ref": {"$ref": "#/$defs/nullable_ref"},
        "outcome": {"enum": ["MATCHED_COMPLETE", "INCOMPLETE", "FAILED", "CHANGED_QUERY"]},
        "deviation_codes": {
          "type": "array", "maxItems": 9, "uniqueItems": true,
          "items": {"enum": [
            "AUTHENTICATION_POSTURE_CHANGED", "EXCLUSIONS_CHANGED", "FIELDS_CHANGED", "FILTERS_CHANGED",
            "GEOGRAPHIC_SCOPE_CHANGED", "PAGINATION_CHANGED",
            "RESULT_SELECTION_CHANGED", "SAMPLING_CHANGED", "TEMPORAL_SCOPE_CHANGED"
          ]}
        },
        "pagination_complete": {"type": "boolean"},
        "result_interpretation": {"enum": ["RESULT_SET_RECORDED", "ZERO_RECORDS_NO_CLAIM", "RESULT_INCOMPLETE_NO_CLAIM", "RETRIEVAL_FAILED_NO_CLAIM", "CHANGED_QUERY_NOT_ACCEPTED"]}
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false,
      "required": ["recommendation", "review_state"],
      "properties": {
        "recommendation": {"enum": ["READY_FOR_REVIEW", "HOLD", "DENY"]},
        "review_state": {"const": "HOLD"}
      }
    },
    "effects": {
      "type": "object", "additionalProperties": false,
      "required": [
        "network_accessed", "secrets_resolved", "source_admitted",
        "response_authenticated", "completeness_proved", "evidence_resolved",
        "policy_decided", "human_review_approved", "lifecycle_mutated",
        "release_authorized", "published", "public_use_authorized"
      ],
      "properties": {
        "network_accessed": {"const": false},
        "secrets_resolved": {"const": false},
        "source_admitted": {"const": false},
        "response_authenticated": {"const": false},
        "completeness_proved": {"const": false},
        "evidence_resolved": {"const": false},
        "policy_decided": {"const": false},
        "human_review_approved": {"const": false},
        "lifecycle_mutated": {"const": false},
        "release_authorized": {"const": false},
        "published": {"const": false},
        "public_use_authorized": {"const": false}
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "source_idea_ids": ["KFM-CAND-0127", "KFM-CAND-0128", "KFM-CAND-0129"],
    "authority": "fixture_internal_coherence_only"
  }
}
