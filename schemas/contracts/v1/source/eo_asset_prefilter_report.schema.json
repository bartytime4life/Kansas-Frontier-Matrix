{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kansasfrontiermatrix.org/schemas/contracts/v1/source/eo_asset_prefilter_report.schema.json",
  "title": "EOAssetPrefilterReport",
  "description": "Deterministic, no-network report over already-normalized Earth-observation item and asset metadata.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "report_id",
    "hash_profile",
    "spec_hash",
    "profile",
    "scope",
    "items",
    "summary",
    "governance"
  ],
  "properties": {
    "object_type": {"const": "EOAssetPrefilterReport"},
    "schema_version": {"const": "1.0.0"},
    "report_id": {"type": "string", "pattern": "^eo-prefilter:[a-z0-9][a-z0-9_.:-]{7,240}$"},
    "hash_profile": {"const": "kfm-canonical-json-v1"},
    "spec_hash": {"$ref": "#/$defs/sha256"},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_ref", "profile_version", "profile_spec_hash"],
      "properties": {
        "profile_ref": {"type": "string", "pattern": "^kfm://prefilter-profile/eo/[a-z0-9_.:-]+$"},
        "profile_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
        "profile_spec_hash": {"$ref": "#/$defs/sha256"}
      }
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analysis_unit_kind", "geography_ref", "query_ref", "query_digest", "collections", "datetime", "cloud_cover_lte_percent", "limit"],
      "properties": {
        "analysis_unit_kind": {"const": "county"},
        "geography_ref": {"$ref": "#/$defs/ref"},
        "query_ref": {"$ref": "#/$defs/ref"},
        "query_digest": {"$ref": "#/$defs/sha256"},
        "collections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 32,
          "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
          "uniqueItems": true
        },
        "datetime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["start", "end"],
          "properties": {"start": {"$ref": "#/$defs/time"}, "end": {"$ref": "#/$defs/time"}}
        },
        "cloud_cover_lte_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "limit": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "items": {"type": "array", "maxItems": 500, "items": {"$ref": "#/$defs/item"}},
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items_checked", "items_found", "assets_checked", "assets_found",
        "items_meeting_valid_pixel_fraction", "items_meeting_cloud_cover", "items_usable",
        "assets_missing", "assets_without_replay_validator", "decision", "reason_codes"
      ],
      "properties": {
        "items_checked": {"type": "integer", "minimum": 0, "maximum": 500},
        "items_found": {"type": "integer", "minimum": 0, "maximum": 500},
        "assets_checked": {"type": "integer", "minimum": 0, "maximum": 32000},
        "assets_found": {"type": "integer", "minimum": 0, "maximum": 32000},
        "items_meeting_valid_pixel_fraction": {"type": "integer", "minimum": 0, "maximum": 500},
        "items_meeting_cloud_cover": {"type": "integer", "minimum": 0, "maximum": 500},
        "items_usable": {"type": "integer", "minimum": 0, "maximum": 500},
        "assets_missing": {"type": "integer", "minimum": 0, "maximum": 32000},
        "assets_without_replay_validator": {"type": "integer", "minimum": 0, "maximum": 32000},
        "decision": {"enum": ["PASS", "HOLD", "DENY"]},
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {"enum": ["ASSET_MISSING", "INSUFFICIENT_ASSETS", "INSUFFICIENT_ITEMS", "INSUFFICIENT_USABLE_ITEMS", "NO_ITEMS_FOUND", "PREFILTER_REQUIREMENTS_MET", "REPLAY_VALIDATOR_MISSING"]},
          "uniqueItems": true
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_activated", "network_performed", "raw_admitted", "evidence_resolved", "policy_evaluated", "promotion_authorized", "public_use_allowed", "release_ref"],
      "properties": {
        "source_activated": {"const": false},
        "network_performed": {"const": false},
        "raw_admitted": {"const": false},
        "evidence_resolved": {"const": false},
        "policy_evaluated": {"const": false},
        "promotion_authorized": {"const": false},
        "public_use_allowed": {"const": false},
        "release_ref": {"type": "null"}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^sha256:[a-f0-9]{64}$"},
    "ref": {"type": "string", "minLength": 3, "maxLength": 640, "pattern": "^(?:kfm|fixture|urn):[^\\s]+$"},
    "time": {"type": "string", "format": "date-time", "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asset_ref", "status_code", "etag", "etag_strength", "last_modified", "content_length", "response_ms", "missing", "evidence_ref"],
      "properties": {
        "asset_ref": {"$ref": "#/$defs/ref"},
        "status_code": {"type": "integer", "minimum": 0, "maximum": 599},
        "etag": {"oneOf": [{"type": "null"}, {"type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[^\"\\s]+$"}]},
        "etag_strength": {"enum": ["strong", "weak", "missing"]},
        "last_modified": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/time"}]},
        "content_length": {"type": "integer", "minimum": 0},
        "response_ms": {"type": "integer", "minimum": 0, "maximum": 600000},
        "missing": {"type": "boolean"},
        "evidence_ref": {"$ref": "#/$defs/ref"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["item_ref", "collection", "observed_at", "cloud_cover_percent", "valid_pixel_fraction", "mask_role", "asset_count", "assets"],
      "properties": {
        "item_ref": {"$ref": "#/$defs/ref"},
        "collection": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_.:-]{0,127}$"},
        "observed_at": {"$ref": "#/$defs/time"},
        "cloud_cover_percent": {"type": "number", "minimum": 0, "maximum": 100},
        "valid_pixel_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "mask_role": {"enum": ["HLS_FMASK", "LANDSAT_QA", "S2CLOUDLESS", "SENTINEL2_SCL", "OTHER_REVIEWED"]},
        "asset_count": {"type": "integer", "minimum": 0, "maximum": 64},
        "assets": {"type": "array", "maxItems": 64, "items": {"$ref": "#/$defs/asset"}}
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "contract_doc": "contracts/source/eo_asset_prefilter_report.md",
    "profile": "pipeline_specs/source/eo_asset_prefilter_profile.v1.json",
    "validator": "tools/validators/source/validate_eo_asset_prefilter_report.py",
    "non_effects": ["does_not_fetch_or_activate_sources", "does_not_admit_raw_data", "does_not_resolve_evidence", "does_not_define_policy", "does_not_authorize_promotion", "does_not_release_or_publish"]
  }
}
