{
  "$id": "https://schemas.kfm.local/schemas/contracts/v1/source/occurrence_retrieval_snapshot.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Fixture-first, no-network snapshot of retrieval intent, a normalized query, sampling support, and transfer state for eBird or GBIF occurrence work. Validation does not activate a source, prove occurrence or absence, resolve evidence, approve rights or sensitivity, or authorize release.",
  "properties": {
    "fixture_only": {
      "const": true
    },
    "governance": {
      "additionalProperties": false,
      "properties": {
        "evidence_resolution_performed": {
          "const": false
        },
        "holds": {
          "maxItems": 2,
          "minItems": 2,
          "prefixItems": [
            {
              "const": "CURRENT_SOURCE_TERMS_UNVERIFIED"
            },
            {
              "const": "SENSITIVE_OCCURRENCE_REVIEW_PENDING"
            }
          ],
          "type": "array"
        },
        "public_use_allowed": {
          "const": false
        },
        "release": {
          "const": "HOLD"
        },
        "rights": {
          "const": "NEEDS_VERIFICATION"
        },
        "sensitivity": {
          "const": "NEEDS_VERIFICATION"
        },
        "source_activation_allowed": {
          "const": false
        }
      },
      "required": [
        "rights",
        "sensitivity",
        "release",
        "public_use_allowed",
        "source_activation_allowed",
        "evidence_resolution_performed",
        "holds"
      ],
      "type": "object"
    },
    "object_type": {
      "const": "OccurrenceRetrievalSnapshotCandidate"
    },
    "previous_snapshot_ref": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "pattern": "^kfm://candidate/source/occurrence-retrieval/(ebird|gbif)/[a-f0-9]{64}/revision/[1-9][0-9]*$",
          "type": "string"
        }
      ]
    },
    "query_snapshot": {
      "additionalProperties": false,
      "properties": {
        "country_code": {
          "const": "US"
        },
        "county_fips": {
          "items": {
            "pattern": "^20[0-9]{3}$",
            "type": "string"
          },
          "maxItems": 105,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        },
        "credentials_embedded": {
          "const": false
        },
        "date_range": {
          "additionalProperties": false,
          "properties": {
            "end": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            },
            "start": {
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
              "type": "string"
            }
          },
          "required": [
            "start",
            "end"
          ],
          "type": "object"
        },
        "notification_addresses_embedded": {
          "const": false
        },
        "predicates": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "field": {
                "pattern": "^[a-z][a-z0-9_]{1,63}$",
                "type": "string"
              },
              "operator": {
                "enum": [
                  "equals",
                  "not_equals",
                  "in",
                  "greater_than_or_equal",
                  "less_than_or_equal"
                ]
              },
              "value": {
                "oneOf": [
                  {
                    "type": "boolean"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "maxLength": 160,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "items": {
                      "oneOf": [
                        {
                          "type": "boolean"
                        },
                        {
                          "type": "number"
                        },
                        {
                          "maxLength": 160,
                          "minLength": 1,
                          "type": "string"
                        }
                      ]
                    },
                    "maxItems": 50,
                    "minItems": 1,
                    "type": "array",
                    "uniqueItems": true
                  }
                ]
              }
            },
            "required": [
              "field",
              "operator",
              "value"
            ],
            "type": "object"
          },
          "maxItems": 50,
          "minItems": 1,
          "type": "array"
        },
        "profile_version": {
          "const": "kfm.synthetic.occurrence-query.v1"
        },
        "query_hash": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "source_native_query_digest": {
          "pattern": "^sha256:[a-f0-9]{64}$",
          "type": "string"
        },
        "state_code": {
          "const": "KS"
        },
        "taxon_keys": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array",
          "uniqueItems": true
        }
      },
      "required": [
        "profile_version",
        "country_code",
        "state_code",
        "county_fips",
        "date_range",
        "taxon_keys",
        "predicates",
        "source_native_query_digest",
        "credentials_embedded",
        "notification_addresses_embedded",
        "query_hash"
      ],
      "type": "object"
    },
    "result_semantics": {
      "additionalProperties": false,
      "properties": {
        "failed_or_missing_transfer": {
          "const": "STATUS_UNCONFIRMED_NOT_EMPTY_RESULT"
        },
        "non_detection_scope": {
          "const": "CHECKLIST_EVENT_ONLY"
        },
        "occurrence_role": {
          "const": "SOURCE_REPORTED_OCCURRENCE_NOT_CONFIRMED_PRESENCE"
        },
        "zero_record_result": {
          "const": "NO_CLAIM_NOT_ABSENCE"
        }
      },
      "required": [
        "failed_or_missing_transfer",
        "zero_record_result",
        "occurrence_role",
        "non_detection_scope"
      ],
      "type": "object"
    },
    "retrieval_id": {
      "pattern": "^kfm://candidate/source/occurrence-retrieval/(ebird|gbif)/[a-f0-9]{64}$",
      "type": "string"
    },
    "retrieval_intent": {
      "additionalProperties": false,
      "properties": {
        "absence_claim_requested": {
          "type": "boolean"
        },
        "exact_coordinates_requested": {
          "type": "boolean"
        },
        "public_output": {
          "enum": [
            "none",
            "aggregate_only"
          ]
        },
        "purpose": {
          "enum": [
            "exploratory_occurrence_analysis",
            "presence_absence_analysis",
            "public_aggregate_candidate"
          ]
        },
        "requested_claim_support": {
          "enum": [
            "presence_only",
            "checklist_non_detection"
          ]
        }
      },
      "required": [
        "purpose",
        "requested_claim_support",
        "public_output",
        "exact_coordinates_requested",
        "absence_claim_requested"
      ],
      "type": "object"
    },
    "revision": {
      "maximum": 1000,
      "minimum": 1,
      "type": "integer"
    },
    "sampling_support": {
      "additionalProperties": false,
      "properties": {
        "absence_claim_supported": {
          "type": "boolean"
        },
        "complete_checklists_only": {
          "type": "boolean"
        },
        "ebd_sed_pair": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "additionalProperties": false,
              "properties": {
                "ebd_artifact_ref": {
                  "pattern": "^source-artifact:sha256:[a-f0-9]{64}$",
                  "type": "string"
                },
                "pairing_confirmed": {
                  "type": "boolean"
                },
                "release_date": {
                  "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                  "type": "string"
                },
                "sed_artifact_ref": {
                  "pattern": "^source-artifact:sha256:[a-f0-9]{64}$",
                  "type": "string"
                }
              },
              "required": [
                "release_date",
                "ebd_artifact_ref",
                "sed_artifact_ref",
                "pairing_confirmed"
              ],
              "type": "object"
            }
          ]
        },
        "non_detection_supported": {
          "type": "boolean"
        },
        "required_effort_fields": {
          "items": {
            "pattern": "^[a-z][a-z0-9_]{1,63}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array",
          "uniqueItems": true
        },
        "support_type": {
          "enum": [
            "COMPLETE_CHECKLIST_EBD_SED",
            "PRESENCE_ONLY_OCCURRENCE"
          ]
        }
      },
      "required": [
        "support_type",
        "non_detection_supported",
        "absence_claim_supported",
        "complete_checklists_only",
        "required_effort_fields",
        "ebd_sed_pair"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "kfm.source.occurrence-retrieval-snapshot.v1"
    },
    "snapshot_id": {
      "pattern": "^kfm://candidate/source/occurrence-retrieval/(ebird|gbif)/[a-f0-9]{64}/revision/[1-9][0-9]*$",
      "type": "string"
    },
    "source_descriptor_ref": {
      "pattern": "^kfm://source/(fauna|flora|biodiversity)/(ebird|gbif)@synthetic-[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "source_family": {
      "enum": [
        "ebird",
        "gbif"
      ]
    },
    "source_role": {
      "enum": [
        "citizen_science_observation",
        "aggregated_occurrence"
      ]
    },
    "spec_hash": {
      "pattern": "^sha256:[a-f0-9]{64}$",
      "type": "string"
    },
    "transfer": {
      "additionalProperties": false,
      "properties": {
        "citation_refs": {
          "items": {
            "pattern": "^kfm://citation/[a-z0-9._/-]+@sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 20,
          "type": "array",
          "uniqueItems": true
        },
        "current_state": {
          "enum": [
            "NOT_SUBMITTED",
            "SUBMITTED",
            "QUEUED",
            "RUNNING",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "EXPIRED"
          ]
        },
        "failure_reason_code": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^[A-Z][A-Z0-9_]{2,80}$",
              "type": "string"
            }
          ]
        },
        "mode": {
          "enum": [
            "bulk_file",
            "async_job"
          ]
        },
        "native_job_key_digest": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "pattern": "^sha256:[a-f0-9]{64}$",
              "type": "string"
            }
          ]
        },
        "record_count": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "minimum": 0,
              "type": "integer"
            }
          ]
        },
        "result_artifact_refs": {
          "items": {
            "pattern": "^source-artifact:sha256:[a-f0-9]{64}$",
            "type": "string"
          },
          "maxItems": 10,
          "type": "array",
          "uniqueItems": true
        },
        "result_interpretation": {
          "enum": [
            "not_evaluated",
            "candidate_records_available",
            "zero_records_no_claim"
          ]
        },
        "state_history": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "occurred_at": {
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$",
                "type": "string"
              },
              "state": {
                "enum": [
                  "NOT_SUBMITTED",
                  "SUBMITTED",
                  "QUEUED",
                  "RUNNING",
                  "SUCCEEDED",
                  "FAILED",
                  "CANCELLED",
                  "EXPIRED"
                ]
              }
            },
            "required": [
              "state",
              "occurred_at"
            ],
            "type": "object"
          },
          "maxItems": 1000,
          "minItems": 1,
          "type": "array"
        }
      },
      "required": [
        "mode",
        "current_state",
        "state_history",
        "native_job_key_digest",
        "result_artifact_refs",
        "citation_refs",
        "record_count",
        "result_interpretation",
        "failure_reason_code"
      ],
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "object_type",
    "fixture_only",
    "retrieval_id",
    "snapshot_id",
    "revision",
    "previous_snapshot_ref",
    "source_family",
    "source_role",
    "source_descriptor_ref",
    "retrieval_intent",
    "query_snapshot",
    "sampling_support",
    "transfer",
    "result_semantics",
    "governance",
    "spec_hash"
  ],
  "title": "Occurrence Retrieval Snapshot Candidate",
  "type": "object",
  "x-kfm": {
    "contract_doc": "contracts/source/occurrence_retrieval_snapshot.md",
    "fixture_only": true,
    "non_effects": [
      "no live source request or async job submission",
      "no source admission or activation",
      "no occurrence, non-detection, or absence proof",
      "no EvidenceBundle resolution or policy decision",
      "no promotion, release, deployment, or publication"
    ],
    "source_basis": "docs/intake/exploratory/new-ideas-4-30-source-map.md",
    "status": "PROPOSED"
  }
}
