{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/source/kansas_transportation_geometry_source_assessment.schema.json",
  "title": "KansasTransportationGeometrySourceAssessmentCandidate",
  "description": "Inactive, no-network synthetic assessment of four Kansas transportation geometry source lanes; no source, connector, lifecycle, release, or public-use authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "profile",
    "status",
    "assessment_id",
    "spec_hash",
    "assessed_at",
    "source_assessment_ref",
    "lanes",
    "crosswalk",
    "decision",
    "limitations",
    "effects"
  ],
  "properties": {
    "object_type": {
      "const": "KansasTransportationGeometrySourceAssessmentCandidate"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "profile": {
      "const": "kfm.source.kansas-transportation-geometry-source-assessment.fixture.v1"
    },
    "status": {
      "const": "PROPOSED_INACTIVE"
    },
    "assessment_id": {
      "type": "string",
      "pattern": "^ks-transport-geometry-assessment:[a-f0-9]{24}$"
    },
    "spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "assessed_at": {
      "$ref": "#/$defs/utc_datetime"
    },
    "source_assessment_ref": {
      "const": "kfm://doc/intake/kansas-transportation-geometry-source-admission-assessment"
    },
    "lanes": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/lane"
      }
    },
    "crosswalk": {
      "$ref": "#/$defs/crosswalk"
    },
    "decision": {
      "$ref": "#/$defs/decision"
    },
    "limitations": {
      "const": [
        "FIXTURE_ONLY_REFERENCES_UNRESOLVED",
        "NO_LIVE_ENDPOINT_OR_PAYLOAD_ACCESS",
        "NO_CANONICAL_ROAD_OR_CROSSWALK_AUTHORITY",
        "NO_SOURCE_EVIDENCE_POLICY_RELEASE_OR_PUBLIC_USE_AUTHORITY"
      ]
    },
    "effects": {
      "$ref": "#/$defs/effects"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "utc_datetime": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "safe_ref": {
      "type": "string",
      "pattern": "^kfm://[a-z0-9][a-z0-9._~:/-]{7,511}$"
    },
    "nullable_safe_ref": {
      "oneOf": [
        {
          "$ref": "#/$defs/safe_ref"
        },
        {
          "type": "null"
        }
      ]
    },
    "identifier_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "field",
        "semantic_role"
      ],
      "properties": {
        "field": {
          "enum": [
            "NGSEGID",
            "LRSKEY",
            "RouteID",
            "EventID",
            "GlobalID"
          ]
        },
        "semantic_role": {
          "enum": [
            "NG911_SEGMENT_ID",
            "CROSSWALK_CANDIDATE",
            "KHUB_ROUTE_ID",
            "KHUB_EVENT_ID",
            "OBJECT_STORE_ID"
          ]
        }
      }
    },
    "lane": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lane_id",
        "source_role",
        "interface_ref",
        "layer_id",
        "source_crs",
        "max_record_count",
        "query_formats",
        "authentication_posture",
        "identifier_state",
        "identifier_roles",
        "rights_state",
        "sensitivity_state",
        "snapshot_identity_state",
        "public_precision_state",
        "precision_policy_ref",
        "declared_disposition",
        "blocking_codes"
      ],
      "properties": {
        "lane_id": {
          "enum": [
            "DASC_NG911_ROAD_CENTERLINE",
            "KDOT_KHUB_LRS",
            "KDOT_MOBILE_LIDAR",
            "DASC_SUPPORTING_PRODUCTS"
          ]
        },
        "source_role": {
          "enum": [
            "ROAD_GEOMETRY_REFERENCE",
            "LRS_ROUTE_REFERENCE",
            "TRANSPORTATION_OBSERVATION_DERIVATIVE",
            "CATALOG_STEWARDSHIP_REFERENCE"
          ]
        },
        "interface_ref": {
          "$ref": "#/$defs/safe_ref"
        },
        "layer_id": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 9999
            },
            {
              "type": "null"
            }
          ]
        },
        "source_crs": {
          "type": "string",
          "pattern": "^(EPSG|ESRI):[0-9]{3,8}$|^SOURCE_DEFINED$"
        },
        "max_record_count": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000000
            },
            {
              "type": "null"
            }
          ]
        },
        "query_formats": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "enum": [
              "GEOJSON",
              "JSON",
              "PBF"
            ]
          }
        },
        "authentication_posture": {
          "enum": [
            "PUBLIC_METADATA",
            "ACCOUNT_REQUIRED",
            "PRODUCT_SPECIFIC"
          ]
        },
        "identifier_state": {
          "enum": [
            "VERIFIED_METADATA",
            "UNRESOLVED",
            "PRODUCT_SPECIFIC_UNRESOLVED"
          ]
        },
        "identifier_roles": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/identifier_role"
          }
        },
        "rights_state": {
          "enum": [
            "UNRESOLVED",
            "REVIEWED",
            "PROHIBITED"
          ]
        },
        "sensitivity_state": {
          "enum": [
            "REVIEW_REQUIRED",
            "PUBLIC_SAFE",
            "RESTRICTED"
          ]
        },
        "snapshot_identity_state": {
          "enum": [
            "UNRESOLVED",
            "PINNED"
          ]
        },
        "public_precision_state": {
          "enum": [
            "UNREVIEWED",
            "APPROVED",
            "GENERALIZED",
            "DENIED"
          ]
        },
        "precision_policy_ref": {
          "$ref": "#/$defs/nullable_safe_ref"
        },
        "declared_disposition": {
          "enum": [
            "ADMIT_REFERENCE_CANDIDATE",
            "HOLD",
            "DENY"
          ]
        },
        "blocking_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "enum": [
              "ACCOUNT_REQUIRED",
              "AUTHORITATIVE_DESIGNATION_PER_PRODUCT",
              "AUTHORITATIVE_DESIGNATION_UNRESOLVED",
              "DERIVATIVE_METHOD_UNRESOLVED",
              "IDENTIFIER_LIFECYCLE_UNRESOLVED",
              "IDENTIFIER_SUPERSESSION_UNRESOLVED",
              "PRODUCT_RIGHTS_UNRESOLVED",
              "PUBLIC_DOWNLOAD_RIGHTS_UNRESOLVED",
              "PUBLIC_PRECISION_REVIEW_REQUIRED",
              "REDISTRIBUTION_RIGHTS_UNRESOLVED",
              "SNAPSHOT_IDENTITY_UNRESOLVED",
              "UPDATE_SEMANTICS_UNRESOLVED"
            ]
          }
        }
      }
    },
    "crosswalk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relationship_state",
        "proximity_only_match_allowed",
        "temporal_overlap_required",
        "geometry_tolerance_meters",
        "split_merge_modelled",
        "identifier_roles"
      ],
      "properties": {
        "relationship_state": {
          "enum": [
            "UNRESOLVED",
            "BOUNDED_CANDIDATE",
            "REJECTED"
          ]
        },
        "proximity_only_match_allowed": {
          "type": "boolean"
        },
        "temporal_overlap_required": {
          "type": "boolean"
        },
        "geometry_tolerance_meters": {
          "oneOf": [
            {
              "type": "number",
              "minimum": 0,
              "maximum": 10000
            },
            {
              "type": "null"
            }
          ]
        },
        "split_merge_modelled": {
          "type": "boolean"
        },
        "identifier_roles": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "NGSEGID",
            "LRSKEY",
            "RouteID",
            "EventID",
            "GlobalID"
          ],
          "properties": {
            "NGSEGID": {
              "enum": [
                "NG911_SEGMENT_ID",
                "CROSSWALK_CANDIDATE",
                "KHUB_ROUTE_ID",
                "KHUB_EVENT_ID",
                "OBJECT_STORE_ID"
              ]
            },
            "LRSKEY": {
              "enum": [
                "NG911_SEGMENT_ID",
                "CROSSWALK_CANDIDATE",
                "KHUB_ROUTE_ID",
                "KHUB_EVENT_ID",
                "OBJECT_STORE_ID"
              ]
            },
            "RouteID": {
              "enum": [
                "NG911_SEGMENT_ID",
                "CROSSWALK_CANDIDATE",
                "KHUB_ROUTE_ID",
                "KHUB_EVENT_ID",
                "OBJECT_STORE_ID"
              ]
            },
            "EventID": {
              "enum": [
                "NG911_SEGMENT_ID",
                "CROSSWALK_CANDIDATE",
                "KHUB_ROUTE_ID",
                "KHUB_EVENT_ID",
                "OBJECT_STORE_ID"
              ]
            },
            "GlobalID": {
              "enum": [
                "NG911_SEGMENT_ID",
                "CROSSWALK_CANDIDATE",
                "KHUB_ROUTE_ID",
                "KHUB_EVENT_ID",
                "OBJECT_STORE_ID"
              ]
            }
          }
        }
      }
    },
    "lane_dispositions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "DASC_NG911_ROAD_CENTERLINE",
        "KDOT_KHUB_LRS",
        "KDOT_MOBILE_LIDAR",
        "DASC_SUPPORTING_PRODUCTS"
      ],
      "properties": {
        "DASC_NG911_ROAD_CENTERLINE": {
          "enum": [
            "ADMIT_REFERENCE_CANDIDATE",
            "HOLD",
            "DENY"
          ]
        },
        "KDOT_KHUB_LRS": {
          "enum": [
            "ADMIT_REFERENCE_CANDIDATE",
            "HOLD",
            "DENY"
          ]
        },
        "KDOT_MOBILE_LIDAR": {
          "enum": [
            "ADMIT_REFERENCE_CANDIDATE",
            "HOLD",
            "DENY"
          ]
        },
        "DASC_SUPPORTING_PRODUCTS": {
          "enum": [
            "ADMIT_REFERENCE_CANDIDATE",
            "HOLD",
            "DENY"
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome",
        "recommendation",
        "review_state",
        "lane_dispositions",
        "reason_codes"
      ],
      "properties": {
        "outcome": {
          "enum": [
            "PASS",
            "DENY",
            "ERROR"
          ]
        },
        "recommendation": {
          "enum": [
            "READY_FOR_REVIEW",
            "HOLD",
            "DENY"
          ]
        },
        "review_state": {
          "const": "HOLD"
        },
        "lane_dispositions": {
          "$ref": "#/$defs/lane_dispositions"
        },
        "reason_codes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{2,95}$"
          }
        }
      }
    },
    "effects": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_accessed",
        "credentials_resolved",
        "source_admitted",
        "connector_created",
        "schedule_created",
        "lifecycle_mutated",
        "road_authority_decided",
        "crosswalk_authority_decided",
        "evidence_resolved",
        "policy_decided",
        "release_authorized",
        "published",
        "public_use_authorized"
      ],
      "properties": {
        "network_accessed": {
          "const": false
        },
        "credentials_resolved": {
          "const": false
        },
        "source_admitted": {
          "const": false
        },
        "connector_created": {
          "const": false
        },
        "schedule_created": {
          "const": false
        },
        "lifecycle_mutated": {
          "const": false
        },
        "road_authority_decided": {
          "const": false
        },
        "crosswalk_authority_decided": {
          "const": false
        },
        "evidence_resolved": {
          "const": false
        },
        "policy_decided": {
          "const": false
        },
        "release_authorized": {
          "const": false
        },
        "published": {
          "const": false
        },
        "public_use_authorized": {
          "const": false
        }
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "authority": "fixture_internal_coherence_only",
    "source_assessment": "docs/intake/exploratory/kansas-transportation-geometry-source-admission-assessment.md",
    "public_release_authority": false
  }
}
