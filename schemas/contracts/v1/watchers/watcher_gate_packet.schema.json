{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.kfm.local/contracts/v1/watchers/watcher_gate_packet.schema.json",
  "title": "WatcherGatePacket",
  "description": "Fixture-only deterministic watcher prefilter/score/decision packet. GREEN, AMBER, and DENY are routing outcomes, not release states.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "object_type",
    "schema_version",
    "packet_id",
    "watcher_id",
    "spec_hash",
    "profile",
    "prefilter",
    "artifacts",
    "score",
    "decision",
    "process_exit_code",
    "reason_codes",
    "obligations",
    "assessed_at",
    "governance"
  ],
  "properties": {
    "object_type": {
      "const": "WatcherGatePacket"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "packet_id": {
      "type": "string",
      "pattern": "^watcher-gate:[a-z0-9][a-z0-9_.:-]{7,200}$"
    },
    "watcher_id": {
      "type": "string",
      "pattern": "^kfm://watcher/[a-z0-9][a-z0-9_./:-]{2,200}$"
    },
    "spec_hash": {
      "$ref": "#/$defs/sha256"
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "profile_id",
        "profile_version",
        "spec_hash"
      ],
      "properties": {
        "profile_id": {
          "type": "string",
          "pattern": "^kfm://watcher-gate-profile/[a-z0-9_.:-]+$"
        },
        "profile_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "spec_hash": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "prefilter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "items_found",
        "asset_missing_count",
        "missing_etag",
        "median_cloud_percent"
      ],
      "properties": {
        "items_found": {
          "type": "integer",
          "minimum": 0
        },
        "asset_missing_count": {
          "type": "integer",
          "minimum": 0
        },
        "missing_etag": {
          "type": "boolean"
        },
        "median_cloud_percent": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "prefilter_report_ref",
        "feature_vector_ref",
        "scorecard_ref",
        "policy_report_ref",
        "run_receipt_ref"
      ],
      "properties": {
        "prefilter_report_ref": {
          "$ref": "#/$defs/ref"
        },
        "feature_vector_ref": {
          "$ref": "#/$defs/ref"
        },
        "scorecard_ref": {
          "$ref": "#/$defs/ref"
        },
        "policy_report_ref": {
          "$ref": "#/$defs/ref"
        },
        "run_receipt_ref": {
          "$ref": "#/$defs/ref"
        }
      }
    },
    "score": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "decision": {
      "enum": [
        "GREEN",
        "AMBER",
        "DENY"
      ]
    },
    "process_exit_code": {
      "enum": [
        0,
        2
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "ALL_GATES_GREEN",
          "ASSET_MISSING",
          "MEDIAN_CLOUD_TOO_HIGH",
          "MISSING_ETAG",
          "NO_ITEMS",
          "SCORE_AMBER",
          "SCORE_BELOW_DENY"
        ]
      }
    },
    "obligations": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "BLOCK_PROMOTION",
          "ROUTE_STEWARD_REVIEW"
        ]
      }
    },
    "assessed_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "governance": {
      "$ref": "#/$defs/governance"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 640,
      "pattern": "^(?:kfm|fixture)://\\S+$"
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_activated",
        "policy_evaluated",
        "promotion_authorized",
        "public_use_allowed",
        "release_ref"
      ],
      "properties": {
        "source_activated": {
          "const": false
        },
        "policy_evaluated": {
          "const": false
        },
        "promotion_authorized": {
          "const": false
        },
        "public_use_allowed": {
          "const": false
        },
        "release_ref": {
          "type": "null"
        }
      }
    }
  },
  "x-kfm": {
    "status": "PROPOSED_INACTIVE",
    "contract_doc": "contracts/watchers/watcher_gate_packet.md",
    "profile": "pipeline_specs/watchers/watcher_gate_profile.v1.json",
    "validator": "tools/validators/watchers/validate_watcher_gate_packet.py",
    "non_effects": [
      "does_not_create_source_authority",
      "does_not_create_policy_authority",
      "does_not_promote_or_publish"
    ]
  }
}
