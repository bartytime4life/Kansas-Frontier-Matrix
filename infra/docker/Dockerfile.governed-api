# Security-review placeholder for governed-api.
# This image intentionally contains no application payload, secrets, lifecycle data,
# receipts, proofs, release material, or published artifacts.
FROM python:3.11.15-slim-trixie

RUN set -eux; \
    python -m pip install \
        --disable-pip-version-check \
        --no-cache-dir \
        --no-compile \
        --upgrade \
        "setuptools==82.0.1" \
        "wheel==0.46.3"; \
    groupadd --gid 10001 kfm; \
    useradd \
        --uid 10001 \
        --gid 10001 \
        --create-home \
        --home-dir /home/kfm \
        --shell /usr/sbin/nologin \
        kfm; \
    mkdir -p /app; \
    chown 10001:10001 /app

WORKDIR /app
USER 10001:10001
