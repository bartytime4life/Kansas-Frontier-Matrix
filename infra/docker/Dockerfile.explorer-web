# Security-review placeholder for explorer-web.
# This image intentionally contains no application payload, secrets, lifecycle data,
# receipts, proofs, release material, or published artifacts.
FROM node:22.23.2-trixie-slim@sha256:db8a96a63e5264607ada2d206758876ebbed6a12be2ada7517793cbfb0c2a29c

# The pinned Debian base carries fixed CVEs in the util-linux and OpenSSL package families.
# Upgrade only those families and fail closed if either remains below Debian's fix.
RUN set -eux; \
    apt-get update; \
    apt-get install --yes --no-install-recommends --only-upgrade \
        bsdutils \
        libblkid1 \
        liblastlog2-2 \
        libmount1 \
        libsmartcols1 \
        libssl3t64 \
        libuuid1 \
        login \
        mount \
        openssl \
        openssl-provider-legacy \
        util-linux; \
    dpkg --compare-versions \
        "$(dpkg-query --show --showformat='${Version}' libblkid1)" \
        ge \
        "2.41.5-0+deb13u1"; \
    dpkg --compare-versions \
        "$(dpkg-query --show --showformat='${Version}' libssl3t64)" \
        ge \
        "3.5.7-1~deb13u2"; \
    rm -rf /var/lib/apt/lists/*

COPY explorer-web/package.json explorer-web/package-lock.json /tmp/npm-overrides/
ADD --checksum=sha256:31e9770f7dc71119a58509353b27917557aaf0ac9b5ef1a0465ee7d8ec67ae75 \
    https://registry.npmjs.org/npm/-/npm-11.19.0.tgz \
    /tmp/npm-11.19.0.tgz

RUN set -eux; \
    npm ci \
        --prefix /tmp/npm-overrides \
        --ignore-scripts \
        --omit=dev \
        --no-audit \
        --no-fund; \
    rm -rf /usr/local/lib/node_modules/npm; \
    tar -xzf /tmp/npm-11.19.0.tgz -C /tmp; \
    mv /tmp/package /usr/local/lib/node_modules/npm; \
    rm -rf \
        /usr/local/lib/node_modules/npm/node_modules/brace-expansion \
        /usr/local/lib/node_modules/npm/node_modules/ip-address \
        /usr/local/lib/node_modules/npm/node_modules/tar; \
    cp -a \
        /tmp/npm-overrides/node_modules/brace-expansion \
        /usr/local/lib/node_modules/npm/node_modules/brace-expansion; \
    cp -a \
        /tmp/npm-overrides/node_modules/ip-address \
        /usr/local/lib/node_modules/npm/node_modules/ip-address; \
    cp -a \
        /tmp/npm-overrides/node_modules/tar \
        /usr/local/lib/node_modules/npm/node_modules/tar; \
    node -e 'const r="/usr/local/lib/node_modules/npm/node_modules"; const expected={"tar":"7.5.22","@isaacs/fs-minipass":"4.0.1","chownr":"3.0.0","minipass":"7.1.3","minizlib":"3.1.0","yallist":"5.0.0"}; for(const [p,v] of Object.entries(expected)) if(require(r+"/"+p+"/package.json").version!==v) process.exit(1); if(typeof require(r+"/tar").extract!=="function") process.exit(1)'; \
    rm -rf /tmp/npm-overrides /tmp/npm-11.19.0.tgz; \
    npm cache clean --force

WORKDIR /app
RUN chown node:node /app

USER node
