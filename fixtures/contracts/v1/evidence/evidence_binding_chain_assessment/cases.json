{
  "schema_version": "v1",
  "suite": "evidence-binding-chain-assessment",
  "cases": [
    {
      "case_id": "valid-exact-reference-chain",
      "mutations": [],
      "expected_outcome": "PASS",
      "expected_findings": []
    },
    {
      "case_id": "valid-deterministic-transformed-binding",
      "mutations": [
        {
          "op": "replace",
          "path": "/claim_field_binding/normalized_value_digest",
          "value": "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
        },
        {
          "op": "replace",
          "path": "/claim_field_binding/transform/kind",
          "value": "NORMALIZE_UNIT"
        },
        {
          "op": "replace",
          "path": "/claim_field_binding/transform/transform_ref",
          "value": "kfm://transform/unit/synthetic-v1"
        },
        {
          "op": "replace",
          "path": "/claim_field_binding/transform/transform_receipt_ref",
          "value": "kfm://transform-receipt/synthetic/value"
        },
        {
          "op": "replace",
          "path": "/claim_field_binding/support_scope",
          "value": "DERIVED_FIELD"
        },
        {
          "op": "replace",
          "path": "/claim_field_binding/quality/state",
          "value": "QUALIFIED"
        },
        {
          "op": "replace",
          "path": "/claim_field_binding/quality/confidence",
          "value": "MEDIUM"
        },
        {
          "op": "replace",
          "path": "/claim_field_binding/quality/reason_codes",
          "value": [
            "DETERMINISTIC_TRANSFORM",
            "SOURCE_FIELD_EXACT"
          ]
        },
        {
          "op": "replace",
          "path": "/claim_field_binding/limitations",
          "value": [
            "Fixture-only field binding.",
            "Normalized value depends on a deterministic unit transform.",
            "Referenced evidence is not resolved outside this assessment."
          ]
        }
      ],
      "expected_outcome": "PASS",
      "expected_findings": []
    },
    {
      "case_id": "source-artifact-not-fetched",
      "mutations": [
        {
          "op": "replace",
          "path": "/source_artifact/retrieval_outcome",
          "value": "MALFORMED"
        }
      ],
      "expected_outcome": "ABSTAIN",
      "expected_findings": [
        "SOURCE_ARTIFACT_NOT_FETCHED"
      ]
    },
    {
      "case_id": "parse-result-artifact-ref-mismatch",
      "mutations": [
        {
          "op": "replace",
          "path": "/parse_result/source_artifact_ref",
          "value": "source-artifact:sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
        }
      ],
      "relink_parse_result": true,
      "expected_outcome": "DENY",
      "expected_findings": [
        "PARSE_ARTIFACT_REF_MISMATCH"
      ]
    },
    {
      "case_id": "parser-version-mismatch",
      "mutations": [
        {
          "op": "replace",
          "path": "/parse_result/parser_version",
