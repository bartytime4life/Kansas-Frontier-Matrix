{
  "name": "kansas-frontier-matrix-explorer",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "archive:migration": "node scripts/migrate-hosted-ingestion.mjs",
    "install:ci": "npm ci",
    "prepare:maplibre": "node scripts/prepare-maplibre-assets.mjs",
    "predev": "npm run prepare:maplibre && npm run prepare:lightning",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "prebuild": "npm run prepare:maplibre && npm run prepare:lightning",
    "build": "vinext build",
    "start": "node server/start.mjs",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:browser-geometry": "node scripts/verify-explorer-geometry.mjs",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern public/maplibre",
    "prepare:lightning": "node scripts/prepare-lightning-reader.mjs",
    "build:qwen-knowledge": "node scripts/build-qwen-knowledge-pack.mjs"
  },
  "dependencies": {
    "@mapbox/vector-tile": "2.0.4",
    "h5wasm": "0.10.3",
    "lerc": "2.0.0",
    "maplibre-gl": "6.9.0",
    "next": "16.3.8",
    "pbf": "4.0.1",
    "polygon-clipping": "0.15.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sunrise-sunset-js": "3.3.1",
    "three": "0.186.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.186.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "file:vendor/vinext-0.0.50-kfm.2.tgz",
    "vite": "8.2.2",
    "mysql2": "3.24.6"
  },
  "type": "module",
  "displayName": "Kansas Frontier Matrix",
  "overrides": {
    "fast-uri": "3.1.8",
    "sharp": "0.35.5",
    "vinext": {
      "image-size": "2.0.4"
    },
    "miniflare": {
      "sharp": "0.35.5",
      "undici": "7.29.1"
    },
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  },
  "main": "server/start.mjs"
}
