[Unit]
Description=KFM bounded source acquisition and curation
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/kfm-data
ConditionPathExists=/etc/kfm-pipeline/config.json

[Service]
Type=oneshot
User=kfm-pipeline
Group=kfm-pipeline
ExecStart=/usr/bin/node /opt/kfm-pipeline/scripts/pc-pipeline/worker.mjs /etc/kfm-pipeline/config.json
LoadCredential=pipeline-worker-key:/etc/kfm-pipeline/worker-key
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/srv/kfm-data
ReadOnlyPaths=/etc/kfm-pipeline
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
MemoryMax=4G
MemorySwapMax=0
CPUQuota=200%
Nice=10
IOSchedulingClass=idle
TasksMax=64
TimeoutStartSec=9min
