# KFM home inference gateway. Install as /etc/systemd/system/kfm-inference-gateway.service
# with the code in /opt/kfm-inference/ and the owner-only config (root, mode 0600) in
# /etc/kfm-inference/gateway.json. See docs/home-inference.md, Phase 1.
[Unit]
Description=KFM home inference gateway (loopback only)
Wants=ollama.service
After=network-online.target ollama.service

[Service]
Type=simple
ExecStart=/usr/bin/node /opt/kfm-inference/home-inference-gateway.mjs serve
# The config with HMAC keys is handed over by systemd; the service cannot read /etc.
LoadCredential=gateway.json:/etc/kfm-inference/gateway.json
DynamicUser=yes
Restart=on-failure
RestartSec=5
# Network: accept from the local tunnel connector, call local Ollama, nothing else.
IPAddressAllow=localhost
IPAddressDeny=any
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Filesystem and kernel: read-only system, no home directories, no devices.
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
UMask=0077
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=multi-user.target
