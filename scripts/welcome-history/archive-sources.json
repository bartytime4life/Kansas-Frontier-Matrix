-dust": {"title": "File:Dust Storm in Rolla, Kansas 05-06-35 (4546091662).jpg", "size": 429135, "width": 3000, "height": 1835, "thumburl": "https://thumb.wikimedia.org/wikipedia/commons/thumb/1/16/Dust_Storm_in_Rolla%2C_Kansas_05-06-35_%284546091662%29.jpg/1920px-Dust_Storm_in_Rolla%2C_Kansas_05-06-35_%284546091662%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "thumbwidth": 1600, "thumbheight": 979, "responsiveUrls": {"2": "https://upload.wikimedia.org/wikipedia/commons/1/16/Dust_Storm_in_Rolla%2C_Kansas_05-06-35_%284546091662%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled"}, "thumbattribs": {"src": "https://thumb.wikimedia.org/wikipedia/commons/thumb/1/16/Dust_Storm_in_Rolla%2C_Kansas_05-06-35_%284546091662%29.jpg/1920px-Dust_Storm_in_Rolla%2C_Kansas_05-06-35_%284546091662%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail", "decoding": "async", "loading": "lazy", "width": 1600, "height": 979, "srcset": "https://upload.wikimedia.org/wikipedia/commons/1/16/Dust_Storm_in_Rolla%2C_Kansas_05-06-35_%284546091662%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=thumbnail_unscaled 2x"}, "url": "https://upload.wikimedia.org/wikipedia/commons/1/16/Dust_Storm_in_Rolla%2C_Kansas_05-06-35_%284546091662%29.jpg?utm_source=commons.wikimedia.org&utm_campaign=imageinfo&utm_content=original", "descriptionurl": "https://commons.wikimedia.org/wiki/File:Dust_Storm_in_Rolla,_Kansas_05-06-35_(4546091662).jpg", "descriptionshorturl": "https://commons.wikimedia.org/w/index.php?curid=38120235", "extmetadata": {"DateTime": {"value": "2015-01-30 13:39:21", "source": "mediawiki-metadata", "hidden": ""}, "ObjectName": {"value": "Dust Storm in Rolla, Kansas 05-06-35 (4546091662)", "source": "mediawiki-metadata"}, "CommonsMetadataExtension": {"value": 1.2, "source": "extension", "hidden": ""}, "Categories": {"value": "1935 in Kansas|Images from the National Archives and Records Administration|Morton County, Kansas|Dust Bowl|Flickr images reviewed by FlickreviewR|Files with derivative versions|Files from Flickr's 'The Commons'|Flickr images missing SDC creator|Flickr images missing SDC inception|Flickr images missing SDC source of file|Dust storms in Kansas|NARA images of Kansas|United States photographs taken on 1935-04-14|Flickr images missing SDC Flickr photo ID|Flickr images missing SDC published in", "source": "commons-categories", "hidden": ""}, "Assessments": {"value": "", "source": "commons-categories", "hidden": ""}, "ImageDescription": {"value": "<p><b>Original Caption:</b> \"Rolla Kansas, May 6-35.  Mr. Franklin D. Roosevelt.  Washington DC.  Dear Mr. Roosevelt, we are mailing you a picture of the dust storm which came April 14-35.  This was a northeast wind and darkness came.  When this hit us the sun was shining bright and darkness was coming on at 3 o'clock in the evening.  Taken from the water tower one hundred feet high.  Yours truly, Chas. P. Williams.  Rolla Kansas.\"  This caption is often abridged, but this is the full letter as quoted by <a rel=\"nofollow\" class=\"external text\" href=\"http://www.fdrlibrary.marist.edu/archives/collections/franklin/index.php?p=digitallibrary/digitalcontent&amp;id=3054\">the FDR Library</a>; abridged captions often make the date of the letter look like the date of the dust storm. \n<b>U.S. National Archives\u2019 Local Identifier:</b>  NLR-PHOCO-A-48223(3719)33\n</p><p><b>Created By:</b>  Roosevelt, Franklin D. (Franklin Delano), 1882-1945\n</p><p><b>From:</b>: Franklin D. Roosevelt Library Public Domain Photographs\n</p><p><b>Production Date:</b> 4/14/1935\n</p><p><b>Persistent URL:</b>  <a rel=\"nofollow\" class=\"external text\" href=\"https://arcweb.archives.gov/arc/action/ExternalIdSearch?id=195691\">arcweb.archives.gov/arc/action/ExternalIdSearch?id=195691</a>\n</p><p><b>Repository: </b>Franklin D. Roosevelt Library (Hyde Park, NY)\n</p><p>Access Restrictions: Unrestricted\n</p>\nUse Restrictions: Unrestricted", "source": "commons-desc-page"}, "Credit": {"value": "This tag does not indicate the copyright status of the attached work. <span style=\"white-space:nowrap\">A normal <a href=\"//commons.wikimedia.org/wiki/Special:MyLanguage/Commons:Copyright_tags\" title=\"Special:MyLanguage/Commons:Copyright tags\">copyright tag</a> is still required.</span> <span style=\"white-space:nowrap\">See <a href=\"//commons.wikimedia.org/wiki/Special:MyLanguage/Commons:Licensing\" title=\"Special:MyLanguage/Commons:Licensing\">Commons:Licensing</a>.</span>", "source": "commons-desc-page"}, "Artist": {"value": "<a rel=\"nofollow\" class=\"external text\" href=\"https://www.flickr.com/people/35740357@N03\">The U.S. National Archives</a>", "source": "commons-desc-page"}, "Permission": {"value": "<a rel=\"nofollow\" class=\"external text\" href=\"https://www.archives.gov/social-media/flickr-faqs.html#9\">The U.S. National Archives @ Flickr Commons</a>", "source": "commons-desc-page", "hidden": ""}, "LicenseShortName": {"value": "No restrictions", "source": "commons-desc-page", "hidden": ""}, "UsageTerms": {"value": "No known copyright restrictions", "source": "commons-desc-page"}, "AttributionRequired": {"value": "false", "source": "commons-desc-page", "hidden": ""}, "LicenseUrl": {"value": "https://www.flickr.com/commons/usage/", "source": "commons-desc-page"}, "Copyrighted": {"value": "True", "source": "commons-desc-page", "hidden": ""}, "Restrictions": {"value": "", "source": "commons-desc-page", "hidden": ""}}}}