+'use strict';
+
+// KFM mitigation for GHSA-vfj7-8cjw-p6xm; fixed, not caller-configurable.
+module.exports = (depth, node) => {
+  if (depth > 128) {
+    throw new RangeError('braces nesting exceeds fixed depth limit (128)');
+  }
+  if (node && node.value !== undefined && typeof node.value !== 'string') {
+    throw new TypeError('braces AST values must be strings');
+  }
+};
