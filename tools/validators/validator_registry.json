      "path_globs": [
        "contracts/source/**",
        "schemas/contracts/v1/source/**",
        "schemas/contracts/v1/sources/**",
        "data/registry/sources/**",
        "fixtures/contracts/v1/source/**",
        "tests/validators/test_validate_source_descriptor.py",
        "tools/validators/validate_source_descriptor.py"
      ],
      "timeout_seconds": 120,
      "artifact_refs": []
    },
    {
