+def _empty_reconciliation_data() -> dict[str, object]:
+    return {
+        "authority": RECONCILIATION_AUTHORITY,
+        "closure_ref": RECONCILIATION_CLOSURE_REF,
+        "entries": [],
+        "non_effects": list(RECONCILIATION_NON_EFFECTS),
+        "owner": "@bartytime4life",
+        "schema_version": RECONCILIATION_VERSION,
+    }
+
+
+def _load_reconciliation_bytes(
+    raw: bytes, *, label: str
+) -> tuple[Mapping[str, object], dict[str, Mapping[str, object]]]:
+    if len(raw) > MAX_FILE_BYTES:
+        raise TopologyError(f"{label} reconciliation register is too large")
+    try:
+        data = json.loads(
+            raw.decode("utf-8"),
+            object_pairs_hook=_unique_object,
+            parse_constant=_nonfinite,
+            parse_float=_finite_float,
+        )
+    except (OSError, UnicodeError, json.JSONDecodeError, TopologyError) as exc:
+        raise TopologyError(
+            f"{label} reconciliation JSON is invalid: {type(exc).__name__}"
+        ) from exc
+    expected = {
+        "authority",
+        "closure_ref",
+        "entries",
+        "non_effects",
+        "owner",
+        "schema_version",
+    }
+    if not isinstance(data, dict) or set(data) != expected:
+        raise TopologyError("reconciliation root does not match the v1 contract")
+    if (
+        data["schema_version"] != RECONCILIATION_VERSION
+        or data["authority"] != RECONCILIATION_AUTHORITY
+        or data["closure_ref"] != RECONCILIATION_CLOSURE_REF
+        or data["non_effects"] != RECONCILIATION_NON_EFFECTS
+        or data["owner"] != "@bartytime4life"
+    ):
+        raise TopologyError("reconciliation identity or authority is invalid")
