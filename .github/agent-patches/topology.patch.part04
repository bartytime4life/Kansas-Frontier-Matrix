+    def test_registered_preexisting_conflict_reconciliation_is_exact(self) -> None:
+        path = "catalog/domain/example/README.md"
+        prior_blob_sha = "a" * 40
+        current_blob_sha = "b" * 40
+        trusted_sha = "c" * 40
+        shared = "catalog/README.md@" + "d" * 40
+        prior = module._finding(
+            "KFM-TOPO-004",
+            "catalog/",
+            [shared, f"{path}@{prior_blob_sha}"],
+        )
+        current = module._finding(
+            "KFM-TOPO-004",
+            "catalog/",
+            [shared, f"{path}@{current_blob_sha}"],
+        )
+        record = _reconciliation_record(
+            prior,
+            current,
+            path=path,
+            prior_blob_sha=prior_blob_sha,
+            current_blob_sha=current_blob_sha,
+            trusted_base_sha=trusted_sha,
+        )
+        module._validate_conflict_reconciliation_record(
+            record,
+            _entry(current),
+            _entry(prior),
+            current,
+            current,
+            b"<<<<<<< HEAD\nleft\n=======\nright\n>>>>>>> origin/main\n",
+            b"resolved\n",
+            trusted_sha,
+        )
+
+        with self.assertRaisesRegex(module.TopologyError, "not already present"):
+            module._validate_conflict_reconciliation_record(
+                record,
+                _entry(current),
+                _entry(prior),
+                current,
+                prior,
+                b"<<<<<<< HEAD\nleft\n=======\nright\n>>>>>>> origin/main\n",
+                b"resolved\n",
+                trusted_sha,
+            )
+        with self.assertRaisesRegex(module.TopologyError, "no complete conflict"):
+            module._validate_conflict_reconciliation_record(
+                record,
+                _entry(current),
+                _entry(prior),
+                current,
+                current,
+                b"ordinary prior text\n",
+                b"resolved\n",
+                trusted_sha,
+            )
+        with self.assertRaisesRegex(module.TopologyError, "still contains conflict"):
+            module._validate_conflict_reconciliation_record(
+                record,
+                _entry(current),
+                _entry(prior),
+                current,
+                current,
+                b"<<<<<<< HEAD\nleft\n=======\nright\n>>>>>>> origin/main\n",
+                b"<<<<<<< HEAD\nunresolved\n",
+                trusted_sha,
+            )
+
