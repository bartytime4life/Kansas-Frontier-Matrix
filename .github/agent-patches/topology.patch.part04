+    def test_reconciliation_register_is_append_only_and_one_at_a_time(self) -> None:
+        empty_data = module._empty_reconciliation_data()
+        current_data = module._empty_reconciliation_data()
+        prior = module._finding(
+            "KFM-TOPO-004",
+            "catalog/",
+            ["catalog/domain/example/README.md@" + "a" * 40],
+        )
+        current = module._finding(
+            "KFM-TOPO-004",
+            "catalog/",
+            ["catalog/domain/example/README.md@" + "b" * 40],
+        )
+        first = _reconciliation_record(prior, current)
+        additions = module.validate_reconciliation_transition(
+            current_data,
+            {str(first["record_id"]): first},
+            empty_data,
+            {},
+        )
+        self.assertEqual((first["record_id"],), additions)
+
+        mutated = dict(first)
+        mutated["governance_issue"] = (
+            "https://github.com/bartytime4life/"
+            "Kansas-Frontier-Matrix/issues/9999"
+        )
+        with self.assertRaisesRegex(module.TopologyError, "mutates"):
+            module.validate_reconciliation_transition(
+                current_data,
+                {str(first["record_id"]): mutated},
+                empty_data,
+                {str(first["record_id"]): first},
+            )
+        with self.assertRaisesRegex(module.TopologyError, "removes"):
+            module.validate_reconciliation_transition(
+                current_data,
+                {},
+                empty_data,
+                {str(first["record_id"]): first},
+            )
+        second = dict(first)
+        second["record_id"] = "catalog-second-readme-conflict-20260902"
+        second["path"] = "catalog/domain/second/README.md"
+        with self.assertRaisesRegex(module.TopologyError, "more than one"):
+            module.validate_reconciliation_transition(
+                current_data,
+                {
+                    str(first["record_id"]): first,
+                    str(second["record_id"]): second,
+                },
+                empty_data,
+                {},
+            )
+
